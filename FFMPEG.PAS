Procedure DCInit;
Var T,I,J,K,E,P,Cnt,L,Code: LongInt; Cd: Int64; Sizes: Array[0..61] Of LongInt; Offs: Array[0..61] Of LongInt;
Begin
 If DCInited Then Exit;
 DCInited:=True;
 T:=0;
 For I:=0 To 9 Do For J:=0 To DCCbGrp[I]-1 Do Begin Sizes[T]:=DCCbSize[I]; Offs[T]:=DCCbOff[I]; DCQI[I,J]:=T; Inc(T); End;
 For I:=0 To 4 Do Begin Sizes[T]:=12; Offs[T]:=1; Inc(T); End;
 For I:=0 To 4 Do Begin Sizes[T]:=129; Offs[T]:=-64; Inc(T); End;
 For I:=0 To 3 Do Begin Sizes[T]:=4; Offs[T]:=0; Inc(T); End;
 P:=0;
 For T:=0 To 61 Do Begin
  DCStart[T]:=P; DCNum[T]:=Sizes[T]; DCOffs[T]:=Offs[T];
  Cd:=0; DCMaxLen[T]:=0;
  For E:=0 To Sizes[T]-1 Do Begin
   L:=DCAVlcLen[P+E];
   If L>0 Then Begin
    DCCode[P+E]:=Cd Shr (32-L);
    If L>DCMaxLen[T] Then DCMaxLen[T]:=L;
    Cd:=Cd+(Int64(1) Shl (32-L));
   End;
  End;
  Inc(P,Sizes[T]);
 End;
 Move(DCAFirPerfect,DCFir32P,2048); Move(DCAFirNon,DCFir32N,2048);
 Move(DCALfe64,DCLfe64F,1024); Move(DCALfe128,DCLfe128F,1024);
 For I:=0 To 31 Do For J:=0 To 31 Do DCCos[I,J]:=Cos(Pi/32*(32-I-0.5)*(J+0.5));
 GetMem(DCSub,7*32*DCStride*4+64);
 FillChar(DCSub^,7*32*DCStride*4,0);
 FillChar(DCLfeS,SizeOf(DCLfeS),0);
 FillChar(DCHist1,SizeOf(DCHist1),0); FillChar(DCHist2,SizeOf(DCHist2),0); FillChar(DCOff,SizeOf(DCOff),0);
 FillChar(DCSfAdj,SizeOf(DCSfAdj),0);
End;

Function DCLeft: LongInt;Begin DCLeft:=DCSize*8-DCBit; End;
Function DCBits(N: LongInt): Int64;
Var V: Int64; I,B: LongInt;
Begin
 V:=0;
 For I:=1 To N Do Begin
  B:=DCBit Shr 3;
  If B<DCSize Then V:=V*2+((DCBuf^[B] Shr (7-(DCBit And 7))) And 1) Else V:=V*2;
  Inc(DCBit);
 End;
 DCBits:=V;
End;
Function DCSBits(N: LongInt): LongInt;
Var V: Int64;
Begin
 If N=0 Then Begin DCSBits:=0; Exit; End;
 V:=DCBits(N); If V>=(Int64(1) Shl (N-1)) Then V:=V-(Int64(1) Shl N); DCSBits:=V;
End;
Function DCVlc(T: LongInt): LongInt;
Var V: Int64; L,E,S: LongInt;
Begin
 V:=0; S:=DCStart[T];
 For L:=1 To DCMaxLen[T] Do Begin
  V:=V*2+DCBits(1);
  For E:=0 To DCNum[T]-1 Do
   If (DCAVlcLen[S+E]=L) And (DCCode[S+E]=V) Then Begin
    DCVlc:=DCAVlcSym[S+E]+DCOffs[T]; Exit;
   End;
 End;
 DCErr:=True; DCVlc:=0;
End;
Function DCClip23(A: Int64): LongInt;
Begin If A>8388607 Then A:=8388607; If A<-8388608 Then A:=-8388608; DCClip23:=A; End;
Function DCNorm(A: Int64; Bits: LongInt): LongInt;
Begin If Bits>0 Then DCNorm:=AVSar(A+(Int64(1) Shl (Bits-1)),Bits) Else DCNorm:=A; End;
Function DCSmp(Ch,Band,N: LongInt): LongInt;Begin DCSmp:=DCSub^[(Ch*32+Band)*DCStride+4+N]; End;

Function DCParseScale(Var Index: LongInt; Sel: LongInt): LongInt;
Var V: LongInt;
Begin
 If Sel<5 Then Inc(Index,DCVlc(53+Sel)) Else Index:=DCBits(Sel+1);
 If Sel>5 Then Begin
  If (Index<0) Or (Index>=128) Then Begin DCErr:=True; DCParseScale:=0; Exit; End;
  V:=DCAScale7[Index];
 End Else Begin
  If (Index<0) Or (Index>=64) Then Begin DCErr:=True; DCParseScale:=0; Exit; End;
  V:=DCAScale6[Index];
 End;
 DCParseScale:=V;
End;
Function DCParseJoint(Sel: LongInt): LongInt;
Var Idx: LongInt;
Begin
 If Sel<5 Then Idx:=DCVlc(53+Sel) Else Idx:=DCBits(Sel+1);
 Inc(Idx,64);
 If (Idx<0) Or (Idx>=129) Then Begin DCErr:=True; DCParseJoint:=0; Exit; End;
 DCParseJoint:=DCAJoint[Idx];
End;

