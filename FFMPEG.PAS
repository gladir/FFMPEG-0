 GetMem(Fr,LogW*PixSize*Hh+16); GetMem(FrPrev,LogW*PixSize*Hh+16);
 GetMem(RleCode,(LogW+2)*4); GetMem(LenTab,(LogW+2)*4); GetMem(SkipTab,LogW+16);
 EncCap:=65536; EncLen:=0; GetMem(Enc,EncCap);
