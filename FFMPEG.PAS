       For Y:=0 To NVCH-1 Do Move(F1Pl[I]^[Y*F1Str[I]],HYOut^[(AXW*AXH+(I-1)*NVCW*NVCH+Y*NVCW)*Bs],NVCW*Bs);
     End;
     F1FreeCur;
    End;
   End;
   20: Begin
    Ok:=HYFrame(PEABuffer(@AXF^[PkPos]),PkLen);
