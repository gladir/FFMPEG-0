 { en-tete trame }
 DCCrcPresent,DCNPcm,DCFrameSize,DCMode,DCSr,DCBrCode,DCBitRate,DCDrc,DCTs,DCAux,DCExtType,DCExtPresent,DCSyncSsf,DCLfe,DCPredHist,DCFilterPerfect,DCSumFront,DCSumSurr: LongInt;
