     Else If HYFmt=9 Then Begin
      For Y:=0 To AXH-1 Do For X:=0 To AXW-1 Do Begin
       HYOut^[(Y*AXW+X)*3]:=HYPlane[2]^[Y*HYStr[2]+X]; HYOut^[(Y*AXW+X)*3+1]:=HYPlane[0]^[Y*HYStr[0]+X]; HYOut^[(Y*AXW+X)*3+2]:=HYPlane[1]^[Y*HYStr[1]+X];
      End;
     End Else Begin
      If HYFmt=7 Then Bs:=1 Else Bs:=2;
      For Y:=0 To AXH-1 Do Move(HYPlane[0]^[Y*HYStr[0]],HYOut^[Y*AXW*Bs],AXW*Bs);
      If HYChroma<>0 Then For I:=1 To 2 Do
       For Y:=0 To NVCH-1 Do Move(HYPlane[I]^[Y*HYStr[I]],HYOut^[(AXW*AXH+(I-1)*NVCW*NVCH+Y*NVCW)*Bs],NVCW*Bs);
     End;
    End;
   End;
  End;
  If Ok Then Begin
   Case Kind Of
    18: NVEmit(FSVPic);
    20,21,40,41,42,43: NVEmit(HYOut);
    24: NVEmit(FROut);
    26: NVEmit(H3OutBuf);
    31,32,37: Begin
     CFSync(PIdx,1,NbF,NbP);
     NVEmitN(HYOut,NbP,NbF);
     Inc(CFNext,NbF); Inc(CFFrameNo,NbF); FFBegun:=True;
    End;
   End;
  End Else If (Kind<>31) And (Kind<>32) And (Kind<>37) And (((Kind<>21) And (Kind<>24) And (Kind<>26) And (Kind<>42) And (Kind<>43)) Or FFBegun) Then NVRepeat;
  If NVDone Then Break;
 End;
 If ((Kind=31) Or (Kind=32) Or (Kind=37)) And FFBegun And Not NVDone Then CFFlush(HYOut);
