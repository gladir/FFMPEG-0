   If (Int64(Buf1[I])+$1000<0) Or (Int64(Buf1[I])+$1000>$1FFF) Then Exit;
   Refl[I]:=Buf1[I];
  End Else Begin
   If (Int64(Buf2[I])+$1000<0) Or (Int64(Buf2[I])+$1000>$1FFF) Then Exit;
   Refl[I]:=Buf2[I];
  End;
