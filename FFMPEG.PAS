   GetMem(Hd,CW*((Hh+1) Div 2)+64);
   For K:=0 To 1 Do Begin
    ReadPlane(Hd,Cur+W*Hh+K*CW*((Hh+1) Div 2),CW*((Hh+1) Div 2));
