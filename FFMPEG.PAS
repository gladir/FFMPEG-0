Procedure IR2Init;
Var I,J,L,R: LongInt; Code: Int64; C: LongInt;
Begin
 FillChar(IR2Sym,SizeOf(IR2Sym),0); FillChar(IR2Len,SizeOf(IR2Len),0);
 Code:=0;
