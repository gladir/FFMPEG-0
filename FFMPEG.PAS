Var I,B,C,S,Lo,Hi,K: LongInt;
Begin
 MaxB:=1;
 For I:=0 To N-1 Do If Bits^[I]>MaxB Then MaxB:=Bits^[I];
 For K:=0 To (1 Shl MaxB)-1 Do Begin Lut[K]:=-1; Len[K]:=0; End;
 For I:=0 To N-1 Do Begin
  B:=Bits^[I]; If B=0 Then Continue;
  If Wide Then C:=Codes^[I*2]+Codes^[I*2+1]*256 Else C:=Codes^[I];
  If Syms<>Nil Then S:=Syms^[I] Else S:=I;
  Lo:=C Shl (MaxB-B); Hi:=Lo+(1 Shl (MaxB-B))-1;
  For K:=Lo To Hi Do Begin Lut[K]:=S; Len[K]:=B; End;
 End;
End;

Function DXSelect(Cid: LongInt; BitDepth: LongInt): Integer;
Var Idx: LongInt;
Begin
 DXSelect:=-1;
 Idx:=DXFindCid(Cid);
 If Idx<0 Then Exit;
 If Idx<>DXCurIdx Then Begin
  DXSelectCid(Idx); DXCurIdx:=Idx;
  DXBuildLut(DXAcLut,DXAcLen,257,PEABuffer(@DXAcCodes),True,PEABuffer(@DXAcBits),Nil,DXAcMax);
  DXBuildLut(DXDcLut,DXDcLen,DXNDc,PEABuffer(@DXDcCodes),False,PEABuffer(@DXDcBits),Nil,DXDcMax);
  DXBuildLut(DXRunLut,DXRunLen,62,PEABuffer(@DXRunCodes),True,PEABuffer(@DXRunBits),PEABuffer(@DXRun),DXRunMax);
 End;
 If (DXTabDepth<>BitDepth) And (DXTabDepth<>0) Then Begin DXSelect:=-2; Exit; End;
 DXBitDepth:=BitDepth;
 DXSelect:=0;
End;

Procedure DXIdctPut(Var Blk: TAMVBlock; Dest: PEABuffer; Stride,Depth: LongInt);
Var
 W1,W2,W3,W4,W5,W6,W7,RS,CS,DCS,Mx,CR: LongInt;
 I,K: Integer; A0,A1,A2,A3,B0,B1,B2,B3: Int64; R: Array[0..7] Of Int64; V: Int64;
Procedure Put(Col,Row: Integer; X: Int64);
Var O: LongInt;
Begin
 X:=AVSar(X,CS); If X<0 Then X:=0; If X>Mx Then X:=Mx;
 If Depth=8 Then Dest^[Row*Stride+Col]:=X
 Else Begin O:=(Row*Stride+Col)*2; Dest^[O]:=X And 255; Dest^[O+1]:=X Shr 8; End;
End;
Begin
 If Depth=8 Then Begin W1:=22725; W2:=21407; W3:=19266; W4:=16383; W5:=12873; W6:=8867; W7:=4520; RS:=11; CS:=20; DCS:=3; End
 Else If Depth=10 Then Begin W1:=22725; W2:=21407; W3:=19265; W4:=16384; W5:=12873; W6:=8867; W7:=4520; RS:=12; CS:=19; DCS:=2; End
 Else Begin W1:=45451; W2:=42813; W3:=38531; W4:=32767; W5:=25746; W6:=17734; W7:=9041; RS:=16; CS:=17; DCS:=-1; End;
 Mx:=(1 Shl Depth)-1; CR:=(1 Shl (CS-1)) Div W4;
 For I:=0 To 7 Do Begin
  For K:=0 To 7 Do R[K]:=Blk[I*8+K];
  If (R[1] Or R[2] Or R[3] Or R[4] Or R[5] Or R[6] Or R[7])=0 Then Begin
   If DCS>=0 Then V:=SmallInt(R[0] Shl DCS) Else V:=SmallInt(AVSar(R[0]+(1 Shl (-DCS-1)),-DCS));
   For K:=0 To 7 Do Blk[I*8+K]:=V;
  End Else Begin
   A0:=W4*R[0]+(Int64(1) Shl (RS-1)); A1:=A0; A2:=A0; A3:=A0;
   Inc(A0,W2*R[2]); Inc(A1,W6*R[2]); Dec(A2,W6*R[2]); Dec(A3,W2*R[2]);
   B0:=W1*R[1]+W3*R[3]; B1:=W3*R[1]-W7*R[3]; B2:=W5*R[1]-W1*R[3]; B3:=W7*R[1]-W5*R[3];
   If (R[4] Or R[5] Or R[6] Or R[7])<>0 Then Begin
    Inc(A0,W4*R[4]+W6*R[6]); Inc(A1,-W4*R[4]-W2*R[6]); Inc(A2,-W4*R[4]+W2*R[6]); Inc(A3,W4*R[4]-W6*R[6]);
    Inc(B0,W5*R[5]+W7*R[7]); Inc(B1,-W1*R[5]-W5*R[7]); Inc(B2,W7*R[5]+W3*R[7]); Inc(B3,W3*R[5]-W1*R[7]);
   End;
   Blk[I*8+0]:=AVSar(A0+B0,RS); Blk[I*8+7]:=AVSar(A0-B0,RS);
   Blk[I*8+1]:=AVSar(A1+B1,RS); Blk[I*8+6]:=AVSar(A1-B1,RS);
   Blk[I*8+2]:=AVSar(A2+B2,RS); Blk[I*8+5]:=AVSar(A2-B2,RS);
   Blk[I*8+3]:=AVSar(A3+B3,RS); Blk[I*8+4]:=AVSar(A3-B3,RS);
  End;
 End;
 For I:=0 To 7 Do Begin
  For K:=0 To 7 Do R[K]:=Blk[K*8+I];
  A0:=W4*(R[0]+CR); A1:=A0; A2:=A0; A3:=A0;
  Inc(A0,W2*R[2]); Inc(A1,W6*R[2]); Dec(A2,W6*R[2]); Dec(A3,W2*R[2]);
  B0:=W1*R[1]+W3*R[3]; B1:=W3*R[1]-W7*R[3]; B2:=W5*R[1]-W1*R[3]; B3:=W7*R[1]-W5*R[3];
  If R[4]<>0 Then Begin Inc(A0,W4*R[4]); Dec(A1,W4*R[4]); Dec(A2,W4*R[4]); Inc(A3,W4*R[4]); End;
  If R[5]<>0 Then Begin Inc(B0,W5*R[5]); Dec(B1,W1*R[5]); Inc(B2,W7*R[5]); Inc(B3,W3*R[5]); End;
  If R[6]<>0 Then Begin Inc(A0,W6*R[6]); Dec(A1,W2*R[6]); Inc(A2,W2*R[6]); Dec(A3,W6*R[6]); End;
  If R[7]<>0 Then Begin Inc(B0,W7*R[7]); Dec(B1,W5*R[7]); Inc(B2,W3*R[7]); Dec(B3,W1*R[7]); End;
  Put(I,0,A0+B0); Put(I,1,A1+B1); Put(I,2,A2+B2); Put(I,3,A3+B3);
  Put(I,4,A3-B3); Put(I,5,A2-B2); Put(I,6,A1-B1); Put(I,7,A0-B0);
 End;
End;

{ Decode un bloc DCT; retourne False en cas d'erreur. Mode: 0 = 8 bits, 1 = 10 bits 4:2:2, 2 = 10 bits 4:4:4/HQX, 3 = 12 bits 4:2:2, 4 = 12 bits 4:4:4 }
Function DXDecodeBlock(N,Mode: LongInt): Boolean;
Var
 IndexBits,LevelBias,LevelShift,DcShift,Comp,I,J,Len,Level,Index1,Flags,Run,Sg,PK: LongInt; Scale: ^LongInt; Weight: PEABuffer; Sc: Array[0..63] Of LongInt;
 UseChroma: Boolean; Blk: ^TAMVBlock;
Begin
 DXDecodeBlock:=False;
 Case Mode Of
  0: Begin IndexBits:=4; LevelBias:=32; LevelShift:=6; DcShift:=0; End;
  1: Begin IndexBits:=6; LevelBias:=8; LevelShift:=4; DcShift:=0; End;
  2: Begin IndexBits:=6; LevelBias:=32; LevelShift:=6; DcShift:=0; End;
  3: Begin IndexBits:=6; LevelBias:=8; LevelShift:=4; DcShift:=2; End;
  Else Begin IndexBits:=6; LevelBias:=32; LevelShift:=4; DcShift:=2; End;
 End;
 Blk:=@DXRow.Blocks[N];
 FillChar(Blk^,SizeOf(TAMVBlock),0);
 If DXIs444=0 Then Begin
  If (N And 2)<>0 Then Begin Comp:=1+(N And 1); UseChroma:=True; End Else Begin Comp:=0; UseChroma:=False; End;
 End Else Begin
  Comp:=(N Shr 1) Mod 3; UseChroma:=Comp<>0;
 End;
 { DC }
 PK:=DXPeek(DXDcMax); Len:=DXDcLut[PK];
 If Len<0 Then Exit;
 Inc(DXBitPos,DXDcLen[PK]);
 If Len<>0 Then Begin
  Level:=DXGet(Len);
  If Level<(1 Shl (Len-1)) Then Level:=Level-((1 Shl Len)-1);
  Inc(DXRow.LastDC[Comp],Level*(1 Shl DcShift));
 End;
 Blk^[0]:=DXRow.LastDC[Comp];
 I:=0;
 PK:=DXPeek(DXAcMax); Index1:=DXAcLut[PK]; If Index1<0 Then Exit; Inc(DXBitPos,DXAcLen[PK]);
 While Index1<>DXEob Do Begin
  Level:=DXAcInfo[2*Index1]; Flags:=DXAcInfo[2*Index1+1];
  Sg:=DXGet(1);
  If (Flags And 1)<>0 Then Level:=Level+(DXGet(IndexBits) Shl 7);
  If (Flags And 2)<>0 Then Begin
   PK:=DXPeek(DXRunMax); Run:=DXRunLut[PK]; If Run<0 Then Exit; Inc(DXBitPos,DXRunLen[PK]);
   Inc(I,Run);
  End;
  Inc(I); If I>63 Then Exit;
  J:=DXZig[I];
  If UseChroma Then Begin Level:=Level*DXRow.ChromaScale[I]; Level:=Level+(DXRow.ChromaScale[I] Shr 1); If (LevelBias<32) Or (DXChroma[I]<>LevelBias) Then Inc(Level,LevelBias); End
  Else Begin Level:=Level*DXRow.LumaScale[I]; Level:=Level+(DXRow.LumaScale[I] Shr 1); If (LevelBias<32) Or (DXLuma[I]<>LevelBias) Then Inc(Level,LevelBias); End;
  Level:=Level Shr LevelShift;
  If Sg<>0 Then Blk^[J]:=-Level Else Blk^[J]:=Level;
  PK:=DXPeek(DXAcMax); Index1:=DXAcLut[PK]; If Index1<0 Then Exit; Inc(DXBitPos,DXAcLen[PK]);
 End;
 DXDecodeBlock:=True;
End;

{ En-tete de trame; retourne 0 si OK }
Function DXHeader(Buf: PEABuffer; Size: LongInt; FirstField: Boolean; Var Il,Tff: Boolean): LongInt;
Var
 Prefix: Int64; Cid,BitDepth,R,I: LongInt;
Function RB16(At: LongInt): LongInt;Begin RB16:=Buf^[At]*256+Buf^[At+1]; End;
Function RB32(At: LongInt): Int64;Begin RB32:=Int64(Buf^[At])*16777216+Buf^[At+1]*65536+Buf^[At+2]*256+Buf^[At+3]; End;
Begin
 DXHeader:=-1;
 If Size<$280 Then Exit;
 Prefix:=(RB32(0) Shl 16) Or (Int64(Buf^[4]) Shl 8);
 If Not ((Prefix=$000002800100) Or (Prefix=$000002800200) Or
  (((Prefix And $FFFF0000FFFF)=$0300) And ((Prefix Shr 16)>=$0280) And ((Prefix Shr 16)<=$2170) And (((Prefix Shr 16) And 3)=0))) Then Exit;
 Il:=(Buf^[5] And 2)<>0; Tff:=False;
 If Il Then Begin
  If FirstField Then DXCurField:=Buf^[5] And 1 Else DXCurField:=1-DXCurField;
  If ((Ord(FirstField) Xor DXCurField) And 1)<>0 Then Tff:=True;
 End Else DXCurField:=0;
 DXMbaff:=(Buf^[6] Shr 5) And 1; DXAlpha:=Buf^[7] And 1;
 DXHeight:=RB16($18); DXWidth:=RB16($1A);
 Case Buf^[$21] Shr 5 Of 1: BitDepth:=8; 2: BitDepth:=10; 3: BitDepth:=12; Else Exit; End;
 Cid:=RB32($28);
 R:=DXSelect(Cid,BitDepth);
 If R<0 Then Exit;
 DXAct:=Buf^[$2C] And 1;
 DXIs444:=(Buf^[$2C] Shr 6) And 1;
 DXProfileHQX:=(Cid=1271);
 If DXIs444<>0 Then Begin If BitDepth=8 Then Exit; End;
 If (DXWidth<>DXW) And (DXW<>0) Then DXWidth:=DXW;
 If Size<DXCUSize Then Exit;
 DXMbW:=(DXWidth+15) Shr 4; DXMbH:=RB16($16C);
 If (((DXHeight+15) Shr 4)=DXMbH) And Il Then DXHeight:=DXHeight Shl 1;
 If (DXMbH>68) And (((Prefix And $FFFF0000FFFF)=$0300) And ((Prefix Shr 16)>=$0280) And ((Prefix Shr 16)<=$2170) And (((Prefix Shr 16) And 3)=0)) Then DXDataOffset:=$170+(DXMbH Shl 2)
 Else Begin If DXMbH>68 Then Exit; DXDataOffset:=$280; End;
 If (DXMbH Shl Ord(Il))>((DXHeight+15) Shr 4) Then Exit;
 If Size<DXDataOffset Then Exit;
 If DXMbH>512 Then Exit;
 For I:=0 To DXMbH-1 Do Begin
  DXScan[I]:=RB32($170+(I Shl 2));
  If Size-DXDataOffset<DXScan[I] Then Exit;
 End;
 DXHeader:=0;
End;

Function DXMbMode: LongInt;
Begin
 If DXIs444<>0 Then Begin If DXBitDepth=10 Then DXMbMode:=2 Else DXMbMode:=4; End
 Else If DXBitDepth=12 Then DXMbMode:=3
 Else If DXBitDepth=10 Then Begin If DXProfileHQX Then DXMbMode:=2 Else DXMbMode:=1; End
 Else DXMbMode:=0;
End;

Function DXDecodeRow(Buf: PEABuffer; BufSize,RowNb: LongInt; Il: Boolean): Boolean;
Var
 Off,X,I,Qscale,Act,InterlacedMb,Shift1,Mode,Lsz,Csz,Ly,DctY,DctX,Q,Fh: LongInt;
 DestY,DestU,DestV: LongInt; LsL,LsC: LongInt;
Begin
 DXDecodeRow:=False;
 Off:=DXScan[RowNb];
 DXBuf:=PEABuffer(@Buf^[Off]); DXBufLen:=BufSize-Off; DXBitPos:=0;
 For I:=0 To 2 Do DXRow.LastDC[I]:=1 Shl (DXBitDepth+2);
 DXRow.LastQ:=-1;
 Mode:=DXMbMode; Shift1:=Ord(DXBitDepth>=10);
 For X:=0 To DXMbW-1 Do Begin
  InterlacedMb:=0;
  If DXMbaff<>0 Then Begin InterlacedMb:=DXGet(1); Qscale:=DXGet(10); End Else Qscale:=DXGet(11);
  Act:=DXGet(1);
  If Qscale<>DXRow.LastQ Then Begin
   For I:=0 To 63 Do Begin DXRow.LumaScale[I]:=Qscale*DXLuma[I]; DXRow.ChromaScale[I]:=Qscale*DXChroma[I]; End;
   DXRow.LastQ:=Qscale;
  End;
  For I:=0 To 7+4*DXIs444 Do If Not DXDecodeBlock(I,Mode) Then Exit;
  { positions (en echantillons) }
  LsL:=DXStrideY; LsC:=DXStrideC;
  If Il Then Begin LsL:=LsL*2; LsC:=LsC*2; End;
  DestY:=(RowNb*LsL)*16+X*16;
  DestU:=(RowNb*LsC)*16+X*(8 Shl DXIs444);
  If Il And (DXCurField<>0) Then Begin Fh:=1; Inc(DestY,DXStrideY); End Else Fh:=0;
  Lsz:=LsL; Csz:=LsC;
  If InterlacedMb<>0 Then Begin Lsz:=Lsz*2; Csz:=Csz*2; End;
  If InterlacedMb<>0 Then DctY:=DXStrideY Else DctY:=Lsz*8;
  DctX:=8;
  If DXIs444=0 Then Begin
   DXIdctPut(DXRow.Blocks[0],@DXPicY^[DestY*DXBpe],Lsz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[1],@DXPicY^[(DestY+DctX)*DXBpe],Lsz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[4],@DXPicY^[(DestY+DctY)*DXBpe],Lsz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[5],@DXPicY^[(DestY+DctY+DctX)*DXBpe],Lsz,DXBitDepth);
   If InterlacedMb<>0 Then DctY:=DXStrideC Else DctY:=Csz*8;
   If Il And (DXCurField<>0) Then Inc(DestU,DXStrideC);
   DXIdctPut(DXRow.Blocks[2],@DXPicU^[DestU*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[3],@DXPicV^[DestU*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[6],@DXPicU^[(DestU+DctY)*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[7],@DXPicV^[(DestU+DctY)*DXBpe],Csz,DXBitDepth);
  End Else Begin
   DXIdctPut(DXRow.Blocks[0],@DXPicY^[DestY*DXBpe],Lsz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[1],@DXPicY^[(DestY+DctX)*DXBpe],Lsz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[6],@DXPicY^[(DestY+DctY)*DXBpe],Lsz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[7],@DXPicY^[(DestY+DctY+DctX)*DXBpe],Lsz,DXBitDepth);
   If InterlacedMb<>0 Then DctY:=DXStrideC Else DctY:=Csz*8;
   If Il And (DXCurField<>0) Then Inc(DestU,DXStrideC);
   DXIdctPut(DXRow.Blocks[2],@DXPicU^[DestU*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[3],@DXPicU^[(DestU+DctX)*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[8],@DXPicU^[(DestU+DctY)*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[9],@DXPicU^[(DestU+DctY+DctX)*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[4],@DXPicV^[DestU*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[5],@DXPicV^[(DestU+DctX)*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[10],@DXPicV^[(DestU+DctY)*DXBpe],Csz,DXBitDepth);
   DXIdctPut(DXRow.Blocks[11],@DXPicV^[(DestU+DctY+DctX)*DXBpe],Csz,DXBitDepth);
  End;
 End;
 DXDecodeRow:=True;
End;

Var DXOut: PEABuffer; DXOutSize: LongInt; DXPicSize: LongInt; DXIlFrame,DXTffFrame: Boolean; DXPicBits: LongInt;

{ Decode une trame (une ou deux unites de codage); retourne False si rejet. L'image est dans DXPicY/U/V. }
Function DXDecodeFrame(Buf: PEABuffer; Size: LongInt): Boolean;
Var
 Il,Tff,First: Boolean; Cu: PEABuffer; CuSize,Y,Rowsn,ErrRows,Hh,Ww,CHn,CWn,NeedY,NeedC: LongInt; Ok: Boolean; Pos: LongInt;
Begin
 DXDecodeFrame:=False;
 First:=True; Pos:=0; ErrRows:=0;
 Repeat
  Cu:=PEABuffer(@Buf^[Pos]); CuSize:=Size-Pos;
  If DXHeader(Cu,CuSize,First,Il,Tff)<>0 Then Exit;
  If First Then Begin
   DXIlFrame:=Il; DXTffFrame:=Tff;
   Hh:=DXHeight; Ww:=DXWidth;
   If DXBitDepth>8 Then DXBpe:=2 Else DXBpe:=1;
   DXStrideY:=DXMbW*16;
   If DXIs444<>0 Then DXStrideC:=DXMbW*16 Else DXStrideC:=DXMbW*8;
   Rowsn:=((Hh+15) Shr 4)*16;
   NeedY:=DXStrideY*Rowsn*DXBpe; NeedC:=DXStrideC*Rowsn*DXBpe;
   If (DXPicY=Nil) Or (DXPicSize<>NeedY+2*NeedC) Then Begin
    If DXPicY<>Nil Then FreeMem(DXPicY,DXPicSize);
    DXPicSize:=NeedY+2*NeedC; GetMem(DXPicY,DXPicSize+64);
   End;
   FillChar(DXPicY^,DXPicSize,0);
   DXPicU:=PEABuffer(@DXPicY^[NeedY]); DXPicV:=PEABuffer(@DXPicY^[NeedY+NeedC]);
  End;
  For Y:=0 To DXMbH-1 Do
   If Not DXDecodeRow(PEABuffer(@Cu^[DXDataOffset]),CuSize-DXDataOffset,Y,Il) Then Inc(ErrRows);
  If First And Il Then Begin Inc(Pos,DXCUSize); First:=False; End
  Else Break;
 Until False;
 DXDecodeFrame:=ErrRows=0;
End;

Procedure DXSetupSink(Mode: LongInt; Const Target: String; FpsN,FpsD: LongInt);
Var Tag: String;
Begin
 If DXBitDepth>8 Then Tag:='p'+Chr(48+DXBitDepth Div 10)+Chr(48+DXBitDepth Mod 10) Else Tag:='';
 If DXIs444<>0 Then Begin NVYTag:='C444'+Tag; NVSubX:=0; NVCW:=DXWidth; End
 Else Begin NVYTag:='C422'+Tag; NVSubX:=1; NVCW:=(DXWidth+1) Div 2; End;
 NVSubY:=0; NVCH:=DXHeight;
End;

{ Copie l'image decodee rognee en plans compacts dans DXOut }
Procedure DXPack;
Var Y,Bp,P0,PC: LongInt;
Begin
 Bp:=DXBpe; P0:=0;
 For Y:=0 To DXHeight-1 Do Begin Move(DXPicY^[Y*DXStrideY*Bp],DXOut^[P0],DXWidth*Bp); Inc(P0,DXWidth*Bp); End;
 For Y:=0 To DXHeight-1 Do Begin Move(DXPicU^[Y*DXStrideC*Bp],DXOut^[P0],NVCW*Bp); Inc(P0,NVCW*Bp); End;
 For Y:=0 To DXHeight-1 Do Begin Move(DXPicV^[Y*DXStrideC*Bp],DXOut^[P0],NVCW*Bp); Inc(P0,NVCW*Bp); End;
End;

{ Taille d'une trame brute d'apres l'en-tete (parseur dnxhd) ou -1 }
Function DXFrameLen(Buf: PEABuffer; Avail: LongInt): LongInt;
Var Cid,Idx,W,H: LongInt; R: Int64;
Begin
 DXFrameLen:=-1;
 If Avail<$2C Then Exit;
 Cid:=Buf^[$28]*16777216+Buf^[$29]*65536+Buf^[$2A]*256+Buf^[$2B];
 If Cid<=0 Then Exit;
 Idx:=DXFindCid(Cid);
 If Idx<0 Then Exit;
 DXSelectCid(Idx); DXCurIdx:=-1;
 If DXFrameSize>0 Then Begin DXFrameLen:=DXFrameSize; Exit; End;
 W:=Buf^[$1A]*256+Buf^[$1B]; H:=Buf^[$18]*256+Buf^[$19];
 R:=Int64((H+15) Div 16)*((W+15) Div 16)*DXPSN Div DXPSD;
 R:=(R+2048) Div 4096*4096;
 If R<8192 Then R:=8192;
 DXFrameLen:=R;
End;

Function DXHeaderPrefixOk(Buf: PEABuffer; Avail: LongInt): Boolean;
Var Pf: Int64;
Begin
 DXHeaderPrefixOk:=False;
 If Avail<6 Then Exit;
 Pf:=((Int64(Buf^[0])*16777216+Buf^[1]*65536+Buf^[2]*256+Buf^[3]) Shl 16) Or (Int64(Buf^[4]) Shl 8);
 If (Pf=$000002800100) Or (Pf=$000002800200) Or (((Pf And $FFFF0000FFFF)=$0300) And ((Pf Shr 16)>=$0280) And ((Pf Shr 16)<=$2170) And (((Pf Shr 16) And 3)=0)) Then DXHeaderPrefixOk:=True;
End;

{ Mode: 0 Y4M, 1 PNG, 2 BMP. Source: flux brut dnxhd, ou AVI (fourcc AVdn). }
Procedure DecodeDNxHD(Const Source,Target: String; Mode: LongInt; IsAvi: Boolean);
Var
 F: PEABuffer; Size,Pos,Len,Avail,Frames,Cnt,MoviePos,Sz,RN,RD,Rate,Scale,I,N: LongInt; Started,Ok: Boolean; Tag: String[4]; Pk: PEABuffer;
 Fcc: String[4]; Vids,HaveFmt,InMovie: Boolean;
Function T4(At: LongInt): String;
Var S4: String[4]; Z: Integer;
Begin S4:=''; For Z:=0 To 3 Do S4:=S4+Chr(EAByte(F,Size,At+Z)); T4:=S4; End;
Procedure Frame(P: PEABuffer; L: LongInt);
Var NeedFmt: LongInt;
Begin
 Ok:=DXDecodeFrame(P,L);
 If Ok Then Begin
  If Not Started Then Begin
   If DXBitDepth>8 Then NeedFmt:=8 Else NeedFmt:=7;
   If (Mode<>0) And (DXBitDepth>8) Then NeedFmt:=8;
   NVBegin(Mode,Target,DXWidth,DXHeight,NeedFmt,RN,RD);
   DXSetupSink(Mode,Target,RN,RD);
   If DXIlFrame Then Begin If DXTffFrame Then NVIl:='t' Else NVIl:='b'; End Else NVIl:='p';
   NVAviSar(DXWidth,DXHeight); NVBT709:=True;
   GetMem(DXOut,DXWidth*DXHeight*3*2+64); DXOutSize:=DXWidth*DXHeight*3*2+64;
   Started:=True;
  End;
  DXPack; NVEmit(DXOut);
 End Else If Started Then NVRepeat;
End;
Begin
 NVLoad(Source,F,Size);
 DXCurIdx:=-1; DXBitDepth:=0; DXPicY:=Nil; DXOut:=Nil; Started:=False; RN:=25; RD:=1; NVNVid:=0; NVVN:=0; NVVD:=0;
 If IsAvi Then Begin
  If (T4(0)<>'RIFF') Or (T4(8)<>'AVI ') Then Fail('dnxhd: signature RIFF/AVI requise.');
  Pos:=12; Vids:=False; HaveFmt:=False; InMovie:=False; Cnt:=0; Rate:=25; Scale:=1; MoviePos:=0;
  While (Pos+8<=Size) And Not InMovie And (Cnt<500) Do Begin
   Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4); Inc(Cnt);
   If Sz<0 Then Break;
   If Tag='LIST' Then Begin
    If T4(Pos+8)='movi' Then Begin InMovie:=True; MoviePos:=Pos+12; End;
    Inc(Pos,12);
   End Else Begin
    If (Tag='strh') And Not HaveFmt Then Begin
     Vids:=T4(Pos+8)='vids';
     If Vids Then Begin Scale:=NVRL32(F,Size,Pos+8+20); Rate:=NVRL32(F,Size,Pos+8+24); End;
    End Else If (Tag='strf') And Vids And Not HaveFmt Then Begin
     Fcc:=T4(Pos+8+16); HaveFmt:=True;
    End;
    If Tag='vprp' Then Begin NVVD:=NVRL16(F,Size,Pos+8+20); NVVN:=NVRL16(F,Size,Pos+8+22); End;
    Inc(Pos,8+Sz+(Sz And 1));
   End;
  End;
  If Not InMovie Or Not HaveFmt Then Fail('dnxhd: flux video AVI introuvable.');
  If (Fcc<>'AVdn') And (Fcc<>'AVDN') And (Fcc<>'AVdh') Then Fail('dnxhd: flux AVI AVdn/AVdh requis.');
  If (Rate<=0) Or (Scale<=0) Then Begin Rate:=25; Scale:=1; End;
  RN:=Rate; RD:=Scale; NVGcd(RN,RD);
  Pos:=MoviePos;
  While Pos+8<=Size Do Begin
   Tag:=T4(Pos); Sz:=NVRL32(F,Size,Pos+4);
   If Sz<0 Then Break;
   If Tag='LIST' Then Begin Inc(Pos,12); Continue; End;
   If Pos+8+Sz>Size Then Sz:=Size-Pos-8;
   If (Tag[1]='0') And (Tag[2]='0') And ((Tag[3]='d') Or (Tag[3]='w')) And ((Tag[4]='c') Or (Tag[4]='b')) Then Begin
    Frame(PEABuffer(@F^[Pos+8]),Sz);
    If NVDone Then Break;
   End;
   Inc(Pos,8+Sz+(Sz And 1));
  End;
 End Else Begin
  Pos:=0;
  While Pos+$2C<=Size Do Begin
   If Not DXHeaderPrefixOk(PEABuffer(@F^[Pos]),Size-Pos) Then Begin Inc(Pos); Continue; End;
   Len:=DXFrameLen(PEABuffer(@F^[Pos]),Size-Pos);
   If Len<=0 Then Begin Inc(Pos); Continue; End;
   Avail:=Size-Pos; If Len>Avail Then Len:=Avail;
   Frame(PEABuffer(@F^[Pos]),Len);
   If NVDone Then Break;
   Inc(Pos,Len);
  End;
 End;
 If DXOut<>Nil Then FreeMem(DXOut,DXOutSize);
 FreeMem(F,Size+64);
 NVFinish('dnxhd');
End;

