 If Not (Double(Sum)>Sd) Then Sum:=Single(Sd);
 For I:=0 To 8 Do R2.GainHist[28+I]:=R2.GainHist[28+I+1];
 A5:=5.0; Kc:=10*(Ln(16777216.0/A5)/Ln(10.0))-32;
 R2.GainHist[37]:=Single(10*(Ln(Double(Sum))/Ln(10.0))+Kc);
 R2LpSynth(R2.SpHist,106,R2.SpLpc,Buf,5,36);
End;
Procedure R2Block(Buf: PEABuffer; Var Pcm: Array Of Single);
Var Bp,I,J,Gi,Cb: LongInt; Gn: Single;
Function GetBitsLE(N: LongInt): LongInt;
Var Z,Rr: LongInt;
Begin Rr:=0; For Z:=0 To N-1 Do Begin Rr:=Rr Or (((Buf^[Bp Shr 3] Shr (Bp And 7)) And 1) Shl Z); Inc(Bp); End; GetBitsLE:=Rr; End;
Begin
 Bp:=0;
 For I:=0 To 31 Do Begin
  Gi:=GetBitsLE(3); Gn:=RA2Amp[Gi];
  Cb:=GetBitsLE(6+(I And 1));
  R2Decode(Gn,Cb);
  For J:=0 To 4 Do Pcm[I*5+J]:=R2.SpHist[106+J];
  If (I And 7)=3 Then Begin
   R2Backward(R2.SpHist,R2.SpRec,RA2SynWin,R2.SpLpc,RA2SynBw,36,40,35,70);
   R2Backward(R2.GainHist,R2.GainRec,RA2GainWin,R2.GainLpc,RA2GainBw,10,8,20,28);
  End;
 End;
End;

Procedure DecodeRA288(Const Source,Target: String);
Var I,P,J,Found,V: LongInt; Pcm: Array[0..159] Of Single; Tg: LongInt;
Begin
 RMParse(Source);
 Found:=-1; Tg:=Ord('2')+Ord('8')*256+Ord('_')*65536+Ord('8')*16777216;
 For I:=0 To RMNS-1 Do If (RMSt[I].Kind=1) And (RMSt[I].Tag=Tg) Then Begin Found:=I; Break; End;
 If Found<0 Then Fail('real_288: aucun flux RealAudio 2.0 (28_8).');
 If RMSt[Found].BlockAlign<>38 Then Fail('real_288: block_align de 38 octets requis.');
 FillChar(R2,SizeOf(R2),0);
 EAReset; OpenWrite(Target); ADPCMWaveHeader(RMSt[Found].Rate,1,0);
 For P:=0 To RMNPk-1 Do If RMPkS^[P]=Found Then Begin
  If RMPkLen^[P]<38 Then Continue;
  R2Block(PEABuffer(@RMArena^[RMPkOff^[P]]),Pcm);
  For J:=0 To 159 Do Begin
   V:=Round(Single(Pcm[J]*32768.0));
   If V>32767 Then V:=32767 Else If V<-32768 Then V:=-32768;
   EAPut(V);
  End;
 End;
 EAFlush;
 If EAWritten=0 Then Fail('real_288: aucune trame decodee.');
 ADPCMPatchHeader(RMSt[Found].Rate,1,EAWritten); CloseWrite;
 RMFree;
End;


Function RMAudioKind(Const Name: String): LongInt;
Var I: LongInt;
Begin
 RMAudioKind:=0;
 RMParse(Name);
 For I:=0 To RMNS-1 Do If RMSt[I].Kind=1 Then Begin
  If RMSt[I].Tag=Ord('l')+Ord('p')*256+Ord('c')*65536+Ord('J')*16777216 Then Begin RMAudioKind:=1; Break; End;
  If RMSt[I].Tag=Ord('2')+Ord('8')*256+Ord('_')*65536+Ord('8')*16777216 Then Begin RMAudioKind:=2; Break; End;
 End;
 RMFree;
End;

{ ---- RealVideo 1.0 / 2.0 (libavcodec/rv10.c) : decodeur sur le moteur H.263 (H3) ---- }
Var
 RVSub,RVMajor,RVMinor,RVMicro,RVOrigW,RVOrigH,RVRprMax,RVCurType,RVLastI: LongInt;
 RVLow,RVPend: Boolean; RVExt: Array[0..255] Of Byte; RVExtLen: LongInt;
 RVFrameBuf: PEABuffer; RVFrameCap: LongInt;

Function RVLog2(V: LongInt): LongInt;
Var R: LongInt;
Begin R:=0; While V>1 Do Begin V:=V Shr 1; Inc(R); End; RVLog2:=R; End;

{ rv10_decode_picture_header : retourne le nombre de macroblocs ou < 0 }
Function RVHeader10: LongInt;
Var PbFrame,MbXy,MbCount,I: LongInt;
Begin
 RVHeader10:=-1;
 H3Bit;
 If H3Bit<>0 Then H3PictType:=1 Else H3PictType:=0;
 PbFrame:=H3Bit;
 If PbFrame<>0 Then Exit;
 H3Qscale:=H3Bits(5);
 If H3Qscale=0 Then Exit;
 If (H3PictType=0) And (H3Rv10Ver=3) Then For I:=0 To 2 Do H3RvLastDc[I]:=H3Bits(8);
 MbXy:=H3MbX+H3MbY*H3MbW;
 If (H3Show(12)=0) Or ((MbXy<>0) And (MbXy<H3MbNum)) Then Begin
  H3MbX:=H3Bits(6); H3MbY:=H3Bits(6); MbCount:=H3Bits(12);
 End Else Begin
  H3MbX:=0; H3MbY:=0; MbCount:=H3MbW*H3MbH;
 End;
 H3Skip(3);
 RVHeader10:=MbCount;
End;

{ rv20_decode_picture_header ; -2 = image B (non prise en charge), -3 = changement de resolution }
Function RVHeader20(Whole: LongInt): LongInt;
Var Typ,F,Seq,MbPos: LongInt;
Begin
 RVHeader20:=-1;
 Typ:=H3Bits(2);
 Case Typ Of 0,1: H3PictType:=0; 2: H3PictType:=1; Else H3PictType:=2; End;
 If H3PictType=2 Then Begin RVHeader20:=-2; Exit; End;
 If H3Bit<>0 Then Exit;
 H3Qscale:=H3Bits(5);
 If H3Qscale=0 Then Exit;
 If RVMinor>=2 Then H3Loop:=H3Bit;
 If RVMinor<=1 Then Seq:=H3Bits(8) Else Seq:=H3Bits(13);
 If RVRprMax<>0 Then Begin
  F:=H3Bits(RVLog2(RVRprMax)+1);
  If F<>0 Then Begin RVHeader20:=-3; Exit; End;
 End;
 MbPos:=H3DecodeMba;
 H3NoRounding:=H3Bit;
 H3Aic:=Ord(H3PictType=0);
 H3ModQ:=1; H3Loop:=1; H3ChromaTab:=True;
 RVHeader20:=H3MbW*H3MbH-MbPos;
End;

Procedure RVStartFrame;
Var Slot: LongInt;
Begin
 If H3PictType<>2 Then Begin RVLastI:=H3CurI; H3RefI:=RVLastI; End;
 Slot:=0;
 While (Slot=H3RefI) Or (Slot=RVLastI) Do Inc(Slot);
 H3CurI:=Slot;
 H3ClearPic(H3CurI);
 If (H3PictType<>0) And (H3RefI<0) Then Begin
  Slot:=0; While Slot=H3CurI Do Inc(Slot);
  H3RefI:=Slot; RVLastI:=Slot;
  FillChar(H3P[H3RefI].Y^,H3LY*H3MbH*16,16);
  FillChar(H3P[H3RefI].U^,H3LC*H3MbH*8,128); FillChar(H3P[H3RefI].V^,H3LC*H3MbH*8,128);
 End;
 RVCurType:=H3PictType; RVPend:=True;
End;

{ rv10_decode_packet : retourne la taille active en bits, ou < 0 }
Function RVPacket(Buf: PEABuffer; BufSize,BufSize2,Whole: LongInt): LongInt;
Var MbCount,MbPos,Left,Active,StartX,Ret,V,I: LongInt;
Begin
 RVPacket:=-1;
 Active:=BufSize*8;
 H3Buf:=Buf; If BufSize>BufSize2 Then H3Size:=BufSize Else H3Size:=BufSize2; H3Pos:=0;
 If H3RvMode=1 Then MbCount:=RVHeader10 Else MbCount:=RVHeader20(Whole);
 If MbCount<0 Then Exit;
 If (H3MbX>=H3MbW) Or (H3MbY>=H3MbH) Then Exit;
 MbPos:=H3MbY*H3MbW+H3MbX; Left:=H3MbW*H3MbH-MbPos;
 If MbCount>Left Then Exit;
 If Whole<H3MbW*H3MbH Div 8 Then Exit;
 If ((H3MbX=0) And (H3MbY=0)) Or Not RVPend Then Begin
  If RVPend Then Begin H3MbX:=0; H3MbY:=0; H3ResyncX:=0; H3ResyncY:=0; End;
  RVStartFrame;
 End Else If RVCurType<>H3PictType Then Exit;
 If H3RvMode=1 Then Begin
  If H3MbY=0 Then H3FirstLine:=1;
 End Else Begin
  H3FirstLine:=1; H3ResyncX:=H3MbX;
 End;
 StartX:=H3MbX; H3ResyncY:=H3MbY;
 H3SetQscale(H3Qscale);
 For I:=0 To 2 Do H3RvFirst[I]:=0;
 H3MbNumLeft:=MbCount;
 While H3MbNumLeft>0 Do Begin
  H3MvType:=0;
  Ret:=H3DecodeMb;
  If Ret<>H3SliceErr Then
   If Active>=H3Pos Then Begin
    V:=H3Show(16);
    If H3Pos+16>Active Then V:=V Shr (H3Pos+16-Active);
    If V=0 Then Ret:=H3SliceEnd;
   End;
  If (Ret<>H3SliceErr) And (Active<H3Pos) And (8*BufSize2>=H3Pos) Then Begin
   Active:=BufSize2*8; Ret:=H3SliceOk;
  End;
  If (Ret=H3SliceErr) Or (Active<H3Pos) Then Exit;
  H3UpdateMotion;
  H3Recon;
  If H3Loop<>0 Then H3LoopFilter;
  Inc(H3MbX);
  If H3MbX=H3MbW Then Begin H3MbX:=0; Inc(H3MbY); End;
  If H3MbX=H3ResyncX Then H3FirstLine:=0;
  If Ret=H3SliceEnd Then Break;
  Dec(H3MbNumLeft);
 End;
 RVPacket:=Active;
End;

{ rv10_decode_frame ; 1 = image disponible dans H3P[H3Out], 0 = rien, < 0 = erreur }
Function RVFrame(Pk: PEABuffer; Len: LongInt): LongInt;
Var
 SliceCount,I,Offset,Size,Size2,Ret,DSize,Off1,Off2: LongInt; Data: PEABuffer;
Function SlOff(N: LongInt): Int64;
Begin SlOff:=Int64(RVFrameBuf^[5+N*8])+Int64(RVFrameBuf^[6+N*8])*256+Int64(RVFrameBuf^[7+N*8])*65536+Int64(RVFrameBuf^[8+N*8])*16777216; End;
Begin
 RVFrame:=0;
 If Len=0 Then Exit;
 If RVFrameCap<Len+128 Then Begin
  If RVFrameBuf<>Nil Then FreeMem(RVFrameBuf);
  RVFrameCap:=Len+128; GetMem(RVFrameBuf,RVFrameCap);
 End;
 Move(Pk^,RVFrameBuf^,Len); FillChar(RVFrameBuf^[Len],128,0);
 SliceCount:=RVFrameBuf^[0]+1;
 DSize:=Len-1;
 If DSize<=8*SliceCount Then Begin RVFrame:=-1; Exit; End;
 Data:=PEABuffer(@RVFrameBuf^[1+8*SliceCount]); Dec(DSize,8*SliceCount);
 I:=0;
 While I<SliceCount Do Begin
  If SlOff(I)>=DSize Then Begin RVFrame:=-1; Exit; End;
  Offset:=SlOff(I);
  If I+1=SliceCount Then Size:=DSize-Offset Else Size:=SlOff(I+1)-Offset;
  If I+2>=SliceCount Then Size2:=DSize-Offset Else Size2:=SlOff(I+2)-Offset;
  If (Size<=0) Or (Size2<=0) Then Begin RVFrame:=-1; Exit; End;
  If Size>Size2 Then Off1:=Size Else Off1:=Size2;
  If Offset+Off1>DSize Then Begin RVFrame:=-1; Exit; End;
  Ret:=RVPacket(PEABuffer(@Data^[Offset]),Size,Size2,DSize);
  If Ret<0 Then Begin RVFrame:=-1; Exit; End;
  If Ret>8*Size Then Inc(I);
  Inc(I);
 End;
 If RVPend And (H3MbY>=H3MbH) Then Begin
  If RVLow Or (RVCurType=2) Then Begin H3Out:=H3CurI; RVFrame:=1; End
  Else If RVLastI>=0 Then Begin H3Out:=RVLastI; RVFrame:=1; End;
  RVPend:=False;
 End;
End;

{ 1 rv10, 2 rv20, 0 sinon }
Function RMVideoKind(Const Name: String): LongInt;
Var I: LongInt;
Begin
 RMVideoKind:=0;
 RMParse(Name);
 For I:=0 To RMNS-1 Do If RMSt[I].Kind=2 Then Begin
  If RMSt[I].Tag=$30315652 Then RMVideoKind:=1
  Else If RMSt[I].Tag=$30325652 Then RMVideoKind:=2;
  Break;
 End;
 RMFree;
End;

Procedure RVSetup(Kind,W,H: LongInt);
Begin
 H3Reset;
 H3RvMode:=Kind; H3Codec:=3+Kind;
 RVSub:=RVExt[4]*16777216+RVExt[5]*65536+RVExt[6]*256+RVExt[7];
 RVMajor:=RVSub Shr 28; RVMinor:=(RVSub Shr 20) And $FF; RVMicro:=(RVSub Shr 12) And $FF;
 RVRprMax:=RVExt[1] And 7;
 H3Wd:=W; H3Ht:=H;
 If (H3Wd<=0) Or (H3Ht<=0) Or (H3Wd>16384) Or (H3Ht>16384) Then Fail('realvideo: dimensions invalides.');
 RVOrigW:=H3Wd; RVOrigH:=H3Ht;
 H3MbW:=(H3Wd+15) Div 16; H3MbH:=(H3Ht+15) Div 16; H3MbNum:=H3MbW*H3MbH;
 H3LongVec:=RVExt[3] And 1;
 RVLow:=True; H3Rv10Ver:=0; H3Obmc:=0;
 Case RVMajor Of
  1: Begin
      If RVMicro<>0 Then H3Rv10Ver:=3 Else H3Rv10Ver:=1;
      If RVMicro=2 Then H3Obmc:=1;
     End;
  2: If RVMinor>=2 Then RVLow:=False;
 Else Fail('realvideo: version non prise en charge.');
 End;
 H3AllocCtx;
 H3CurI:=-1; H3RefI:=-1; RVLastI:=-1; RVPend:=False; H3MbX:=0; H3MbY:=0; H3FirstLine:=0; H3ResyncX:=0; H3ResyncY:=0;
 RVFrameBuf:=Nil; RVFrameCap:=0;
End;

Procedure DecodeRV(Const Source,Target: String; Mode: LongInt);
Var
 I,K,Found,N,D,Fps: LongInt; Begun: Boolean; Kind: LongInt; Pk: PEABuffer;
Begin
 RMParse(Source);
 Found:=-1;
 For I:=0 To RMNS-1 Do If RMSt[I].Kind=2 Then Begin Found:=I; Break; End;
 If Found<0 Then Fail('realvideo: aucun flux video.');
 If RMSt[Found].Tag=$30315652 Then Kind:=1 Else If RMSt[Found].Tag=$30325652 Then Kind:=2
 Else Fail('realvideo: seuls rv10 et rv20 sont pris en charge.');
 RVExtLen:=RMSt[Found].ExtLen; If RVExtLen>256 Then RVExtLen:=256;
 If RVExtLen<8 Then Fail('realvideo: extradata trop petit.');
 For I:=0 To RVExtLen-1 Do RVExt[I]:=RMB(RMSt[Found].ExtPos+I);
 RVSetup(Kind,RMSt[Found].W,RMSt[Found].H);
 Fps:=RMSt[Found].Fps;
 N:=Fps; D:=65536; If N<=0 Then Begin N:=25; D:=1; End; NVGcd(N,D);
 Begun:=False; NVVN:=0; NVVD:=0;
 For K:=0 To RMNPk-1 Do If RMPkS^[K]=Found Then Begin
  If RVFrame(PEABuffer(@RMArena^[RMPkOff^[K]]),RMPkLen^[K])=1 Then Begin
   If H3Pack Then Begin
    If Not Begun Then Begin H3BeginNV(Mode,Target,N,D); Begun:=True; End;
    NVEmit(H3OutBuf);
    If NVDone Then Break;
   End;
  End;
 End;
 If NVLast<>Nil Then Begin FreeMem(NVLast,NVLastSize); NVLast:=Nil; End;
 If Not Begun Then Fail('realvideo: aucune image decodee.');
 CloseRead; If NVOpened Then CloseWrite;
 RMFree;
End;

{ ---- Shorten (libavcodec/shorten.c) : fichiers .shn ---- }
Procedure DecodeShorten(Const Source,Target: String);
Const FnDiff0=0; FnDiff1=1; FnDiff2=2; FnDiff3=3; FnQuit=4; FnBlocksize=5; FnBitshift=6; FnQlpc=7; FnZero=8; FnVerbatim=9;
Var
 F: PEABuffer; Size: LongInt; Bp,BitsTot: Int64; Version,IType,Chans,Blocksize,Nmean,Nwrap,LpcqOff,Bitshift,CurChan,Rate,Bps,HeaderSize,I,J,Ch,Cmd,Len,Skip: LongInt;
 Swap,GotQuit: Boolean; Dc: Array[0..7] Of PALLong; Off: Array[0..7] Of PALLong; Coeffs: PALLong; Hdr: PEABuffer;
 ResSize,Coffset,PredOrder,Qshift,InitSum,Z: LongInt; Sum: Int64; Used: Boolean; Fixed: Array[0..3,0..2] Of LongInt;
 Bad: Boolean;
Function W32(X: Int64): LongInt;
Begin X:=X And $FFFFFFFF; If X>=$80000000 Then X:=X-$100000000; W32:=X; End;
Function Sar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then Sar:=V Shr N Else Sar:=-(((-V)+(Int64(1) Shl N)-1) Shr N); End;
Function GBit: LongInt;
Begin
 If Bp>=BitsTot Then Begin GBit:=0; Inc(Bp); Exit; End;
 GBit:=(F^[Bp Shr 3] Shr (7-(Bp And 7))) And 1; Inc(Bp);
End;
Function GBits(N: LongInt): Int64;
Var R: Int64; K: LongInt;
Begin R:=0; For K:=1 To N Do R:=R*2+GBit; GBits:=R; End;
{ get_ur_golomb_jpegls(k, INT_MAX, 0) ; retourne -1 si flux epuise }
Function UrGolomb(K: LongInt): Int64;
Var Cnt: Int64;
Begin
 Cnt:=0;
 While GBit=0 Do Begin
  If Bp>BitsTot Then Begin UrGolomb:=$FFFFFFFF; Exit; End;
  Inc(Cnt);
 End;
 UrGolomb:=(Cnt Shl K)+GBits(K);
End;
Function SrGolomb(K: LongInt): LongInt;
Var U: Int64;
Begin
 U:=UrGolomb(K+1) And $FFFFFFFF;
 If (U And 1)<>0 Then SrGolomb:=W32(Not (U Shr 1)) Else SrGolomb:=W32(U Shr 1);
End;
Function GetUint(K: LongInt): Int64;
Begin
 If Version<>0 Then Begin K:=UrGolomb(2) And $FFFFFFFF; If K>31 Then Begin GetUint:=-1; Exit; End; End;
 GetUint:=UrGolomb(K);
End;
Function Log2I(V: LongInt): LongInt;
Var R: LongInt;
Begin R:=0; While V>1 Do Begin V:=V Shr 1; Inc(R); End; Log2I:=R; End;
Begin
 NVLoad(Source,F,Size); BitsTot:=Size*8; Bp:=0;
 If (F^[0]<>$61) Or (F^[1]<>$6A) Or (F^[2]<>$6B) Or (F^[3]<>$67) Then Fail('shorten: signature ajkg requise.');
 Bp:=32;
 Version:=GBits(8);
 LpcqOff:=0; Blocksize:=256; Nmean:=-1;
 IType:=GetUint(4);
 Chans:=GetUint(0);
 If (Chans<1) Or (Chans>8) Then Fail('shorten: nombre de canaux invalide.');
 I:=0;
 If Version>0 Then Begin
  Blocksize:=GetUint(Log2I(256));
  If (Blocksize<1) Or (Blocksize>65535) Then Fail('shorten: taille de bloc invalide.');
  I:=GetUint(2); If (I<0) Or (I>1024) Then Fail('shorten: maxnlpc invalide.');
  Nmean:=GetUint(0); If (Nmean<0) Or (Nmean>32768) Then Fail('shorten: nmean invalide.');
  Skip:=GetUint(1);
  If (Skip<0) Or (Skip>(BitsTot-Bp) Div 8) Then Fail('shorten: skip_bytes invalide.');
  For J:=1 To Skip Do GBits(8);
 End;
 If I>3 Then Nwrap:=I Else Nwrap:=3;
 If Version>1 Then LpcqOff:=32;
 If UrGolomb(2)<>FnVerbatim Then Fail('shorten: section verbatim initiale absente.');
 HeaderSize:=UrGolomb(5);
 If (HeaderSize>=16384) Or (HeaderSize<44) Then Fail('shorten: taille d''en-tete invalide.');
 GetMem(Hdr,HeaderSize+16);
 For J:=0 To HeaderSize-1 Do Hdr^[J]:=UrGolomb(8) And 255;
 Swap:=False; Rate:=0; Bps:=0;
 If (Hdr^[0]=$52) And (Hdr^[1]=$49) And (Hdr^[2]=$46) And (Hdr^[3]=$46) Then Begin
  { RIFF/WAVE : recherche du bloc fmt }
  J:=12; Rate:=0;
  While J+8<=HeaderSize Do Begin
   Len:=Hdr^[J+4]+Hdr^[J+5]*256+Hdr^[J+6]*65536+Hdr^[J+7]*16777216;
   If (Hdr^[J]=$66) And (Hdr^[J+1]=$6D) And (Hdr^[J+2]=$74) And (Hdr^[J+3]=$20) Then Begin
    If Hdr^[J+8]+Hdr^[J+9]*256<>1 Then Fail('shorten: format WAVE non PCM.');
    Rate:=Hdr^[J+12]+Hdr^[J+13]*256+Hdr^[J+14]*65536+Hdr^[J+15]*16777216;
    Bps:=Hdr^[J+22]+Hdr^[J+23]*256;
    Break;
   End;
   Inc(J,8+Len);
  End;
  If Rate=0 Then Fail('shorten: bloc fmt absent.');
 End Else If (Hdr^[0]=$46) And (Hdr^[1]=$4F) And (Hdr^[2]=$52) And (Hdr^[3]=$4D) Then Begin
  Fail('shorten: en-tete AIFF non pris en charge.');
 End Else Fail('shorten: bit packing non pris en charge.');
 If (Bps<>8) And (Bps<>16) Then Fail('shorten: profondeur non prise en charge.');
 If (IType<>2) And (IType<>3) And (IType<>5) Then Fail('shorten: type audio inconnu.');
 FreeMem(Hdr,1);
 For Ch:=0 To Chans-1 Do Begin
  GetMem(Dc[Ch],(Blocksize+Nwrap+16)*4); FillChar(Dc[Ch]^,(Blocksize+Nwrap+16)*4,0);
  If Nmean>1 Then I:=Nmean Else I:=1;
  GetMem(Off[Ch],I*4);
  For J:=0 To I-1 Do If IType=2 Then Off[Ch]^[J]:=128 Else Off[Ch]^[J]:=0;
 End;
 GetMem(Coeffs,(Nwrap+4)*4);
 Fixed[0,0]:=0; Fixed[0,1]:=0; Fixed[0,2]:=0; Fixed[1,0]:=1; Fixed[1,1]:=0; Fixed[1,2]:=0;
 Fixed[2,0]:=2; Fixed[2,1]:=-1; Fixed[2,2]:=0; Fixed[3,0]:=3; Fixed[3,1]:=-3; Fixed[3,2]:=1;
 Bitshift:=0; CurChan:=0; GotQuit:=False;
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,Chans,0);
 Bad:=False;
 While Not GotQuit And (Not Bad) Do Begin
  If BitsTot-Bp<5 Then Break;
  Cmd:=UrGolomb(2);
  If Cmd>FnVerbatim Then Break;
  If Cmd In [FnQuit,FnBlocksize,FnBitshift,FnVerbatim] Then Begin
   Case Cmd Of
    FnVerbatim: Begin
     Len:=UrGolomb(5);
     If (Len<0) Or (Len>BitsTot-Bp) Then Begin Bad:=True; Break; End;
     For J:=1 To Len Do UrGolomb(8);
    End;
    FnBitshift: Begin
     J:=UrGolomb(2); If J>32 Then Begin Bad:=True; Break; End; Bitshift:=J;
    End;
    FnBlocksize: Begin
     J:=GetUint(Log2I(Blocksize));
     If (J>Blocksize) Or (J<1) Or (J>65535) Then Begin Bad:=True; Break; End;
     Blocksize:=J;
    End;
    FnQuit: GotQuit:=True;
   End;
   Continue;
  End;
  { commande audio }
  ResSize:=0;
  If Cmd<>FnZero Then Begin
   ResSize:=UrGolomb(3);
   If Version=0 Then Dec(ResSize);
   If (ResSize<0) Or (ResSize>30) Then Begin Bad:=True; Break; End;
  End;
  Ch:=CurChan;
  If Nmean=0 Then Coffset:=Off[Ch]^[0]
  Else Begin
   If Version<2 Then Sum:=0 Else Sum:=Nmean Div 2;
   For J:=0 To Nmean-1 Do Sum:=Sum+Off[Ch]^[J];
   Coffset:=W32(Sum);
   Coffset:=Coffset Div Nmean;
   If Version>=2 Then
    If Bitshift<>0 Then Coffset:=Sar(Sar(Coffset,Bitshift-1),1);
  End;
  If Cmd=FnZero Then Begin
   For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=0;
  End Else Begin
   If Cmd=FnQlpc Then Begin
    PredOrder:=UrGolomb(2);
    If (PredOrder<0) Or (PredOrder>Nwrap) Then Begin Bad:=True; Break; End;
    For J:=0 To PredOrder-1 Do Coeffs^[J]:=SrGolomb(5);
    Qshift:=5;
   End Else Begin
    PredOrder:=Cmd; Qshift:=0;
    For J:=0 To 2 Do Coeffs^[J]:=Fixed[PredOrder,J];
   End;
   If (Cmd=FnQlpc) And (Coffset<>0) Then
    For I:=-PredOrder To -1 Do Dc[Ch]^[Nwrap+I]:=W32(Int64(Dc[Ch]^[Nwrap+I])-(Int64(Coffset) And $FFFFFFFF));
   If PredOrder<>0 Then Begin If Cmd=FnQlpc Then InitSum:=LpcqOff Else InitSum:=0; End Else InitSum:=Coffset;
   For I:=0 To Blocksize-1 Do Begin
    Sum:=InitSum;
    For J:=0 To PredOrder-1 Do Sum:=W32(Sum+(Int64(Coeffs^[J])*(Int64(Dc[Ch]^[Nwrap+I-J-1]) And $FFFFFFFF)));
