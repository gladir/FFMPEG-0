 For I:=8 Downto 0 Do Begin
  If Not Sw Then B:=$1000-RASar(Int64(Buf2[I+1])*Buf2[I+1],12) Else B:=$1000-RASar(Int64(Buf1[I+1])*Buf1[I+1],12);
  If B=0 Then B:=-2;
  B:=$1000000 Div B;
  For J:=0 To I Do Begin
