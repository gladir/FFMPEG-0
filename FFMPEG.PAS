Function EC3Sar(V: Int64; N: Integer): Int64;
Begin If V>=0 Then EC3Sar:=V Shr N Else EC3Sar:=-1-((-1-V) Shr N); End;
Function EC3Bit(P: LongInt): LongInt;
Begin If (P Shr 3)>=EC3Lim Then EC3Bit:=0 Else EC3Bit:=(EC3Data^[P Shr 3] Shr (7-(P And 7))) And 1; End;
Function EC3Peek(N: LongInt): LongInt;
Var V,K: LongInt;
Begin V:=0; For K:=0 To N-1 Do V:=V*2+EC3Bit(EC3BP+K); EC3Peek:=V; End;
Procedure EC3Skip(N: LongInt);
Begin Inc(EC3BP,N); If EC3BP>EC3Cap Then EC3BP:=EC3Cap; End;
Function EC3Bits(N: LongInt): LongInt;
Begin EC3Bits:=EC3Peek(N); EC3Skip(N); End;
Function EC3SBits(N: LongInt): LongInt;
Var V: LongInt;
Begin V:=EC3Bits(N); If (N>0) And (V>=(LongInt(1) Shl (N-1))) Then V:=V-(LongInt(1) Shl N); EC3SBits:=V; End;
Function EC3Log2(V: LongInt): LongInt;
Var N: LongInt;
Begin N:=0; While V>1 Do Begin V:=V Shr 1; Inc(N); End; EC3Log2:=N; End;

{ MD5 d'un bloc de 16 octets (libavutil/md5.c), pour av_lfg_init }
Procedure EC3Md5(Var M: Array of Byte);
Const
 S: Array[0..63] Of Byte=(7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,
  4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21);
Var
 K: Array[0..63] Of LongWord; X: Array[0..15] Of LongWord; I,G: Integer; A,B,C,D,F,T: LongWord; Blk: Array[0..63] Of Byte;
 Rot: LongWord;
Begin
 For I:=0 To 63 Do K[I]:=LongWord(Trunc(4294967296.0*Abs(Sin(I+1))));
 FillChar(Blk,64,0); For I:=0 To 15 Do Blk[I]:=M[I]; Blk[16]:=$80; Blk[56]:=128;
 For I:=0 To 15 Do X[I]:=Blk[I*4] Or (LongWord(Blk[I*4+1]) Shl 8) Or (LongWord(Blk[I*4+2]) Shl 16) Or (LongWord(Blk[I*4+3]) Shl 24);
 A:=$67452301; B:=$EFCDAB89; C:=$98BADCFE; D:=$10325476;
 For I:=0 To 63 Do Begin
  If I<16 Then Begin F:=(B And C) Or ((Not B) And D); G:=I; End
  Else If I<32 Then Begin F:=(D And B) Or ((Not D) And C); G:=(5*I+1) And 15; End
  Else If I<48 Then Begin F:=B Xor C Xor D; G:=(3*I+5) And 15; End
  Else Begin F:=C Xor (B Or (Not D)); G:=(7*I) And 15; End;
  T:=D; D:=C; C:=B;
  F:=F+A+K[I]+X[G]; Rot:=(F Shl S[I]) Or (F Shr (32-S[I]));
  B:=B+Rot; A:=T;
 End;
 A:=A+$67452301; B:=B+$EFCDAB89; C:=C+$98BADCFE; D:=D+$10325476;
 For I:=0 To 3 Do Begin
  Case I Of 0: T:=A; 1: T:=B; 2: T:=C; Else T:=D; End;
  M[I*4]:=T And 255; M[I*4+1]:=(T Shr 8) And 255; M[I*4+2]:=(T Shr 16) And 255; M[I*4+3]:=T Shr 24;
 End;
End;
Procedure EC3LfgInit(Seed: LongWord);
Var Tmp: Array[0..15] Of Byte; I,J: Integer;
Begin
 FillChar(EC3Lfg,SizeOf(EC3Lfg),0); FillChar(Tmp,16,0);
 I:=8;
 While I<64 Do Begin
  Tmp[0]:=Seed And 255; Tmp[1]:=(Seed Shr 8) And 255; Tmp[2]:=(Seed Shr 16) And 255; Tmp[3]:=Seed Shr 24; Tmp[4]:=I;
  EC3Md5(Tmp);
  For J:=0 To 3 Do EC3Lfg[I+J]:=Tmp[J*4] Or (LongWord(Tmp[J*4+1]) Shl 8) Or (LongWord(Tmp[J*4+2]) Shl 16) Or (LongWord(Tmp[J*4+3]) Shl 24);
  Inc(I,4);
 End;
 EC3LfgIdx:=0;
End;
Function EC3LfgGet: LongWord;
Var A: LongWord;
Begin
 A:=EC3Lfg[(EC3LfgIdx-24) And 63]+EC3Lfg[(EC3LfgIdx-55) And 63];
 EC3Lfg[EC3LfgIdx And 63]:=A; Inc(EC3LfgIdx); EC3LfgGet:=A;
End;

Function EC3Bessel(X: Double): Double;
Var T,S,Q: Double; K: Integer;
Begin
 T:=1; S:=1; Q:=X*X/4;
 For K:=1 To 300 Do Begin T:=T*Q/(K*1.0*K); S:=S+T; If T<S*1E-18 Then Break; End;
 EC3Bessel:=S;
End;
Function EC3SymDeq(Code,Levels: LongInt): LongInt;
Begin EC3SymDeq:=((Code-(Levels Shr 1))*16777216) Div Levels; End;
Procedure EC3Tables;
Var I,V: LongInt; Temp: Array[0..128] Of Double; Sum,Scale,A2,Tmp: Double;
Begin
 For I:=0 To 127 Do Begin EC3Ungroup7[I,0]:=I Div 25; EC3Ungroup7[I,1]:=(I Mod 25) Div 5; EC3Ungroup7[I,2]:=(I Mod 25) Mod 5; End;
 For I:=0 To 31 Do Begin EC3Ungroup5[I,0]:=I Div 9; EC3Ungroup5[I,1]:=(I Mod 9) Div 3; EC3Ungroup5[I,2]:=(I Mod 9) Mod 3; End;
 For I:=0 To 31 Do For V:=0 To 2 Do EC3B1[I,V]:=EC3SymDeq(EC3Ungroup5[I,V],3);
 For I:=0 To 127 Do Begin
  For V:=0 To 2 Do EC3B2[I,V]:=EC3SymDeq(EC3Ungroup7[I,V],5);
  EC3B4[I,0]:=EC3SymDeq(I Div 11,11); EC3B4[I,1]:=EC3SymDeq(I Mod 11,11);
 End;
 For I:=0 To 6 Do EC3B3[I]:=EC3SymDeq(I,7);
 For I:=0 To 14 Do EC3B5[I]:=EC3SymDeq(I,15);
 For I:=0 To 255 Do Begin
  V:=(I Shr 5)-((I Shr 7) Shl 3)-5;
  If V>=0 Then EC3Dyn[I]:=((I And 31) Or 32)*(LongInt(1) Shl V) Else EC3Dyn[I]:=((I And 31) Or 32)/(LongInt(1) Shl (-V));
 End;
 { fenetre KBD alpha 5, n=256 }
 Sum:=0; Scale:=0; A2:=4*(5.0*Pi/256)*(5.0*Pi/256);
 For I:=0 To 128 Do Begin
  Tmp:=A2*I*(256-I); Temp[I]:=EC3Bessel(Sqrt(Tmp));
  If (I<>0) And (I<128) Then Scale:=Scale+Temp[I]*2 Else Scale:=Scale+Temp[I];
 End;
 Scale:=1.0/(Scale+1);
 For I:=0 To 128 Do Begin Sum:=Sum+Temp[I]; EC3Win[I]:=Sqrt(Sum*Scale); End;
 For I:=129 To 255 Do Begin Sum:=Sum+Temp[256-I]; EC3Win[I]:=Sqrt(Sum*Scale); End;
 EC3LfgInit(0);
 EC3Init:=True;
End;
Var
 HSync,HBsid,HNBlk,HSr,HSrShift,HRate,HBitRate,HMode,HLfe,HNCh,HFSize,HFType,HSub,HBsmod,HCenter,HSurr,HDsur,HRateCode: LongInt;
