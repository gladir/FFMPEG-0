{ ---- PNM / PAM / PBM (libavcodec/pnm.c, pnmdec.c) : images P1..P7 vers le circuit d'image commun ---- }
Var PnmYuvFlag: Boolean;
Procedure DecodePNM(Const Source,Target: String; Mode: LongInt);
Var
 F,Img: PEABuffer; Size,Pos,W,H,Typ,Maxval,Depth,Comp,SampleLen,Fmt,I,J,K,N,V,Q,RowBytes,Bpp,Up,Fc: LongInt;
 Tok,Tup: String; IsMono,MonoWhite,Is16: Boolean; Smp: Array[0..7] Of LongInt; Bits,Cw,Ch2: LongInt;
Function IsSp(C: LongInt): Boolean;
Begin IsSp:=(C=32) Or (C=10) Or (C=13) Or (C=9); End;
Function GetTok: String;
Var C: LongInt; R: String;
Begin
 R:=''; C:=0;
 While Pos<Size Do Begin
  C:=F^[Pos]; Inc(Pos);
  If C=35 Then Begin
   While (C<>10) And (Pos<Size) Do Begin C:=F^[Pos]; Inc(Pos); End;
  End Else If Not IsSp(C) Then Break;
 End;
 While (Pos<=Size) And Not IsSp(C) And (Length(R)<31) Do Begin
  R:=R+Chr(C);
  If Pos<Size Then Begin C:=F^[Pos]; Inc(Pos); End Else Begin C:=32; Inc(Pos); End;
 End;
 GetTok:=R;
End;
Function ToInt(Const S: String): LongInt;
Var X,Code: LongInt;
Begin Val(S,X,Code); If Code<>0 Then X:=0; ToInt:=X; End;
Begin
 NVLoad(Source,F,Size);
 Pos:=0;
 If (Size<3) Or (F^[0]<>80) Or (F^[1]<49) Or (F^[1]>55) Then Fail('pnm: signature invalide.');
 Tok:=GetTok;
 Typ:=Ord(Tok[2])-48;
 W:=0; H:=0; Maxval:=255; Comp:=1; SampleLen:=8; IsMono:=False; MonoWhite:=True; Is16:=False;
 If Typ=7 Then Begin
  W:=-1; H:=-1; Maxval:=-1; Depth:=-1; Tup:='';
  Repeat
   Tok:=GetTok;
   If Tok='WIDTH' Then W:=ToInt(GetTok)
   Else If Tok='HEIGHT' Then H:=ToInt(GetTok)
   Else If Tok='DEPTH' Then Depth:=ToInt(GetTok)
   Else If Tok='MAXVAL' Then Maxval:=ToInt(GetTok)
   Else If (Tok='TUPLTYPE') Or (Tok='TUPLETYPE') Then Tup:=GetTok
   Else If Tok='ENDHDR' Then Break
   Else Fail('pnm: en-tete PAM invalide.');
  Until False;
  If (W<=0) Or (H<=0) Or (Maxval<=0) Or (Maxval>65535) Or (Depth<=0) Or (Tup='') Or (Pos>=Size) Then Fail('pnm: en-tete PAM incomplet.');
  Comp:=Depth;
  If Depth=1 Then Begin
   If Maxval=1 Then Begin IsMono:=True; MonoWhite:=False; SampleLen:=1; End
   Else If Maxval<256 Then SampleLen:=8 Else SampleLen:=16;
  End Else If (Depth>=2) And (Depth<=4) Then Begin
   If Maxval<256 Then SampleLen:=8 Else SampleLen:=16;
  End Else Fail('pnm: profondeur PAM non prise en charge.');
 End Else Begin
  If (Typ=1) Or (Typ=4) Then Begin IsMono:=True; MonoWhite:=True; SampleLen:=1; Comp:=1; End
  Else If (Typ=2) Or (Typ=5) Then Comp:=1
  Else If (Typ=3) Or (Typ=6) Then Comp:=3
  Else Fail('pnm: type non pris en charge.');
  W:=ToInt(GetTok); H:=ToInt(GetTok);
  If (W<=0) Or (H<=0) Or (Pos>=Size) Then Fail('pnm: dimensions invalides.');
  If Not IsMono Then Begin
   Maxval:=ToInt(GetTok);
   If (Maxval<=0) Or (Maxval>65535) Then Maxval:=255;
   If Maxval>=256 Then SampleLen:=16;
  End Else Maxval:=1;
 End;
 If (W>16000) Or (H>16000) Then Fail('pnm: dimensions trop grandes.');
 If PnmYuvFlag And (Typ=5) And (Maxval<256) Then Begin
  { pgmyuv : YUV 4:2:0 stocke dans une image PGM de hauteur 3/2 }
  If Odd(W) Or ((H*2) Mod 3<>0) Then Fail('pgmyuv: dimensions incorrectes.');
  H:=H*2 Div 3;
  If Odd(H) Then Fail('pgmyuv: hauteur paire requise.');
  If Int64(W)*(H*3 Div 2)>Size-Pos Then Fail('pnm: donnees insuffisantes.');
  Cw:=W Div 2; Ch2:=H Div 2;
  NVBegin(Mode,Target,W,H,7,25,1); NVSarN:=0; NVSarD:=0;
  NVSubX:=1; NVSubY:=1; NVCW:=Cw; NVCH:=Ch2; NVYTag:='C420jpeg'; NVIl:='p';
  GetMem(Img,W*H+2*Cw*Ch2+16);
  Move(F^[Pos],Img^[0],W*H);
  For I:=0 To Ch2-1 Do Begin
   Move(F^[Pos+W*H+I*W],Img^[W*H+I*Cw],Cw);
   Move(F^[Pos+W*H+I*W+Cw],Img^[W*H+Cw*Ch2+I*Cw],Cw);
  End;
  NVEmit(Img);
  FreeMem(Img,W*H+2*Cw*Ch2+16); FreeMem(F,Size+64);
  NVFinish('pgmyuv'); Exit;
 End;
 Is16:=SampleLen=16;
 If IsMono Then RowBytes:=(W+7) Div 8 Else If Is16 Then RowBytes:=W*Comp*2 Else RowBytes:=W*Comp;
 If Int64(RowBytes)*H>Size-Pos Then
  If (Typ>=4) Then Fail('pnm: donnees insuffisantes.');
 { pixel natif : gris (4), RGB24 (9), BGRA (3) }
 If Comp>=3 Then Begin If Comp=3 Then Fmt:=9 Else Fmt:=3; End Else If IsMono Then Fmt:=10 Else Fmt:=4;
 NVBegin(Mode,Target,W,H,Fmt,25,1); NVSarN:=0; NVSarD:=0; NVHasAlpha:=(Comp=4);
 Bpp:=NVBpp(Fmt);
 GetMem(Img,W*H*Bpp+16);
 For I:=0 To H-1 Do Begin
  Bits:=0;
  For J:=0 To W-1 Do Begin
   For K:=0 To Comp-1 Do Begin
    If IsMono Then Begin
     If Typ=1 Then Begin
      While (Pos<Size) And ((F^[Pos]<48) Or (F^[Pos]>57)) Do Inc(Pos);
      If Pos>=Size Then Fail('pnm: donnees insuffisantes.');
      V:=F^[Pos] And 1; Inc(Pos);
     End Else If Typ=7 Then Begin
      If Pos>=Size Then Fail('pnm: donnees insuffisantes.');
      V:=F^[Pos] And 1; Inc(Pos);
     End Else Begin
      If Pos+I*RowBytes+(J Shr 3)>=Size Then Fail('pnm: donnees insuffisantes.');
      V:=(F^[Pos+I*RowBytes+(J Shr 3)] Shr (7-(J And 7))) And 1;
     End;
     If Typ=7 Then Smp[K]:=V*255 Else If MonoWhite Then Smp[K]:=(1-V)*255 Else Smp[K]:=V*255;
    End Else If Typ<4 Then Begin
     While (Pos<Size) And ((F^[Pos]<48) Or (F^[Pos]>57)) Do Inc(Pos);
     If Pos>=Size Then Fail('pnm: donnees insuffisantes.');
     V:=0; N:=0;
     While (Pos<Size) And (F^[Pos]>=48) And (F^[Pos]<=57) And (N<6) Do Begin V:=V*10+F^[Pos]-48; Inc(Pos); Inc(N); End;
     If V>Maxval Then Fail('pnm: valeur superieure a maxval.');
     If Is16 Then Smp[K]:=(V*255+Maxval Div 2) Div Maxval Else Smp[K]:=(255*V+Maxval Div 2) Div Maxval;
    End Else Begin
     If Is16 Then Begin
      Q:=Pos+I*RowBytes+(J*Comp+K)*2;
      V:=F^[Q]*256+F^[Q+1];
      If Maxval<65535 Then Begin Fc:=(Int64(65535)*32768+Maxval Div 2) Div Maxval; V:=(Int64(V)*Fc+16384) Shr 15; End;
      Smp[K]:=(V+128) Div 257;
     End Else Begin
      V:=F^[Pos+I*RowBytes+J*Comp+K];
      If Maxval<255 Then Begin Fc:=(255*128+Maxval Div 2) Div Maxval; V:=(V*Fc+64) Shr 7; End;
      Smp[K]:=V;
     End;
    End;
   End;
   Q:=(I*W+J)*Bpp;
   If Comp>=3 Then Begin
    If Comp=3 Then Begin Img^[Q]:=Smp[0]; Img^[Q+1]:=Smp[1]; Img^[Q+2]:=Smp[2]; End
    Else Begin Img^[Q]:=Smp[2]; Img^[Q+1]:=Smp[1]; Img^[Q+2]:=Smp[0]; Img^[Q+3]:=Smp[3]; End;
   End Else Img^[Q]:=Smp[0];
  End;
 End;
 NVEmit(Img);
 FreeMem(Img,W*H*Bpp+16); FreeMem(F,Size+64);
 NVFinish('pnm');
End;

{ ---- NuppelVideo / RTJPEG (libavformat/nuv.c, libavcodec/nuv.c, rtjpeg.c) : fichier .nuv vers image ---- }
Var NuBuf: PEABuffer; NuBits: LongInt; NuBytes: LongInt;
Function NuGet(N: LongInt): LongInt;
Var K,V,B: LongInt;
Begin
 V:=0;
 For K:=1 To N Do Begin
  If NuBits Shr 3<NuBytes Then B:=(NuBuf^[NuBits Shr 3] Shr (7-(NuBits And 7))) And 1 Else B:=0;
  V:=V*2+B; Inc(NuBits);
 End;
 NuGet:=V;
End;
Function NuSGet(N: LongInt): LongInt;
Var V: LongInt;
Begin V:=NuGet(N); If V>=(1 Shl (N-1)) Then V:=V-(1 Shl N); NuSGet:=V; End;

Procedure NuReduce(Var DNum,DDen: Int64; Num,Den,Mx: Int64);
Var A0n,A0d,A1n,A1d,X,NextDen,A2n,A2d,G,T1,T2: Int64;
Begin
 G:=Abs(Num); T1:=Abs(Den);
 T2:=T1; T1:=G; While T2<>0 Do Begin G:=T1 Mod T2; T1:=T2; T2:=G; End;
 G:=T1;
 If G<>0 Then Begin Num:=Abs(Num) Div G; Den:=Abs(Den) Div G; End;
 A0n:=0; A0d:=1; A1n:=1; A1d:=0;
 If (Num<=Mx) And (Den<=Mx) Then Begin A1n:=Num; A1d:=Den; Den:=0; End;
 While Den<>0 Do Begin
  X:=Num Div Den; NextDen:=Num-Den*X;
  A2n:=X*A1n+A0n; A2d:=X*A1d+A0d;
  If (A2n>Mx) Or (A2d>Mx) Then Begin
   If A1n<>0 Then X:=(Mx-A0n) Div A1n;
   If A1d<>0 Then Begin T1:=(Mx-A0d) Div A1d; If T1<X Then X:=T1; End;
   If Den*(2*X*A1d+A0d)>Num*A1d Then Begin A1n:=X*A1n+A0n; A1d:=X*A1d+A0d; End;
   Break;
  End;
  A0n:=A1n; A0d:=A1d; A1n:=A2n; A1d:=A2d; Num:=Den; Den:=NextDen;
 End;
 DNum:=A1n; DDen:=A1d;
End;

Procedure NuD2Q(D: Double; Mx: Int64; Var N,Dn: LongInt);
Var Ex: LongInt; Den,A,B: Int64; T: Double;
Begin
 If D<=0 Then Begin N:=0; Dn:=1; Exit; End;
 Ex:=0; T:=D; While T>=2.0 Do Begin T:=T/2; Inc(Ex); End;
 Den:=Int64(1) Shl (61-Ex);
 NuReduce(A,B,Trunc(Int(D*Den+0.5)),Den,Mx);
 N:=A; Dn:=B;
 If (N=0) Or (Dn=0) Then Begin NuReduce(A,B,Trunc(Int(D*Den+0.5)),Den,2147483647); N:=A; Dn:=B; End;
End;

Function NuRdD(P: PEABuffer; At: LongInt): Double;
Var U: Record Case Byte Of 0: (A: Array[0..7] Of Byte); 1: (D: Double); End; K: LongInt;
Begin For K:=0 To 7 Do U.A[K]:=P^[At+K]; NuRdD:=U.D; End;

Procedure DecodeNUV(Const Source,Target: String; Mode: LongInt);
Const
 LumQ: Array[0..63] Of Byte=(16,11,10,16,24,40,51,61,12,12,14,19,26,58,60,55,14,13,16,24,40,57,69,56,14,17,22,29,51,87,80,62,
  18,22,37,56,68,109,103,77,24,35,55,64,81,104,113,92,49,64,78,87,103,121,120,101,72,92,95,98,112,100,103,99);
 ChrQ: Array[0..63] Of Byte=(17,18,24,47,99,99,99,99,18,21,26,66,99,99,99,99,24,26,56,99,99,99,99,99,47,66,99,99,99,99,99,99,
  99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99,99);
ZZ: Array[0..63] Of Byte=(0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,12,19,26,33,40,48,41,34,27,20,13,6,7,14,21,28,
  35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,58,59,52,45,38,31,39,46,53,60,61,54,47,55,62,63);
Var
 F,Pic,Lz,Hb: PEABuffer; Size,Pos,W,H,Vp,Ap,I,Sz,Ts,Cw,Ch,K,Cap,Produced,Gap,Emitted,Idx,Fh: LongInt; Typ: Byte;
 IsMyth,HaveExtra,FrameHeader,Ok,FirstFrame,Key,InitFrame: Boolean; Aspect,Fps: Double;
 Lq,Cq: Array[0..63] Of LongWord; Scan: Array[0..63] Of Byte; SarN,SarD,FrN,FrD,Tmp: LongInt; An,Ad: Int64;
 Comp: Char; Buf: PEABuffer; BufSize,OutLen,Res,Hh,Q,X,Y,Hdr: LongInt; PicStride: LongInt; Fmt: LongInt;
 Blk: TAMVBlock; Quality: LongInt;
Function RL32(At: LongInt): LongInt;Begin RL32:=NVRL32(F,Size,At); End;
Function RL16(At: LongInt): LongInt;Begin RL16:=NVRL16(F,Size,At); End;
Procedure Quant(P: PEABuffer; Cnt: LongInt);
Var J: LongInt;
Begin
 For J:=0 To 63 Do Lq[J]:=LongWord(LongInt(P^[J*4])+LongInt(P^[J*4+1])*256+LongInt(P^[J*4+2])*65536+LongInt(P^[J*4+3])*16777216);
 For J:=0 To 63 Do Cq[J]:=LongWord(LongInt(P^[256+J*4])+LongInt(P^[256+J*4+1])*256+LongInt(P^[256+J*4+2])*65536+LongInt(P^[256+J*4+3])*16777216);
End;
Procedure PutC(Var Cf: LongInt; C: LongInt; Const Qt: Array Of LongWord);
Var Ix: LongInt; V: Int64;
Begin
 Ix:=Scan[Cf]; Dec(Cf);
 V:=Int64(C)*Int64(Qt[Ix]);
 Blk[Ix]:=SmallInt(V And $FFFF);
End;
{ get_block : 0 = non code, 1 = ok, -1 = erreur }
Function GetBlock(Const Qt: Array Of LongWord): LongInt;
Var Dc,Cf,Ac,N,J: LongInt;
Begin
 GetBlock:=1;
 Dc:=NuGet(8);
 If Dc=255 Then Begin GetBlock:=0; Exit; End;
 Cf:=NuGet(6);
 If NuBytes*8-NuBits<(Cf Shl 1) Then Begin GetBlock:=-1; Exit; End;
 For J:=0 To 63 Do Blk[J]:=0;
 While Cf<>0 Do Begin
  Ac:=NuSGet(2);
  If Ac=-2 Then Break;
  PutC(Cf,Ac,Qt);
 End;
 N:=(-NuBits) And 3; If N<>0 Then NuGet(N);
 If NuBytes*8-NuBits<(Cf Shl 2) Then Begin GetBlock:=-1; Exit; End;
 While Cf<>0 Do Begin
  Ac:=NuSGet(4);
  If Ac=-8 Then Break;
  PutC(Cf,Ac,Qt);
 End;
 N:=(-NuBits) And 7; If N<>0 Then NuGet(N);
 If NuBytes*8-NuBits<(Cf Shl 3) Then Begin GetBlock:=-1; Exit; End;
 While Cf<>0 Do Begin
  Ac:=NuSGet(8);
  PutC(Cf,Ac,Qt);
 End;
 PutC(Cf,Dc,Qt);
End;
Function RtjDecode(Data: PEABuffer; Len: LongInt): LongInt;
Var Bx,By,Wb,Hb2,R: LongInt; Y1,Y2,U,V: LongInt;
Procedure DoBlk(Const Qt: Array Of LongWord; Plane: PEABuffer; Off,Stride: LongInt);
Begin
 R:=GetBlock(Qt);
 If R<0 Then Begin RtjDecode:=-1; Exit; End;
 If R>0 Then AVIdctPut(Blk,@Plane^[Off],Stride);
End;
Begin
 NuBuf:=Data; NuBits:=0; NuBytes:=Len;
 RtjDecode:=0;
 Wb:=W Div 16; Hb2:=H Div 16;
 For By:=0 To Hb2-1 Do For Bx:=0 To Wb-1 Do Begin
  Y1:=By*16*W+Bx*16;
  DoBlk(Lq,Pic,Y1,W); If R<0 Then Begin RtjDecode:=-1; Exit; End;
  DoBlk(Lq,Pic,Y1+8,W); If R<0 Then Begin RtjDecode:=-1; Exit; End;
  DoBlk(Lq,Pic,Y1+8*W,W); If R<0 Then Begin RtjDecode:=-1; Exit; End;
  DoBlk(Lq,Pic,Y1+8*W+8,W); If R<0 Then Begin RtjDecode:=-1; Exit; End;
  U:=W*H+By*8*Cw+Bx*8;
  DoBlk(Cq,Pic,U,Cw); If R<0 Then Begin RtjDecode:=-1; Exit; End;
  V:=W*H+Cw*Ch+By*8*Cw+Bx*8;
  DoBlk(Cq,Pic,V,Cw); If R<0 Then Begin RtjDecode:=-1; Exit; End;
 End;
 RtjDecode:=NuBits Div 8;
End;
Begin
 NVLoad(Source,F,Size);
 If Size<72 Then Fail('nuv: fichier trop court.');
 If Not (((F^[0]=78) And (F^[1]=117) And (F^[2]=112)) Or ((F^[0]=77) And (F^[1]=121) And (F^[2]=116))) Then Fail('nuv: signature NuppelVideo/MythTVVideo requise.');
 IsMyth:=F^[0]=77;
 W:=RL32(20); H:=RL32(24);
 Aspect:=NuRdD(F,40); Fps:=NuRdD(F,48);
 Vp:=RL32(56); Ap:=RL32(60);
 If Vp=0 Then Fail('nuv: aucune piste video.');
 If (W<1) Or (H<1) Or (W>16384) Or (H>16384) Then Fail('nuv: dimensions incorrectes.');
 If (Aspect>0.9999) And (Aspect<1.0001) Then Aspect:=4.0/3.0;
 If Fps<0 Then Fps:=0;
 NuD2Q(Fps,60000,FrN,FrD);
 NuD2Q(Aspect*H/W,10000,SarN,SarD);
 { donnees de codec : tables de quantification (sous-type R) }
 Pos:=72; HaveExtra:=False; FrameHeader:=False; Quality:=-1;
 FillChar(Lq,SizeOf(Lq),0); FillChar(Cq,SizeOf(Cq),0);
 While Pos+12<=Size Do Begin
  Typ:=F^[Pos];
  If Typ=Ord('D') Then Begin
   Sz:=RL32(Pos+8) And $FFFFFF;
   If F^[Pos+1]=Ord('R') Then Begin
    If Sz>=512 Then Begin Quant(PEABuffer(@F^[Pos+12]),Sz); HaveExtra:=True; End;
    Inc(Pos,12+Sz);
    If Not IsMyth Then Break;
    Continue;
   End;
   Inc(Pos,12+Sz);
  End Else If Typ=Ord('X') Then Begin
   Sz:=RL32(Pos+8) And $FFFFFF;
   If Sz=512 Then Begin
    I:=RL32(Pos+12+4);
    If I=LongInt($47504A52) Then FrameHeader:=True
    Else Fail('nuv: codec video MythTV non pris en charge (RJPG seulement).');
    Inc(Pos,12+Sz);
    Break;
   End;
   Inc(Pos,12+Sz);
  End Else If Typ=Ord('R') Then Inc(Pos,12)
  Else Begin Sz:=RL32(Pos+8) And $FFFFFF; Inc(Pos,12+Sz); End;
 End;
 If Not HaveExtra And Not FrameHeader Then Fail('nuv: tables de quantification RTJPEG introuvables.');
 For I:=0 To 63 Do Begin
  K:=ZZ[I]; K:=((K Shl 3) Or (K Shr 3)) And 63;
  Scan[I]:=K;
 End;
 { dimensions paires comme codec_reinit }
 W:=(W+1) And Not 1; H:=(H+1) And Not 1;
 Cw:=W Div 2; Ch:=H Div 2;
 Fmt:=7;
 NVBegin(Mode,Target,W,H,7,FrN,FrD);
 NVSubX:=1; NVSubY:=1; NVCW:=Cw; NVCH:=Ch; NVYTag:='C420jpeg'; NVIl:='p';
 NVSarN:=SarN; NVSarD:=SarD;
 If (SarN<=0) Or (SarD<=0) Then Begin NVSarN:=0; NVSarD:=1; End;
 GetMem(Pic,W*H+2*Cw*Ch+64); FillChar(Pic^,W*H,0); FillChar(Pic^[W*H],2*Cw*Ch+64,128);
 Cap:=W*H*3 Div 2+12;
 GetMem(Lz,Cap+128);
 FirstFrame:=True; Emitted:=0;
 While Pos+12<=Size Do Begin
  Typ:=F^[Pos]; Sz:=RL32(Pos+8) And $FFFFFF;
  Ts:=RL32(Pos+4);
  If Typ=Ord('R') Then Begin Inc(Pos,12); Continue; End;
  If Pos+12+Sz>Size Then Sz:=Size-Pos-12;
  Ok:=False;
  If ((Typ=Ord('V')) Or ((Typ=Ord('D')) And (F^[Pos+1]=Ord('R')))) Then Begin
   If Typ=Ord('D') Then Begin
    If Sz>=512 Then Begin Quant(PEABuffer(@F^[Pos+12]),Sz); End;
   End Else Begin
    Comp:=Chr(F^[Pos+1]);
    Key:=True; Ok:=True;
    Case Comp Of
     '1','2': Begin Key:=F^[Pos+2]=0; If (W<16) Or (H<16) Then Ok:=False; End;
     'L': Key:=False;
     '0','3','N': ;
     Else Ok:=False;
    End;
    If Ok Then Begin
     { taille minimale }
     If Comp='0' Then Q:=W*H*3 Div 2 Else If Comp='1' Then Q:=(W Div 16)*(H Div 16)*6 Else Q:=0;
     If Sz+12<Q Div 4 Then Ok:=False;
    End;
    If Ok Then Begin
     Buf:=PEABuffer(@F^[Pos+12]); BufSize:=Sz;
     If (Comp='2') Or (Comp='3') Then Begin
      OutLen:=Cap;
      FillChar(Lz^,Cap+128,0);
      Res:=NVLzo(Buf,BufSize,Lz,OutLen);
      If Res<>0 Then Ok:=False Else Begin Buf:=Lz; BufSize:=Cap-OutLen; End;
     End;
    End;
    If Ok And FrameHeader Then Begin
     If BufSize<12 Then Ok:=False
     Else Begin
      Hb:=Buf;
      If (Hb^[0]<>Ord('V')) And ((Hb^[4]+Hb^[5]*256)<>$000C) Then Ok:=False
      Else Begin
       { changement de taille non pris en charge }
       Hh:=Hb^[6]+Hb^[7]*256; Q:=Hb^[8]+Hb^[9]*256;
       If (((Hh+1) And Not 1)<>W) Or (((Q+1) And Not 1)<>H) Then Fail('nuv: changement de dimensions dans le flux non pris en charge.');
       Quality:=Hb^[10]; If Quality<1 Then Quality:=1;
       For I:=0 To 63 Do Begin Lq[I]:=(LongWord(LumQ[I]) Shl 7) Div LongWord(Quality); Cq[I]:=(LongWord(ChrQ[I]) Shl 7) Div LongWord(Quality); End;
       Buf:=PEABuffer(@Buf^[12]); Dec(BufSize,12);
      End;
     End;
    End;
    If Ok Then Begin
     If Key Or FirstFrame Then Begin
      FillChar(Pic^,W*H,0); FillChar(Pic^[W*H],2*Cw*Ch,128);
     End;
     Case Comp Of
      '0','3': Begin
       Hh:=H;
       If BufSize<W*H*3 Div 2 Then Hh:=BufSize Div W Div 3*2;
       If Hh>0 Then Begin
        Move(Buf^[0],Pic^[0],W*Hh);
        Q:=(Hh+1) Div 2;
        Move(Buf^[W*Hh],Pic^[W*H],Cw*Q);
        Move(Buf^[W*Hh+Cw*Q],Pic^[W*H+Cw*Ch],Cw*Q);
       End;
      End;
      '1','2': Begin
       Res:=RtjDecode(Buf,BufSize);
       If Res<0 Then Ok:=False;
      End;
      'N': Begin FillChar(Pic^,W*H,0); FillChar(Pic^[W*H],2*Cw*Ch,128); End;
      'L': ;
     End;
    End;
    If Ok Then Begin
     NVEmit(Pic); Inc(Emitted); FirstFrame:=False;
     If NVDone Then Break;
    End Else If Typ=Ord('V') Then NVRepeat;
   End;
  End;
  Inc(Pos,12+Sz);
 End;
 FreeMem(Pic,W*H+2*Cw*Ch+64); FreeMem(F,Size+64);
 NVFinish('nuv');
End;

{ ---- PCX (libavcodec/pcx.c) ---- }
Procedure DecodePCX(Const Source,Target: String; Mode: LongInt);
Var
 F,Img,Scan: PEABuffer; Size,Pos,Comp,Bpp,Xmin,Ymin,Xmax,Ymax,W,H,Planes,Bpl,Bps,Y,X,I,Fmt,V,M,Q,PalStart,Dx,Dy: LongInt;
Function RL16(At: LongInt): LongInt;Begin RL16:=NVRL16(F,Size,At); End;
Procedure RleLine;
Var Run,Val,N: LongInt;
Begin
 If Pos>=Size Then Begin FillChar(Scan^,Bps,0); Exit; End;
 If Comp<>0 Then Begin
  N:=0;
  While (N<Bps) And (Pos<Size) Do Begin
   Run:=1; Val:=F^[Pos]; Inc(Pos);
   If (Val>=$C0) And (Pos<Size) Then Begin Run:=Val And $3F; Val:=F^[Pos]; Inc(Pos); End;
   While (N<Bps) And (Run>0) Do Begin Scan^[N]:=Val; Inc(N); Dec(Run); End;
  End;
 End Else Begin
  N:=Size-Pos; If N>Bps Then N:=Bps;
  Move(F^[Pos],Scan^,N); Inc(Pos,N);
 End;
End;
Begin
 NVLoad(Source,F,Size);
 If Size<128 Then Fail('pcx: fichier trop court.');
 If (F^[0]<>10) Or (F^[1]>5) Then Fail('pcx: signature invalide.');
 Comp:=F^[2]; Bpp:=F^[3];
 Xmin:=RL16(4); Ymin:=RL16(6); Xmax:=RL16(8); Ymax:=RL16(10);
 Dx:=RL16(12); Dy:=RL16(14);
 If (Xmax<Xmin) Or (Ymax<Ymin) Then Fail('pcx: dimensions invalides.');
 W:=Xmax-Xmin+1; H:=Ymax-Ymin+1;
 Planes:=F^[65]; Bpl:=RL16(66); Bps:=Planes*Bpl;
 If (Bps<(W*Bpp*Planes+7) Div 8) Or ((Comp=0) And (Bps>(Size-128) Div H)) Then Fail('pcx: donnees corrompues.');
 If (Planes=3) And (Bpp=8) Then Fmt:=9
 Else If ((Planes=1) And ((Bpp=8) Or (Bpp=4) Or (Bpp=2) Or (Bpp=1))) Or ((Planes=4) And (Bpp=1)) Or ((Planes=3) And (Bpp=1)) Or ((Planes=2) And (Bpp=1)) Then Fmt:=0
 Else Fail('pcx: format non pris en charge.');
 If (W>16000) Or (H>16000) Then Fail('pcx: dimensions trop grandes.');
 NVBegin(Mode,Target,W,H,Fmt,25,1);
 If (Dx>0) And (Dy>0) Then Begin NVGcd(Dx,Dy); NVSarN:=Dx; NVSarD:=Dy; End Else Begin NVSarN:=0; NVSarD:=1; End;
 FillChar(NVPalR,256,0); FillChar(NVPalG,256,0); FillChar(NVPalB,256,0);
 Pos:=128;
 GetMem(Scan,Bps+64); FillChar(Scan^,Bps+64,0);
 GetMem(Img,W*H*NVBpp(Fmt)+64);
 If Fmt=9 Then Begin
  For Y:=0 To H-1 Do Begin
   RleLine;
   For X:=0 To W-1 Do Begin
    Img^[(Y*W+X)*3]:=Scan^[X]; Img^[(Y*W+X)*3+1]:=Scan^[X+Bpl]; Img^[(Y*W+X)*3+2]:=Scan^[X+2*Bpl];
   End;
  End;
 End Else Begin
  If (Planes=1) And (Bpp=8) Then Begin
   If Size<769 Then Fail('pcx: fichier trop court.');
   For Y:=0 To H-1 Do Begin RleLine; Move(Scan^,Img^[Y*W],W); End;
   PalStart:=Size-769;
   If F^[PalStart]<>12 Then Fail('pcx: palette attendue apres les donnees.');
   For I:=0 To 255 Do Begin NVPalR[I]:=F^[PalStart+1+I*3]; NVPalG[I]:=F^[PalStart+2+I*3]; NVPalB[I]:=F^[PalStart+3+I*3]; End;
  End Else If Planes=1 Then Begin
   For Y:=0 To H-1 Do Begin
    RleLine;
    For X:=0 To W-1 Do Begin
     Q:=X*Bpp; V:=(Scan^[Q Shr 3] Shr (8-Bpp-(Q And 7))) And ((1 Shl Bpp)-1);
     Img^[Y*W+X]:=V;
    End;
   End;
  End Else Begin
   For Y:=0 To H-1 Do Begin
    RleLine;
    For X:=0 To W-1 Do Begin
     M:=$80 Shr (X And 7); V:=0;
     For I:=Planes-1 Downto 0 Do Begin
      V:=V*2; If (Scan^[I*Bpl+(X Shr 3)] And M)<>0 Then Inc(V);
     End;
     Img^[Y*W+X]:=V;
    End;
   End;
  End;
  If Bpp*Planes=1 Then Begin NVPalR[0]:=0; NVPalG[0]:=0; NVPalB[0]:=0; NVPalR[1]:=255; NVPalG[1]:=255; NVPalB[1]:=255; End
  Else If Bpp<8 Then Begin
   For I:=0 To 15 Do Begin NVPalR[I]:=F^[16+I*3]; NVPalG[I]:=F^[17+I*3]; NVPalB[I]:=F^[18+I*3]; End;
  End;
 End;
 NVEmit(Img);
 FreeMem(Img,W*H*NVBpp(Fmt)+64); FreeMem(Scan,Bps+64); FreeMem(F,Size+64);
 NVFinish('pcx');
End;

{ ---- SGI (libavcodec/sgidec.c) ---- }
Procedure DecodeSGI(Const Source,Target: String; Mode: LongInt);
Var
 F,Img: PEABuffer; Size,Rle,Bpc,Dim,W,H,Nc,Z,R,Y,X,Pos,TblPos,Start,Cnt,N,Fmt,Pl,Val,Rows: LongInt;
 Row: PEABuffer; RowLen: LongInt;
Function RB16(At: LongInt): LongInt;Begin RB16:=EAByte(F,Size,At)*256+EAByte(F,Size,At+1); End;
Function RB32(At: LongInt): LongInt;Begin RB32:=RB16(At)*65536+RB16(At+2); End;
Procedure Bad;Begin Fail('sgi: donnees invalides.'); End;
Begin
 NVLoad(Source,F,Size);
 If Size<512 Then Fail('sgi: fichier trop court.');
 If RB16(0)<>$01DA Then Fail('sgi: signature invalide.');
 Rle:=F^[2]; Bpc:=F^[3]; Dim:=RB16(4); W:=RB16(6); H:=RB16(8); Nc:=RB16(10);
 If (Bpc<>1) And (Bpc<>2) Then Fail('sgi: nombre de canaux invalide.');
 If (Dim<>2) And (Dim<>3) Then Fail('sgi: dimension invalide.');
 If (Nc<>1) And (Nc<>3) And (Nc<>4) Then Fail('sgi: format d''image invalide.');
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail('sgi: dimensions invalides.');
 If Nc=1 Then Fmt:=4 Else Fmt:=9;
 RowLen:=W*Bpc;
 GetMem(Row,RowLen*H*Nc+64); FillChar(Row^,RowLen*H*Nc,0);
 { Row: plans SGI, canal Z, ligne R (0 = haut de l'image) }
 Pos:=512;
 If Rle<>0 Then Begin
  If H*Nc*8>Size-512 Then Bad;
  TblPos:=512;
  For Z:=0 To Nc-1 Do
   For R:=H-1 Downto 0 Do Begin
    Start:=RB32(TblPos); Inc(TblPos,4);
    Pos:=Start; X:=0;
    While X<W Do Begin
     If Pos+Bpc>Size Then Bad;
     If Bpc=1 Then Begin Cnt:=F^[Pos] And $7F; Val:=F^[Pos]; Inc(Pos); End
     Else Begin Val:=RB16(Pos); Cnt:=Val And $7F; Inc(Pos,2); End;
     If Cnt=0 Then Break;
     If W-X<Cnt Then Bad;
     If (Val And $80)<>0 Then Begin
      For N:=1 To Cnt Do Begin
       If Pos+Bpc>Size Then Bad;
       Move(F^[Pos],Row^[(Z*H+R)*RowLen+X*Bpc],Bpc); Inc(Pos,Bpc); Inc(X);
      End;
     End Else Begin
      If Pos+Bpc>Size Then Bad;
      For N:=1 To Cnt Do Begin Move(F^[Pos],Row^[(Z*H+R)*RowLen+X*Bpc],Bpc); Inc(X); End;
      Inc(Pos,Bpc);
     End;
    End;
    If X<>W Then Bad;
   End;
 End Else Begin
  If Int64(RowLen)*H*Nc>Size-512 Then Bad;
  For Z:=0 To Nc-1 Do
   For R:=H-1 Downto 0 Do Begin
    Move(F^[Pos],Row^[(Z*H+R)*RowLen],RowLen); Inc(Pos,RowLen);
   End;
 End;
 If Bpc=2 Then Fail('sgi: canaux 16 bits non pris en charge.');
 NVBegin(Mode,Target,W,H,Fmt,25,1);
 GetMem(Img,W*H*NVBpp(Fmt)+64);
 { la premiere rangee stockee est la ligne du bas : R est deja l'indice de ligne de l'image }
 For Y:=0 To H-1 Do
  For X:=0 To W-1 Do Begin
   R:=Y;
   If Nc=1 Then Img^[Y*W+X]:=Row^[R*RowLen+X]
   Else Begin
    Img^[(Y*W+X)*3]:=Row^[(0*H+R)*RowLen+X];
    Img^[(Y*W+X)*3+1]:=Row^[(1*H+R)*RowLen+X];
    Img^[(Y*W+X)*3+2]:=Row^[(2*H+R)*RowLen+X];
   End;
  End;
 NVEmit(Img);
 FreeMem(Img,W*H*NVBpp(Fmt)+64); FreeMem(Row,RowLen*H*Nc+64); FreeMem(F,Size+64);
 NVFinish('sgi');
End;

{ ---- PTX (libavcodec/ptx.c) ---- }
Procedure DecodePTX(Const Source,Target: String; Mode: LongInt);
Var F,Img: PEABuffer; Size,Off,W,H,Y: LongInt;
Begin
 NVLoad(Source,F,Size);
 If Size<14 Then Fail('ptx: fichier trop court.');
 Off:=NVRL16(F,Size,0); W:=NVRL16(F,Size,8); H:=NVRL16(F,Size,10);
 If (NVRL16(F,Size,12) Shr 3)<>2 Then Fail('ptx: format different de RGB15 non pris en charge.');
 If Size<Off Then Fail('ptx: donnees invalides.');
 If Size-Off<W*2 Then Fail('ptx: donnees invalides.');
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail('ptx: dimensions invalides.');
 NVBegin(Mode,Target,W,H,2,25,1);
 GetMem(Img,W*H*2+64); FillChar(Img^,W*H*2,0);
 Y:=0;
 While (Y<H) And (Size-Off>=W*2) Do Begin Move(F^[Off],Img^[Y*W*2],W*2); Inc(Off,W*2); Inc(Y); End;
 { BGR555LE -> RGB555 natif : echange des champs R et B }
 For Y:=0 To W*H-1 Do Begin
  Off:=Img^[Y*2]+Img^[Y*2+1]*256;
  Off:=(Off And $3E0) Or ((Off And $1F) Shl 10) Or ((Off Shr 10) And $1F);
  Img^[Y*2]:=Off And 255; Img^[Y*2+1]:=Off Shr 8;
 End;
 NVEmit(Img);
 FreeMem(Img,W*H*2+64); FreeMem(F,Size+64);
 NVFinish('ptx');
End;

{ ---- PNG (libavcodec/pngdec.c) : 1 a 8 bits par composante, entrelacement Adam7 ---- }
Procedure DecodePNG(Const Source,Target: String; Mode: LongInt);
Const
 PX0: Array[0..6] Of Integer=(0,4,0,2,0,1,0); PY0: Array[0..6] Of Integer=(0,0,4,0,2,0,1);
 PDX: Array[0..6] Of Integer=(8,8,4,4,2,2,1); PDY: Array[0..6] Of Integer=(8,8,8,4,4,2,2);
Var
 F,Idat,Raw,Img,Prv,Cur: PEABuffer; Size,Pos,Len,IdLen,Bd,Ct,Il,W,H,Q,Bits,Bpp,RowB,I,X,Y,Res,OutLen,Fl,A,B,C,Pa,Pb,Pc,Pp,V,Fmt,Ps,Pw,Ph,Rp,Total,Ox,Oy,PNg,Np: LongInt;
 Tag: String[4]; HasPal: Boolean; Alpha: Boolean; PhN,PhD: LongInt;
Function RB32(At: LongInt): LongInt;Begin RB32:=EAByte(F,Size,At)*16777216+EAByte(F,Size,At+1)*65536+EAByte(F,Size,At+2)*256+EAByte(F,Size,At+3); End;
Function Smp(Row: PEABuffer; X: LongInt): LongInt;
Begin
 Case Bd Of
  8: Smp:=Row^[X];
  4: Smp:=(Row^[X Shr 1] Shr (4-4*(X And 1))) And 15;
  2: Smp:=(Row^[X Shr 2] Shr (6-2*(X And 3))) And 3;
  Else Smp:=(Row^[X Shr 3] Shr (7-(X And 7))) And 1;
 End;
End;
Begin
 NVLoad(Source,F,Size);
 If (Size<33) Or (F^[0]<>137) Or (F^[1]<>80) Or (F^[2]<>78) Or (F^[3]<>71) Or (F^[4]<>13) Or (F^[5]<>10) Or (F^[6]<>26) Or (F^[7]<>10) Then Fail('png: signature invalide.');
 Pos:=8; IdLen:=0; W:=0; H:=0; Bd:=0; Ct:=0; Il:=0; HasPal:=False; PhN:=0; PhD:=1;
 FillChar(NVPalR,256,0); FillChar(NVPalG,256,0); FillChar(NVPalB,256,0);
 GetMem(Idat,Size+64);
 While Pos+12<=Size Do Begin
  Len:=RB32(Pos);
  Tag:=Chr(F^[Pos+4])+Chr(F^[Pos+5])+Chr(F^[Pos+6])+Chr(F^[Pos+7]);
  If (Len<0) Or (Pos+12+Len>Size) Then Break;
  If Tag='IHDR' Then Begin
   W:=RB32(Pos+8); H:=RB32(Pos+12);
   Bd:=F^[Pos+16]; Ct:=F^[Pos+17]; Il:=F^[Pos+20];
  End Else If Tag='PLTE' Then Begin
   For I:=0 To (Len Div 3)-1 Do If I<256 Then Begin NVPalR[I]:=F^[Pos+8+I*3]; NVPalG[I]:=F^[Pos+9+I*3]; NVPalB[I]:=F^[Pos+10+I*3]; End;
   HasPal:=True;
  End Else If (Tag='pHYs') And (Len>=9) And (IdLen=0) Then Begin
   PhN:=RB32(Pos+8); PhD:=RB32(Pos+12);
   If (PhN<0) Or (PhD<0) Then Begin PhN:=0; PhD:=1; End;
  End Else If Tag='IDAT' Then Begin
   Move(F^[Pos+8],Idat^[IdLen],Len); Inc(IdLen,Len);
  End Else If Tag='IEND' Then Break;
  Inc(Pos,12+Len);
 End;
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail('png: dimensions invalides.');
 If Il>1 Then Fail('png: methode d''entrelacement invalide.');
 If Bd>8 Then Fail('png: profondeur 16 bits non prise en charge.');
 Alpha:=False;
 Case Ct Of
  0: Begin Q:=1; If Bd=1 Then Fmt:=10 Else Fmt:=4; If (Bd<>1) And (Bd<>2) And (Bd<>4) And (Bd<>8) Then Fail('png: profondeur invalide.'); End;
  2: Begin Q:=3; Fmt:=9; If Bd<>8 Then Fail('png: RGB 8 bits requis.'); End;
  3: Begin Q:=1; Fmt:=0; If (Bd<>1) And (Bd<>2) And (Bd<>4) And (Bd<>8) Then Fail('png: profondeur invalide.'); If Not HasPal Then Fail('png: palette absente.'); End;
  4: Begin Q:=2; Fmt:=4; If Bd<>8 Then Fail('png: gris+alpha 8 bits requis.'); End;
  6: Begin Q:=4; Fmt:=3; Alpha:=True; If Bd<>8 Then Fail('png: RGBA 8 bits requis.'); End;
  Else Fail('png: type de couleur invalide.');
 End;
 Bits:=Q*Bd; Bpp:=(Bits+7) Div 8;
 RowB:=(W*Bits+7) Div 8;
 If Il=0 Then Total:=H*(RowB+1)
 Else Begin
  Total:=0;
  For Ps:=0 To 6 Do Begin
   Pw:=(W-PX0[Ps]+PDX[Ps]-1) Div PDX[Ps]; Ph:=(H-PY0[Ps]+PDY[Ps]-1) Div PDY[Ps];
   If (Pw>0) And (Ph>0) Then Inc(Total,Ph*(((Pw*Bits+7) Div 8)+1));
  End;
 End;
 GetMem(Raw,Total+64);
 Res:=NVInflate(Idat,IdLen,Raw,Total,OutLen);
 If (Res<>0) Or (OutLen<Total) Then Fail('png: donnees compressees invalides.');
 FreeMem(Idat,Size+64);
 NVBegin(Mode,Target,W,H,Fmt,25,1); NVSarN:=0; NVSarD:=0; If (PhN>0) And (PhD>0) Then Begin NVSarN:=PhN; NVSarD:=PhD; NVGcd(NVSarN,NVSarD); End; NVHasAlpha:=Alpha; If Il=1 Then NVIl:='b';
 GetMem(Img,W*H*NVBpp(Fmt)+64); FillChar(Img^,W*H*NVBpp(Fmt),0);
 GetMem(Prv,RowB+64);
 Rp:=0;
 If Il=0 Then PNg:=0 Else PNg:=6;
 For Ps:=0 To PNg Do Begin
  If Il=0 Then Begin Pw:=W; Ph:=H; Ox:=0; Oy:=0; End
  Else Begin
   Pw:=(W-PX0[Ps]+PDX[Ps]-1) Div PDX[Ps]; Ph:=(H-PY0[Ps]+PDY[Ps]-1) Div PDY[Ps];
  End;
  If (Pw<=0) Or (Ph<=0) Then Continue;
  Np:=(Pw*Bits+7) Div 8;
  FillChar(Prv^,RowB+64,0);
  For Y:=0 To Ph-1 Do Begin
   Cur:=PEABuffer(@Raw^[Rp+1]); Fl:=Raw^[Rp];
   For X:=0 To Np-1 Do Begin
    If X>=Bpp Then A:=Cur^[X-Bpp] Else A:=0;
    B:=Prv^[X]; If X>=Bpp Then C:=Prv^[X-Bpp] Else C:=0;
    Case Fl Of
     0: V:=Cur^[X];
     1: V:=Cur^[X]+A;
     2: V:=Cur^[X]+B;
     3: V:=Cur^[X]+(A+B) Div 2;
     4: Begin
      Pp:=A+B-C; Pa:=Abs(Pp-A); Pb:=Abs(Pp-B); Pc:=Abs(Pp-C);
      If (Pa<=Pb) And (Pa<=Pc) Then V:=Cur^[X]+A Else If Pb<=Pc Then V:=Cur^[X]+B Else V:=Cur^[X]+C;
     End;
     Else Begin V:=0; Fail('png: filtre invalide.'); End;
    End;
    Cur^[X]:=V And 255;
   End;
   Move(Cur^,Prv^,Np);
   For X:=0 To Pw-1 Do Begin
    If Il=0 Then Begin Ox:=X; Oy:=Y; End Else Begin Ox:=PX0[Ps]+X*PDX[Ps]; Oy:=PY0[Ps]+Y*PDY[Ps]; End;
    I:=Oy*W+Ox;
    Case Ct Of
     0,3: Img^[I]:=Smp(Cur,X);
     4: Img^[I]:=Cur^[X*2];
     2: Begin Img^[I*3]:=Cur^[X*3]; Img^[I*3+1]:=Cur^[X*3+1]; Img^[I*3+2]:=Cur^[X*3+2]; End;
     Else Begin Img^[I*4]:=Cur^[X*4+2]; Img^[I*4+1]:=Cur^[X*4+1]; Img^[I*4+2]:=Cur^[X*4]; Img^[I*4+3]:=Cur^[X*4+3]; End;
    End;
   End;
   Inc(Rp,Np+1);
  End;
 End;
 { gris < 8 bits : mise a l'echelle 0..max vers 0..255 }
 If (Ct=0) And (Bd<8) Then
  For I:=0 To W*H-1 Do Img^[I]:=Img^[I]*(255 Div ((1 Shl Bd)-1));
 NVEmit(Img);
 FreeMem(Prv,RowB+64); FreeMem(Img,W*H*NVBpp(Fmt)+64); FreeMem(Raw,Total+64); FreeMem(F,Size+64);
 NVFinish('png');
End;

Procedure DecodeNV2(Kind: LongInt; Const Source,Target: String; Mode: LongInt);
Begin
 If Kind=55 Then Begin DecodePCX(Source,Target,Mode); Exit; End;
 If Kind=66 Then Begin DecodeRL2(Source,Target,Mode); Exit; End;
 If Kind=67 Then Begin DecodeSMK(Source,Target,Mode); Exit; End;
 If Kind=68 Then Begin DecodeRV(Source,Target,Mode); Exit; End;
 If Kind=65 Then Begin DecodeRoQ(Source,Target,Mode); Exit; End;
 If Kind=64 Then Begin DecodeRawQX(Source,Target,Mode); Exit; End;
 If Kind=63 Then Begin DecodeQPEG(Source,Target,Mode); Exit; End;
 If Kind=62 Then Begin DecodeQDRAW(Source,Target,Mode); Exit; End;
 If Kind=60 Then Begin DecodeRPZA(Source,Target,Mode); Exit; End;
 If Kind=61 Then Begin DecodeSMC(Source,Target,Mode); Exit; End;
 If Kind=59 Then Begin DecodeQTRLE(Source,Target,Mode); Exit; End;
 If Kind=58 Then Begin DecodePNG(Source,Target,Mode); Exit; End;
 If Kind=56 Then Begin DecodeSGI(Source,Target,Mode); Exit; End;
 If Kind=57 Then Begin DecodePTX(Source,Target,Mode); Exit; End;
 If Kind=54 Then Begin DecodeNUV(Source,Target,Mode); Exit; End;
 If (Kind>=51) And (Kind<=53) Then Begin DecodeMsAVI(Source,Target,Mode,Kind-49); Exit; End;
 If Kind=50 Then Begin PnmYuvFlag:=InputFormat='pgmyuv'; DecodePNM(Source,Target,Mode); Exit; End;
 If Kind=12 Then DecodeCAVS(Source,Target,Mode)
 Else If Kind=13 Then DecodeDV(Source,Target,Mode,False)
 Else If Kind=15 Then DecodeDSICin(Source,Target,Mode)
 Else If Kind=16 Then DecodeDXA(Source,Target,Mode) Else If Kind=17 Then DecodeEAVideo(Source,Target,Mode)
 Else If Kind=14 Then DecodeDV(Source,Target,Mode,True)
 Else If Kind=10 Then DecodeDNxHD(Source,Target,Mode,False)
 Else If Kind=11 Then DecodeDNxHD(Source,Target,Mode,True)
 Else If Kind=19 Then DecodeRPL(Source,Target,Mode)
 Else If Kind=22 Then DecodeFLVScreen(Source,Target,Mode)
 Else If Kind=23 Then DecodeFLIC(Source,Target,Mode)
 Else If Kind=30 Then DecodeIdcin(Source,Target,Mode)
 Else If Kind=38 Then DecodeMVE(Source,Target,Mode)
 Else If Kind=39 Then DecodeJLS(Source,Target,Mode)
 Else If Kind=44 Then DecodeSTRVideo(Source,Target,Mode)
 Else If Kind=45 Then DecodeMSNWC(Source,Target,Mode)
 Else If Kind=46 Then DecodeMJP(Source,Target,Mode)
 Else If Kind=48 Then DecodeMM(Source,Target,Mode)
 Else If Kind=49 Then DecodeMVI(Source,Target,Mode)
 Else If Kind=47 Then DecodeMJPB(Source,Target,Mode)
 Else If Kind=33 Then DecodeH264Raw(Source,Target,Mode)
 Else If Kind=34 Then DecodeH264Mp4(Source,Target,Mode)
 Else If Kind=35 Then DecodeH264Avi(Source,Target,Mode)
 Else If Kind=36 Then DecodeH264Flv(Source,Target,Mode)
 Else If Kind=25 Then DecodeGIF(Source,Target,Mode)
 Else If Kind=27 Then DecodeFLVH263(Source,Target,Mode)
 Else If Kind=28 Then DecodeH263Raw(Source,Target,Mode)
 Else If Kind=29 Then DecodeH261Raw(Source,Target,Mode)
 Else If ((Kind>=18) And (Kind<=24)) Or (Kind=26) Or (Kind=31) Or (Kind=32) Or (Kind=37) Or ((Kind>=40) And (Kind<=43)) Then DecodeAVIX(Source,Target,Mode,Kind)
 Else If Kind>=7 Then DecodeAVIVideo(Source,Target,Mode,Kind) Else DecodeNV(Kind,Source,Target,Mode);
End;

{ ---- VC3/DNxHD: encodeur (libavcodec/dnxhdenc.c), progressif, qscale global ajuste a la taille de trame ---- }
Type
 TDEBlk=Array[0..63] Of LongInt;
 TDEShort=Array[0..200000000] Of SmallInt; PDEShort=^TDEShort;
Var
 DECo: PDEShort; DEOut: PEABuffer; DEAcc: Int64; DEAccN,DEOutPos,DETotal: LongInt; DEWrite: Boolean;
 DEVCode: Array[0..4096,0..1] Of LongInt; DEVBits: Array[0..4096,0..1] Of Byte;
 DERunCode: Array[0..63] Of LongInt; DERunBits: Array[0..63] Of Byte;
 DEMaxA,DESh,DEBias,DELast0,DELast1,DELast2: LongInt;

Procedure DEPut(N: LongInt; V: Int64);
Begin
 Inc(DETotal,N);
 If Not DEWrite Then Exit;
 DEAcc:=(DEAcc Shl N) Or (V And ((Int64(1) Shl N)-1)); Inc(DEAccN,N);
 While DEAccN>=8 Do Begin
  Dec(DEAccN,8); DEOut^[DEOutPos]:=(DEAcc Shr DEAccN) And 255; Inc(DEOutPos);
 End;
 DEAcc:=DEAcc And ((Int64(1) Shl DEAccN)-1);
End;

Procedure DEFdct(Var D: TDEBlk);
Const F0541=4433; F0765=6270; F1847=15137; F1175=9633; F0298=2446; F2053=16819; F3072=25172; F1501=12299;
 F0899=7373; F2562=20995; F1961=16069; F0390=3196;
Var
 I: Integer; T0,T1,T2,T3,T4,T5,T6,T7,T10,T11,T12,T13,Z1,Z2,Z3,Z4,Z5: Int64;
Function Ds(X: Int64; N: Integer): Int64;
Begin Ds:=AVSar(X+(Int64(1) Shl (N-1)),N); End;
Begin
 For I:=0 To 7 Do Begin
  T0:=D[I*8]+D[I*8+7]; T7:=D[I*8]-D[I*8+7]; T1:=D[I*8+1]+D[I*8+6]; T6:=D[I*8+1]-D[I*8+6];
  T2:=D[I*8+2]+D[I*8+5]; T5:=D[I*8+2]-D[I*8+5]; T3:=D[I*8+3]+D[I*8+4]; T4:=D[I*8+3]-D[I*8+4];
  T10:=T0+T3; T13:=T0-T3; T11:=T1+T2; T12:=T1-T2;
  D[I*8]:=(T10+T11)*16; D[I*8+4]:=(T10-T11)*16;
  Z1:=(T12+T13)*F0541;
  D[I*8+2]:=Ds(Z1+T13*F0765,9); D[I*8+6]:=Ds(Z1+T12*(-F1847),9);
  Z1:=T4+T7; Z2:=T5+T6; Z3:=T4+T6; Z4:=T5+T7; Z5:=(Z3+Z4)*F1175;
  T4:=T4*F0298; T5:=T5*F2053; T6:=T6*F3072; T7:=T7*F1501;
  Z1:=Z1*(-F0899); Z2:=Z2*(-F2562); Z3:=Z3*(-F1961); Z4:=Z4*(-F0390);
  Inc(Z3,Z5); Inc(Z4,Z5);
  D[I*8+7]:=Ds(T4+Z1+Z3,9); D[I*8+5]:=Ds(T5+Z2+Z4,9); D[I*8+3]:=Ds(T6+Z2+Z3,9); D[I*8+1]:=Ds(T7+Z1+Z4,9);
 End;
 For I:=0 To 7 Do Begin
  T0:=D[I]+D[56+I]; T7:=D[I]-D[56+I]; T1:=D[8+I]+D[48+I]; T6:=D[8+I]-D[48+I];
  T2:=D[16+I]+D[40+I]; T5:=D[16+I]-D[40+I]; T3:=D[24+I]+D[32+I]; T4:=D[24+I]-D[32+I];
  T10:=T0+T3; T13:=T0-T3; T11:=T1+T2; T12:=T1-T2;
  D[I]:=Ds(T10+T11,4); D[32+I]:=Ds(T10-T11,4);
  Z1:=(T12+T13)*F0541;
  D[16+I]:=Ds(Z1+T13*F0765,17); D[48+I]:=Ds(Z1+T12*(-F1847),17);
  Z1:=T4+T7; Z2:=T5+T6; Z3:=T4+T6; Z4:=T5+T7; Z5:=(Z3+Z4)*F1175;
  T4:=T4*F0298; T5:=T5*F2053; T6:=T6*F3072; T7:=T7*F1501;
  Z1:=Z1*(-F0899); Z2:=Z2*(-F2562); Z3:=Z3*(-F1961); Z4:=Z4*(-F0390);
  Inc(Z3,Z5); Inc(Z4,Z5);
  D[56+I]:=Ds(T4+Z1+Z3,17); D[40+I]:=Ds(T5+Z2+Z4,17); D[24+I]:=Ds(T6+Z2+Z3,17); D[8+I]:=Ds(T7+Z1+Z4,17);
 End;
End;

{ Tables VLC niveau/course selon dnxhd_init_vlc }
Procedure DEBuildVlc(Bd: LongInt);
Var A,R,Off,AL,J,K,Best: LongInt;
Begin
 DEMaxA:=64*((1 Shl DXIndexBits)-1)+64;
 If DEMaxA>(1 Shl (Bd+2))-1 Then DEMaxA:=(1 Shl (Bd+2))-1;
 If DEMaxA>4096 Then DEMaxA:=4096;
 For A:=1 To DEMaxA Do For R:=0 To 1 Do Begin
  Off:=0; AL:=A;
  If AL>64 Then Begin Off:=(AL-1) Shr 6; AL:=AL-(Off Shl 6); End;
  Best:=-1;
  For J:=0 To 256 Do
   If (DXAcInfo[2*J] Shr 1=AL) And (((DXAcInfo[2*J+1] And 1)<>0)=(Off<>0)) And (((DXAcInfo[2*J+1] And 2)<>0)=(R=1)) Then Begin Best:=J; Break; End;
  If Best<0 Then
   For J:=0 To 256 Do
    If (DXAcInfo[2*J] Shr 1=AL) And ((Off=0) Or ((DXAcInfo[2*J+1] And 1)<>0)) And ((R=0) Or ((DXAcInfo[2*J+1] And 2)<>0)) Then Begin Best:=J; Break; End;
  If Best<0 Then Begin DEVBits[A,R]:=0; Continue; End;
  DEVCode[A,R]:=(DXAcCodes[Best] Shl 1);
  DEVBits[A,R]:=DXAcBits[Best]+1;
  If Off<>0 Then DEVBits[A,R]:=DEVBits[A,R]+DXIndexBits;
 End;
 FillChar(DERunBits,SizeOf(DERunBits),0);
 For K:=0 To 61 Do Begin DERunCode[DXRun[K]]:=DXRunCodes[K]; DERunBits[DXRun[K]]:=DXRunBits[K]; End;
 { memorise Best pour reconstruire le code avec decalage d'index: on recalcule a l'ecriture }
End;

Procedure DEPutLevel(A,R,Sg: LongInt);
Var Off,AL,Code: LongInt;
Begin
 Off:=0; AL:=A;
 If AL>64 Then Begin Off:=(AL-1) Shr 6; AL:=AL-(Off Shl 6); End;
 Code:=DEVCode[A,R] Or Sg;
 If Off<>0 Then Begin Code:=(Code Shl DXIndexBits) Or Off; End;
 DEPut(DEVBits[A,R],Code);
End;

Procedure DEPutDC(Diff: LongInt);
Var N,V,T: LongInt;
Begin
 If Diff<0 Then T:=-2*Diff Else T:=2*Diff;
 N:=0; While (T Shr (N+1))<>0 Do Inc(N);
 If T=0 Then N:=0;
 If Diff<0 Then Dec(Diff);
 If N>=DXNDc Then N:=DXNDc-1;
 V:=Diff And ((1 Shl N)-1);
 DEPut(DXDcBits[N]+N,(Int64(DXDcCodes[N]) Shl N)+V);
End;

{ Quantifie et (ou) ecrit un bloc. Retourne rien; DETotal s'incremente. }
Procedure DEBlock(Co: PDEShort; Qs,Comp: LongInt; Chroma: Boolean);
Var
 I,C,AC,W,Sc,Bs,X,A0,A,Best,R0,E,BestE,Last,Run,Rf,Sg,Diff,Cand: LongInt; Last0: ^LongInt;
Begin
 Case Comp Of 0: Last0:=@DELast0; 1: Last0:=@DELast1; Else Last0:=@DELast2; End;
 Diff:=Co^[0]-Last0^; Last0^:=Co^[0];
 DEPutDC(Diff);
 Last:=0;
 For I:=1 To 63 Do Begin
  C:=Co^[DXZig[I]];
  If C=0 Then Continue;
  If C<0 Then Begin AC:=-C; Sg:=1; End Else Begin AC:=C; Sg:=0; End;
  If Chroma Then W:=DXChroma[I] Else W:=DXLuma[I];
  Sc:=Qs*W;
  If (DEBias<32) Or (W<>DEBias) Then Bs:=DEBias Else Bs:=0;
  X:=(Int64(AC) Shl DESh) Div Sc;
  A0:=X Div 2;
  Best:=0; BestE:=AC;
  For Cand:=A0-1 To A0+1 Do Begin
   If Cand<1 Then Continue;
   A:=Cand; If A>DEMaxA Then A:=DEMaxA;
   R0:=((2*A+1)*Int64(Sc)+(Sc Shr 1)+Bs) Shr DESh;
   E:=Abs(R0-AC);
   If E<BestE Then Begin BestE:=E; Best:=A; End;
  End;
  If Best=0 Then Continue;
  Run:=I-Last-1; If Run>0 Then Rf:=1 Else Rf:=0;
  If DEVBits[Best,Rf]=0 Then Continue;
  DEPutLevel(Best,Rf,Sg);
  If Run>0 Then DEPut(DERunBits[Run],DERunCode[Run]);
  Last:=I;
 End;
 DEPut(DXAcBits[DXEob],DXAcCodes[DXEob]);
End;

Function DEClampX(V,Hi: LongInt): LongInt;
Begin If V<0 Then V:=0; If V>Hi Then V:=Hi; DEClampX:=V; End;

{ Encode un fichier Y4M en DNxHD/DNxHR. Profil: '' (DNxHD, debit en Mbit/s), dnxhr_lb/sq/hq/hqx/444. IsAvi: sortie AVI, sinon flux brut. }
Procedure EncodeDNxHD(Const Source,Target: String; IsAvi: Boolean; Const Profile: String; Mbps: LongInt);
Var
 H: Array[0..255] Of Byte;
 Limit,Cur,W,Hh,FN,FD,Frames,I,K,Q,Code,CW,Bd,Sub,Fmt,Cid,Idx,FrameSize,DataOff,Mw,Mh,Nb,Mx,My,N,Qs,Lo,Hi,Mid,OutPos,Fix,Used,Bp,CHh,Row,Bits,Avail,Total,Ofs,Lsb,Mode,Z,Dx,Dy,MbN,PQ,Hr,Is444: LongInt;
 Y,U,V,Pk,Hd: PEABuffer; Line,Token: String; Blk: TDEBlk; Sizes: PALLong; OutB: Array[0..255] Of Byte; Chroma420,Found: Boolean;
 RowBytes: Array[0..511] Of LongInt;
Procedure PutB(X: LongInt);Begin OutB[Used]:=X And 255; Inc(Used); Inc(OutPos); If Used>=250 Then Begin WriteBytes(OutB,Used); Used:=0; End; End;
Procedure PutL16(X: LongInt);Begin PutB(X); PutB(X Shr 8); End;
Procedure PutL32(X: LongInt);Begin PutL16(X); PutL16(X Shr 16); End;
Procedure PutTag(Const T: String);
Var Z2: Integer;
Begin For Z2:=1 To 4 Do PutB(Ord(T[Z2])); End;
Procedure Flush;Begin If Used>0 Then Begin WriteBytes(OutB,Used); Used:=0; End; End;
Procedure Patch32(At,Value: LongInt);
Var Z2: Integer; Code2: Integer; B4: Array[0..3] Of Byte;
Begin
 Flush;
 {$I-}Seek(ActiveOutput,At); Code2:=IOResult;{$I+}
 If Code2<>0 Then Fail('dnxhd: positionnement AVI impossible.');
 For Z2:=0 To 3 Do Begin B4[Z2]:=Value And 255; Value:=Value Shr 8; End;
 WriteBytes(B4,4);
End;
Function ReadLine: String;
Var R: String;
Begin
 R:='';
 While Cur<Limit Do Begin ReadAt(Cur,H,1); Inc(Cur); If H[0]=10 Then Break; If Length(R)<250 Then R:=R+Chr(H[0]); End;
 ReadLine:=R;
End;
Procedure ReadPlane(Plane: PEABuffer; At,Count: LongInt);
Var Nn: LongInt;
Begin
 Nn:=0;
 While Nn<Count Do Begin
  If Count-Nn>4096 Then Q:=4096 Else Q:=Count-Nn;
  ReadAt(At+Nn,Plane^[Nn],Q); Inc(Nn,Q);
 End;
End;
Function Sample(P: PEABuffer; Stride,PW,PH,X,Yy: LongInt): LongInt;
Var O: LongInt;
Begin
 X:=DEClampX(X,PW-1); Yy:=DEClampX(Yy,PH-1);
 If Bd=8 Then Sample:=P^[Yy*Stride+X]
 Else Begin O:=(Yy*Stride+X)*2; Sample:=P^[O]+P^[O+1]*256; End;
End;
{ Calcule les coefficients DCT d'un bloc 8x8 }
Procedure Load(Dest: LongInt; P: PEABuffer; Stride,PW,PH,X0,Y0: LongInt);
Var A,C: Integer;
Begin
 For A:=0 To 7 Do For C:=0 To 7 Do Blk[A*8+C]:=Sample(P,Stride,PW,PH,X0+C,Y0+A);
 DEFdct(Blk);
 For A:=0 To 63 Do DECo^[Dest*64+A]:=AVSar(Blk[A]+4,3);
End;
Procedure Put32(Pos,Vv: LongInt);
Begin Pk^[Pos]:=(Vv Shr 24) And 255; Pk^[Pos+1]:=(Vv Shr 16) And 255; Pk^[Pos+2]:=(Vv Shr 8) And 255; Pk^[Pos+3]:=Vv And 255; End;
Procedure Put16(Pos,Vv: LongInt);
Begin Pk^[Pos]:=(Vv Shr 8) And 255; Pk^[Pos+1]:=Vv And 255; End;
{ Un passage sur la trame: ecrit si DEWrite, retourne la taille totale des lignes en bits (alignees 32 bits) }
Function Pass(Qv: LongInt): LongInt;
Var Ry,Rx,Bn,Mbi,Bits0,Tot: LongInt; IsCh: Boolean; Cp: LongInt;
Begin
 Tot:=0;
 For Ry:=0 To Mh-1 Do Begin
  If DEWrite Then Begin DEAcc:=0; DEAccN:=0; DEOutPos:=DataOff+Tot Div 8; End;
  DETotal:=0;
  DELast0:=1 Shl (Bd+2); DELast1:=DELast0; DELast2:=DELast0;
  For Rx:=0 To Mw-1 Do Begin
   Mbi:=Ry*Mw+Rx;
   DEPut(11,Qv); DEPut(1,Ord(Is444<>0));
   For Bn:=0 To Nb-1 Do Begin
    If Is444=0 Then Begin If (Bn And 2)<>0 Then Begin Cp:=1+(Bn And 1); IsCh:=True; End Else Begin Cp:=0; IsCh:=False; End; End
    Else Begin Cp:=(Bn Shr 1) Mod 3; IsCh:=Cp<>0; End;
    DEBlock(@DECo^[(Mbi*Nb+Bn)*64],Qv,Cp,IsCh);
   End;
  End;
  Bits0:=(32-(DETotal And 31)) And 31;
  If Bits0<>0 Then DEPut(Bits0,0);
  RowBytes[Ry]:=DETotal Div 8;
  Tot:=Tot+DETotal;
 End;
 Pass:=Tot;
End;
Begin
 OpenRead(Source); Limit:=InputSize; Cur:=0;
 Line:=ReadLine;
 If Copy(Line,1,9)<>'YUV4MPEG2' Then Fail('dnxhd: entree Y4M requise.');
 W:=0; Hh:=0; FN:=25; FD:=1; Bd:=8; Sub:=2; Chroma420:=False;
 Line:=Copy(Line,11,255);
 While Line<>'' Do Begin
  K:=Pos(' ',Line); If K=0 Then K:=Length(Line)+1;
  Token:=Copy(Line,1,K-1); Line:=Copy(Line,K+1,255);
  If Token='' Then Continue;
  Case Token[1] Of
   'W': Val(Copy(Token,2,20),W,Code);
   'H': Val(Copy(Token,2,20),Hh,Code);
   'F': Begin K:=Pos(':',Token); If K>0 Then Begin Val(Copy(Token,2,K-2),FN,Code); Val(Copy(Token,K+1,20),FD,Code); End; End;
   'C': Begin
         If (Token='C422') Then Begin Bd:=8; Sub:=2; End
         Else If Token='C422p10' Then Begin Bd:=10; Sub:=2; End
         Else If Token='C444p10' Then Begin Bd:=10; Sub:=1; End
         Else If (Token='C420') Or (Token='C420jpeg') Or (Token='C420mpeg2') Or (Token='C420paldv') Then Begin Bd:=8; Sub:=2; Chroma420:=True; End
         Else Fail('dnxhd: Y4M 4:2:0, 4:2:2 ou 4:4:4 requis (8 bits, ou 10 bits en 4:2:2/4:4:4).');
        End;
   'I': If Token<>'Ip' Then Fail('dnxhd: video progressive requise (entrelace non pris en charge).');
  End;
 End;
 If (W<256) Or (Hh<120) Or (W>8192) Or (Hh>4320) Then Fail('dnxhd: dimensions minimales 256x120.');
 If (FN<=0) Or (FD<=0) Then Begin FN:=25; FD:=1; End;
 If Bd=8 Then Bp:=1 Else Bp:=2;
 If Sub=1 Then CW:=W Else CW:=(W+1) Div 2;
 CHh:=Hh;
 Is444:=0; Cid:=0;
 If Profile='' Then Begin
  { DNxHD: recherche de cid par taille / profondeur / debit }
  If Sub=1 Then Fail('dnxhd: 4:4:4 exige -profile:v dnxhr_444.');
  Found:=False;
  For Idx:=0 To 14 Do Begin
   DXSelectCid(Idx);
   If (DXW=W) And (DXH=Hh) And ((DXFlags And 5)=0) And (DXTabDepth=Bd) Then
    For K:=0 To 4 Do If (DXRates[K]=Mbps) And (Mbps>0) Then Begin Found:=True; Cid:=DXCid; End;
   If Found Then Break;
  End;
  If Not Found Then Fail('dnxhd: profil DNxHD introuvable pour ces dimensions/debit (-b:v en Mbit/s entier, ex. 36M, 120M, 185M, et yuv422p ou yuv422p10 adapte).');
 End Else Begin
  If Profile='dnxhr_444' Then Cid:=1270 Else If Profile='dnxhr_hqx' Then Cid:=1271 Else If Profile='dnxhr_hq' Then Cid:=1272
  Else If Profile='dnxhr_sq' Then Cid:=1273 Else If Profile='dnxhr_lb' Then Cid:=1274
  Else Fail('dnxhd: profil inconnu: '+Profile);
  If Cid=1270 Then Begin If (Sub<>1) Or (Bd<>10) Then Fail('dnxhd: dnxhr_444 exige yuv444p10.'); End
  Else If Cid=1271 Then Begin If (Sub<>2) Or (Bd<>10) Then Fail('dnxhd: dnxhr_hqx exige yuv422p10.'); End
  Else If (Sub<>2) Or (Bd<>8) Then Fail('dnxhd: dnxhr_lb/sq/hq exigent yuv422p (8 bits).');
 End;
 If (Cid=1270) Then Is444:=1;
 Idx:=DXFindCid(Cid); DXSelectCid(Idx); DXCurIdx:=-1;
 Mw:=(W+15) Div 16; Mh:=(Hh+15) Div 16;
 If DXFrameSize>0 Then Begin FrameSize:=DXFrameSize; End Else Begin
  FrameSize:=((Int64(Mh)*Mw*DXPSN Div DXPSD)+2048) Div 4096*4096;
  If FrameSize<8192 Then FrameSize:=8192;
 End;
 If Mh>68 Then DataOff:=$170+(Mh Shl 2) Else DataOff:=$280;
 If Mh>256 Then Fail('dnxhd: hauteur trop grande.');
 If Is444<>0 Then Nb:=12 Else Nb:=8;
 If Is444<>0 Then Mode:=2 Else If Bd=8 Then Mode:=0 Else If Cid=1271 Then Mode:=2 Else Mode:=1;
 If Mode=1 Then Begin DEBias:=8; DESh:=4; End Else Begin DEBias:=32; DESh:=6; End;
 DEBuildVlc(Bd);
 Avail:=(FrameSize-DataOff-4)*8;
 GetMem(Y,W*Hh*Bp+64); GetMem(U,CW*CHh*Bp+64); GetMem(V,CW*CHh*Bp+64);
 GetMem(Pk,FrameSize+64); GetMem(Sizes,1048576*4);
 GetMem(DECo,Int64(Mw)*Mh*Nb*128+64);
 DEOut:=Pk;
 Frames:=0; OutPos:=0; Used:=0;
 OpenWrite(Target);
 If IsAvi Then Begin
  PutTag('RIFF'); PutL32(0); PutTag('AVI '); PutTag('LIST'); PutL32(192); PutTag('hdrl');
  PutTag('avih'); PutL32(56); PutL32(Round(1000000.0*FD/FN)); PutL32(0); PutL32(0); PutL32($10); PutL32(0); PutL32(0); PutL32(1);
  PutL32(FrameSize); PutL32(W); PutL32(Hh); PutL32(0); PutL32(0); PutL32(0); PutL32(0);
  PutTag('LIST'); PutL32(116); PutTag('strl');
  PutTag('strh'); PutL32(56); PutTag('vids'); If Cid>=1270 Then PutTag('AVdh') Else PutTag('AVdn');
  PutL32(0); PutL16(0); PutL16(0); PutL32(0); PutL32(FD); PutL32(FN); PutL32(0); PutL32(0); PutL32(FrameSize); PutL32(-1); PutL32(0);
  PutL16(0); PutL16(0); PutL16(W); PutL16(Hh);
  PutTag('strf'); PutL32(40); PutL32(40); PutL32(W); PutL32(Hh); PutL16(1); PutL16(24);
  If Cid>=1270 Then PutTag('AVdh') Else PutTag('AVdn');
  PutL32(FrameSize); PutL32(0); PutL32(0); PutL32(0); PutL32(0);
  PutTag('LIST'); PutL32(0); PutTag('movi'); Flush;
 End;
 While Cur<Limit Do Begin
  Line:=ReadLine;
  If Copy(Line,1,5)<>'FRAME' Then Fail('dnxhd: marqueur FRAME requis.');
  If Chroma420 Then Begin
   Z:=W*Hh+2*((W+1) Div 2)*((Hh+1) Div 2);
   If Z>Limit-Cur Then Break;
   ReadPlane(Y,Cur,W*Hh);
   { chroma 4:2:0 -> 4:2:2 par interpolation verticale 3:1 }
   GetMem(Hd,CW*((Hh+1) Div 2)+64);
   For K:=0 To 1 Do Begin
    ReadPlane(Hd,Cur+W*Hh+K*CW*((Hh+1) Div 2),CW*((Hh+1) Div 2));
    For Row:=0 To Hh-1 Do Begin
     Dx:=Row Div 2; If (Row And 1)=0 Then Dy:=Dx-1 Else Dy:=Dx+1;
     If Dy<0 Then Dy:=0; If Dy>(Hh+1) Div 2-1 Then Dy:=(Hh+1) Div 2-1;
     For I:=0 To CW-1 Do Begin
      Z:=(3*Hd^[Dx*CW+I]+Hd^[Dy*CW+I]+2) Shr 2;
      If K=0 Then U^[Row*CW+I]:=Z Else V^[Row*CW+I]:=Z;
