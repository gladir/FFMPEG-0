    Gv:=Yv Shl 7; If Gv>30189 Then Gv:=30189;
    Gv:=Sar(Gv*19077-39057361,14); Gv:=Sar(Gv+64,7); If Gv<0 Then Gv:=0; If Gv>255 Then Gv:=255;
