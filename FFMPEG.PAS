 For I:=0 To 2 Do Begin
  If I=0 Then FillChar(MDPl[I]^,MDStr[0]*MDMbh*16+64,0) Else FillChar(MDPl[I]^,MDStr[I]*MDMbh*8+64,0);
 End;
End;
