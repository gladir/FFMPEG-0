Type TRA144=Record
  OldEnergy: Int64; LpcTab: Array[0..1,0..9] Of LongInt; Cur: LongInt; LpcRefl: Array[0..1] Of Int64;
  CurSb: Array[0..49] Of LongInt; Adapt: Array[0..147] Of LongInt; BufA: Array[0..39] Of LongInt;
 End;
Var RA: TRA144;

Function RAWrap(X: Int64): LongInt;
Begin X:=X And $FFFFFFFF; If X>=$80000000 Then X:=X-$100000000; RAWrap:=X; End;
Function RASar(V: Int64; N: LongInt): Int64;
Begin If V>=0 Then RASar:=V Shr N Else RASar:=-(((-V)+(Int64(1) Shl N)-1) Shr N); End;
Function RAClip16(V: Int64): LongInt;
Begin If V>32767 Then RAClip16:=32767 Else If V<-32768 Then RAClip16:=-32768 Else RAClip16:=V; End;
Function RAS16(V: Int64): LongInt;
Begin V:=V And $FFFF; If V>=$8000 Then V:=V-$10000; RAS16:=V; End;
Function RAISqrt(X: Int64): Int64;
Var R: Int64;
Begin R:=Trunc(Sqrt(X)); While R*R>X Do Dec(R); While (R+1)*(R+1)<=X Do Inc(R); RAISqrt:=R; End;
Function RATSqrt(X: Int64): Int64;
Var S: LongInt;
Begin S:=2; X:=X And $FFFFFFFF; While X>$FFF Do Begin Inc(S); X:=X Shr 2; End; RATSqrt:=RAWrap(RAISqrt(X Shl 20) Shl S); End;
Function RARms(Const D: Array Of LongInt): Int64;
Var I,B: LongInt; Res: Int64;
Begin
 Res:=$10000; B:=10;
 For I:=0 To 9 Do Begin
  Res:=((RASar(RAWrap($1000000-Int64(D[I])*D[I]),12)*Res) And $FFFFFFFF) Shr 12;
  If Res=0 Then Begin RARms:=0; Exit; End;
  While Res<=$3FFF Do Begin Inc(B); Res:=(Res Shl 2) And $FFFFFFFF; End;
 End;
 RARms:=(RATSqrt(Res) And $FFFFFFFF) Shr B;
End;
Function RARescale(Rms,Energy: Int64): Int64;
Begin RARescale:=((Rms*Energy) And $FFFFFFFF) Shr 10; End;
Procedure RAEvalCoefs(Var Coefs: Array Of LongInt; Const Refl: Array Of LongInt);
Var B1,B2: Array[0..9] Of LongInt; I,J: LongInt; Flip: Boolean;
Begin
 FillChar(B1,SizeOf(B1),0); FillChar(B2,SizeOf(B2),0);
 { b1 = buffer, b2 = coefs ; echange a chaque iteration }
 Flip:=False;
 For I:=0 To 9 Do Begin
  If Not Flip Then Begin
   B1[I]:=Refl[I]*16;
   For J:=0 To I-1 Do B1[J]:=RAWrap(RASar(RAWrap(Int64(Refl[I])*B2[I-J-1]),12)+B2[J]);
  End Else Begin
   B2[I]:=Refl[I]*16;
   For J:=0 To I-1 Do B2[J]:=RAWrap(RASar(RAWrap(Int64(Refl[I])*B1[I-J-1]),12)+B1[J]);
  End;
  Flip:=Not Flip;
 End;
 { apres 10 echanges la sortie est dans b2 (= coefs) quand Flip est faux }
 For I:=0 To 9 Do Begin
  If Flip Then Coefs[I]:=B1[I] Else Coefs[I]:=B2[I];
  Coefs[I]:=RAWrap(RASar(Coefs[I],4));
 End;
End;
