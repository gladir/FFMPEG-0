Const
 DXZig: Array[0..63] Of Byte=(0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,12,19,26,33,40,48,41,34,27,20,13,6,7,14,21,28,35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,58,59,52,45,38,31,39,46,53,60,61,54,47,55,62,63);
Type
 TDXRow=Record
  Blocks: Array[0..11] Of TAMVBlock;
  LumaScale,ChromaScale: Array[0..63] Of LongInt;
  LastDC: Array[0..2] Of LongInt; LastQ: LongInt; Errors: LongInt;
 End;
Var
 DXAcLut,DXRunLut: Array[0..65535] Of SmallInt; DXAcLen,DXRunLen: Array[0..65535] Of Byte;
 DXDcLut: Array[0..65535] Of SmallInt; DXDcLen: Array[0..65535] Of Byte;
 DXAcMax,DXRunMax,DXDcMax: LongInt; DXCurIdx: LongInt;
 DXBuf: PEABuffer; DXBufLen,DXBitPos: LongInt;
