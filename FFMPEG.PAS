Type
 TAMVHuff=Record
  Min,Max,Ptr: Array[1..16] Of LongInt; Vals: Array[0..255] Of Byte;
 End;
 TAMVBlock=Array[0..63] Of SmallInt;
Var
 AVH: Array[0..3] Of TAMVHuff;
 AVBuf: PEABuffer; AVPos,AVEnd: LongInt; AVBitBuf,AVBitCnt: Integer;
