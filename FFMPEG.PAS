 BY:=0;
 While BY<198 Do Begin
  BX:=0; BitAt:=0;
  While BX<318 Do Begin
   Changed:=True;
   If SubType<>0 Then Begin
    V:=EAByte(P,Size,MapAt+(BitAt Shr 3)); Changed:=((V Shr (7-(BitAt And 7))) And 1)<>0; Inc(BitAt);
   End;
