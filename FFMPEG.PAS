Function IMCS(X: Double): Single; Begin IMCS:=X; End;

Procedure IMCLoadFloats(Const Src; N: LongInt; Var Dst);
Begin Move(Src,Dst,N*4); End;

Function IMCSplitPerm(I,Len,Inv: LongInt): LongInt;
Begin
 Len:=Len Shr 1;
 If Len<=1 Then Begin IMCSplitPerm:=I And 1; Exit; End;
 If (I And Len)=0 Then Begin IMCSplitPerm:=IMCSplitPerm(I,Len,Inv)*2; Exit; End;
 Len:=Len Shr 1;
 If (I And Len)=0 Then IMCSplitPerm:=IMCSplitPerm(I,Len,Inv)*4+1-2*(1 Xor Inv)
 Else IMCSplitPerm:=IMCSplitPerm(I,Len,Inv)*4+1-2*(0 Xor Inv);
End;

Procedure IMCInit;
Var I,J,K,L: LongInt; Freq,Alpha,Sc,Dv: Double; Cd: LongWord; Sg: Single;
Begin
 If IMCReady Then Exit;
 SetMXCSR(GetMXCSR Or $1F80);
 IMCLoadFloats(IMCW1Bits,31,IMCW1); IMCLoadFloats(IMCW2Bits,31,IMCW2);
 IMCLoadFloats(IMCQ1Bits,32,IMCQ1); IMCLoadFloats(IMCQ2Bits,112,IMCQ2);
 Move(IMCExp2Bits,IMCExp2T,SizeOf(IMCExp2T)); Move(IMCPow2Bits,IMCPow2T,SizeOf(IMCPow2T)); Move(IMCPowfBits,IMCPowfT,SizeOf(IMCPowfT));
 IMCLoadFloats(IMCXTabBits,14,IMCXTab); IMCLoadFloats(IMCExpBits,32,IMCExp);
 { fenetre sinus normalisee par sqrt(2) }
 For I:=0 To 255 Do Begin
  Move(IMCWinBits[I],IMCWin[I],4);
 End;
 For I:=0 To 29 Do IMCSqrt[I]:=Sqrt(I);
 { tables de cosinus du FFT split-radix }
 For L:=3 To 7 Do Begin
  K:=1 Shl L; Freq:=2*IMCPi/K;
  For I:=0 To K Div 4-1 Do Begin Dv:=Cos(I*Freq); IMCTab[L,I]:=Dv; End;
  IMCTab[L,K Div 4]:=0;
 End;
 { permutation du FFT 128 (inverse) et twiddles du MDCT }
 For I:=0 To 127 Do IMCMap[I]:=(-IMCSplitPerm(I,128,1)) And 127;
 Sc:=Sqrt(Abs(IMCD(1.0/16384)));
 For I:=0 To 127 Do Begin
  Alpha:=(IMCPi/2)*(I+0.125)/128;
  Dv:=Cos(Alpha); Dv:=Dv*Sc; IMCExpRe[128+I]:=Dv; Dv:=Sin(Alpha); Dv:=Dv*Sc; IMCExpIm[128+I]:=Dv;
 End;
 For I:=0 To 127 Do Begin IMCExpRe[I]:=IMCExpRe[128+IMCMap[I]]; IMCExpIm[I]:=IMCExpIm[128+IMCMap[I]]; End;
 For I:=0 To 127 Do IMCMap[I]:=IMCMap[I] Shl 1;
 { codes de Huffman canoniques : code += 2^(32-len) dans l'ordre des tables }
 For I:=0 To 3 Do For J:=0 To 3 Do Begin
  Cd:=0;
  For K:=0 To IMCHuffSizes[I]-1 Do Begin
   IMCCodes[I,J,K]:=Cd;
   Cd:=Cd+(LongWord(1) Shl (32-IMCHuffLens[I,J,K]));
  End;
 End;
 IMCReady:=True;
End;

{ ---- lecture de bits (flux deja permute par mots de 16 bits) ---- }
Function IMCGetBits(N: LongInt): LongInt;
Var V,I,B: LongInt;
Begin
 V:=0;
 For I:=1 To N Do Begin
  If IMCPos<512 Then B:=(IMCBuf[IMCPos Shr 3] Shr (7-(IMCPos And 7))) And 1 Else B:=0;
  V:=V*2+B; Inc(IMCPos);
 End;
 IMCGetBits:=V;
End;
Function IMCGetVlc(S,T: LongInt): LongInt;
Var Peek: LongWord; I,B,L: LongInt;
Begin
 Peek:=0;
 For I:=0 To 31 Do Begin
  If IMCPos+I<512 Then B:=(IMCBuf[(IMCPos+I) Shr 3] Shr (7-((IMCPos+I) And 7))) And 1 Else B:=0;
  Peek:=Peek*2+LongWord(B);
 End;
 For I:=0 To IMCHuffSizes[S]-1 Do Begin
  L:=IMCHuffLens[S,T,I];
  If (Peek Shr (32-L))=(IMCCodes[S,T,I] Shr (32-L)) Then Begin
   Inc(IMCPos,L); IMCGetVlc:=IMCHuffSyms[S,T,I]; Exit;
  End;
 End;
 IMCGetVlc:=0; Inc(IMCPos,1);
End;

{ ---- MDCT inverse : FFT split-radix en place et rotations (libavutil/tx_template.c, versions C) ---- }
Procedure IMCButterflies(A0,A1,A2,A3: LongInt; T1,T2,T5,T6: Single);
Var R0,I0,R1,I1,T3,T4: Single;
Begin
 R0:=IMCZr[A0]; I0:=IMCZi[A0]; R1:=IMCZr[A1]; I1:=IMCZi[A1];
 T3:=T5-T1; T5:=T5+T1;
 IMCZr[A2]:=R0-T5; IMCZr[A0]:=R0+T5;
 IMCZi[A3]:=I1-T3; IMCZi[A1]:=I1+T3;
 T4:=T2-T6; T6:=T2+T6;
 IMCZr[A3]:=R1-T4; IMCZr[A1]:=R1+T4;
 IMCZi[A2]:=I0-T6; IMCZi[A0]:=I0+T6;
End;
Procedure IMCTransform(A0,A1,A2,A3: LongInt; Wre,Wim: Single);
Var T1,T2,T5,T6,Nw: Single;
Begin
 Nw:=-Wim;
 T1:=IMCZr[A2]*Wre-IMCZi[A2]*Nw;
 T2:=IMCZr[A2]*Nw+IMCZi[A2]*Wre;
 T5:=IMCZr[A3]*Wre-IMCZi[A3]*Wim;
 T6:=IMCZr[A3]*Wim+IMCZi[A3]*Wre;
 IMCButterflies(A0,A1,A2,A3,T1,T2,T5,T6);
End;
Procedure IMCFft2(B: LongInt);
Var Tr,Ti: Single;
Begin
 Tr:=IMCZr[B]-IMCZr[B+1]; IMCZr[B]:=IMCZr[B]+IMCZr[B+1];
 Ti:=IMCZi[B]-IMCZi[B+1]; IMCZi[B]:=IMCZi[B]+IMCZi[B+1];
 IMCZr[B+1]:=Tr; IMCZi[B+1]:=Ti;
End;
Procedure IMCFft4(B: LongInt);
Var T1,T2,T3,T4,T5,T6,T7,T8: Single;
Begin
 T3:=IMCZr[B]-IMCZr[B+1]; T1:=IMCZr[B]+IMCZr[B+1];
 T8:=IMCZr[B+3]-IMCZr[B+2]; T6:=IMCZr[B+3]+IMCZr[B+2];
 IMCZr[B+2]:=T1-T6; IMCZr[B]:=T1+T6;
 T4:=IMCZi[B]-IMCZi[B+1]; T2:=IMCZi[B]+IMCZi[B+1];
 T7:=IMCZi[B+2]-IMCZi[B+3]; T5:=IMCZi[B+2]+IMCZi[B+3];
 IMCZi[B+3]:=T4-T8; IMCZi[B+1]:=T4+T8;
 IMCZr[B+3]:=T3-T7; IMCZr[B+1]:=T3+T7;
 IMCZi[B+2]:=T2-T5; IMCZi[B]:=T2+T5;
End;
Procedure IMCFft8(B: LongInt);
Var T1,T2,T5,T6,Nr,Ni: Single;
Begin
 IMCFft4(B);
 Nr:=-IMCZr[B+5]; T1:=IMCZr[B+4]-Nr; IMCZr[B+5]:=IMCZr[B+4]+Nr;
 Ni:=-IMCZi[B+5]; T2:=IMCZi[B+4]-Ni; IMCZi[B+5]:=IMCZi[B+4]+Ni;
 Nr:=-IMCZr[B+7]; T5:=IMCZr[B+6]-Nr; IMCZr[B+7]:=IMCZr[B+6]+Nr;
 Ni:=-IMCZi[B+7]; T6:=IMCZi[B+6]-Ni; IMCZi[B+7]:=IMCZi[B+6]+Ni;
 IMCButterflies(B+0,B+2,B+4,B+6,T1,T2,T5,T6);
 IMCTransform(B+1,B+3,B+5,B+7,IMCTab[3,1],IMCTab[3,1]);
End;
Procedure IMCFft16(B: LongInt);
Var T1,T2,T5,T6,C1,C2,C3: Single;
Begin
 C1:=IMCTab[4,1]; C2:=IMCTab[4,2]; C3:=IMCTab[4,3];
 IMCFft8(B); IMCFft4(B+8); IMCFft4(B+12);
 T1:=IMCZr[B+8]; T2:=IMCZi[B+8]; T5:=IMCZr[B+12]; T6:=IMCZi[B+12];
 IMCButterflies(B+0,B+4,B+8,B+12,T1,T2,T5,T6);
 IMCTransform(B+2,B+6,B+10,B+14,C2,C2);
 IMCTransform(B+1,B+5,B+9,B+13,C1,C3);
 IMCTransform(B+3,B+7,B+11,B+15,C3,C1);
End;
Procedure IMCCombine(B,L,Len: LongInt);
Var O1,O2,O3,I,C,W: LongInt;
Begin
 O1:=2*Len; O2:=4*Len; O3:=6*Len;
 C:=0; W:=O1-7; I:=0;
 While I<Len Do Begin
  IMCTransform(B+0,B+O1+0,B+O2+0,B+O3+0,IMCTab[L,C+0],IMCTab[L,W+7]);
  IMCTransform(B+2,B+O1+2,B+O2+2,B+O3+2,IMCTab[L,C+2],IMCTab[L,W+5]);
  IMCTransform(B+4,B+O1+4,B+O2+4,B+O3+4,IMCTab[L,C+4],IMCTab[L,W+3]);
  IMCTransform(B+6,B+O1+6,B+O2+6,B+O3+6,IMCTab[L,C+6],IMCTab[L,W+1]);
  IMCTransform(B+1,B+O1+1,B+O2+1,B+O3+1,IMCTab[L,C+1],IMCTab[L,W+6]);
  IMCTransform(B+3,B+O1+3,B+O2+3,B+O3+3,IMCTab[L,C+3],IMCTab[L,W+4]);
  IMCTransform(B+5,B+O1+5,B+O2+5,B+O3+5,IMCTab[L,C+5],IMCTab[L,W+2]);
  IMCTransform(B+7,B+O1+7,B+O2+7,B+O3+7,IMCTab[L,C+7],IMCTab[L,W+0]);
  Inc(I,4); Inc(B,8); Inc(C,8); Dec(W,8);
 End;
End;
Procedure IMCFft(N,B,L: LongInt);
Begin
 Case N Of
  2: IMCFft2(B);
  4: IMCFft4(B);
  8: IMCFft8(B);
  16: IMCFft16(B);
 Else Begin
  IMCFft(N Div 2,B,L-1);
  IMCFft(N Div 4,B+N Div 2,L-2);
  IMCFft(N Div 4,B+(N Div 4)*3,L-2);
  IMCCombine(B,L,(N Div 4) Shr 1);
 End;
 End;
End;

{ MDCT inverse (demi-longueur) de 256 coefficients : Src -> IMCTempOut[0..255], echelle 1/16384 }
Procedure IMCMdct(Const Src: Array Of Single);
Var I,K,I0,I1: LongInt; Tr,Ti,S1r,S1i,S0r,S0i: Single;
Begin
 For I:=0 To 127 Do Begin
  K:=IMCMap[I];
  Tr:=Src[255-K]; Ti:=Src[K];
  IMCZr[I]:=Tr*IMCExpRe[I]-Ti*IMCExpIm[I];
  IMCZi[I]:=Tr*IMCExpIm[I]+Ti*IMCExpRe[I];
 End;
 IMCFft(128,0,7);
 For I:=0 To 63 Do Begin
  I0:=64+I; I1:=63-I;
  S1r:=IMCZi[I1]; S1i:=IMCZr[I1];
  S0r:=IMCZi[I0]; S0i:=IMCZr[I0];
  IMCZr[I1]:=S1r*IMCExpIm[128+I1]-S1i*IMCExpRe[128+I1];
  IMCZi[I0]:=S1r*IMCExpRe[128+I1]+S1i*IMCExpIm[128+I1];
  IMCZr[I0]:=S0r*IMCExpIm[128+I0]-S0i*IMCExpRe[128+I0];
  IMCZi[I1]:=S0r*IMCExpRe[128+I0]+S0i*IMCExpIm[128+I0];
 End;
 For I:=0 To 127 Do Begin IMCTempOut[2*I]:=IMCZr[I]; IMCTempOut[2*I+1]:=IMCZi[I]; End;
End;

{ ---- decodage d'un bloc IMC ---- }
Function IMCLog2f(X: Single): Single;
Var D: Extended;
Begin
 D:=X;
 If D<=0 Then Begin IMCLog2f:=-1E38; Exit; End;
 D:=Ln(D)/Ln(2.0);
 IMCLog2f:=D;
End;

Procedure IMCCalcCoeffs;
Var W1,W2,W3: TIMCSa; Snr,Accum,Sg: Single; I,C2: LongInt; Dv: Double;
Begin
 Snr:=1E-30; Accum:=0.0;
 For I:=0 To 31 Do Begin
  IMCFl5[I]:=0.0; W2[I]:=0.0;
  If IMCBandW[I]<>0 Then Begin
   W1[I]:=IMCFl1[I]*IMCFl1[I];
   Dv:=IMCFl2[I]; Dv:=2.0*Dv; IMCFl3[I]:=Dv;
  End Else Begin
   W1[I]:=0.0; IMCFl3[I]:=-30000.0;
  End;
  Sg:=IMCBandW[I]; Sg:=Sg*W1[I]; Dv:=Sg; Dv:=Dv*0.01; W3[I]:=Dv;
  If W3[I]<=Snr Then W3[I]:=0.0;
 End;
 For I:=0 To 31 Do Begin
  C2:=I;
  While C2<IMCCycl[I] Do Begin IMCFl5[C2]:=IMCFl5[C2]+W3[I]; Inc(C2); End;
  W2[C2-1]:=W2[C2-1]+W3[I];
 End;
 For I:=1 To 31 Do Begin
  Accum:=(W2[I-1]+Accum)*IMCW1[I-1];
  IMCFl5[I]:=IMCFl5[I]+Accum;
 End;
 For I:=0 To 31 Do W2[I]:=0.0;
 For I:=0 To 31 Do Begin
  C2:=I-1;
  While C2>IMCCycl2[I] Do Begin IMCFl5[C2]:=IMCFl5[C2]+W3[I]; Dec(C2); End;
  W2[C2+1]:=W2[C2+1]+W3[I];
 End;
 Accum:=0.0;
 For I:=30 DownTo 0 Do Begin
  Accum:=(W2[I+1]+Accum)*IMCW2[I];
  IMCFl5[I]:=IMCFl5[I]+Accum;
 End;
End;

Procedure IMCReadLevels(Sfc: LongInt);
Var I,S,Start: LongInt;
Begin
 S:=Sfc Shr 1; Start:=0;
 If (Sfc And 4)<>0 Then Start:=1;
 If Start<>0 Then IMCLevl[0]:=IMCGetBits(7);
 For I:=Start To 31 Do Begin
  IMCLevl[I]:=IMCGetVlc(S,IMCCbSel[S,I]);
  If IMCLevl[I]=17 Then Inc(IMCLevl[I],IMCGetBits(4));
 End;
End;
Procedure IMCReadLevelsRaw;
Var I: LongInt;
Begin
 IMCCoef0:=IMCGetBits(5);
 IMCLevl[0]:=IMCGetBits(7);
 For I:=1 To 31 Do IMCLevl[I]:=IMCGetBits(4);
End;

Procedure IMCDecLevels;
Var I,Level: LongInt; Tmp,Tmp2: Single; Dv: Double;
Begin
 Dv:=20000.0/IMCExp2T[IMCLevl[0] And 127]; IMCFl1[0]:=Dv;
 IMCFl2[0]:=IMCLog2f(IMCFl1[0]);
 Tmp:=IMCFl1[0]; Tmp2:=IMCFl2[0];
 For I:=1 To 31 Do Begin
  Level:=IMCLevl[I];
  If Level=16 Then Begin IMCFl1[I]:=1.0; IMCFl2[I]:=0.0; End
  Else Begin
   If Level<17 Then Dec(Level,7) Else If Level<=24 Then Dec(Level,32) Else Dec(Level,16);
   Tmp:=Tmp*IMCExp[15+Level];
   Dv:=Tmp2; Dv:=Dv+0.83048*Level; Tmp2:=Dv;
   IMCFl1[I]:=Tmp; IMCFl2[I]:=Tmp2;
  End;
 End;
End;

Procedure IMCDecLevels2;
Var I: LongInt; Dv: Double;
Begin
 For I:=0 To 31 Do Begin
  IMCFl1[I]:=0;
  If IMCLevl[I]<16 Then Begin
   IMCFl1[I]:=IMCExp[8+IMCLevl[I]]*IMCOldFloor[I];
   Dv:=(IMCLevl[I]-7)*0.83048; Dv:=Dv+IMCD(IMCFl2[I]); IMCFl2[I]:=Dv;
  End Else IMCFl1[I]:=IMCOldFloor[I];
 End;
End;

Procedure IMCDecLevelsRaw;
Var I,Level,Pos,K: LongInt; Tmp,Tmp2: Single; Dv: Double; A: Single;
Begin
 Pos:=IMCCoef0;
 Dv:=20000.0/IMCPow2T[IMCLevl[0] And 127]; IMCFl1[Pos]:=Dv;
 IMCFl2[Pos]:=IMCLog2f(IMCFl1[Pos]);
 Tmp:=IMCFl1[Pos]; Tmp2:=IMCFl2[Pos];
 K:=1;
 For I:=0 To 31 Do Begin
  If I=Pos Then Continue;
  Level:=IMCLevl[K]; Inc(K);
  A:=IMCPowfT[Level And 15];
  IMCFl1[I]:=Tmp*A;
  Dv:=Tmp2; Dv:=Dv-1.4533435415*Level; IMCFl2[I]:=Dv;
 End;
End;

{ allocation des bits ; renvoie False en cas d'erreur }
Function IMCBitAlloc(Sfc,FreeBits,Flag: LongInt): Boolean;
Var I,J,Indx,T1,T2,Iacc,Summer,Rres,Cwlen,Flg,FoundIdx,LowIdx,Bw,St: LongInt;
 Limit,Highest,Summa,Lowest,X,Y: Single; WorkT: TIMCSa; Dv: Double;
Begin
 IMCBitAlloc:=False;
 Limit:=-1E20; Highest:=0.0; T1:=0; T2:=1; Summa:=0.0; Iacc:=0; Summer:=0; Lowest:=1E10; LowIdx:=0; FoundIdx:=0;
 For I:=0 To 31 Do If IMCFl1[I]>Highest Then Highest:=IMCFl1[I];
 For I:=0 To 30 Do Begin
  If IMCFl5[I]<=0 Then Exit;
  IMCFl4[I]:=IMCFl3[I]-IMCLog2f(IMCFl5[I]);
 End;
 IMCFl4[31]:=Limit;
 Dv:=Highest; Dv:=Dv*0.25; Highest:=Dv;
 For I:=0 To 31 Do Begin
  Indx:=-1;
  Bw:=IMCBandTab[I+1]-IMCBandTab[I];
  If Bw=IMCBandW[I] Then Indx:=0;
  If Bw>IMCBandW[I] Then Indx:=1;
  If (Bw Div 2)>=IMCBandW[I] Then Indx:=2;
  If Indx=-1 Then Exit;
  IMCFl4[I]:=IMCFl4[I]+IMCXTab[(Indx*2+Ord(IMCFl1[I]<Highest))*2+Flag];
 End;
 If (Sfc And 2)<>0 Then Begin IMCFl4[0]:=Limit; IMCFl4[1]:=Limit; IMCFl4[2]:=Limit; IMCFl4[3]:=Limit; End;
 If (Sfc And 2)<>0 Then St:=4 Else St:=0;
 For I:=St To 30 Do Begin
  Inc(Iacc,IMCBandW[I]);
  X:=IMCBandW[I]; X:=X*IMCFl4[I]; Summa:=Summa+X;
 End;
 If Iacc=0 Then Exit;
 IMCBandW[31]:=0;
 Dv:=Summa; Dv:=Dv*0.5; Dv:=Dv-FreeBits; Dv:=Dv/Iacc; Summa:=Dv;
 For I:=0 To 15 Do Begin
  Rres:=Summer-FreeBits;
  If (Rres>=-8) And (Rres<=8) Then Break;
  Summer:=0; Iacc:=0;
  For J:=St To 31 Do Begin
   Dv:=IMCFl4[J]; Dv:=Dv*0.5; Dv:=Dv-IMCD(Summa); Dv:=Dv+0.5; X:=Dv;
   If Not (X>0) Then X:=0;
   If X>6 Then X:=6;
   Cwlen:=Trunc(X);
   IMCBitsBand[J]:=Cwlen;
   Inc(Summer,IMCBandW[J]*Cwlen);
   If Cwlen>0 Then Inc(Iacc,IMCBandW[J]);
  End;
  Flg:=T2; T2:=1;
  If FreeBits<Summer Then T2:=-1;
  If I=0 Then Flg:=T2;
  If Flg<>T2 Then Inc(T1);
  { (float)(summer - freebits) / ((t1 + 1) * iacc) + summa : tout en float }
  X:=Summer-FreeBits; Y:=(T1+1)*Iacc; X:=X/Y; Summa:=X+Summa;
 End;
 For I:=St To 31 Do
  For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do IMCCWlen[J]:=IMCBitsBand[I];
 If FreeBits>Summer Then Begin
  For I:=0 To 31 Do Begin
   If IMCBitsBand[I]=6 Then WorkT[I]:=-1E20
   Else Begin X:=IMCBitsBand[I]*-2; X:=X+IMCFl4[I]; Dv:=X; Dv:=Dv-0.415; WorkT[I]:=Dv; End;
  End;
  Highest:=0.0;
  Repeat
   If Highest<=-1E20 Then Break;
   FoundIdx:=0; Highest:=-1E20;
   For I:=0 To 31 Do If WorkT[I]>Highest Then Begin Highest:=WorkT[I]; FoundIdx:=I; End;
   If Highest>-1E20 Then Begin
    Dv:=WorkT[FoundIdx]; Dv:=Dv-2.0; WorkT[FoundIdx]:=Dv;
    Inc(IMCBitsBand[FoundIdx]);
    If IMCBitsBand[FoundIdx]=6 Then WorkT[FoundIdx]:=-1E20;
    J:=IMCBandTab[FoundIdx];
    While (J<IMCBandTab[FoundIdx+1]) And (FreeBits>Summer) Do Begin
     Inc(IMCCWlen[J]); Inc(Summer); Inc(J);
    End;
   End;
  Until FreeBits<=Summer;
 End;
 If FreeBits<Summer Then Begin
  For I:=0 To 31 Do Begin
   If IMCBitsBand[I]<>0 Then Begin X:=IMCBitsBand[I]*-2; X:=X+IMCFl4[I]; Dv:=X; Dv:=Dv+1.585; WorkT[I]:=Dv; End
   Else WorkT[I]:=1E20;
  End;
  If (Sfc And 2)<>0 Then Begin WorkT[0]:=1E20; WorkT[1]:=1E20; WorkT[2]:=1E20; WorkT[3]:=1E20; End;
  While FreeBits<Summer Do Begin
   Lowest:=1E10; LowIdx:=0;
   For I:=0 To 31 Do If WorkT[I]<Lowest Then Begin Lowest:=WorkT[I]; LowIdx:=I; End;
   Dv:=Lowest; Dv:=Dv+2.0; WorkT[LowIdx]:=Dv;
   Dec(IMCBitsBand[LowIdx]);
   If IMCBitsBand[LowIdx]=0 Then WorkT[LowIdx]:=1E20;
   J:=IMCBandTab[LowIdx];
   While (J<IMCBandTab[LowIdx+1]) And (FreeBits<Summer) Do Begin
    If IMCCWlen[J]>0 Then Begin Dec(IMCCWlen[J]); Dec(Summer); End;
    Inc(J);
   End;
  End;
 End;
 IMCBitAlloc:=True;
End;

Procedure IMCGetSkip;
Var I,J: LongInt;
Begin
 FillChar(IMCSkipBits,SizeOf(IMCSkipBits),0);
 FillChar(IMCSkipCnt,SizeOf(IMCSkipCnt),0);
 For I:=0 To 31 Do Begin
  If (IMCBandFlags[I]=0) Or (IMCBandW[I]=0) Then Continue;
  If IMCSkipRaw[I]=0 Then Begin
   IMCSkipBits[I]:=IMCBandTab[I+1]-IMCBandTab[I];
   For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do Begin
    IMCSkip[J]:=IMCGetBits(1);
    If IMCSkip[J]<>0 Then Inc(IMCSkipCnt[I]);
   End;
  End Else Begin
   J:=IMCBandTab[I];
   While J<IMCBandTab[I+1]-1 Do Begin
    If IMCGetBits(1)=0 Then Begin
     Inc(IMCSkipBits[I]);
     IMCSkip[J]:=1; IMCSkip[J+1]:=1; Inc(IMCSkipCnt[I],2);
    End Else Begin
     If IMCGetBits(1)<>0 Then Begin
      Inc(IMCSkipBits[I],2);
      IMCSkip[J]:=0; IMCSkip[J+1]:=1; Inc(IMCSkipCnt[I]);
     End Else Begin
      Inc(IMCSkipBits[I],3);
      IMCSkip[J+1]:=0;
      If IMCGetBits(1)=0 Then Begin IMCSkip[J]:=1; Inc(IMCSkipCnt[I]); End
      Else IMCSkip[J]:=0;
     End;
    End;
    Inc(J,2);
   End;
   If J<IMCBandTab[I+1] Then Begin
    Inc(IMCSkipBits[I]);
    IMCSkip[J]:=IMCGetBits(1);
    If IMCSkip[J]<>0 Then Inc(IMCSkipCnt[I]);
   End;
  End;
 End;
End;

Procedure IMCAdjustAlloc(Summer: LongInt);
Var WorkT: TIMCSa; Corrected,I,J,FoundIdx: LongInt; Highest,X: Single; Dv: Double;
Begin
 Corrected:=0; Highest:=0; FoundIdx:=0;
 For I:=0 To 31 Do Begin
  If IMCBitsBand[I]=6 Then WorkT[I]:=-1E20
  Else Begin X:=IMCBitsBand[I]*-2; X:=X+IMCFl4[I]; Dv:=X; Dv:=Dv-0.415; WorkT[I]:=Dv; End;
 End;
 While Corrected<Summer Do Begin
  If Highest<=-1E20 Then Break;
  Highest:=-1E20;
  For I:=0 To 31 Do If WorkT[I]>Highest Then Begin Highest:=WorkT[I]; FoundIdx:=I; End;
  If Highest>-1E20 Then Begin
   Dv:=WorkT[FoundIdx]; Dv:=Dv-2.0; WorkT[FoundIdx]:=Dv;
   Inc(IMCBitsBand[FoundIdx]);
   If IMCBitsBand[FoundIdx]=6 Then WorkT[FoundIdx]:=-1E20;
   J:=IMCBandTab[FoundIdx];
   While (J<IMCBandTab[FoundIdx+1]) And (Corrected<Summer) Do Begin
    If (IMCSkip[J]=0) And (IMCCWlen[J]<6) Then Begin Inc(IMCCWlen[J]); Inc(Corrected); End;
    Inc(J);
   End;
  End;
 End;
End;

Function IMCInvQuant(Sfc: LongInt): Boolean;
Var I,J,MidVal,CwLen,MaxSize,Q: LongInt; Qv: Single;
Begin
 IMCInvQuant:=False;
 For I:=0 To 31 Do
  For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do Begin
   IMCCWd[J]:=0;
   CwLen:=IMCCWlen[J];
   If (CwLen<=0) Or (IMCSkip[J]<>0) Then Continue;
   MaxSize:=1 Shl CwLen; MidVal:=MaxSize Shr 1;
   If (IMCCodewords[J]>=MaxSize) Or (IMCCodewords[J]<0) Then Exit;
   If CwLen>=4 Then Begin
    Q:=(Sfc And 2) Shr 1;
    If IMCCodewords[J]>=MidVal Then Qv:=IMCQ2[Q,IMCCodewords[J]-8]*IMCFl6[I]
    Else Qv:=-IMCQ2[Q,MaxSize-IMCCodewords[J]-8-1]*IMCFl6[I];
   End Else Begin
    Q:=((Sfc And 2) Shr 1) Or (IMCBandFlags[I] Shl 1);
    If IMCCodewords[J]>=MidVal Then Qv:=IMCQ1[Q,IMCCodewords[J]-1]*IMCFl6[I]
    Else Qv:=-IMCQ1[Q,MaxSize-2-IMCCodewords[J]]*IMCFl6[I];
   End;
   IMCCWd[J]:=Qv;
  End;
 IMCInvQuant:=True;
End;

Procedure IMCGetCoeffs;
Var I,J,CwLen,Cw: LongInt;
Begin
 For I:=0 To 31 Do Begin
  If IMCSumLen[I]=0 Then Continue;
  If (IMCBandFlags[I]<>0) Or (IMCBandW[I]<>0) Then
   For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do Begin
    CwLen:=IMCCWlen[J]; Cw:=0;
    If (CwLen<>0) And ((IMCBandFlags[I]=0) Or (IMCSkip[J]=0)) Then Begin
     If IMCPos+CwLen<=512 Then Cw:=IMCGetBits(CwLen);
    End;
    IMCCodewords[J]:=Cw;
   End;
 End;
End;

Procedure IMCRefineAlloc;
Var I,J,Summer: LongInt;
Begin
 For I:=0 To 31 Do Begin
  IMCSumLen[I]:=0; IMCSkipRaw[I]:=0;
  For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do Inc(IMCSumLen[I],IMCCWlen[J]);
  If IMCBandFlags[I]<>0 Then
   If (Trunc((IMCBandTab[I+1]-IMCBandTab[I])*1.5)>IMCSumLen[I]) And (IMCSumLen[I]>0) Then IMCSkipRaw[I]:=1;
 End;
 IMCGetSkip;
 For I:=0 To 31 Do Begin
  IMCFl6[I]:=IMCFl1[I];
  If (IMCBandFlags[I]<>0) And ((IMCBandTab[I+1]-IMCBandTab[I])<>IMCSkipCnt[I]) Then
   IMCFl6[I]:=IMCFl6[I]*(IMCSqrt[IMCBandTab[I+1]-IMCBandTab[I]]/IMCSqrt[IMCBandTab[I+1]-IMCBandTab[I]-IMCSkipCnt[I]]);
 End;
 Summer:=0;
 For I:=0 To 31 Do
  If IMCBandFlags[I]<>0 Then Begin
   For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do
    If IMCSkip[J]<>0 Then Begin Inc(Summer,IMCCWlen[J]); IMCCWlen[J]:=0; End;
   Dec(Summer,IMCSkipBits[I]);
  End;
 IMCAdjustAlloc(Summer);
End;

Function IMCDecodeBlock: Boolean;
Var Hdr,Sfc,I,J,Flag,Bits,BitsCount,K: LongInt; Dv: Double; S0,S1,Wi,Wj: Single;
Begin
 IMCDecodeBlock:=False;
 Hdr:=IMCGetBits(9);
 If (Hdr And $18)<>0 Then Exit;
 Sfc:=IMCGetBits(3);
 If (Sfc And 4)<>0 Then IMCReset:=True;
 If IMCReset Then Begin
  For I:=0 To 31 Do IMCOldFloor[I]:=1.0;
  For I:=0 To 255 Do IMCCWd[I]:=0;
  IMCReset:=False;
 End;
 Flag:=IMCGetBits(1);
 If (Sfc And 1)<>0 Then IMCReadLevelsRaw Else IMCReadLevels(Sfc);
 If (Sfc And 1)<>0 Then IMCDecLevelsRaw
 Else If (Sfc And 4)<>0 Then IMCDecLevels
 Else IMCDecLevels2;
 For I:=0 To 31 Do If IMCFl1[I]>2147483648.0 Then Exit;
 IMCOldFloor:=IMCFl1;
 If (Sfc And 1)<>0 Then Begin
  For I:=0 To 31 Do Begin
   IMCBandW[I]:=IMCBandTab[I+1]-IMCBandTab[I];
   IMCBandFlags[I]:=0;
   Dv:=IMCFl2[I]; Dv:=Dv*2; IMCFl3[I]:=Dv;
   IMCFl5[I]:=1.0;
  End;
 End Else Begin
  For I:=0 To 31 Do
   If IMCLevl[I]=16 Then IMCBandW[I]:=0 Else IMCBandW[I]:=IMCBandTab[I+1]-IMCBandTab[I];
  FillChar(IMCBandFlags,SizeOf(IMCBandFlags),0);
  For I:=0 To 30 Do If IMCBandW[I]<>0 Then IMCBandFlags[I]:=IMCGetBits(1);
  IMCCalcCoeffs;
 End;
 BitsCount:=0;
 If (Sfc And 2)<>0 Then Begin
  Inc(BitsCount,15);
  IMCBitsBand[0]:=5; IMCCWlen[0]:=5; IMCCWlen[1]:=5; IMCCWlen[2]:=5;
  For I:=1 To 3 Do Begin
   If (Sfc And 1)<>0 Then Bits:=5
   Else If IMCLevl[I]=16 Then Bits:=0 Else Bits:=5;
   IMCBitsBand[I]:=Bits;
   For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do Begin IMCCWlen[J]:=Bits; Inc(BitsCount,Bits); End;
  End;
 End;
 If Not IMCBitAlloc(Sfc,512-BitsCount-IMCPos,Flag) Then Begin IMCReset:=True; Exit; End;
 If (Sfc And 1)<>0 Then Begin
  For I:=0 To 31 Do IMCSkip[I]:=0;
 End Else IMCRefineAlloc;
 For I:=0 To 31 Do Begin
  IMCSumLen[I]:=0;
  For J:=IMCBandTab[I] To IMCBandTab[I+1]-1 Do If IMCSkip[J]=0 Then Inc(IMCSumLen[I],IMCCWlen[J]);
 End;
 FillChar(IMCCodewords,SizeOf(IMCCodewords),0);
 IMCGetCoeffs;
 If Not IMCInvQuant(Sfc) Then Begin IMCReset:=True; Exit; End;
 FillChar(IMCSkip,SizeOf(IMCSkip),0);
 IMCMdct(IMCCWd);
 { vector_fmul_window(out, prev, temp, window, 128) }
 For K:=0 To 127 Do Begin
  S0:=IMCPrev[K]; S1:=IMCTempOut[127-K]; Wi:=IMCWin[K]; Wj:=IMCWin[255-K];
  IMCOut[K]:=S0*Wj-S1*Wi;
  IMCOut[255-K]:=S0*Wi+S1*Wj;
 End;
 For K:=0 To 127 Do IMCPrev[K]:=IMCTempOut[128+K];
 IMCDecodeBlock:=True;
End;

Procedure IMCSetBlock(Src: PEABuffer);
Var I: LongInt;
Begin
 For I:=0 To 31 Do Begin IMCBuf[2*I]:=Src^[2*I+1]; IMCBuf[2*I+1]:=Src^[2*I]; End;
 For I:=64 To 79 Do IMCBuf[I]:=0;
 IMCPos:=0;
End;

{ WAV 0x0401 (Intel Music Coder) -> WAV PCM 16 bits mono }
Procedure DecodeIMC(Const Source,Target: String);
Var
 H: Array[0..127] Of Byte; Limit,Pos,Size,DataPos,DataSize,Rate,Left,Cnt,Real_: Int64; Tag,Chn,Align,Count,I,J,V,Take,Done: LongInt;
 Fmt: Boolean; Pk: PEABuffer; Sg: Single; Dv: Double; V64: Int64;
Begin
 OpenRead(Source); Limit:=InputSize; Pos:=0; DataPos:=-1; DataSize:=0; Fmt:=False;
 If Limit<12 Then Fail('imc: fichier trop court.');
 ReadAt(0,H,12);
 If Not ((H[0]=82) And (H[1]=73) And (H[2]=70) And (H[3]=70) And (H[8]=87) And (H[9]=65)) Then Fail('imc: signature RIFF/WAVE requise.');
 Pos:=12; Count:=0; Align:=0; Rate:=0; Chn:=1;
 While (Limit-Pos>=8) And (Count<256) Do Begin
  ReadAt(Pos,H,8); Inc(Pos,8); Inc(Count);
  Size:=Int64(H[4])+Int64(H[5])*256+Int64(H[6])*65536+Int64(H[7])*16777216;
  If (H[0]=102) And (H[1]=109) And (H[2]=116) And (H[3]=32) Then Begin
   If (Size<16) Or (Limit-Pos<Size) Then Fail('imc: bloc fmt incorrect.');
   Real_:=Size;
   If Size>120 Then Size:=120;
   ReadAt(Pos,H,Size);
   Tag:=H[0]+H[1]*256; Chn:=H[2]+H[3]*256; Rate:=Int64(H[4])+H[5]*256+Int64(H[6])*65536+Int64(H[7])*16777216;
   Align:=H[12]+H[13]*256;
   If Tag<>$401 Then Fail('imc: WAV de type 0x401 requis.');
   Fmt:=True; Size:=Real_;
  End Else If (H[0]=100) And (H[1]=97) And (H[2]=116) And (H[3]=97) Then Begin
   DataPos:=Pos; DataSize:=Size; If DataPos+DataSize>Limit Then DataSize:=Limit-DataPos;
   Break;
  End;
  If Size>Limit-Pos Then Break;
  Inc(Pos,Size); If Odd(Size) Then Inc(Pos);
 End;
 If Not Fmt Or (DataPos<0) Then Fail('imc: blocs fmt/data requis.');
 If (Rate<1) Or (Rate>4000000) Then Fail('imc: frequence incorrecte.');
 IMCInit;
 FillChar(IMCPrev,SizeOf(IMCPrev),0);
 FillChar(IMCSkip,SizeOf(IMCSkip),0);
 FillChar(IMCCWd,SizeOf(IMCCWd),0);
 FillChar(IMCCWlen,SizeOf(IMCCWlen),0);
 FillChar(IMCFl1,SizeOf(IMCFl1),0); FillChar(IMCFl2,SizeOf(IMCFl2),0); FillChar(IMCFl3,SizeOf(IMCFl3),0);
 FillChar(IMCFl4,SizeOf(IMCFl4),0); FillChar(IMCFl5,SizeOf(IMCFl5),0); FillChar(IMCFl6,SizeOf(IMCFl6),0);
 FillChar(IMCBitsBand,SizeOf(IMCBitsBand),0); FillChar(IMCLevl,SizeOf(IMCLevl),0);
 FillChar(IMCSumLen,SizeOf(IMCSumLen),0); FillChar(IMCSkipRaw,SizeOf(IMCSkipRaw),0);
 IMCReset:=True;
 for I:=0 To 31 Do IMCOldFloor[I]:=1.0;
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,1,0);
 GetMem(Pk,4096+16);
 Left:=DataSize; Pos:=DataPos;
 While Left>0 Do Begin
  { paquet du demuxeur WAV : 4096 octets, multiple de block_align }
  Take:=4096;
  If Align>1 Then Begin If Take<Align Then Take:=Align; Take:=(Take Div Align)*Align; End;
  If Take>Left Then Take:=Left;
  If Take>4096 Then Take:=4096;
  Done:=0;
  While Done<Take Do Begin
   If Take-Done>60000 Then J:=60000 Else J:=Take-Done;
   ReadAt(Pos+Done,Pk^[Done],J); Inc(Done,J);
  End;
  Inc(Pos,Take); Dec(Left,Take);
  I:=0;
  While Take-I>=64 Do Begin
   IMCSetBlock(PEABuffer(@Pk^[I]));
   Inc(I,64);
   If Not IMCDecodeBlock Then Break;
   For J:=0 To 255 Do Begin
    Sg:=IMCOut[J]; Dv:=Sg; Dv:=Dv*32768.0;
    { lrintf puis av_clip_int16(int) : l'entier 64 bits est tronque a 32 bits avant l'ecretage }
    If (Dv>=9.2E18) Or (Dv<=-9.2E18) Or (Dv<>Dv) Then V64:=0
    Else Begin
     V64:=Round(Dv) And $FFFFFFFF;
     If V64>=2147483648 Then V64:=V64-4294967296;
    End;
    If V64>32767 Then V:=32767 Else If V64<-32768 Then V:=-32768 Else V:=V64;
    EAPut(V);
   End;
  End;
 End;
 FreeMem(Pk,4096+16); EAFlush;
 ADPCMPatchHeader(Rate,1,EAWritten);
 CloseRead; CloseWrite;
End;
{ IMC-END }

{ ---- Monkey's Audio (APE): decodeur, versions de fichier 3930..3990, 8 et 16 bits ---- }
Type
 TAPI32=Array[0..4000000] Of LongInt; PAPI32=^TAPI32;
 TAPI16=Array[0..8000000] Of SmallInt; PAPI16=^TAPI16;
 TAPFilter=Record
  Order,Frac,D,A: LongInt; Coef,Hist: PAPI16; Avg: Int64;
 End;
Const
 APEOrders: Array[0..4,0..2] Of Integer=((0,0,0),(16,0,0),(64,0,0),(32,256,0),(16,256,1280));
 APEFrac: Array[0..4,0..2] Of Integer=((0,0,0),(11,0,0),(11,0,0),(10,13,0),(11,13,15));
 APECnt3970: Array[0..21] Of Word=(0,14824,28224,39348,47855,53994,58171,60926,62682,63786,64463,64878,65126,65276,65365,65419,65450,65469,65480,65487,65491,65493);
 APEDif3970: Array[0..20] Of Word=(14824,13400,11124,8507,6139,4177,2755,1756,1104,677,415,248,150,89,54,31,19,11,7,4,2);
 APECnt3980: Array[0..21] Of Word=(0,19578,36160,48417,56323,60899,63265,64435,64971,65232,65351,65416,65447,65466,65476,65482,65485,65488,65490,65491,65492,65493);
 APEDif3980: Array[0..20] Of Word=(19578,16582,12257,7906,4576,2366,1170,536,261,119,65,31,19,10,6,3,3,2,1,1,1);
 APEM32=$FFFFFFFF;
 APEYDelayA=50; APEYDelayB=42; APEXDelayA=34; APEXDelayB=26;
 APEYAdaptA=18; APEXAdaptA=14; APEYAdaptB=10; APEXAdaptB=5;
 APEChunk=4608;
Var
 APEVer,APELevel,APEFlags,APEFset,APECh,APEBps,APEFrameFlags,APEPtr,APEEnd,APEDLen,APEPos,APEFiles: LongInt;
 APEData: PEABuffer; APEErr: Boolean;
 APELow,APERange,APEHelp,APEBuf: Int64;
 APEKX,APEKY: LongInt; APESX,APESY: Int64;
 APEDec: Array[0..1] Of PAPI32;
 APEPB: Array[0..575] Of Int64;
 APELastA,APEFilA,APEFilB: Array[0..1] Of Int64;
 APECoefA: Array[0..1,0..3] Of Int64; APECoefB: Array[0..1,0..4] Of Int64;
 APEFilt: Array[0..2,0..1] Of TAPFilter;

Function APEW32(X: Int64): LongInt;
Begin
 X:=X And APEM32; If X>=$80000000 Then X:=X-$100000000; APEW32:=X;
End;

Function APESign(X: Int64): LongInt;
Begin
 If X<0 Then APESign:=1 Else If X>0 Then APESign:=-1 Else APESign:=0;
End;

Function APEByteAt(P: LongInt): LongInt;
Begin
 If (P<0) Or (P>=APEDLen) Then APEByteAt:=0 Else APEByteAt:=APEData^[P];
End;

Procedure APERcStart;
Begin
 APEBuf:=APEByteAt(APEPtr); Inc(APEPtr);
 APELow:=APEBuf Shr 1; APERange:=128;
End;

Procedure APERcNorm;
Begin
 While APERange<=$800000 Do Begin
  APEBuf:=(APEBuf Shl 8) And APEM32;
  If APEPtr<APEEnd Then Begin APEBuf:=(APEBuf+APEByteAt(APEPtr)) And APEM32; Inc(APEPtr); End
  Else APEErr:=True;
  APELow:=((APELow Shl 8) Or ((APEBuf Shr 1) And 255)) And APEM32;
  APERange:=(APERange Shl 8) And APEM32;
 End;
End;

Function APECulFreq(Tot: LongInt): LongInt;
Begin
 APERcNorm; APEHelp:=APERange Div Tot;
 If APEHelp=0 Then Begin APEErr:=True; APEHelp:=1; End;
 APECulFreq:=APELow Div APEHelp;
End;

Function APECulShift(Shift: LongInt): LongInt;
Begin
 APERcNorm; APEHelp:=APERange Shr Shift;
 If APEHelp=0 Then Begin APEErr:=True; APEHelp:=1; End;
 APECulShift:=APELow Div APEHelp;
End;

Procedure APEUpdate(Sy,Lt: LongInt);
Begin
 APELow:=(APELow-APEHelp*Lt) And APEM32; APERange:=(APEHelp*Sy) And APEM32;
End;

Function APEBits(N: LongInt): LongInt;
Var S: LongInt;
Begin
 S:=APECulShift(N); APEUpdate(1,S); APEBits:=S;
End;

Function APESymbol(V3980: Boolean): LongInt;
Var Sym,Cf: LongInt;
Begin
 Cf:=APECulShift(16);
 If Cf>65492 Then Begin
  Sym:=Cf-65535+63; APEUpdate(1,Cf);
  If Cf>65535 Then APEErr:=True;
  APESymbol:=Sym; Exit;
 End;
 Sym:=0;
 If V3980 Then Begin
  While APECnt3980[Sym+1]<=Cf Do Inc(Sym);
  APEUpdate(APEDif3980[Sym],APECnt3980[Sym]);
 End Else Begin
  While APECnt3970[Sym+1]<=Cf Do Inc(Sym);
  APEUpdate(APEDif3970[Sym],APECnt3970[Sym]);
 End;
 APESymbol:=Sym;
End;

Procedure APEUpdateRice(Var K: LongInt; Var KSum: Int64; X: Int64);
Var Lim: Int64;
Begin
 If K<>0 Then Lim:=Int64(1) Shl (K+4) Else Lim:=0;
 KSum:=(KSum+(((X+1) And APEM32) Shr 1)-((KSum+16) Shr 5)) And APEM32;
 If KSum<Lim Then Dec(K)
 Else If (KSum>=(Int64(1) Shl (K+5))) And (K<24) Then Inc(K);
End;

Function APESigned(X: Int64): LongInt;
Var R: Int64;
Begin
 If (X And 1)=0 Then R:=(X Shr 1) Xor APEM32 Else R:=X Shr 1;
 APESigned:=APEW32(R+1);
End;

Function APEValue(Y: Boolean): LongInt;
Var
 K: LongInt; KSum,X,Ov,Pivot,Base,BHi,BLo: Int64; TmpK,BBits: LongInt;
Begin
 If Y Then Begin K:=APEKY; KSum:=APESY; End Else Begin K:=APEKX; KSum:=APESX; End;
 If APEVer>=3990 Then Begin
  Pivot:=KSum Shr 5; If Pivot<1 Then Pivot:=1;
  Ov:=APESymbol(True);
  If Ov=63 Then Begin
   Ov:=Int64(APEBits(16)) Shl 16; Ov:=Ov Or APEBits(16);
  End;
  If Pivot<$10000 Then Begin
   Base:=APECulFreq(Pivot); APEUpdate(1,Base);
  End Else Begin
   BHi:=Pivot; BBits:=0;
   While (BHi And Not Int64($FFFF))<>0 Do Begin BHi:=BHi Shr 1; Inc(BBits); End;
   BHi:=APECulFreq(BHi+1); APEUpdate(1,BHi);
   BLo:=APECulFreq(1 Shl BBits); APEUpdate(1,BLo);
   Base:=(BHi Shl BBits)+BLo;
  End;
  X:=(Base+Ov*Pivot) And APEM32;
 End Else Begin
  Ov:=APESymbol(False);
  If Ov=63 Then Begin TmpK:=APEBits(5); Ov:=0; End
  Else If K<1 Then TmpK:=0 Else TmpK:=K-1;
  If TmpK<=16 Then X:=APEBits(TmpK)
  Else If TmpK<=31 Then Begin X:=APEBits(16); X:=X Or (Int64(APEBits(TmpK-16)) Shl 16); End
  Else Begin APEErr:=True; X:=0; End;
  X:=(X+(Ov Shl TmpK)) And APEM32;
 End;
 APEUpdateRice(K,KSum,X);
 If Y Then Begin APEKY:=K; APESY:=KSum; End Else Begin APEKX:=K; APESX:=KSum; End;
 APEValue:=APESigned(X);
End;

Procedure APEEntropy(Count: LongInt; Stereo: Boolean);
Var I: LongInt;
Begin
 If Not Stereo Then Begin
  For I:=0 To Count-1 Do APEDec[0]^[I]:=APEValue(True);
 End Else For I:=0 To Count-1 Do Begin
  APEDec[0]^[I]:=APEValue(True); APEDec[1]^[I]:=APEValue(False);
 End;
End;

Procedure APEFilterRun(Var F: TAPFilter; Data: PAPI32; Count: LongInt);
Var
 N,J,Mul,Res,D,Ord: LongInt; Sum,Wide,AbsR: Int64; X: LongInt; Sg: LongInt;
Begin
 Ord:=F.Order;
 For N:=0 To Count-1 Do Begin
  X:=Data^[N]; Mul:=APESign(X); Sum:=0;
  If Mul<>0 Then Begin
   For J:=0 To Ord-1 Do Begin
    Sum:=Sum+Int64(F.Coef^[J])*F.Hist^[F.D-Ord+J];
    F.Coef^[J]:=SmallInt(F.Coef^[J]+Mul*F.Hist^[F.A-Ord+J]);
   End;
  End Else For J:=0 To Ord-1 Do Sum:=Sum+Int64(F.Coef^[J])*F.Hist^[F.D-Ord+J];
  Res:=APEW32(Sum);
  Wide:=AVSar(Int64(Res)+(Int64(1) Shl (F.Frac-1)),F.Frac);
  Res:=APEW32(APEW32(Wide)+Int64(X));
  Data^[N]:=Res;
  If Res>32767 Then F.Hist^[F.D]:=32767 Else If Res<-32768 Then F.Hist^[F.D]:=-32768 Else F.Hist^[F.D]:=Res;
  Inc(F.D);
  If APEVer<3980 Then Begin
   If Res=0 Then F.Hist^[F.A]:=0 Else If Res<0 Then F.Hist^[F.A]:=4 Else F.Hist^[F.A]:=-4;
   F.Hist^[F.A-4]:=(F.Hist^[F.A-4]-(F.Hist^[F.A-4] And 1)) Div 2;
   F.Hist^[F.A-8]:=(F.Hist^[F.A-8]-(F.Hist^[F.A-8] And 1)) Div 2;
  End Else Begin
   If Res<0 Then AbsR:=-Int64(Res) Else AbsR:=Res;
   If AbsR<>0 Then Begin
    Sg:=8;
    If AbsR>F.Avg*3 Then Sg:=Sg Shl 1;
    If AbsR>((F.Avg+F.Avg Div 3) And APEM32) Then Sg:=Sg Shl 1;
    F.Hist^[F.A]:=APESign(Res)*Sg;
   End Else F.Hist^[F.A]:=0;
   F.Avg:=(F.Avg+(APEW32(AbsR-F.Avg) Div 16)) And APEM32;
   F.Hist^[F.A-1]:=(F.Hist^[F.A-1]-(F.Hist^[F.A-1] And 1)) Div 2;
   F.Hist^[F.A-2]:=(F.Hist^[F.A-2]-(F.Hist^[F.A-2] And 1)) Div 2;
   F.Hist^[F.A-8]:=(F.Hist^[F.A-8]-(F.Hist^[F.A-8] And 1)) Div 2;
  End;
  Inc(F.A);
  If F.D=512+Ord*2 Then Begin
   D:=F.D-Ord*2; Move(F.Hist^[D],F.Hist^[0],Ord*2*2);
   F.D:=Ord*2; F.A:=Ord;
  End;
 End;
End;

Procedure APEApplyFilters(Count: LongInt; Stereo: Boolean);
Var I: Integer;
Begin
 For I:=0 To 2 Do Begin
  If APEOrders[APEFset,I]=0 Then Break;
  APEFilterRun(APEFilt[I,0],APEDec[0],Count);
  If Stereo Then APEFilterRun(APEFilt[I,1],APEDec[1],Count);
 End;
End;

Procedure APEHistWrap;
Begin
 Inc(APEPos);
 If APEPos=512 Then Begin
  Move(APEPB[APEPos],APEPB[0],50*SizeOf(Int64)); APEPos:=0;
 End;
End;

Function APEUpd3930(Decoded: LongInt; F,DA: LongInt): LongInt;
Var D: Array[0..3] Of Int64; PA,Sg: Int64; K: Integer;
Begin
 APEPB[APEPos+DA]:=APELastA[F];
 D[0]:=APEPB[APEPos+DA];
 D[1]:=APEW32(APEPB[APEPos+DA]-APEPB[APEPos+DA-1]);
 D[2]:=APEW32(APEPB[APEPos+DA-1]-APEPB[APEPos+DA-2]);
 D[3]:=APEW32(APEPB[APEPos+DA-2]-APEPB[APEPos+DA-3]);
 PA:=APEW32(D[0]*APECoefA[F,0]+D[1]*APECoefA[F,1]+D[2]*APECoefA[F,2]+D[3]*APECoefA[F,3]);
 APELastA[F]:=APEW32(Int64(Decoded)+AVSar(PA,9));
 APEFilA[F]:=APEW32(APELastA[F]+AVSar(APEW32(APEFilA[F]*31),5));
 Sg:=APESign(Decoded);
 For K:=0 To 3 Do Begin
  If D[K]<0 Then APECoefA[F,K]:=APEW32(APECoefA[F,K]+Sg) Else APECoefA[F,K]:=APEW32(APECoefA[F,K]-Sg);
 End;
 APEUpd3930:=APEFilA[F];
End;

Function APEUpd3950(Decoded: LongInt; F,DA,DB,AA,AB: LongInt): LongInt;
Var PA,PB,Sg: Int64; K: Integer; P: LongInt;
Begin
 P:=APEPos;
 APEPB[P+DA]:=APELastA[F];
 APEPB[P+AA]:=APESign(APEPB[P+DA]);
 APEPB[P+DA-1]:=APEPB[P+DA]-APEPB[P+DA-1];
 APEPB[P+AA-1]:=APESign(APEPB[P+DA-1]);
 PA:=0; For K:=0 To 3 Do PA:=PA+APEPB[P+DA-K]*APECoefA[F,K];
 APEPB[P+DB]:=APEFilA[F xor 1]-AVSar(APEFilB[F]*31,5);
 APEPB[P+AB]:=APESign(APEPB[P+DB]);
 APEPB[P+DB-1]:=APEPB[P+DB]-APEPB[P+DB-1];
 APEPB[P+AB-1]:=APESign(APEPB[P+DB-1]);
 APEFilB[F]:=APEFilA[F xor 1];
 PB:=0; For K:=0 To 4 Do PB:=PB+APEPB[P+DB-K]*APECoefB[F,K];
 PA:=APEW32(PA); PB:=APEW32(PB);
 APELastA[F]:=APEW32(Int64(Decoded)+AVSar(APEW32(PA+AVSar(PB,1)),10));
 APEFilA[F]:=APELastA[F]+AVSar(APEFilA[F]*31,5);
 Sg:=APESign(Decoded);
 For K:=0 To 3 Do APECoefA[F,K]:=APECoefA[F,K]+APEPB[P+AA-K]*Sg;
 For K:=0 To 4 Do APECoefB[F,K]:=APECoefB[F,K]+APEPB[P+AB-K]*Sg;
 APEUpd3950:=APEW32(APEFilA[F]);
End;

Procedure APEPredictor(Count: LongInt; Stereo: Boolean);
Var I: LongInt; A0,A1,CurA,PA,Sg,A: Int64;
Begin
 APEApplyFilters(Count,Stereo);
 If APEVer<3950 Then Begin
  For I:=0 To Count-1 Do Begin
   If Stereo Then Begin
    A0:=APEDec[1]^[I]; A1:=APEDec[0]^[I];
    APEDec[0]^[I]:=APEUpd3930(A0,0,APEYDelayA);
    APEDec[1]^[I]:=APEUpd3930(A1,1,APEXDelayA);
   End Else APEDec[0]^[I]:=APEUpd3930(APEDec[0]^[I],0,APEYDelayA);
   APEHistWrap;
  End;
  Exit;
 End;
 If Stereo Then Begin
  APEPos:=0;
  For I:=0 To Count-1 Do Begin
   A0:=APEUpd3950(APEDec[0]^[I],0,APEYDelayA,APEYDelayB,APEYAdaptA,APEYAdaptB);
   A1:=APEUpd3950(APEDec[1]^[I],1,APEXDelayA,APEXDelayB,APEXAdaptA,APEXAdaptB);
   APEDec[0]^[I]:=A0; APEDec[1]^[I]:=A1;
   APEHistWrap;
  End;
 End Else Begin
  CurA:=APELastA[0];
  For I:=0 To Count-1 Do Begin
   A:=APEDec[0]^[I];
   APEPB[APEPos+APEYDelayA]:=CurA;
   APEPB[APEPos+APEYDelayA-1]:=APEPB[APEPos+APEYDelayA]-APEPB[APEPos+APEYDelayA-1];
   PA:=APEW32(APEPB[APEPos+APEYDelayA]*APECoefA[0,0]+APEPB[APEPos+APEYDelayA-1]*APECoefA[0,1]+
    APEPB[APEPos+APEYDelayA-2]*APECoefA[0,2]+APEPB[APEPos+APEYDelayA-3]*APECoefA[0,3]);
   CurA:=APEW32(A+AVSar(PA,10));
   APEPB[APEPos+APEYAdaptA]:=APESign(APEPB[APEPos+APEYDelayA]);
   APEPB[APEPos+APEYAdaptA-1]:=APESign(APEPB[APEPos+APEYDelayA-1]);
   Sg:=APESign(A);
   APECoefA[0,0]:=APECoefA[0,0]+APEPB[APEPos+APEYAdaptA]*Sg;
   APECoefA[0,1]:=APECoefA[0,1]+APEPB[APEPos+APEYAdaptA-1]*Sg;
   APECoefA[0,2]:=APECoefA[0,2]+APEPB[APEPos+APEYAdaptA-2]*Sg;
   APECoefA[0,3]:=APECoefA[0,3]+APEPB[APEPos+APEYAdaptA-3]*Sg;
   APEHistWrap;
   APEFilA[0]:=CurA+AVSar(APEFilA[0]*31,5);
   APEDec[0]^[I]:=APEW32(APEFilA[0]);
  End;
  APELastA[0]:=CurA;
 End;
End;

Procedure APEInitFrame;
Var I,J,Ord: LongInt;
Begin
 APEKX:=10; APESX:=16384; APEKY:=10; APESY:=16384;
 FillChar(APEPB,SizeOf(APEPB),0); APEPos:=0;
 For I:=0 To 1 Do Begin
  APECoefA[I,0]:=360; APECoefA[I,1]:=317; APECoefA[I,2]:=-109; APECoefA[I,3]:=98;
  For J:=0 To 4 Do APECoefB[I,J]:=0;
  APEFilA[I]:=0; APEFilB[I]:=0; APELastA[I]:=0;
 End;
 For I:=0 To 2 Do For J:=0 To 1 Do Begin
  Ord:=APEOrders[APEFset,I];
  With APEFilt[I,J] Do Begin
   Order:=Ord; Frac:=APEFrac[APEFset,I]; D:=Ord*2; A:=Ord; Avg:=0;
   If Ord>0 Then Begin
    FillChar(Coef^,Ord*2,0); FillChar(Hist^,(Ord*2+512+16)*2,0);
   End;
  End;
 End;
End;

{ Decode un paquet (trame APE inversee par mots de 32 bits): PCM16 via EAPut. }
Procedure APEDecodePacket(Pk: PEABuffer; PkSize: LongInt);
Var
 Base,Offset,Samples,N,I,C: LongInt; NBlocks,Crc: Int64; Mono: Boolean; Left,Right: Int64;
Function BE32(At: LongInt): Int64;
Begin
 BE32:=Int64(APEByteAt(At))*16777216+APEByteAt(At+1)*65536+APEByteAt(At+2)*256+APEByteAt(At+3);
End;
Begin
 If PkSize<8 Then Exit;
 Base:=PkSize And Not 3; APEDLen:=Base+64;
 GetMem(APEData,Base+64); FillChar(APEData^,Base+64,0);
 I:=0;
 While I<Base Do Begin
  APEData^[I]:=Pk^[I+3]; APEData^[I+1]:=Pk^[I+2]; APEData^[I+2]:=Pk^[I+1]; APEData^[I+3]:=Pk^[I];
  Inc(I,4);
 End;
 If APEVer<3950 Then APEEnd:=Base+2 Else APEEnd:=Base;
 NBlocks:=BE32(0); Offset:=LongInt(BE32(4)); APEPtr:=8;
 If (NBlocks=0) Or (NBlocks>268435440) Or (BE32(4)>3) Or (APEEnd-APEPtr<Offset) Or (APEEnd-APEPtr-Offset<6) Then Begin
  FreeMem(APEData,Base+64); Exit;
 End;
 Inc(APEPtr,Offset);
 Crc:=BE32(APEPtr); Inc(APEPtr,4); APEFrameFlags:=0;
 If (APEVer>3820) And ((Crc And $80000000)<>0) Then Begin
  If APEEnd-APEPtr<6 Then Begin FreeMem(APEData,Base+64); Exit; End;
  APEFrameFlags:=LongInt(BE32(APEPtr) And $FF); Inc(APEPtr,4);
 End;
 Inc(APEPtr); APERcStart;
 APEInitFrame;
 Samples:=NBlocks;
 Mono:=(APECh=1) Or ((APEFrameFlags And 4)<>0);
 While Samples>0 Do Begin
  N:=Samples; If N>APEChunk Then N:=APEChunk;
  FillChar(APEDec[0]^,(N+8)*4,0); FillChar(APEDec[1]^,(N+8)*4,0);
  APEErr:=False;
  If Mono Then Begin
   If (APEFrameFlags And 3)=0 Then Begin
    APEEntropy(N,False);
    If Not APEErr Then Begin
     APEPredictor(N,False);
     If APECh=2 Then Move(APEDec[0]^,APEDec[1]^,N*4);
    End;
   End;
  End Else If (APEFrameFlags And 3)<>3 Then Begin
   APEEntropy(N,True);
   If Not APEErr Then Begin
    APEPredictor(N,True);
    For I:=0 To N-1 Do Begin
     Left:=APEW32(Int64(APEDec[1]^[I])-Int64(APEDec[0]^[I] Div 2));
     Right:=APEW32(Left+APEDec[0]^[I]);
     APEDec[0]^[I]:=Left; APEDec[1]^[I]:=Right;
    End;
   End;
  End;
  If APEErr Then Break;
  For I:=0 To N-1 Do For C:=0 To APECh-1 Do Begin
   If APEBps=8 Then EAPut((((APEDec[C]^[I]+128) And 255)-128)*256)
   Else EAPut(APEDec[C]^[I] And 65535);
  End;
  Dec(Samples,N);
 End;
 FreeMem(APEData,Base+64);
End;

Procedure DecodeAPE(Const Source,Target: String);
Type TI64=Array[0..50000000] Of Int64; PI64=^TI64;
Var
 H: Array[0..63] Of Byte; Cur,Limit,Junk,FileSize: Int64; I,J,Bytes,Take: LongInt;
 Descriptor,HeaderLen,SeekLen,WavHeader,WavTail,TotalFrames,FinalBlocks,BlocksPerFrame,Rate,Level,Flags,FinalSize: Int64;
 FPos,FSize: PI64; FSkip: PAPI32; Pk: PEABuffer; Avail,Want,Pos0,Entry: Int64; NBlocks: Int64; Ord: LongInt;
Function R16: LongInt;
Begin
 If Cur+2>Limit Then Fail('ape: en-tete tronque.');
 ReadAt(Cur,H,2); Inc(Cur,2); R16:=H[0]+H[1]*256;
End;
Function R32: Int64;
Begin
 If Cur+4>Limit Then Fail('ape: en-tete tronque.');
 ReadAt(Cur,H,4); Inc(Cur,4); R32:=Int64(H[0])+Int64(H[1])*256+Int64(H[2])*65536+Int64(H[3])*16777216;
End;
Begin
 OpenRead(Source); Limit:=InputSize; FileSize:=Limit; Cur:=0; Junk:=0;
 If Limit>=10 Then Begin
  ReadAt(0,H,10);
  If (H[0]=73) And (H[1]=68) And (H[2]=51) Then Begin
   Junk:=10+(Int64(H[6] And 127) Shl 21)+(Int64(H[7] And 127) Shl 14)+(Int64(H[8] And 127) Shl 7)+(H[9] And 127);
   If (H[5] And 16)<>0 Then Inc(Junk,10);
   Cur:=Junk;
  End;
 End;
 If R32<>$2043414D Then Fail('ape: signature MAC requise.');
 APEVer:=R16;
 If (APEVer<3800) Or (APEVer>3990) Then Fail('ape: version de fichier 3.80..3.99 requise.');
 If APEVer<3930 Then Fail('ape: versions de fichier inferieures a 3.93 non supportees.');
 If APEVer>=3980 Then Begin
  R16; Descriptor:=R32; HeaderLen:=R32; SeekLen:=R32; WavHeader:=R32; R32; R32; WavTail:=R32; Inc(Cur,16);
  If Descriptor>52 Then Inc(Cur,Descriptor-52);
  Level:=R16; Flags:=R16; BlocksPerFrame:=R32; FinalBlocks:=R32; TotalFrames:=R32; APEBps:=R16; APECh:=R16; Rate:=R32;
 End Else Begin
  Descriptor:=0; HeaderLen:=32;
  Level:=R16; Flags:=R16; APECh:=R16; Rate:=R32; WavHeader:=R32; WavTail:=R32; TotalFrames:=R32; FinalBlocks:=R32;
  If (Flags And 4)<>0 Then Begin Inc(Cur,4); Inc(HeaderLen,4); End;
  If (Flags And 16)<>0 Then Begin SeekLen:=R32*4; Inc(HeaderLen,4); End Else SeekLen:=TotalFrames*4;
  If (Flags And 1)<>0 Then APEBps:=8 Else If (Flags And 8)<>0 Then APEBps:=24 Else APEBps:=16;
  If APEVer>=3950 Then BlocksPerFrame:=73728*4 Else BlocksPerFrame:=73728;
  If (Flags And 32)=0 Then Inc(Cur,WavHeader);
 End;
 APELevel:=Level; APEFlags:=Flags;
 If (TotalFrames=0) Or (TotalFrames*4>Limit) Then Fail('ape: aucune trame dans le fichier.');
 If SeekLen Div 4<TotalFrames Then Fail('ape: table de positions incomplete.');
 If (APECh<1) Or (APECh>2) Then Fail('ape: mono ou stereo requis.');
 If (APEBps<>8) And (APEBps<>16) Then Fail('ape: 8 ou 16 bits requis (24 bits non supporte).');
 If (Level Mod 1000<>0) Or (Level>5000) Or (Level=0) Then Fail('ape: niveau de compression incorrect.');
 If (Rate<1) Or (Rate>768000) Then Fail('ape: frequence incorrecte.');
 APEFset:=Level Div 1000-1;
 GetMem(FPos,TotalFrames*8); GetMem(FSize,TotalFrames*8); GetMem(FSkip,TotalFrames*4);
 FPos^[0]:=Junk+Descriptor+HeaderLen+SeekLen+WavHeader; FSkip^[0]:=0; Pos0:=FPos^[0];
 R32;
 For I:=1 To TotalFrames-1 Do Begin
  Entry:=R32; FPos^[I]:=Entry+Junk; FSize^[I-1]:=FPos^[I]-FPos^[I-1];
  FSkip^[I]:=(FPos^[I]-Pos0) And 3;
 End;
 Cur:=Cur+(SeekLen Div 4-TotalFrames)*4;
 FinalSize:=FileSize-FPos^[TotalFrames-1]-WavTail; FinalSize:=FinalSize-(FinalSize And 3);
 If FinalSize<=0 Then FinalSize:=FinalBlocks*8;
 FSize^[TotalFrames-1]:=FinalSize;
 For I:=0 To TotalFrames-1 Do Begin
  If FSkip^[I]<>0 Then Begin Dec(FPos^[I],FSkip^[I]); Inc(FSize^[I],FSkip^[I]); End;
  If FSize^[I]>2147483640 Then Fail('ape: taille de trame incorrecte.');
  FSize^[I]:=(FSize^[I]+3) And Not Int64(3);
 End;
 For I:=0 To 1 Do GetMem(APEDec[I],(APEChunk+16)*4);
 For I:=0 To 2 Do For J:=0 To 1 Do Begin
  Ord:=APEOrders[APEFset,I]; APEFilt[I,J].Coef:=Nil; APEFilt[I,J].Hist:=Nil;
  If Ord>0 Then Begin GetMem(APEFilt[I,J].Coef,Ord*2); GetMem(APEFilt[I,J].Hist,(Ord*2+512+16)*2); End;
 End;
 EAReset; OpenWrite(Target); ADPCMWaveHeader(Rate,APECh,0);
 For I:=0 To TotalFrames-1 Do Begin
  If FSize^[I]<=0 Then Continue;
  Avail:=FileSize-FPos^[I]; If Avail<=0 Then Break;
  Want:=FSize^[I]; If Want>Avail Then Want:=Avail;
  If I=TotalFrames-1 Then NBlocks:=FinalBlocks Else NBlocks:=BlocksPerFrame;
  GetMem(Pk,Want+16+8); Cur:=0;
  While Cur<Want Do Begin
   If Want-Cur>60000 Then Take:=60000 Else Take:=Want-Cur;
   ReadAt(FPos^[I]+Cur,Pk^[8+Cur],Take); Inc(Cur,Take);
  End;
  Pk^[0]:=NBlocks And 255; Pk^[1]:=(NBlocks Shr 8) And 255; Pk^[2]:=(NBlocks Shr 16) And 255; Pk^[3]:=(NBlocks Shr 24) And 255;
  Pk^[4]:=FSkip^[I]; Pk^[5]:=0; Pk^[6]:=0; Pk^[7]:=0;
  APEDecodePacket(Pk,LongInt(Want)+8);
  FreeMem(Pk,Want+16+8);
 End;
 EAFlush;
 If EAWritten=0 Then Fail('ape: aucune donnee audio decodee.');
 ADPCMPatchHeader(Rate,APECh,EAWritten);
 For I:=0 To 1 Do FreeMem(APEDec[I],(APEChunk+16)*4);
 For I:=0 To 2 Do For J:=0 To 1 Do Begin
  Ord:=APEOrders[APEFset,I];
  If Ord>0 Then Begin FreeMem(APEFilt[I,J].Coef,Ord*2); FreeMem(APEFilt[I,J].Hist,(Ord*2+512+16)*2); End;
 End;
 FreeMem(FPos,TotalFrames*8); FreeMem(FSize,TotalFrames*8); FreeMem(FSkip,TotalFrames*4);
 CloseRead; CloseWrite;
End;

