     Dx:=Row Div 2; If (Row And 1)=0 Then Dy:=Dx-1 Else Dy:=Dx+1;
     If Dy<0 Then Dy:=0; If Dy>(Hh+1) Div 2-1 Then Dy:=(Hh+1) Div 2-1;
