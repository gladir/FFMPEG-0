  Inc(PkPos,4);
  Acc:=Acc And ((Int64(1) Shl AccN)-1);
 End;
End;
{ prediction gauche d'une ligne, memorisee dans Dst ; renvoie le dernier echantillon }
Function SubLeft(Dst,Src: PEABuffer; SrcOff,Wd,Left: LongInt): LongInt;
Var Z,Tt: LongInt;
Begin
