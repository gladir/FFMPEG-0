End;
Function RAInterp(Var Out: Array Of LongInt; A,CopyOld: LongInt; Energy: Int64): Int64;
Var Work: Array[0..9] Of LongInt; B,I,K: LongInt;
Begin
 B:=4-A;
 For I:=0 To 9 Do
  Out[I]:=RAS16(((A*Int64(RA.LpcTab[RA.Cur,I])+B*Int64(RA.LpcTab[1-RA.Cur,I])) And $FFFFFFFF) Shr 2);
 If RAEvalRefl(Work,Out) Then Begin
  If CopyOld=0 Then K:=RA.Cur Else K:=1-RA.Cur;
  For I:=0 To 9 Do Out[I]:=RAS16(RA.LpcTab[K,I]);
  RAInterp:=RARescale(RA.LpcRefl[CopyOld],Energy);
 End Else RAInterp:=RARescale(RARms(Work),Energy);
End;
Procedure RADecodeBlock(Buf: PEABuffer; Var Pcm: Array Of SmallInt);
Const Sizes: Array[0..9] Of Byte=(6,5,5,4,4,3,3,3,3,2);
Var
 Bp,I,J,K,CbaIdx,Gain,Cb1,Cb2: LongInt; Refl: Array[0..9] Of LongInt; BlockCoefs: Array[0..3,0..9] Of LongInt; ReflRms: Array[0..3] Of Int64;
 Energy: Int64; Tmp: Array[0..9] Of LongInt; Cf: Array[0..9] Of LongInt;
 Gval: Int64; M: Array[0..2] Of Int64; V: Array[0..2] Of Int64; Sum,S1: Int64; BufS: Array[0..39] Of LongInt; Off,Dup,N,P: LongInt; Sc: Int64; Ov: Boolean;
 Blk: Array[0..39] Of LongInt;
Function GetBits(N: LongInt): LongInt;
Var Z,R: LongInt;
Begin R:=0; For Z:=1 To N Do Begin R:=R*2+((Buf^[Bp Shr 3] Shr (7-(Bp And 7))) And 1); Inc(Bp); End; GetBits:=R; End;
Begin
 Bp:=0;
 For I:=0 To 9 Do Refl[I]:=RAReflCb[RAReflOff[I]+GetBits(Sizes[I])];
 { coefficients courants dans LpcTab[Cur] }
 For I:=0 To 9 Do Cf[I]:=0;
 RAEvalCoefs(Cf,Refl);
 For I:=0 To 9 Do RA.LpcTab[RA.Cur,I]:=Cf[I];
 RA.LpcRefl[0]:=RARms(Refl);
 Energy:=RAEnergyTab[GetBits(5)];
 ReflRms[0]:=RAInterp(BlockCoefs[0],1,1,RA.OldEnergy);
 If Energy<=RA.OldEnergy Then K:=1 Else K:=0;
 ReflRms[1]:=RAInterp(BlockCoefs[1],2,K,RATSqrt((Energy*RA.OldEnergy) And $FFFFFFFF) Shr 12);
 ReflRms[2]:=RAInterp(BlockCoefs[2],3,0,Energy);
 ReflRms[3]:=RARescale(RA.LpcRefl[0],Energy);
 For I:=0 To 9 Do BlockCoefs[3,I]:=RAS16(RA.LpcTab[RA.Cur,I]);
 For I:=0 To 3 Do Begin
  CbaIdx:=GetBits(7); Gain:=GetBits(8); Cb1:=GetBits(7); Cb2:=GetBits(7);
  Gval:=ReflRms[I];
  { ff_subblock_synthesis }
  If CbaIdx<>0 Then Begin
   Inc(CbaIdx,19);
   { copy_and_dup }
   Off:=146-CbaIdx;
   If CbaIdx<40 Then N:=CbaIdx Else N:=40;
   For J:=0 To N-1 Do RA.BufA[J]:=RA.Adapt[Off+J];
   If CbaIdx<40 Then For J:=0 To 40-CbaIdx-1 Do RA.BufA[CbaIdx+J]:=RA.Adapt[Off+J];
   { irms }
   Sum:=0; For J:=0 To 39 Do Sum:=(Sum+Int64(RA.BufA[J])*RA.BufA[J]) And $FFFFFFFF;
   If Sum=0 Then P:=0 Else P:=$20000000 Div ((RATSqrt(Sum) And $FFFFFFFF) Shr 8);
   M[0]:=((Int64(P) And $FFFFFFFF)*Gval And $FFFFFFFF) Shr 12;
  End Else M[0]:=0;
  M[1]:=((Int64(RACb1Base[Cb1])*Gval) And $FFFFFFFF) Shr 8;
  M[2]:=((Int64(RACb2Base[Cb2])*Gval) And $FFFFFFFF) Shr 8;
  For J:=0 To 145-40 Do RA.Adapt[J]:=RA.Adapt[J+40];
  { add_wav }
  V[0]:=0;
  If CbaIdx<>0 Then K:=0 Else K:=1;
  For J:=K To 2 Do V[J]:=(((Int64(RAGainVal[Gain*3+J])*(M[J] And $FFFFFFFF)) And $FFFFFFFF) Shr RAGainExp[Gain]);
  For J:=0 To 39 Do Begin
   If V[0]<>0 Then Begin
    Sum:=((Int64(RA.BufA[J])*(V[0] And $FFFFFFFF)) And $FFFFFFFF)+Int64(RACb1Vects[Cb1*40+J])*RAWrap(V[1])+Int64(RACb2Vects[Cb2*40+J])*RAWrap(V[2]);
   End Else Sum:=Int64(RACb1Vects[Cb1*40+J])*RAWrap(V[1])+Int64(RACb2Vects[Cb2*40+J])*RAWrap(V[2]);
   Blk[J]:=RAS16(RASar(RAWrap(Sum),12));
   RA.Adapt[106+J]:=Blk[J];
  End;
  For J:=0 To 9 Do RA.CurSb[J]:=RA.CurSb[J+40];
  { filtre de synthese LPC }
  Ov:=False;
  For N:=0 To 39 Do Begin
   Sc:=$FFF;
   For J:=1 To 10 Do Sc:=RAWrap(Sc-RAWrap(Int64(BlockCoefs[I,J-1])*RA.CurSb[10+N-J]));
   S1:=RASar(Sc,12)+Blk[N];
   Sum:=RAClip16(S1);
   If Sum<>S1 Then Begin Ov:=True; Break; End;
   RA.CurSb[10+N]:=Sum;
  End;
  If Ov Then FillChar(RA.CurSb,SizeOf(RA.CurSb),0);
  For J:=0 To 39 Do Pcm[I*40+J]:=RAClip16(Int64(RA.CurSb[J+10])*4);
 End;
 RA.OldEnergy:=Energy;
 RA.LpcRefl[1]:=RA.LpcRefl[0];
 RA.Cur:=1-RA.Cur;
End;

Procedure DecodeRA144(Const Source,Target: String);
Var I,P,N,J,Blocks,Tot: LongInt; Pcm: Array[0..159] Of SmallInt; Kk,Found: LongInt; Lp: LongInt;
Begin
 RMParse(Source);
 Found:=-1; Lp:=RMl32(0);
 For I:=0 To RMNS-1 Do If (RMSt[I].Kind=1) And (RMSt[I].Tag=$4A637 * 0 + (Ord('l') + Ord('p')*256 + Ord('c')*65536 + Ord('J')*16777216)) Then Begin Found:=I; Break; End;
 If Found<0 Then Fail('real_144: aucun flux RealAudio 1.0 (lpcJ).');
 FillChar(RA,SizeOf(RA),0);
 EAReset; OpenWrite(Target); ADPCMWaveHeader(8000,1,0);
 For P:=0 To RMNPk-1 Do If RMPkS^[P]=Found Then Begin
  Blocks:=RMPkLen^[P] Div 20;
  For N:=0 To Blocks-1 Do Begin
   RADecodeBlock(PEABuffer(@RMArena^[RMPkOff^[P]+N*20]),Pcm);
   For J:=0 To 159 Do EAPut(Pcm[J]);
  End;
 End;
 EAFlush;
 If EAWritten=0 Then Fail('real_144: aucune trame decodee.');
 ADPCMPatchHeader(8000,1,EAWritten); CloseWrite;
 RMFree;
End;


