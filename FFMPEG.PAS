Function QCBits(Const B: Array Of Byte; Var Bp: LongInt; N: LongInt): LongInt;
Var R,Z: LongInt;
Begin R:=0; For Z:=1 To N Do Begin R:=R*2+((B[Bp Shr 3] Shr (7-(Bp And 7))) And 1); Inc(Bp); End; QCBits:=R; End;
Procedure QCInitTab;
Var I: LongInt; D: Double;
Begin
