{ quantification inverse d'un bloc 4x4 raster : C -> D ; Dc0 : valeur DC deja calculee (si Sep) }
Procedure H4Dequant4(Var C: Array Of LongInt; Off: LongInt; Var D: Array Of LongInt; List,Qp: LongInt; Sep: Boolean; Dc0: LongInt);
Var I,Qd,Qm,V: LongInt;
Begin
 Qd:=Qp Div 6; Qm:=Qp Mod 6;
 For I:=0 To 15 Do Begin
  V:=C[Off+I];
  If V=0 Then D[I]:=0
  Else If Qd>=4 Then D[I]:=(V*H4Ls4[List,Qm,I]) Shl (Qd-4)
  Else D[I]:=H4Sar(V*H4Ls4[List,Qm,I]+(1 Shl (3-Qd)),4-Qd);
 End;
 If Sep Then D[0]:=Dc0;
End;
Procedure H4Dequant8(Var C: Array Of LongInt; Off: LongInt; Var D: Array Of LongInt; List,Qp: LongInt);
Var I,Qd,Qm,V: LongInt;
Begin
 Qd:=Qp Div 6; Qm:=Qp Mod 6;
 For I:=0 To 63 Do Begin
  V:=C[Off+I];
  If V=0 Then D[I]:=0
  Else If Qd>=6 Then D[I]:=(V*H4Ls8[List,Qm,I]) Shl (Qd-6)
  Else D[I]:=H4Sar(V*H4Ls8[List,Qm,I]+(1 Shl (5-Qd)),6-Qd);
 End;
End;
{ DC luma Intra16x16 : Hadamard + mise a l'echelle ; Lv : 16 niveaux en raster 4x4 ; Out en raster }
Procedure H4LumaDcTransform(Var Lv: Array Of LongInt; Var Out: Array Of LongInt; Qp: LongInt);
Var T,F: Array[0..15] Of LongInt; I,J,A,B,C,D,Qd,Qm,Ls: LongInt;
Begin
 For I:=0 To 3 Do Begin
  A:=Lv[I*4]; B:=Lv[I*4+1]; C:=Lv[I*4+2]; D:=Lv[I*4+3];
  T[I*4]:=A+B+C+D; T[I*4+1]:=A+B-C-D; T[I*4+2]:=A-B-C+D; T[I*4+3]:=A-B+C-D;
 End;
 For J:=0 To 3 Do Begin
  A:=T[J]; B:=T[4+J]; C:=T[8+J]; D:=T[12+J];
  F[J]:=A+B+C+D; F[4+J]:=A+B-C-D; F[8+J]:=A-B-C+D; F[12+J]:=A-B+C-D;
 End;
 Qd:=Qp Div 6; Qm:=Qp Mod 6; Ls:=H4Ls4[0,Qm,0];
 For I:=0 To 15 Do
  If Qd>=6 Then Out[I]:=(F[I]*Ls) Shl (Qd-6) Else Out[I]:=H4Sar(F[I]*Ls+(1 Shl (5-Qd)),6-Qd);
End;

