 DCCrcPresent:=DCBits(1);
 DCNPcm:=DCBits(7)+1;
 If (DCNPcm And 7)<>0 Then Exit;
 DCFrameSize:=DCBits(14)+1;
 If DCFrameSize<96 Then Exit;
 DCMode:=DCBits(6);
 If DCMode>=10 Then Exit;
 DCSr:=DCBits(4);
 If DCRates[DCSr]=0 Then Exit;
 DCBrCode:=DCBits(5);
 If DCBits(1)<>0 Then Exit;
 DCDrc:=DCBits(1); DCTs:=DCBits(1); DCAux:=DCBits(1); Dummy:=DCBits(1);
 DCExtType:=DCBits(3); DCExtPresent:=DCBits(1); DCSyncSsf:=DCBits(1);
 DCLfe:=DCBits(2); If DCLfe=3 Then Exit;
 DCPredHist:=DCBits(1);
 If DCCrcPresent<>0 Then Dummy:=DCBits(16);
 DCFilterPerfect:=DCBits(1);
 Dummy:=DCBits(4); Dummy:=DCBits(2);
 Dummy:=DCBits(3);
 If (Dummy=4) Or (Dummy=7) Then Exit;
 DCSumFront:=DCBits(1); DCSumSurr:=DCBits(1); Dummy:=DCBits(4);
 DCBitRate:=DCABitRates[DCBrCode];
 DCParseHeader:=True;
End;

Function DCParseCoding: Boolean;
Var N,Ch,Idx: LongInt;
Begin
 DCParseCoding:=False;
 If DCLeft<0 Then Exit;
 DCNSub:=DCBits(4)+1;
 DCNCh:=DCBits(3)+1;
 If DCNCh<>DCAChannelsTab[DCMode] Then Exit;
 For Ch:=0 To DCNCh-1 Do Begin
  DCNSubbands[Ch]:=DCBits(5)+2;
  If DCNSubbands[Ch]>32 Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do DCVqStart[Ch]:=DCBits(5)+1;
 For Ch:=0 To DCNCh-1 Do Begin
  N:=DCBits(3);
  If N>DCNCh Then Exit;
  DCJointIdx[Ch]:=N;
 End;
 For Ch:=0 To DCNCh-1 Do DCTransSel[Ch]:=DCBits(2);
 For Ch:=0 To DCNCh-1 Do Begin DCSfSel[Ch]:=DCBits(3); If DCSfSel[Ch]=7 Then Exit; End;
 For Ch:=0 To DCNCh-1 Do Begin DCBaSel[Ch]:=DCBits(3); If DCBaSel[Ch]=7 Then Exit; End;
 For N:=0 To 9 Do For Ch:=0 To DCNCh-1 Do DCQSel[Ch,N]:=DCBits(DCCbSel[N]);
 For N:=0 To 9 Do For Ch:=0 To DCNCh-1 Do
  If DCQSel[Ch,N]<DCCbGrp[N] Then Begin Idx:=DCBits(2); DCSfAdj[Ch,N]:=DCAScaleAdj[Idx]; End;
 If DCCrcPresent<>0 Then Idx:=DCBits(16);
 DCParseCoding:=True;
End;

Function DCParseSubHeader(Sf: LongInt): Boolean;
Var Ch,Band,Sel,Abits,SI,R: LongInt;
Begin
 DCParseSubHeader:=False;
 If DCLeft<0 Then Exit;
 DCNSubSub[Sf]:=DCBits(2)+1;
 R:=DCBits(3);
 For Ch:=0 To DCNCh-1 Do For Band:=0 To DCNSubbands[Ch]-1 Do DCPredMode[Ch,Band]:=DCBits(1);
 For Ch:=0 To DCNCh-1 Do For Band:=0 To DCNSubbands[Ch]-1 Do If DCPredMode[Ch,Band]<>0 Then DCPredVq[Ch,Band]:=DCBits(12);
 For Ch:=0 To DCNCh-1 Do Begin
  Sel:=DCBaSel[Ch];
  For Band:=0 To DCVqStart[Ch]-1 Do Begin
   If Sel<5 Then Abits:=DCVlc(48+Sel) Else Abits:=DCBits(Sel-1);
   If DCErr Or (Abits>26) Then Exit;
   DCBitAlloc[Ch,Band]:=Abits;
  End;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  FillChar(DCTrans[Sf,Ch],SizeOf(DCTrans[Sf,Ch]),0);
  If DCNSubSub[Sf]>1 Then Begin
   Sel:=DCTransSel[Ch];
   For Band:=0 To DCVqStart[Ch]-1 Do If DCBitAlloc[Ch,Band]<>0 Then DCTrans[Sf,Ch,Band]:=DCVlc(58+Sel);
  End;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  Sel:=DCSfSel[Ch]; SI:=0;
  For Band:=0 To DCVqStart[Ch]-1 Do Begin
   If DCBitAlloc[Ch,Band]<>0 Then Begin
    DCScale[Ch,Band,0]:=DCParseScale(SI,Sel); If DCErr Then Exit;
    If DCTrans[Sf,Ch,Band]<>0 Then Begin DCScale[Ch,Band,1]:=DCParseScale(SI,Sel); If DCErr Then Exit; End;
   End Else DCScale[Ch,Band,0]:=0;
  End;
  For Band:=DCVqStart[Ch] To DCNSubbands[Ch]-1 Do Begin
   DCScale[Ch,Band,0]:=DCParseScale(SI,Sel); If DCErr Then Exit;
  End;
 End;
 For Ch:=0 To DCNCh-1 Do If DCJointIdx[Ch]<>0 Then Begin
  DCJointSel[Ch]:=DCBits(3); If DCJointSel[Ch]=7 Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  SI:=DCJointIdx[Ch]-1;
  If SI>=0 Then Begin
   Sel:=DCJointSel[Ch];
   For Band:=DCNSubbands[Ch] To DCNSubbands[SI]-1 Do Begin
    DCJointScale[Ch,Band]:=DCParseJoint(Sel); If DCErr Then Exit;
   End;
  End;
 End;
 If (DCDrc<>0) Then R:=DCBits(8);
 If DCCrcPresent<>0 Then R:=DCBits(16);
 DCParseSubHeader:=True;
End;

Function DCPredict(Ch,Band,Pred,At: LongInt): LongInt;
Var I: LongInt; S: Int64;
Begin
 S:=0;
 For I:=0 To 3 Do S:=S+Int64(DCSub^[(Ch*32+Band)*DCStride+4+At-1-I])*DCAAdpcmVb[Pred*4+I];
 DCPredict:=DCClip23(DCNorm(S,13));
End;

Function DCParseSubAudio(Sf: LongInt; Var SubPos,LfePos: LongInt): Boolean;
Var
 Audio: Array[0..15] Of LongInt; N,Ssf,Ofs,Ch,Band,NSamples,Abits,Sel,Ret,Step,Trans,Scl,Idx,Code1,Code2,Levels,Off2,Dv,Hi,J,SrcCh,NLfe,Sh,Base,Vq: LongInt;
 Adj,StepScale: Int64; VqIdx: Array[0..31] Of LongInt; Sc: LongInt;
 Ok: Boolean;
Function Extract(AbitsV,ChV: LongInt; Var Ret2: LongInt): Boolean;
Var K,SelV,C1,C2,Lv,Of3,Dd: LongInt;
Begin
 Extract:=True; Ret2:=0;
 If AbitsV=0 Then Begin FillChar(Audio,SizeOf(Audio),0); Exit; End;
 If AbitsV<=10 Then Begin
  SelV:=DCQSel[ChV,AbitsV-1];
  If SelV<DCCbGrp[AbitsV-1] Then Begin
   For K:=0 To 7 Do Audio[K]:=DCVlc(DCQI[AbitsV-1,SelV]);
   Ret2:=1; Exit;
  End;
  If AbitsV<=7 Then Begin
   C1:=DCBits(DCBlockBits[AbitsV-1]); C2:=DCBits(DCBlockBits[AbitsV-1]); Lv:=DCAQuantLevels[AbitsV]; Of3:=(Lv-1) Div 2;
   For K:=0 To 3 Do Begin Dd:=C1 Div Lv; Audio[K]:=C1-Dd*Lv-Of3; C1:=Dd; End;
   For K:=4 To 7 Do Begin Dd:=C2 Div Lv; Audio[K]:=C2-Dd*Lv-Of3; C2:=Dd; End;
   If (C1 Or C2)<>0 Then Extract:=False;
   Exit;
  End;
 End;
 For K:=0 To 7 Do Audio[K]:=DCSBits(AbitsV-3);
End;
Begin
 DCParseSubAudio:=False;
 NSamples:=DCNSubSub[Sf]*8;
 If SubPos+NSamples>DCNPcm Then Exit;
 If DCLeft<0 Then Exit;
 { sous-bandes VQ haute frequence }
 For Ch:=0 To DCNCh-1 Do Begin
  For Band:=DCVqStart[Ch] To DCNSubbands[Ch]-1 Do VqIdx[Band]:=DCBits(10);
  For Band:=DCVqStart[Ch] To DCNSubbands[Ch]-1 Do
   For J:=0 To NSamples-1 Do
    DCSub^[(Ch*32+Band)*DCStride+4+SubPos+J]:=DCClip23(AVSar(Int64(DCAHfVq[VqIdx[Band]*32+J])*DCScale[Ch,Band,0]+8,4));
 End;
 { LFE }
 If DCLfe<>0 Then Begin
  NLfe:=2*DCLfe*DCNSubSub[Sf];
  For N:=0 To NLfe-1 Do Audio[N]:=DCSBits(8);
  Idx:=DCBits(8);
  If Idx>=128 Then Exit;
  Sc:=DCAScale7[Idx];
  Sc:=DCNorm(Int64(4697620)*Sc,23);
  Ofs:=LfePos;
  For N:=0 To NLfe-1 Do Begin DCLfeS[Ofs]:=DCClip23(AVSar(Int64(Audio[N])*Sc,4)); Inc(Ofs); End;
  LfePos:=Ofs;
 End;
 { donnees audio }
 Ofs:=SubPos;
 For Ssf:=0 To DCNSubSub[Sf]-1 Do Begin
  For Ch:=0 To DCNCh-1 Do Begin
   If DCLeft<0 Then Exit;
   For Band:=0 To DCVqStart[Ch]-1 Do Begin
    Abits:=DCBitAlloc[Ch,Band];
    If Not Extract(Abits,Ch,Ret) Then Exit;
    If DCErr Then Exit;
    If DCBitRate=3 Then Step:=DCALossless[Abits] Else Step:=DCALossy[Abits];
    Trans:=DCTrans[Sf,Ch,Band];
    If (Trans=0) Or (Ssf<Trans) Then Scl:=DCScale[Ch,Band,0] Else Scl:=DCScale[Ch,Band,1];
    If Ret>0 Then Begin
     Adj:=DCSfAdj[Ch,Abits-1];
     Scl:=DCClip23(AVSar(Adj*Scl,22));
    End;
    StepScale:=Int64(Step)*Scl; Sh:=0;
    If StepScale>(1 Shl 23) Then Begin
     Hi:=StepScale Shr 23; Sh:=0; While Hi>1 Do Begin Hi:=Hi Shr 1; Inc(Sh); End; Inc(Sh);
     StepScale:=StepScale Shr Sh;
    End;
    For N:=0 To 7 Do
     DCSub^[(Ch*32+Band)*DCStride+4+Ofs+N]:=DCClip23(DCNorm(Int64(Audio[N])*StepScale,22-Sh));
   End;
  End;
  If (Ssf=DCNSubSub[Sf]-1) Or (DCSyncSsf<>0) Then
   If DCBits(16)<>$FFFF Then Exit;
  Inc(Ofs,8);
 End;
 { ADPCM inverse }
 For Ch:=0 To DCNCh-1 Do
  For Band:=0 To DCNSubbands[Ch]-1 Do
   If DCPredMode[Ch,Band]<>0 Then
    For J:=0 To NSamples-1 Do Begin
     Idx:=(Ch*32+Band)*DCStride+4+SubPos+J;
     DCSub^[Idx]:=DCClip23(Int64(DCSub^[Idx])+DCPredict(Ch,Band,DCPredVq[Ch,Band],SubPos+J));
    End;
 { codage joint }
 For Ch:=0 To DCNCh-1 Do Begin
  SrcCh:=DCJointIdx[Ch]-1;
  If SrcCh>=0 Then
   For Band:=DCNSubbands[Ch] To DCNSubbands[SrcCh]-1 Do
    For J:=0 To NSamples-1 Do
     DCSub^[(Ch*32+Band)*DCStride+4+SubPos+J]:=DCClip23(DCNorm(Int64(DCSub^[(SrcCh*32+Band)*DCStride+4+SubPos+J])*DCJointScale[Ch,Band],17));
 End;
 SubPos:=Ofs;
 DCParseSubAudio:=True;
End;

Function DCDecodeFrame(P: PEABuffer; Size: LongInt): Boolean;
Var Sf,SubPos,LfePos,Ch,Band,NSb,I,J: LongInt;
Begin
 DCDecodeFrame:=False; DCErr:=False;
 DCBuf:=P; DCSize:=Size;
 If Not DCParseHeader Then Exit;
 If DCNPcm>512 Then Exit;
 If DCPredHist=0 Then
  For Ch:=0 To 6 Do For Band:=0 To 31 Do
   FillChar(DCSub^[(Ch*32+Band)*DCStride],16,0);
 If Not DCParseCoding Then Exit;
 SubPos:=0; LfePos:=8;
 For Sf:=0 To DCNSub-1 Do Begin
  If Not DCParseSubHeader(Sf) Then Exit;
  If DCErr Then Exit;
  If Not DCParseSubAudio(Sf,SubPos,LfePos) Then Exit;
  If DCErr Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  NSb:=DCNSubbands[Ch];
  If DCJointIdx[Ch]<>0 Then If DCNSubbands[DCJointIdx[Ch]-1]>NSb Then NSb:=DCNSubbands[DCJointIdx[Ch]-1];
  For Band:=0 To 31 Do Begin
   I:=(Ch*32+Band)*DCStride;
   If Band<NSb Then Move(DCSub^[I+DCNPcm],DCSub^[I],16)
   Else FillChar(DCSub^[I],(4+DCNPcm)*4,0);
  End;
 End;
 DCDecodeFrame:=True;
End;

{ Filtrage de synthese de sous-bandes (synth_filter_float) pour un canal; Out recoit npcmblocks*32 echantillons }
Procedure DCSynthChannel(Ch: LongInt; Win: Pointer; Out: PDCF);
Var
 Blk,I,J,K,Offset: LongInt; Inp: Array[0..31] Of Single; W: PDCF; H1: PDCF;
 A,B,C,D: Single; Acc: Double; Scale: Single;
Begin
 W:=PDCF(Win); Scale:=1.0/131072.0; H1:=PDCF(@DCHist1[Ch,0]);
 For Blk:=0 To DCNPcm-1 Do Begin
  For I:=0 To 31 Do Begin
   If ((I+3) And 2)<>0 Then Inp[I]:=-DCSmp(Ch,I,Blk) Else Inp[I]:=DCSmp(Ch,I,Blk);
  End;
  Offset:=DCOff[Ch];
  For I:=0 To 31 Do Begin
   Acc:=0;
   For K:=0 To 31 Do Acc:=Acc+Inp[K]*DCCos[I,K];
   H1^[Offset+I]:=Acc;
  End;
  For I:=0 To 15 Do Begin
   A:=DCHist2[Ch,I]; B:=DCHist2[Ch,I+16]; C:=0; D:=0;
   J:=0;
   While J<512-Offset Do Begin
    A:=A+W^[I+J]*(-H1^[Offset+15-I+J]);
    B:=B+W^[I+J+16]*H1^[Offset+I+J];
    C:=C+W^[I+J+32]*H1^[Offset+16+I+J];
    D:=D+W^[I+J+48]*H1^[Offset+31-I+J];
    Inc(J,64);
   End;
   While J<512 Do Begin
    A:=A+W^[I+J]*(-H1^[Offset+15-I+J-512]);
    B:=B+W^[I+J+16]*H1^[Offset+I+J-512];
    C:=C+W^[I+J+32]*H1^[Offset+16+I+J-512];
    D:=D+W^[I+J+48]*H1^[Offset+31-I+J-512];
    Inc(J,64);
   End;
   Out^[Blk*32+I]:=A*Scale; Out^[Blk*32+I+16]:=B*Scale;
   DCHist2[Ch,I]:=C; DCHist2[Ch,I+16]:=D;
  End;
  DCOff[Ch]:=(Offset-32) And 511;
 End;
End;

{ Interpolation du canal LFE (lfe_fir_float) vers Out (npcmblocks*32 echantillons) }
Procedure DCLfeChannel(Out: PDCF);
Var Dec,Factor,NCoef,NLfe,I,J,K,Base,P: LongInt; A,B: Single; Coef: PDCF;
Begin
 If DCLfe=1 Then Dec:=1 Else Dec:=0;
 Factor:=64 Shl Dec; NCoef:=8 Shr Dec; NLfe:=DCNPcm Shr (Dec+1);
 If Dec=1 Then Coef:=PDCF(@DCLfe128F) Else Coef:=PDCF(@DCLfe64F);
 For I:=0 To NLfe-1 Do Begin
  Base:=8+I;
  For J:=0 To Factor Div 2-1 Do Begin
   A:=0; B:=0;
   For K:=0 To NCoef-1 Do Begin
    A:=A+Coef^[J*NCoef+K]*DCLfeS[Base-K];
    B:=B+Coef^[255-J*NCoef-K]*DCLfeS[Base-K];
   End;
   Out^[I*Factor+J]:=A; Out^[I*Factor+Factor Div 2+J]:=B;
  End;
 End;
 For I:=7 DownTo 0 Do DCLfeS[I]:=DCLfeS[NLfe+I];
End;

{ Decode un fichier DTS brut (core, 16 bits BE/LE ou 14 bits) vers un WAV PCM 16 bits (5.1 max, canaux dans l'ordre WAV). }
Procedure DecodeDCA(Const Source,Target: String);
Var
 F,Cv: PEABuffer; Size,CvSize,Pos2,P,I,J,K,N,Mask,WavMask,NSpk,Chn,Frames,Nout,Ch,Spk,Wc,Rate0,Q,Code,DataBytes,Tmp,LfeSp: LongInt;
 Fmt: Integer; Word2: LongInt; Win: Pointer; Out: Array[0..6] Of PDCF; WavMap: Array[0..17] Of LongInt; Order: Array[0..6] Of LongInt;
 Pcm: Array[0..8191] Of Byte; Used: LongInt; X: Single; V: LongInt; Fs: LongInt; T: Single; Got: Boolean;
 Wr: Array[0..71] Of Byte; Started: Boolean; Sync4: Int64;
Procedure P32(At: LongInt; Vv: LongInt);
Var Z: Integer;
Begin For Z:=0 To 3 Do Begin Wr[At+Z]:=Vv And 255; Vv:=Vv Shr 8; End; End;
Procedure P16(At: LongInt; Vv: LongInt);
Begin Wr[At]:=Vv And 255; Wr[At+1]:=(Vv Shr 8) And 255; End;
Procedure Header(NCh,Rate,Bytes,MaskW: LongInt);
Begin
 FillChar(Wr,SizeOf(Wr),0);
 Wr[0]:=82; Wr[1]:=73; Wr[2]:=70; Wr[3]:=70; Wr[8]:=87; Wr[9]:=65; Wr[10]:=86; Wr[11]:=69;
 Wr[12]:=102; Wr[13]:=109; Wr[14]:=116; Wr[15]:=32;
 If NCh<=2 Then Begin
  P32(4,36+Bytes); P32(16,16); P16(20,1); P16(22,NCh); P32(24,Rate); P32(28,Rate*NCh*2); P16(32,NCh*2); P16(34,16);
  Wr[36]:=100; Wr[37]:=97; Wr[38]:=116; Wr[39]:=97; P32(40,Bytes); WriteBytes(Wr,44);
 End Else Begin
  P32(4,60+Bytes); P32(16,40); P16(20,$FFFE); P16(22,NCh); P32(24,Rate); P32(28,Rate*NCh*2); P16(32,NCh*2); P16(34,16);
  P16(36,22); P16(38,16); P32(40,MaskW);
  Wr[44]:=1; Wr[47]:=0; Wr[48]:=0; Wr[49]:=0; Wr[50]:=16; Wr[52]:=128; Wr[55]:=170; Wr[57]:=56; Wr[58]:=155; Wr[59]:=113;
  Wr[60]:=100; Wr[61]:=97; Wr[62]:=116; Wr[63]:=97; P32(64,Bytes); WriteBytes(Wr,68);
 End;
End;
Procedure FlushPcm;Begin If Used>0 Then Begin WriteBytes(Pcm,Used); Used:=0; End; End;
Begin
 DCInit;
 OpenRead(Source); Size:=InputSize;
 GetMem(F,Size+64); K:=0;
 While K<Size Do Begin
  If Size-K>4096 Then Q:=4096 Else Q:=Size-K;
  ReadAt(K,F^[K],Q); Inc(K,Q);
 End;
 CloseRead;
 { format du flux: synchro au debut (apres eventuel bourrage) }
 Fmt:=-1; P:=0;
 While P+4<=Size Do Begin
  Sync4:=Int64(F^[P])*16777216+F^[P+1]*65536+F^[P+2]*256+F^[P+3];
  If Sync4=$7FFE8001 Then Fmt:=0 Else If Sync4=$FE7F0180 Then Fmt:=1 Else If Sync4=$1FFFE800 Then Fmt:=2 Else If Sync4=$FF1F00E8 Then Fmt:=3;
  If Fmt>=0 Then Break;
  Inc(P);
 End;
 If Fmt<0 Then Fail('dts: aucun mot de synchronisation DTS trouve.');
 GetMem(Cv,Size+64); CvSize:=0;
 If Fmt=0 Then Begin Move(F^[P],Cv^[0],Size-P); CvSize:=Size-P; End
 Else If Fmt=1 Then Begin
  I:=P; While I+1<Size Do Begin Cv^[CvSize]:=F^[I+1]; Cv^[CvSize+1]:=F^[I]; Inc(CvSize,2); Inc(I,2); End;
 End Else Begin
  FillChar(Cv^,Size+64,0); N:=0; I:=P;
  While I+1<Size Do Begin
   If Fmt=2 Then Word2:=(F^[I]*256+F^[I+1]) And $3FFF Else Word2:=(F^[I+1]*256+F^[I]) And $3FFF;
   For K:=13 DownTo 0 Do Begin
    If ((Word2 Shr K) And 1)<>0 Then Cv^[N Shr 3]:=Cv^[N Shr 3] Or (128 Shr (N And 7));
    Inc(N);
   End;
   Inc(I,2);
  End;
  CvSize:=N Div 8;
 End;
 FreeMem(F,Size+64);
 GetMem(Win,2048);
 For I:=0 To 5 Do Out[I]:=Nil;
 For I:=0 To 6 Do GetMem(Out[I],16384*4+64);
 OpenWrite(Target); Used:=0; Started:=False; Frames:=0; DataBytes:=0; Rate0:=0; Chn:=0; WavMask:=0;
 Pos2:=0;
 While Pos2+10<=CvSize Do Begin
  If Not ((Cv^[Pos2]=$7F) And (Cv^[Pos2+1]=$FE) And (Cv^[Pos2+2]=$80) And (Cv^[Pos2+3]=1)) Then Begin Inc(Pos2); Continue; End;
  Tmp:=Cv^[Pos2+4]*16777216+Cv^[Pos2+5]*65536+Cv^[Pos2+6]*256+Cv^[Pos2+7];
  Fs:=((Tmp Shr 4) And $3FFF)+1;
  If Fs<96 Then Begin Inc(Pos2,4); Continue; End;
  If Pos2+Fs>CvSize Then Fs:=CvSize-Pos2;
  Got:=DCDecodeFrame(PEABuffer(@Cv^[Pos2]),Fs);
  If Got Then Begin
   Mask:=DCModeMask[DCMode];
   If DCLfe<>0 Then Mask:=Mask Or 32;
   If DCFilterPerfect<>0 Then Win:=@DCFir32P Else Win:=@DCFir32N;
   For Ch:=0 To DCNCh-1 Do Begin
    Spk:=DCPrmSpk[DCMode,Ch];
    DCSynthChannel(Ch,Win,Out[Spk]);
   End;
   If DCLfe<>0 Then DCLfeChannel(Out[5]);
   If ((DCSumFront<>0) And (DCMode>0)) Or (DCMode=3) Then
    For I:=0 To DCNPcm*32-1 Do Begin T:=Out[1]^[I]-Out[2]^[I]; Out[1]^[I]:=Out[1]^[I]+Out[2]^[I]; Out[2]^[I]:=T; End;
   If (DCSumSurr<>0) And (DCMode>=8) Then
    For I:=0 To DCNPcm*32-1 Do Begin T:=Out[3]^[I]-Out[4]^[I]; Out[3]^[I]:=Out[3]^[I]+Out[4]^[I]; Out[4]^[I]:=T; End;
   { ordre WAV }
   For I:=0 To 17 Do WavMap[I]:=-1;
   WavMask:=0;
   For Spk:=0 To 6 Do If (Mask And (1 Shl Spk))<>0 Then Begin
    Wc:=DCDca2Wav[Spk];
    If WavMap[Wc]<0 Then Begin WavMap[Wc]:=Spk; WavMask:=WavMask Or (1 Shl Wc); End;
   End;
   NSpk:=0;
   For Wc:=0 To 17 Do If WavMap[Wc]>=0 Then Begin Order[NSpk]:=WavMap[Wc]; Inc(NSpk); End;
   If Not Started Then Begin
    Chn:=NSpk; Rate0:=DCRates[DCSr];
    Header(Chn,Rate0,0,WavMask); Started:=True;
   End;
   If (NSpk=Chn) And (DCRates[DCSr]=Rate0) Then Begin
    For I:=0 To DCNPcm*32-1 Do
     For Ch:=0 To Chn-1 Do Begin
      T:=Out[Order[Ch]]^[I]*32768.0;
      V:=Round(T);
      If V>32767 Then V:=32767; If V<-32768 Then V:=-32768;
      If V<0 Then Inc(V,65536);
      Pcm[Used]:=V And 255; Pcm[Used+1]:=V Shr 8; Inc(Used,2);
      If Used>=8190 Then FlushPcm;
     End;
    Inc(DataBytes,DCNPcm*32*Chn*2);
    If DataBytes>2000000000 Then Fail('dts: sortie superieure a 2 Go.');
   End;
   Inc(Frames);
  End;
  Inc(Pos2,Fs);
 End;
 If Not Started Then Fail('dts: aucune trame DTS decodable.');
 FlushPcm;
 {$I-}Seek(ActiveOutput,0); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('dts: positionnement entete WAV impossible.');
 Header(Chn,Rate0,DataBytes,WavMask);
 CloseWrite;
 FreeMem(Cv,Size+64);
End;


{ ---- Cook (RealAudio G2): decodeur adapte de libavcodec/cook.c, cookdata.h et du demultiplexeur RealMedia libavformat/rmdec.c (LGPL-2.1-or-later). Seuls .rm/.rmvb avec entrelacement genr sont pris en charge. ---- }
Const
 CKExpBits: Array[0..7] Of LongInt=(
  52,47,43,37,29,22,16,0);
 CKDither: Array[0..8] Of LongInt=(
  0,0,0,0,0,1043662088,1048576000,1060439287,1065353216);
 CKCentroid: Array[0..97] Of LongInt=(
  0,1053340729,1061343461,1066359849,1069354582,1072332538,1074509382,1076010942,1077487337,1078963732,1080444322,1081887162,1082734412,1083648770,
