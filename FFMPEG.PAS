     End Else If FRBegun<>Bs Then Ok:=False;
    End;
   End;
   21: Begin
    Ok:=F1Frame(PEABuffer(@AXF^[PkPos]),PkLen);
    If Ok Then Begin
     If Not FFBegun Then Begin
      NVBegin(Mode,Target,AXW,AXH,F1Fmt,RN,RD); NVAviSar(AXW,AXH); FFBegun:=True;
