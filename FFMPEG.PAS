 TDCF=Array[0..1048575] Of Single; PDCF=^TDCF;
Const
 DCStride=516; { 4 echantillons d'historique ADPCM + 512 }
 DCCbSel: Array[0..9] Of Byte=(1,2,2,2,2,3,3,3,3,3);
 DCCbGrp: Array[0..9] Of Byte=(1,3,3,3,3,7,7,7,7,7);
 DCCbSize: Array[0..9] Of Byte=(3,5,7,9,13,17,25,33,65,129);
 DCCbOff: Array[0..9] Of ShortInt=(-1,-2,-3,-4,-6,-8,-12,-16,-32,-64);
 DCRates: Array[0..15] Of LongInt=(0,8000,16000,32000,0,0,11025,22050,44100,0,0,12000,24000,48000,96000,192000);
 DCBlockBits: Array[0..6] Of Byte=(7,10,12,13,15,17,19);
 DCPrmSpk: Array[0..9,0..4] Of ShortInt=((0,-1,-1,-1,-1),(1,2,-1,-1,-1),(1,2,-1,-1,-1),(1,2,-1,-1,-1),(1,2,-1,-1,-1),(0,1,2,-1,-1),(1,2,6,-1,-1),(0,1,2,6,-1),(1,2,3,4,-1),(0,1,2,3,4));
 { masque haut-parleurs DCA par mode: C=1 L=2 R=4 Ls=8 Rs=16 LFE=32 Cs=64 }
 DCModeMask: Array[0..9] Of Byte=(1,6,6,6,6,7,70,71,30,31);
 DCDca2Wav: Array[0..27] Of Byte=(2,0,1,9,10,3,8,4,5,9,10,6,7,12,13,14,3,6,7,11,12,14,16,15,17,8,4,5);
Var
 DCBuf: PEABuffer; DCSize,DCBit: LongInt; DCErr: Boolean;
 DCStart,DCNum,DCOffs: Array[0..61] Of LongInt;
 DCCode: Array[0..2708] Of LongInt; DCMaxLen: Array[0..61] Of LongInt;
 DCQI: Array[0..9,0..6] Of LongInt;
 DCFir32P,DCFir32N,DCLfe64F,DCLfe128F: Array[0..511] Of Single;
 DCCos: Array[0..31,0..31] Of Double;
 DCSub: PDCI32; DCLfeS: Array[0..300] Of LongInt;
 DCHist1: Array[0..6,0..1023] Of Single; DCHist2: Array[0..6,0..63] Of Single; DCOff: Array[0..6] Of LongInt;
