  If Bitshift=32 Then Begin For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=0; End
  Else If Bitshift<>0 Then For I:=0 To Blocksize-1 Do Dc[Ch]^[Nwrap+I]:=W32(Int64(Dc[Ch]^[Nwrap+I])*(Int64(1) Shl Bitshift));
