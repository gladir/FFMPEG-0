 If Cid=1241 Then DXFindCid:=3;
 If Cid=1242 Then DXFindCid:=4;
 If Cid=1243 Then DXFindCid:=5;
 If Cid=1244 Then DXFindCid:=6;
 If Cid=1250 Then DXFindCid:=7;
 If Cid=1251 Then DXFindCid:=8;
 If Cid=1252 Then DXFindCid:=9;
 If Cid=1253 Then DXFindCid:=10;
 If Cid=1256 Then DXFindCid:=11;
 If Cid=1258 Then DXFindCid:=12;
 If Cid=1259 Then DXFindCid:=13;
 If Cid=1260 Then DXFindCid:=14;
 If Cid=1270 Then DXFindCid:=15;
 If Cid=1271 Then DXFindCid:=16;
 If Cid=1272 Then DXFindCid:=17;
 If Cid=1273 Then DXFindCid:=18;
 If Cid=1274 Then DXFindCid:=19;
