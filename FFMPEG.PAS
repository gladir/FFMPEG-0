Function R2Dot(Const A: Array Of Single; Ao: LongInt; Const B: Array Of Single; Bo: LongInt; Len: LongInt): Single;
Var P: Single; I: LongInt;
Begin P:=0.0; For I:=0 To Len-1 Do P:=P+A[Ao+I]*B[Bo+I]; R2Dot:=P; End;
Procedure R2Convolve(Var Tgt: Array Of Single; Const Src: Array Of Single; So: LongInt; Len,N: LongInt);
Begin
 While N>=0 Do Begin Tgt[N]:=R2Dot(Src,So,Src,So-N,Len); Dec(N); End;
End;
{ ff_celp_lp_synthesis_filterf, Out[OutPos..] avec historique avant OutPos }
Procedure R2LpSynth(Var Out: Array Of Single; OutPos: LongInt; Const Co: Array Of Single; Const Inp: Array Of Single; BufLen,FLen: LongInt);
Var Out0,Out1,Out2,Out3,Old0,Old1,Old2,Old3,A,B,C,Val,Tmp0,Tmp1,Tmp2,T: Single; N,I,Ip,Op: LongInt;
Begin
 A:=Co[0]; B:=Co[1]; C:=Co[2];
 B:=B-Co[0]*Co[0]; C:=C-Co[1]*Co[0]; C:=C-Co[0]*B;
 Old0:=Out[OutPos-4]; Old1:=Out[OutPos-3]; Old2:=Out[OutPos-2]; Old3:=Out[OutPos-1];
 N:=0; Ip:=0; Op:=OutPos;
 While N<=BufLen-4 Do Begin
  Out0:=Inp[Ip]; Out1:=Inp[Ip+1]; Out2:=Inp[Ip+2]; Out3:=Inp[Ip+3];
  Out0:=Out0-Co[2]*Old1; Out1:=Out1-Co[2]*Old2; Out2:=Out2-Co[2]*Old3;
  Out0:=Out0-Co[1]*Old2; Out1:=Out1-Co[1]*Old3;
  Out0:=Out0-Co[0]*Old3;
  Val:=Co[3];
  Out0:=Out0-Val*Old0; Out1:=Out1-Val*Old1; Out2:=Out2-Val*Old2; Out3:=Out3-Val*Old3;
  I:=5;
  While I<FLen Do Begin
   Old3:=Out[Op-I];
   Val:=Co[I-1];
   Out0:=Out0-Val*Old3; Out1:=Out1-Val*Old0; Out2:=Out2-Val*Old1; Out3:=Out3-Val*Old2;
   Old2:=Out[Op-I-1];
   Val:=Co[I];
   Out0:=Out0-Val*Old2; Out1:=Out1-Val*Old3; Out2:=Out2-Val*Old0; Out3:=Out3-Val*Old1;
   T:=Old0; Old0:=Old2; Old2:=T;
   Old1:=Old3;
   Inc(I,2);
  End;
  Tmp0:=Out0; Tmp1:=Out1; Tmp2:=Out2;
  Out3:=Out3-A*Tmp2; Out2:=Out2-A*Tmp1; Out1:=Out1-A*Tmp0;
  Out3:=Out3-B*Tmp1; Out2:=Out2-B*Tmp0;
  Out3:=Out3-C*Tmp0;
  Out[Op]:=Out0; Out[Op+1]:=Out1; Out[Op+2]:=Out2; Out[Op+3]:=Out3;
  Old0:=Out0; Old1:=Out1; Old2:=Out2; Old3:=Out3;
  Inc(Op,4); Inc(Ip,4); Inc(N,4);
 End;
 { Op/Ip correspondent a la position N ; reprise echantillon par echantillon }
 While N<BufLen Do Begin
  Out[OutPos+N]:=Inp[N];
  For I:=1 To FLen Do Out[OutPos+N]:=Out[OutPos+N]-Co[I-1]*Out[OutPos+N-I];
  Inc(N);
 End;
End;
{ compute_lpc_coefs (float), normalize=1, fail=1, lpc_stride=0 ; retourne True si echec }
Function R2LpcCoefs(Const Autoc: Array Of Single; MaxOrder: LongInt; Var Lpc: Array Of Single): Boolean;
Var I,J: LongInt; Err,R,F,B: Single;
Begin
 R2LpcCoefs:=False;
 Err:=Autoc[0];
 If (Autoc[MaxOrder]=0) Or (Err<=0) Then Begin R2LpcCoefs:=True; Exit; End;
 For I:=0 To MaxOrder-1 Do Begin
  R:=-Autoc[1+I];
  For J:=0 To I-1 Do R:=R-Lpc[J]*Autoc[1+I-J-1];
  If Err<>0 Then R:=R/Err;
  Err:=Err*(1.0-R*R);
  Lpc[I]:=R;
  For J:=0 To ((I+1) Shr 1)-1 Do Begin
   F:=Lpc[J]; B:=Lpc[I-1-J];
   Lpc[J]:=F+R*B;
   Lpc[I-1-J]:=B+R*F;
  End;
  If Err<0 Then Begin R2LpcCoefs:=True; Exit; End;
 End;
End;
Procedure R2Backward(Var Hist: Array Of Single; Var Rec: Array Of Single; Const Win: Array Of Single; Var Lpc: Array Of Single; Const Tab: Array Of Single; Order,N,NonRec,MoveSize: LongInt);
Var Work: Array[0..127] Of Single; B1,B2,Temp: Array[0..36] Of Single; I,Tot: LongInt; Fail: Boolean;
Begin
 Tot:=Order+N+NonRec;
 For I:=0 To Tot-1 Do Work[I]:=Win[I]*Hist[I];
 R2Convolve(B1,Work,Order,N,Order);
 R2Convolve(B2,Work,Order+N,NonRec,Order);
 For I:=0 To Order Do Begin
  Rec[I]:=Single(Double(Rec[I])*0.5625+B1[I]);
  Temp[I]:=Rec[I]+B2[I];
 End;
 Temp[0]:=Single(Double(Temp[0])*(257.0/256.0));
 Fail:=R2LpcCoefs(Temp,Order,Lpc);
 If Not Fail Then For I:=0 To Order-1 Do Lpc[I]:=Lpc[I]*Tab[I];
 For I:=0 To MoveSize-1 Do Hist[I]:=Hist[I+N];
End;
