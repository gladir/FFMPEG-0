Type
 TIV3Cell=Record X,Y,W,H: LongInt; Tree: LongInt; HasMv: Boolean; MvY,MvX: LongInt; End;
Var
 IV3Buf: Array[0..2,0..1] Of PEABuffer; IV3BufSize: Array[0..2] Of LongInt;
 IV3Pitch,IV3PW,IV3PH: Array[0..2] Of LongInt;
 IV3W,IV3H,IV3Sel,IV3CbOff,IV3FrameFlags,IV3DataSize,IV3AltQuant: LongInt;
 IV3YPtr,IV3VPtr,IV3UPtr,IV3YSize,IV3VSize,IV3USize: LongInt;
 IV3Pk: PEABuffer; IV3PkLen: LongInt;
 IV3Requant: Array[0..7,0..127] Of Byte; IV3Ready: Boolean;
 { lecteur de bits MSB d'abord sur le paquet }
 IV3GbBase,IV3GbIdx,IV3GbSize: LongInt; IV3NeedResync: Boolean; IV3SkipBits: LongInt;
 IV3NextCell,IV3LastByte,IV3NumVec,IV3McBase: LongInt;

Function IV3Byte(O: LongInt): LongInt;
Begin If (O<0) Or (O>=IV3PkLen) Then IV3Byte:=0 Else IV3Byte:=IV3Pk^[O]; End;

Procedure IV3Build;
Const Off: Array[0..7] Of ShortInt=(1,1,2,-3,-3,3,4,4); Del: Array[0..7] Of ShortInt=(0,1,0,4,4,1,0,1);
Var I,J,Step: LongInt;
Begin
 For I:=0 To 7 Do Begin
  Step:=I+2;
  For J:=0 To 127 Do IV3Requant[I,J]:=((J+Off[I]) Div Step*Step+Del[I]) And 255;
 End;
 IV3Requant[0,127]:=126; IV3Requant[1,119]:=118; IV3Requant[1,120]:=118; IV3Requant[2,126]:=124; IV3Requant[2,127]:=124;
 IV3Requant[6,124]:=120; IV3Requant[6,125]:=120; IV3Requant[6,126]:=120; IV3Requant[6,127]:=120;
 IV3Requant[1,7]:=10; IV3Requant[4,8]:=10;
 IV3Ready:=True;
End;

Function IV3R16(B: PEABuffer; O: LongInt): Int64; Begin IV3R16:=B^[O]+B^[O+1]*256; End;
Function IV3R32(B: PEABuffer; O: LongInt): Int64; Begin IV3R32:=Int64(B^[O])+Int64(B^[O+1])*256+Int64(B^[O+2])*65536+Int64(B^[O+3])*16777216; End;
Procedure IV3W16(B: PEABuffer; O: LongInt; V: Int64); Begin B^[O]:=V And 255; B^[O+1]:=(V Shr 8) And 255; End;
Procedure IV3W32(B: PEABuffer; O: LongInt; V: Int64); Begin B^[O]:=V And 255; B^[O+1]:=(V Shr 8) And 255; B^[O+2]:=(V Shr 16) And 255; B^[O+3]:=(V Shr 24) And 255; End;
Function IV3Rep32(A: Int64): Int64; Begin A:=A And $00FF00FF; IV3Rep32:=A Or ((A Shl 8) And $FFFFFFFF); End;

Function IV3Alloc(LW,LH: LongInt): Boolean;
Var P,CW,CH,LP,CP: LongInt;
Begin
 IV3Alloc:=False;
 If (LW<16) Or (LW>640) Or (LH<16) Or (LH>480) Or Odd(LW) Or Odd(LH) Then Exit;
 IV3W:=LW; IV3H:=LH;
 CW:=((LW Shr 2)+3) And Not 3; CH:=((LH Shr 2)+3) And Not 3;
 LP:=(LW+15) And Not 15; CP:=(CW+15) And Not 15;
 For P:=0 To 2 Do Begin
  If P=0 Then Begin IV3Pitch[P]:=LP; IV3PW[P]:=LW; IV3PH[P]:=LH; IV3BufSize[P]:=LP*(LH+1); End
  Else Begin IV3Pitch[P]:=CP; IV3PW[P]:=CW; IV3PH[P]:=CH; IV3BufSize[P]:=CP*(CH+1); End;
  GetMem(IV3Buf[P,0],IV3BufSize[P]+256); GetMem(IV3Buf[P,1],IV3BufSize[P]+256);
  FillChar(IV3Buf[P,0]^,IV3BufSize[P]+256,0); FillChar(IV3Buf[P,1]^,IV3BufSize[P]+256,0);
  FillChar(IV3Buf[P,0]^,IV3Pitch[P],$40); FillChar(IV3Buf[P,1]^,IV3Pitch[P],$40);
 End;
 IV3Alloc:=True;
End;

{ copie du bloc de la trame precedente (copy_cell) }
Function IV3Pix(P,S: LongInt): PEABuffer;
Begin IV3Pix:=IV3Buf[P,S]; End;

Function IV3CopyCell(P: LongInt; Var C: TIV3Cell): Boolean;
Var Pitch,OffDst,OffSrc,Row,Wd,Hh: LongInt; MvX,MvY: LongInt; Dst,Src: PEABuffer;
Begin
 IV3CopyCell:=False; Pitch:=IV3Pitch[P];
 OffDst:=(C.Y Shl 2)*Pitch+(C.X Shl 2);
 If C.HasMv Then Begin MvY:=C.MvY; MvX:=C.MvX; End Else Begin MvY:=0; MvX:=0; End;
 If ((C.Y Shl 2)+MvY<-1) Or ((C.X Shl 2)+MvX<0) Or (((C.Y+C.H) Shl 2)+MvY>IV3PH[P]) Or (((C.X+C.W) Shl 2)+MvX>IV3PW[P]) Then Exit;
 Dst:=IV3Pix(P,IV3Sel); Src:=IV3Pix(P,IV3Sel Xor 1);
 OffSrc:=OffDst+MvY*Pitch+MvX;
 Hh:=C.H Shl 2; Wd:=C.W Shl 2;
 For Row:=0 To Hh-1 Do Move(Src^[Pitch+OffSrc+Row*Pitch],Dst^[Pitch+OffDst+Row*Pitch],Wd);
 IV3CopyCell:=True;
End;

Const IV3Ok=0; IV3BadRle=1; IV3BadData=2; IV3BadCounter=3; IV3Unsupported=4; IV3OutOfData=5;

{ decode_cell_data. Block: decalage dans le tampon courant Cur ; Ref: decalage dans RefB (peut etre nil) }
Function IV3CellData(Var C: TIV3Cell; Cur: PEABuffer; Block: LongInt; RefB: PEABuffer; RefBlock: LongInt; RowOff,HZoom,VZoom,Mode: LongInt;
 Dl0,Dl1: LongInt; Swap0,Swap1: Boolean; Var DataPtr: LongInt; LastPtr: LongInt): LongInt;
Var
 X,Y,Line,NumLines,RleBlocks,I,R: LongInt; Code: LongInt; Dst,Ref: LongInt;
 Dyad1,Dyad2,DT,SkipFlag: LongInt; IsTop,IsFirstRow: Boolean; BlkRow,LineOff: LongInt;
 Pix0,Pix1: Int64; A,B: Int64; Mask: Int64; SwapQ: Boolean;
Procedure Copy4(D,Sr,Rows: LongInt);
Var Rr: LongInt;
Begin For Rr:=0 To Rows-1 Do Move(RefB^[Sr+Rr*RowOff],Cur^[D+Rr*RowOff],4); End;
Procedure Fill64(D: LongInt; P0,P1: Int64; N: LongInt);
Var Rr: LongInt;
Begin For Rr:=0 To N-1 Do Begin IV3W32(Cur,D+Rr*RowOff,P0); IV3W32(Cur,D+Rr*RowOff+4,P1); End; End;
Procedure Avg64(D: LongInt; S1: LongInt; S2: LongInt);
Var A0,A1,B0,B1: Int64;
Begin
 A0:=IV3R32(RefB,S1); A1:=IV3R32(RefB,S1+4); B0:=IV3R32(Cur,S2); B1:=IV3R32(Cur,S2+4);
 IV3W32(Cur,D,((A0+B0) Shr 1) And $7F7F7F7F); IV3W32(Cur,D+4,((A1+B1) Shr 1) And $7F7F7F7F);
End;
Procedure Avg32(D: LongInt; S1: LongInt; S2: LongInt);
Begin IV3W32(Cur,D,((IV3R32(RefB,S1)+IV3R32(Cur,S2)) Shr 1) And $7F7F7F7F); End;
Procedure BlockCopy8;
Begin
 Pix0:=IV3R32(RefB,Ref); Pix1:=IV3R32(RefB,Ref+4);
 If IsFirstRow Then Begin
  Pix0:=IV3Rep32(Pix0); Pix1:=IV3Rep32(Pix1);
  Fill64(Dst+RowOff,Pix0,Pix1,7);
  Avg64(Dst,Ref,Dst+RowOff);
 End Else Fill64(Dst,Pix0,Pix1,8);
End;
Procedure LinesCopyM10;
Begin
 Pix0:=IV3R32(RefB,Ref); Pix1:=IV3R32(RefB,Ref+4);
 If IsTop Then Begin
  Pix0:=IV3Rep32(Pix0); Pix1:=IV3Rep32(Pix1);
  Fill64(Dst+RowOff,Pix0,Pix1,(NumLines Shl 1)-1);
  Avg64(Dst,Ref,Dst+RowOff);
 End Else Fill64(Dst,Pix0,Pix1,NumLines Shl 1);
End;
Begin
 IV3CellData:=IV3Ok;
 RleBlocks:=0; SkipFlag:=0; IsFirstRow:=True;
 BlkRow:=(RowOff Shl (2+VZoom))-(C.W Shl 2);
 If VZoom<>0 Then LineOff:=RowOff Else LineOff:=0;
 If (((C.H And VZoom)<>0)) Or ((C.W And HZoom)<>0) Then Begin IV3CellData:=IV3BadData; Exit; End;
 Y:=0;
 While Y<C.H Do Begin
  X:=0;
  While X<C.W Do Begin
   Ref:=RefBlock; Dst:=Block;
   If RleBlocks>0 Then Begin
    If Mode<=4 Then Begin
     If C.HasMv Or (SkipFlag=0) Then Copy4(Dst,Ref,4 Shl VZoom);
    End Else If (Mode=10) And Not C.HasMv Then BlockCopy8;
    Dec(RleBlocks);
   End Else Begin
    Line:=0;
    While Line<4 Do Begin
     NumLines:=1;
     IsTop:=IsFirstRow And (Line=0);
     If (Line And 1)=0 Then SwapQ:=Swap0 Else SwapQ:=Swap1;
     If Mode<=4 Then Begin If (Line And 1)=0 Then DT:=Dl0 Else DT:=Dl1; End Else DT:=Dl1;
     If DataPtr>=LastPtr Then Begin IV3CellData:=IV3OutOfData; Exit; End;
     Code:=IV3Byte(DataPtr); Inc(DataPtr);
     If Code<248 Then Begin
      If Code<IV3NDy[DT] Then Begin
       If DataPtr>=LastPtr Then Begin IV3CellData:=IV3OutOfData; Exit; End;
       Dyad1:=IV3Byte(DataPtr); Inc(DataPtr); Dyad2:=Code;
       If (Dyad1>=IV3NDy[DT]) Or (Dyad1>=248) Then Begin IV3CellData:=IV3BadData; Exit; End;
      End Else Begin
       Dec(Code,IV3NDy[DT]);
       Dyad1:=Code Div IV3QExp[DT]; Dyad2:=Code Mod IV3QExp[DT];
       If SwapQ Then Begin I:=Dyad1; Dyad1:=Dyad2; Dyad2:=I; End;
      End;
      If Mode<=4 Then Begin
       { APPLY_DELTA_4 }
       IV3W16(Cur,Dst+LineOff,(IV3R16(RefB,Ref)+IV3Delta[IV3VqOff[DT]+Dyad1]) And $7F7F);
       IV3W16(Cur,Dst+LineOff+2,(IV3R16(RefB,Ref+2)+IV3Delta[IV3VqOff[DT]+Dyad2]) And $7F7F);
       If Mode>=3 Then Begin
        If IsTop And (C.Y=0) Then Move(Cur^[Dst+RowOff],Cur^[Dst],4) Else Avg32(Dst,Ref,Dst+RowOff);
       End;
      End Else If (Mode=10) And Not C.HasMv Then Begin
       { APPLY_DELTA_8 }
       If IsTop Then Begin
        IV3W32(Cur,Dst+RowOff,(IV3Rep32(IV3R32(RefB,Ref))+IV3Delta8[IV3VqOff[DT]+Dyad1]) And $7F7F7F7F);
        IV3W32(Cur,Dst+RowOff+4,(IV3Rep32(IV3R32(RefB,Ref+4))+IV3Delta8[IV3VqOff[DT]+Dyad2]) And $7F7F7F7F);
       End Else Begin
        IV3W32(Cur,Dst+RowOff,(IV3R32(RefB,Ref)+IV3Delta8[IV3VqOff[DT]+Dyad1]) And $7F7F7F7F);
        IV3W32(Cur,Dst+RowOff+4,(IV3R32(RefB,Ref+4)+IV3Delta8[IV3VqOff[DT]+Dyad2]) And $7F7F7F7F);
       End;
       If IsTop And (C.Y=0) Then Move(Cur^[Dst+RowOff],Cur^[Dst],8) Else Avg64(Dst,Ref,Dst+RowOff);
      End Else Begin
       { APPLY_DELTA_1011_INTER }
       If Mode=10 Then Begin
        IV3W32(Cur,Dst,(IV3R32(Cur,Dst)+IV3Delta8[IV3VqOff[DT]+Dyad1]) And $7F7F7F7F);
        IV3W32(Cur,Dst+4,(IV3R32(Cur,Dst+4)+IV3Delta8[IV3VqOff[DT]+Dyad2]) And $7F7F7F7F);
        IV3W32(Cur,Dst+RowOff,(IV3R32(Cur,Dst+RowOff)+IV3Delta8[IV3VqOff[DT]+Dyad1]) And $7F7F7F7F);
        IV3W32(Cur,Dst+RowOff+4,(IV3R32(Cur,Dst+RowOff+4)+IV3Delta8[IV3VqOff[DT]+Dyad2]) And $7F7F7F7F);
       End Else Begin
        IV3W16(Cur,Dst,(IV3R16(Cur,Dst)+IV3Delta[IV3VqOff[DT]+Dyad1]) And $7F7F);
        IV3W16(Cur,Dst+2,(IV3R16(Cur,Dst+2)+IV3Delta[IV3VqOff[DT]+Dyad2]) And $7F7F);
        IV3W16(Cur,Dst+RowOff,(IV3R16(Cur,Dst+RowOff)+IV3Delta[IV3VqOff[DT]+Dyad1]) And $7F7F);
        IV3W16(Cur,Dst+RowOff+2,(IV3R16(Cur,Dst+RowOff+2)+IV3Delta[IV3VqOff[DT]+Dyad2]) And $7F7F);
       End;
      End;
     End Else Begin
      Case Code Of
       252,255,254,253: Begin
        If Code=252 Then Begin SkipFlag:=0; RleBlocks:=1; Code:=253; End;
        NumLines:=257-Code-Line;
        If NumLines<=0 Then Begin IV3CellData:=IV3BadRle; Exit; End;
        If Mode<=4 Then Copy4(Dst,Ref,NumLines Shl VZoom) Else If (Mode=10) And Not C.HasMv Then LinesCopyM10;
       End;
       251: Begin
        If DataPtr>=LastPtr Then Begin IV3CellData:=IV3OutOfData; Exit; End;
        Code:=IV3Byte(DataPtr); Inc(DataPtr);
        RleBlocks:=(Code And $1F)-1;
        If (Code>=64) Or (RleBlocks<0) Then Begin IV3CellData:=IV3BadCounter; Exit; End;
        SkipFlag:=Code And $20;
        NumLines:=4-Line;
        If (Mode>=10) Or (C.HasMv Or (SkipFlag=0)) Then Begin
         If Mode<=4 Then Copy4(Dst,Ref,NumLines Shl VZoom) Else If (Mode=10) And Not C.HasMv Then LinesCopyM10;
        End;
       End;
       249,250: Begin
        If Code=249 Then Begin SkipFlag:=1; RleBlocks:=1; End;
        If Line<>0 Then Begin IV3CellData:=IV3BadRle; Exit; End;
        NumLines:=4;
        If C.HasMv Then Begin
         If Mode<=4 Then Copy4(Dst,Ref,NumLines Shl VZoom);
        End;
       End;
       Else Begin IV3CellData:=IV3Unsupported; Exit; End;
      End;
     End;
     Inc(Line,NumLines);
     Inc(Ref,RowOff*(NumLines Shl VZoom));
     Inc(Dst,RowOff*(NumLines Shl VZoom));
    End;
   End;
   Inc(Block,4 Shl HZoom); Inc(RefBlock,4 Shl HZoom);
   Inc(X,1+HZoom);
  End;
  Inc(RefBlock,BlkRow); Inc(Block,BlkRow);
  IsFirstRow:=False;
  Inc(Y,1+VZoom);
 End;
End;

{ decode_cell: renvoie le nombre d'octets consommes, ou -1 }
Function IV3DecodeCell(P: LongInt; Var C: TIV3Cell; DataStart,LastPtr: LongInt): LongInt;
Var
 X,Mode,VqIndex,Prim,Second,Zoom,Offset,Err,DataPtr,Code,Pitch: LongInt; Swap0,Swap1: Boolean;
 Cur,RefB: PEABuffer; Block,RefBlock: LongInt; Dl0,Dl1: LongInt;
Begin
 IV3DecodeCell:=-1; DataPtr:=DataStart; Pitch:=IV3Pitch[P];
 Code:=IV3Byte(DataPtr); Inc(DataPtr);
 Mode:=Code Shr 4; VqIndex:=Code And 15;
 Offset:=(C.Y Shl 2)*Pitch+(C.X Shl 2);
 Cur:=IV3Pix(P,IV3Sel); Block:=Offset+Pitch; RefB:=Nil; RefBlock:=0;
 If Not C.HasMv Then Begin
  RefB:=Cur; RefBlock:=Block-Pitch;
 End Else If Mode>=10 Then Begin
  If Not IV3CopyCell(P,C) Then Exit;
 End Else Begin
  If ((C.Y Shl 2)+C.MvY<-1) Or ((C.X Shl 2)+C.MvX<0) Or (((C.Y+C.H) Shl 2)+C.MvY>IV3PH[P]) Or (((C.X+C.W) Shl 2)+C.MvX>IV3PW[P]) Then Exit;
  Inc(Offset,C.MvY*Pitch+C.MvX);
  RefB:=IV3Pix(P,IV3Sel Xor 1); RefBlock:=Offset+Pitch;
 End;
 If (Mode=1) Or (Mode=4) Then Begin
  Code:=IV3Byte(IV3AltQuant+VqIndex);
  Prim:=(Code Shr 4)+IV3CbOff; Second:=(Code And 15)+IV3CbOff;
 End Else Begin
  Inc(VqIndex,IV3CbOff); Prim:=VqIndex; Second:=VqIndex;
 End;
 If (Prim>=24) Or (Second>=24) Then Exit;
 Dl0:=Second; Dl1:=Prim; Swap0:=Second>=16; Swap1:=Prim>=16;
 If (VqIndex>=8) And (RefB<>Nil) Then
  For X:=0 To (C.W Shl 2)-1 Do RefB^[RefBlock+X]:=IV3Requant[VqIndex And 7,RefB^[RefBlock+X] And 127];
 Case Mode Of
  0,1,3,4: Begin
   If (Mode>=3) And C.HasMv Then Exit;
   If Mode>=3 Then Zoom:=1 Else Zoom:=0;
   Err:=IV3CellData(C,Cur,Block,RefB,RefBlock,Pitch,0,Zoom,Mode,Dl0,Dl1,Swap0,Swap1,DataPtr,LastPtr);
  End;
  10,11: Begin
   If (Mode=10) And Not C.HasMv Then
    Err:=IV3CellData(C,Cur,Block,RefB,RefBlock,Pitch,1,1,Mode,Dl0,Dl1,Swap0,Swap1,DataPtr,LastPtr)
   Else Begin
    If (Mode=11) And Not C.HasMv Then Exit;
    If Mode=10 Then Zoom:=1 Else Zoom:=0;
    Err:=IV3CellData(C,Cur,Block,RefB,RefBlock,Pitch,Zoom,1,Mode,Dl0,Dl1,Swap0,Swap1,DataPtr,LastPtr);
   End;
  End;
  Else Exit;
 End;
 If Err<>IV3Ok Then Exit;
 IV3DecodeCell:=DataPtr-DataStart;
End;

Function IV3GetBits2: LongInt;
Var Pos,B0,B1,V: LongInt;
Begin
 Pos:=IV3GbIdx; B0:=IV3Byte(IV3GbBase+(Pos Shr 3)); B1:=IV3Byte(IV3GbBase+(Pos Shr 3)+1);
 V:=((B0 Shl 8) Or B1) Shr (16-(Pos And 7)-2) And 3;
 Inc(IV3GbIdx,2); IV3GetBits2:=V;
End;

Procedure IV3Resync;
Var N: LongInt;
Begin
 If IV3NeedResync And ((IV3GbIdx And 7)=0) Then Begin
  N:=IV3SkipBits;
  If N<-IV3GbIdx Then N:=-IV3GbIdx;
  If N>IV3GbSize+8-IV3GbIdx Then N:=IV3GbSize+8-IV3GbIdx;
  Inc(IV3GbIdx,N); IV3SkipBits:=0; IV3NeedResync:=False;
 End;
End;

Function IV3Bintree(P: LongInt; Code: LongInt; Var Ref: TIV3Cell; Depth,Strip: LongInt): Boolean; { True = erreur }
Var Cur: TIV3Cell; Used,NewSz,Sz,Ri: LongInt; Ok: Boolean;
Function SplitSz(S: LongInt): LongInt; Begin If S>2 Then SplitSz:=((S+2) Shr 2) Shl 1 Else SplitSz:=1; End;
Function CheckCell: Boolean;
Begin CheckCell:=(Cur.X+Cur.W>(IV3PW[P] Shr 2)) Or (Cur.Y+Cur.H>(IV3PH[P] Shr 2)); End;
Begin
 IV3Bintree:=True;
 If Depth<=0 Then Exit;
 Cur:=Ref;
 If Code=0 Then Begin
  Cur.H:=SplitSz(Ref.H);
  Inc(Ref.Y,Cur.H); Dec(Ref.H,Cur.H);
  If (Ref.H<=0) Or (Cur.H<=0) Then Exit;
 End Else If Code=1 Then Begin
  If Cur.W>Strip Then Begin
   If Cur.W<=(Strip Shl 1) Then Cur.W:=Strip Else Cur.W:=2*Strip;
  End Else Cur.W:=SplitSz(Ref.W);
  Inc(Ref.X,Cur.W); Dec(Ref.W,Cur.W);
  If (Ref.W<=0) Or (Cur.W<=0) Then Exit;
 End;
 While IV3GbSize-IV3GbIdx>=2 Do Begin
  IV3Resync;
  Code:=IV3GetBits2;
  Case Code Of
   0,1: If IV3Bintree(P,Code,Cur,Depth-1,Strip) Then Exit;
   2: Begin
    If Cur.Tree=0 Then Begin Cur.HasMv:=False; Cur.Tree:=1; End
    Else Begin
     IV3Resync;
     Code:=IV3GetBits2;
     If Code>=2 Then Exit;
     If CheckCell Then Exit;
     If Not Cur.HasMv Then Exit;
     If Not IV3CopyCell(P,Cur) Then Exit;
     IV3Bintree:=False; Exit;
    End;
   End;
   3: Begin
    If Cur.Tree=0 Then Begin
     If Not IV3NeedResync Then IV3NextCell:=IV3GbBase+((IV3GbIdx+7) Shr 3);
     If IV3NextCell>=IV3LastByte Then Exit;
     Ri:=IV3Byte(IV3NextCell); Inc(IV3NextCell);
     If Ri>=IV3NumVec Then Exit;
     Cur.HasMv:=True;
     Cur.MvY:=IV3Byte(IV3McBase+Ri*2); If Cur.MvY>=128 Then Dec(Cur.MvY,256);
     Cur.MvX:=IV3Byte(IV3McBase+Ri*2+1); If Cur.MvX>=128 Then Dec(Cur.MvX,256);
     Cur.Tree:=1;
     Inc(IV3SkipBits,8); IV3NeedResync:=True;
    End Else Begin
     If Not IV3NeedResync Then IV3NextCell:=IV3GbBase+((IV3GbIdx+7) Shr 3);
     If CheckCell Then Exit;
     Used:=IV3DecodeCell(P,Cur,IV3NextCell,IV3LastByte);
     If Used<0 Then Exit;
     Inc(IV3SkipBits,Used Shl 3); IV3NeedResync:=True;
     Inc(IV3NextCell,Used);
     IV3Bintree:=False; Exit;
    End;
   End;
  End;
 End;
End;

Function IV3Plane(P: LongInt; DataOff,DataSize,Strip: LongInt): Boolean; { True = erreur }
Var NumV: LongInt; Cell: TIV3Cell;
Begin
 IV3Plane:=True;
 NumV:=IV3Byte(DataOff)+IV3Byte(DataOff+1)*256+IV3Byte(DataOff+2)*65536+IV3Byte(DataOff+3)*16777216;
 Inc(DataOff,4); Dec(DataSize,4);
 If NumV>256 Then Exit;
 If (Int64(NumV)*2>DataSize) And (DataSize>=0) Then Exit;
 If DataSize-NumV*2<0 Then Exit;
 IV3NumVec:=NumV; IV3McBase:=DataOff;
 IV3GbBase:=DataOff+NumV*2; IV3GbIdx:=0; IV3GbSize:=(DataSize-NumV*2)*8;
 IV3SkipBits:=0; IV3NeedResync:=False;
 IV3LastByte:=DataOff+DataSize;
 Cell.X:=0; Cell.Y:=0; Cell.W:=IV3PW[P] Shr 2; Cell.H:=IV3PH[P] Shr 2; Cell.Tree:=0; Cell.HasMv:=False; Cell.MvY:=0; Cell.MvX:=0;
 IV3Plane:=IV3Bintree(P,2,Cell,20,Strip);
End;

{ en-tetes: <0 erreur, 0 ok, >0 trame sans donnees }
Function IV3Headers(Pk: PEABuffer; Len: LongInt): LongInt;
Var Pos: LongInt; FrameNum,Word2,CheckSum,DSz: Int64;
 W,H,I,J: LongInt; Starts,Ends,Sz: Array[0..2] Of Int64; Offs: Array[0..2] Of Int64; MinO,MaxO: Int64;
Function G8: LongInt; Begin If Pos<Len Then Begin G8:=Pk^[Pos]; Inc(Pos); End Else G8:=0; End;
Function G16: LongInt; Begin If Pos+2<=Len Then Begin G16:=Pk^[Pos]+Pk^[Pos+1]*256; Inc(Pos,2); End Else Begin G16:=0; Pos:=Len; End; End;
Function G32: Int64; Begin If Pos+4<=Len Then Begin G32:=Int64(Pk^[Pos])+Int64(Pk^[Pos+1])*256+Int64(Pk^[Pos+2])*65536+Int64(Pk^[Pos+3])*16777216; Inc(Pos,4); End Else Begin G32:=0; Pos:=Len; End; End;
Function S32(V: Int64): Int64; Begin If V>=$80000000 Then S32:=V-Int64($100000000) Else S32:=V; End;
Begin
 IV3Headers:=-1; Pos:=0; IV3Pk:=Pk; IV3PkLen:=Len;
 FrameNum:=G32; Word2:=G32; CheckSum:=G32; DSz:=G32;
 If ((FrameNum Xor Word2 Xor DSz Xor $46524D48) And $FFFFFFFF)<>CheckSum Then Exit;
 If G16<>32 Then Exit;
 IV3FrameFlags:=G16;
 IV3DataSize:=LongInt((((G32+7) And $FFFFFFFF) Shr 3) And $7FFFFFFF);
 IV3CbOff:=G8;
 If IV3DataSize=16 Then Begin IV3Headers:=4; Exit; End;
 If IV3DataSize>Len-16 Then IV3DataSize:=Len-16;
 G8; G8; G8;
 H:=G16; W:=G16;
 If (W<1) Or (H<1) Then Exit;
 If (W<>IV3W) Or (H<>IV3H) Then Exit; { changement de dimensions non pris en charge }
 Offs[0]:=S32(G32); Offs[1]:=S32(G32); Offs[2]:=S32(G32); G32; { y, v, u }
 { starts[0]=y, starts[1]=v, starts[2]=u }
 For I:=0 To 2 Do Starts[I]:=Offs[I] And $FFFFFFFF;
 For J:=0 To 2 Do Begin
  Ends[J]:=Int64(IV3DataSize) And $FFFFFFFF;
  For I:=2 DownTo 0 Do If (Starts[I]<Ends[J]) And (Starts[I]>Starts[J]) Then Ends[J]:=Starts[I];
 End;
 For I:=0 To 2 Do Begin Sz[I]:=(Ends[I]-Starts[I]) And $FFFFFFFF; If Sz[I]>=$80000000 Then Sz[I]:=Sz[I]-Int64($100000000); End;
 MinO:=Offs[0]; MaxO:=Offs[0];
 For I:=1 To 2 Do Begin If Offs[I]<MinO Then MinO:=Offs[I]; If Offs[I]>MaxO Then MaxO:=Offs[I]; End;
 If (MinO<0) Or (MaxO>=IV3DataSize-16) Or (MinO<32+16) Then Exit;
 If (Sz[0]<=0) Or (Sz[1]<=0) Or (Sz[2]<=0) Then Exit;
 IV3YPtr:=16+Offs[0]; IV3VPtr:=16+Offs[1]; IV3UPtr:=16+Offs[2];
 IV3YSize:=Sz[0]; IV3VSize:=Sz[1]; IV3USize:=Sz[2];
 IV3AltQuant:=48;
 If (IV3FrameFlags And 2)<>0 Then Exit; { 8 bits par pixel: non pris en charge }
 If (IV3FrameFlags And $30)<>0 Then Exit; { vecteurs demi-pixel }
 IV3Headers:=0;
End;

{ 1 = image prete, 0 = trame de synchronisation (aucune image), -1 = erreur }
Function IV3Frame(Pk: PEABuffer; Len: LongInt): LongInt;
Var R: LongInt;
Begin
 IV3Frame:=-1;
 If Not IV3Ready Then IV3Build;
 R:=IV3Headers(Pk,Len);
 If R<0 Then Exit;
 If R>0 Then Begin IV3Frame:=0; Exit; End;
 IV3Sel:=(IV3FrameFlags Shr 9) And 1;
 If IV3Plane(0,IV3YPtr,IV3YSize,40) Then Exit;
 If IV3Plane(1,IV3UPtr,IV3USize,10) Then Exit;
 If IV3Plane(2,IV3VPtr,IV3VSize,10) Then Exit;
 IV3Frame:=1;
End;


{ output_plane: pixels 7 bits -> 8 bits, vers la trame planaire yuv410p }
Procedure IV3Output(Dst: PEABuffer; CW,CH: LongInt);
Var P,X,Y,Rows,Cols: LongInt; Src: PEABuffer; Base: LongInt;
Begin
 FillChar(Dst^,IV3W*IV3H+2*CW*CH,0);
 Base:=0;
 For P:=0 To 2 Do Begin
  Src:=IV3Pix(P,IV3Sel);
  If P=0 Then Begin Rows:=IV3H; Cols:=IV3W; End Else Begin Rows:=CH; Cols:=CW; End;
  If Rows>IV3PH[P] Then Rows:=IV3PH[P];
  If Cols>IV3PW[P] Then Cols:=IV3PW[P];
  For Y:=0 To Rows-1 Do
   For X:=0 To Cols-1 Do
    If P=0 Then Dst^[Y*IV3W+X]:=(Src^[IV3Pitch[P]+Y*IV3Pitch[P]+X] And $7F) Shl 1
    Else Dst^[IV3W*IV3H+(P-1)*CW*CH+Y*CW+X]:=(Src^[IV3Pitch[P]+Y*IV3Pitch[P]+X] And $7F) Shl 1;
 End;
End;

{ ---- Karl Morton's Video Codec (libavcodec/kmvc.c), AVI KMVC, PAL8 <= 320x200 ---- }
Var
 KMCur,KMPrev: PEABuffer; KMPal: TKMPal; KMPalSize: LongInt; KMSetPal: Boolean;
 KMBuf: PEABuffer; KMLen,KMPos: LongInt; KMBits,KMBitBuf: LongInt;

Function KMByte: LongInt;
Begin
 If KMLen-KMPos<1 Then Begin KMPos:=KMLen; KMByte:=0; Exit; End;
 KMByte:=KMBuf^[KMPos]; Inc(KMPos);
End;

Function KMBe24: LongInt;
Begin
 If KMLen-KMPos<3 Then Begin KMPos:=KMLen; KMBe24:=0; Exit; End;
 KMBe24:=KMBuf^[KMPos]*65536+KMBuf^[KMPos+1]*256+KMBuf^[KMPos+2]; Inc(KMPos,3);
End;

Function KMGetBit: LongInt;
Begin
 If (KMBitBuf And (1 Shl KMBits))<>0 Then KMGetBit:=1 Else KMGetBit:=0;
 Dec(KMBits);
 If KMBits=-1 Then Begin KMBitBuf:=KMByte; KMBits:=7; End;
End;

Function KMIdx(X,Y: LongInt): LongInt;
Var V: LongInt;
Begin
 V:=X+Y*320;
 If V<0 Then V:=0 Else If V>63999 Then V:=63999;
 KMIdx:=V;
End;

Procedure KMIntra(W,H: LongInt);
Var Res,Val,I,J,BX,BY,L0X,L1X,L0Y,L1Y,MX,MY,V: LongInt;
Begin
 KMBits:=7; KMBitBuf:=KMByte;
 BY:=0;
 While BY<H Do Begin
  BX:=0;
  While BX<W Do Begin
   If KMLen-KMPos=0 Then Exit;
   Res:=KMGetBit;
   If Res=0 Then Begin
    Val:=KMByte;
    For I:=0 To 63 Do KMCur^[KMIdx(BX+(I And 7),BY+(I Shr 3))]:=Val;
   End Else Begin
    For I:=0 To 3 Do Begin
     L0X:=BX+(I And 1)*4; L0Y:=BY+(I And 2)*2;
     Res:=KMGetBit;
     If Res=0 Then Begin
      Res:=KMGetBit;
      If Res=0 Then Begin
       Val:=KMByte;
       For J:=0 To 15 Do KMCur^[KMIdx(L0X+(J And 3),L0Y+(J Shr 2))]:=Val;
      End Else Begin
       Val:=KMByte; MX:=Val And 15; MY:=Val Shr 4;
       V:=(L0X-MX)+320*(L0Y-MY);
       If (V<0) Or (V>320*197-4) Then Exit;
       For J:=0 To 15 Do
        KMCur^[KMIdx(L0X+(J And 3),L0Y+(J Shr 2))]:=KMCur^[KMIdx(L0X+(J And 3)-MX,L0Y+(J Shr 2)-MY)];
      End;
     End Else Begin
      For J:=0 To 3 Do Begin
       L1X:=L0X+(J And 1)*2; L1Y:=L0Y+(J And 2);
       Res:=KMGetBit;
       If Res=0 Then Begin
        Res:=KMGetBit;
        If Res=0 Then Begin
         Val:=KMByte;
         KMCur^[KMIdx(L1X,L1Y)]:=Val; KMCur^[KMIdx(L1X+1,L1Y)]:=Val;
         KMCur^[KMIdx(L1X,L1Y+1)]:=Val; KMCur^[KMIdx(L1X+1,L1Y+1)]:=Val;
        End Else Begin
         Val:=KMByte; MX:=Val And 15; MY:=Val Shr 4;
         V:=(L1X-MX)+320*(L1Y-MY);
         If (V<0) Or (V>320*199-2) Then Exit;
         KMCur^[KMIdx(L1X,L1Y)]:=KMCur^[KMIdx(L1X-MX,L1Y-MY)];
         KMCur^[KMIdx(L1X+1,L1Y)]:=KMCur^[KMIdx(L1X+1-MX,L1Y-MY)];
         KMCur^[KMIdx(L1X,L1Y+1)]:=KMCur^[KMIdx(L1X-MX,L1Y+1-MY)];
         KMCur^[KMIdx(L1X+1,L1Y+1)]:=KMCur^[KMIdx(L1X+1-MX,L1Y+1-MY)];
        End;
       End Else Begin
        KMCur^[KMIdx(L1X,L1Y)]:=KMByte; KMCur^[KMIdx(L1X+1,L1Y)]:=KMByte;
        KMCur^[KMIdx(L1X,L1Y+1)]:=KMByte; KMCur^[KMIdx(L1X+1,L1Y+1)]:=KMByte;
       End;
      End;
     End;
    End;
   End;
   Inc(BX,8);
  End;
  Inc(BY,8);
 End;
End;

Procedure KMInter(W,H: LongInt);
Var Res,Val,I,J,BX,BY,L0X,L1X,L0Y,L1Y,MX,MY,V: LongInt;
Begin
 KMBits:=7; KMBitBuf:=KMByte;
 BY:=0;
 While BY<H Do Begin
  BX:=0;
  While BX<W Do Begin
   Res:=KMGetBit;
   If Res=0 Then Begin
    Res:=KMGetBit;
    If Res=0 Then Begin
     If KMLen-KMPos=0 Then Exit;
     Val:=KMByte;
     For I:=0 To 63 Do KMCur^[KMIdx(BX+(I And 7),BY+(I Shr 3))]:=Val;
    End Else
     For I:=0 To 63 Do KMCur^[KMIdx(BX+(I And 7),BY+(I Shr 3))]:=KMPrev^[KMIdx(BX+(I And 7),BY+(I Shr 3))];
   End Else Begin
    If KMLen-KMPos=0 Then Exit;
    For I:=0 To 3 Do Begin
     L0X:=BX+(I And 1)*4; L0Y:=BY+(I And 2)*2;
     Res:=KMGetBit;
     If Res=0 Then Begin
      Res:=KMGetBit;
      If Res=0 Then Begin
       Val:=KMByte;
       For J:=0 To 15 Do KMCur^[KMIdx(L0X+(J And 3),L0Y+(J Shr 2))]:=Val;
      End Else Begin
       Val:=KMByte; MX:=(Val And 15)-8; MY:=(Val Shr 4)-8;
       V:=(L0X+MX)+320*(L0Y+MY);
       If (V<0) Or (V>320*197-4) Then Exit;
       For J:=0 To 15 Do
        KMCur^[KMIdx(L0X+(J And 3),L0Y+(J Shr 2))]:=KMPrev^[KMIdx(L0X+(J And 3)+MX,L0Y+(J Shr 2)+MY)];
      End;
     End Else Begin
      For J:=0 To 3 Do Begin
       L1X:=L0X+(J And 1)*2; L1Y:=L0Y+(J And 2);
       Res:=KMGetBit;
       If Res=0 Then Begin
        Res:=KMGetBit;
        If Res=0 Then Begin
         Val:=KMByte;
         KMCur^[KMIdx(L1X,L1Y)]:=Val; KMCur^[KMIdx(L1X+1,L1Y)]:=Val;
         KMCur^[KMIdx(L1X,L1Y+1)]:=Val; KMCur^[KMIdx(L1X+1,L1Y+1)]:=Val;
        End Else Begin
         Val:=KMByte; MX:=(Val And 15)-8; MY:=(Val Shr 4)-8;
         V:=(L1X+MX)+320*(L1Y+MY);
         If (V<0) Or (V>320*199-2) Then Exit;
         KMCur^[KMIdx(L1X,L1Y)]:=KMPrev^[KMIdx(L1X+MX,L1Y+MY)];
         KMCur^[KMIdx(L1X+1,L1Y)]:=KMPrev^[KMIdx(L1X+1+MX,L1Y+MY)];
         KMCur^[KMIdx(L1X,L1Y+1)]:=KMPrev^[KMIdx(L1X+MX,L1Y+1+MY)];
         KMCur^[KMIdx(L1X+1,L1Y+1)]:=KMPrev^[KMIdx(L1X+1+MX,L1Y+1+MY)];
        End;
       End Else Begin
        KMCur^[KMIdx(L1X,L1Y)]:=KMByte; KMCur^[KMIdx(L1X+1,L1Y)]:=KMByte;
        KMCur^[KMIdx(L1X,L1Y+1)]:=KMByte; KMCur^[KMIdx(L1X+1,L1Y+1)]:=KMByte;
       End;
      End;
     End;
    End;
   End;
   Inc(BX,8);
  End;
  Inc(BY,8);
 End;
End;

{ extradata AVI : palette (avidec.c), puis initialisation du decodeur (decode_init) ; retourne '' ou une erreur }
Function KMInit(W,H: LongInt): String;
Var I,PS,Src: LongInt; V: LongWord;
Begin
 KMInit:='';
 If (W>320) Or (H>200) Then Begin KMInit:='kmvc: images <= 320x200 requises.'; Exit; End;
 GetMem(KMCur,320*200+64); GetMem(KMPrev,320*200+64);
 FillChar(KMCur^,320*200+64,0); FillChar(KMPrev^,320*200+64,0);
 FillChar(AXPal,SizeOf(AXPal),0); AXHasPal:=False;
 If (AXExtraLen>0) And (AXBits<=8) Then Begin
  PS:=(1 Shl AXBits)*4; If PS>AXExtraLen Then PS:=AXExtraLen;
  Src:=AXExtra+AXExtraLen-PS;
  If (Src-AXExtra>=9) And (AXT4(AXExtra+AXExtraLen-9)='Bott') And (AXT4(AXExtra+AXExtraLen-5)='omUp') And (EAByte(AXF,AXSize,AXExtra+AXExtraLen-1)=0) Then Dec(Src,9);
  For I:=0 To PS Div 4-1 Do Begin
   V:=LongWord(EAByte(AXF,AXSize,Src+4*I))+LongWord(EAByte(AXF,AXSize,Src+4*I+1))*256+LongWord(EAByte(AXF,AXSize,Src+4*I+2))*65536+LongWord(EAByte(AXF,AXSize,Src+4*I+3))*16777216;
   AXPal[I]:=$FF000000 Or (V And $FFFFFF);
  End;
  AXHasPal:=True;
 End;
 For I:=0 To 255 Do KMPal[I]:=$FF000000+LongWord(I)*$10101;
 If AXExtraLen<12 Then KMPalSize:=127
 Else Begin
  KMPalSize:=EAByte(AXF,AXSize,AXExtra+10)+EAByte(AXF,AXSize,AXExtra+11)*256;
  If KMPalSize>=256 Then Begin KMPalSize:=127; KMInit:='kmvc: palette trop grande.'; Exit; End;
 End;
 KMSetPal:=False;
 If AXExtraLen=1036 Then Begin
  For I:=0 To 255 Do Begin
   Src:=AXExtra+12+4*I;
   KMPal[I]:=LongWord(EAByte(AXF,AXSize,Src))+LongWord(EAByte(AXF,AXSize,Src+1))*256+LongWord(EAByte(AXF,AXSize,Src+2))*65536+LongWord(EAByte(AXF,AXSize,Src+3))*16777216;
  End;
  KMSetPal:=True;
 End;
End;

{ decode_frame ; palette courante recopiee dans NVPal ; faux si le paquet est refuse }
Function KMFrame(Pk: PEABuffer; Len,W,H: LongInt): Boolean;
Var Header,I,BlockSize,Method: LongInt; T: PEABuffer;
Begin
 KMFrame:=False;
 KMBuf:=Pk; KMLen:=Len; KMPos:=0;
 If AXHasPal Then Begin KMPal:=AXPal; AXHasPal:=False; End;
 Header:=KMByte;
 If (KMPos<KMLen) And (KMBuf^[KMPos]=127) Then Begin
  Inc(KMPos,3); If KMPos>KMLen Then KMPos:=KMLen;
  For I:=0 To 126 Do Begin
   KMPal[I+(Header And $81)]:=$FF000000 Or LongWord(KMBe24);
   Inc(KMPos); If KMPos>KMLen Then KMPos:=KMLen;
  End;
  KMPos:=KMPos-127*4-3; If KMPos<0 Then KMPos:=0;
 End;
 If (Header And $40)<>0 Then
  For I:=1 To KMPalSize Do KMPal[I]:=$FF000000 Or LongWord(KMBe24);
 KMSetPal:=False;
 For I:=0 To 255 Do Begin NVPalR[I]:=(KMPal[I] Shr 16) And 255; NVPalG[I]:=(KMPal[I] Shr 8) And 255; NVPalB[I]:=KMPal[I] And 255; End;
 BlockSize:=KMByte;
 If (BlockSize<>8) And (BlockSize<>127) Then Exit;
 FillChar(KMCur^,320*200,0);
 Method:=Header And 15;
 Case Method Of
  0,1: Move(KMPrev^,KMCur^,320*200);
  3: KMIntra(W,H);
  4: KMInter(W,H);
 Else Exit;
 End;
 T:=KMCur; KMCur:=KMPrev; KMPrev:=T;
 KMFrame:=True;
End;

