Function RAEvalRefl(Var Refl: Array Of LongInt; Const Coefs: Array Of LongInt): Boolean;
Var Buf1,Buf2: Array[0..9] Of LongInt; I,J,B: LongInt; Sw: Boolean; T: Int64;
Begin
 RAEvalRefl:=True;
 For I:=0 To 9 Do Buf2[I]:=Coefs[I];
 Refl[9]:=Buf2[9];
