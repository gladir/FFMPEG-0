 HotClear;
 HideMouse;
 DrawMenuBar(0);
 DrawTabs;
 DrawToolbar;
 Case Tab Of
  0: DrawConvertScreen;
  1: DrawRipper;
  2: DrawMV;
  3: DrawCollage;
  4: DrawToolbox;
 End;
