{$IFDEF FPC}
Var
 VJMed: ^TMedia;
 VJIdx,VJN,VJOutW,VJOutH,VJFn,VJFd,VJBitrate,VJResW,VJResH,VJTrimS,VJTrimE: LongInt;
 VJStarted,VJNeedEdit: Boolean;
 VJOut: PEABuffer;
 VJErr: String;
 VJTmp: File;
 VJTmpName: String;
 VJCnt: LongInt;

Procedure ParseRes(Const S: String; Var W,H: LongInt);
Var P: Integer;
Begin
 W:=0; H:=0; P:=Pos('x',S);
 If P>1 Then Begin W:=ValL(Copy(S,1,P-1)); H:=ValL(Copy(S,P+1,10)); End;
End;

Function Gcd(A,B: LongInt): LongInt;
Var T: LongInt;
Begin
 While B<>0 Do Begin T:=A Mod B; A:=B; B:=T; End;
 Gcd:=A;
End;

Var VJAlt: Boolean; VJDecim: LongInt;
Function AltVideoOut(Var M: TMedia; Const Pr: TProf; Const Dst: String; HaveAudio: Boolean; Var Err: String): Boolean; Forward;

Function Y4mSource(Var M: TMedia; Const Fmt,Codec: String; Var Y4: String; Var Err: String): Integer; Forward;
Function Y4mTrack(Const Y4: String; Var V: TTrkIn): Boolean; Forward;

Function EditsPresent(Const M: TMedia): Boolean;
Begin
 EditsPresent:=(M.Rot Mod 4<>0) Or M.FlipH Or M.FlipV Or (M.CropW>0) Or (M.Bright<>0) Or (M.Contr<>0) Or (M.Satur<>0) Or (M.Hue<>0) Or (M.WmOn And (M.WmText<>''));
End;

Procedure CalcOutDims(Const M: TMedia; W,H: LongInt; Var OW,OH: LongInt);
Var EW,EH: LongInt;
Begin
 EW:=W; EH:=H;
 If (M.CropW>0) And (M.CropX+M.CropW<=W) And (M.CropY+M.CropH<=H) Then Begin EW:=M.CropW; EH:=M.CropH; End;
 If Odd(M.Rot) Then Begin OW:=EW; EW:=EH; EH:=OW; End;
 If (VJResW>0) And (VJResH>0) Then Begin OW:=VJResW; OH:=VJResH; End
 Else Begin OW:=EW; OH:=EH; End;
 OW:=OW And (Not 1); OH:=OH And (Not 1);
 If VJAlt And ((OW>640) Or (OH>480)) Then Begin
  { limites des encodeurs MPEG-4 / WMV / Theora : 640x480 maximum }
  If OW*480>OH*640 Then Begin OH:=Round(OH*640.0/OW); OW:=640; End Else Begin OW:=Round(OW*480.0/OH); OH:=480; End;
  OW:=OW And (Not 1); OH:=OH And (Not 1);
 End;
 If OW<16 Then OW:=16; If OH<16 Then OH:=16;
End;

Procedure ProcFrame(B: PEABuffer; W,H: LongInt);
Var Im,T: PImg;
Begin
 If (Not VJNeedEdit) And (W=VJOutW) And (H=VJOutH) And (Not Odd(W)) And (Not Odd(H)) Then Begin
  Move(B^,VJOut^,W*H*3 Div 2); Exit;
 End;
 Im:=YuvToImg(B,W,H);
 If Im=Nil Then Exit;
 If VJNeedEdit Then ApplyEdit(VJMed^,Im);
 If (Im^.W<>VJOutW) Or (Im^.H<>VJOutH) Then Begin
  T:=ImgFit(Im,VJOutW,VJOutH,0,0,0,False);
  If T<>Nil Then Begin ImgFree(Im); Im:=T; End;
 End;
 ImgToYuv(Im,VJOut);
 ImgFree(Im);
End;

{ Phase 1 : decodage + retouche, images ecrites dans un fichier temporaire }
Procedure TranscodeCb(B: PEABuffer; W,H: LongInt);
Var Ms: LongInt;
Begin
 Inc(VJIdx);
 If (VJDecim>1) And ((VJIdx-1) Mod VJDecim<>0) Then Exit;
 Ms:=Round((VJIdx-1)*1000.0*VJFd/VJFn);
 If Ms<VJTrimS Then Exit;
 If (VJTrimE>0) And (Ms>=VJTrimE) Then Begin VStopFlag:=True; Exit; End;
 If Not VJStarted Then Begin
  CalcOutDims(VJMed^,W,H,VJOutW,VJOutH);
  GetMem(VJOut,VJOutW*VJOutH*3 Div 2+64);
  VJTmpName:=TmpName('YUV');
  Assign(VJTmp,VJTmpName);
  {$I-}Rewrite(VJTmp,1);{$I+}
  If IOResult<>0 Then Begin VJErr:='Fichier temporaire impossible : '+VJTmpName; VStopFlag:=True; Exit; End;
  VJStarted:=True; VJCnt:=0;
 End;
 ProcFrame(B,W,H);
 {$I-}BlockWrite(VJTmp,VJOut^,VJOutW*VJOutH*3 Div 2);{$I+}
 If IOResult<>0 Then Begin VJErr:='Disque plein (fichier temporaire).'; VStopFlag:=True; Exit; End;
 Inc(VJCnt);
 If (VJIdx And 3)=0 Then UiTick(VJIdx,VJN);
 If Stopped Then VStopFlag:=True;
End;

{ Phase 2 : encodage H.264 depuis le fichier temporaire }
Function EncodeTemp(Var Err: String): Boolean;
Var I,Fsz: LongInt; Got: Word; P: LongInt; Ok: Boolean;
Begin
 EncodeTemp:=False;
 Fsz:=VJOutW*VJOutH*3 Div 2;
 If Not VEncBegin(VJOutW,VJOutH,VJFn,VJFd,VJCnt,VJBitrate,Err) Then Exit;
 Seek(VJTmp,0); Ok:=True;
 For I:=1 To VJCnt Do Begin
  P:=0;
  While P<Fsz Do Begin
   {$I-}BlockRead(VJTmp,VJOut^[P],Min(32768,Fsz-P),Got);{$I+}
   If (IOResult<>0) Or (Got=0) Then Begin Ok:=False; Break; End;
   Inc(P,Got);
  End;
  If Not Ok Then Break;
  VEncFrame(VJOut);
  If (I And 3)=0 Then UiTick(I,VJCnt);
  If Stopped Then Begin Ok:=False; Err:='Conversion annul'#233'e.'; Break; End;
 End;
 If (Not Ok) And (Err='') Then Err:='Lecture du fichier temporaire impossible.';
 EncodeTemp:=Ok;
End;

{ ---- ADTS -> piste audio ---- }
Function ParseAdts(Const Path: String; Var T: TTrkIn): Boolean;
Var P,L,H,N,Pass,I: LongInt; Obj,Sfi,Ch: Integer;
Const Rates: Array[0..12] Of LongInt = (96000,88200,64000,48000,44100,32000,24000,22050,16000,12000,11025,8000,7350);
Begin
 ParseAdts:=False; FillChar(T,SizeOf(T),0);
 If Not COpen(Path) Then Exit;
 P:=0; N:=0;
 For Pass:=1 To 2 Do Begin
  P:=0; I:=0;
  While P+7<CSize Do Begin
   If (CB(P)<>$FF) Or ((CB(P+1) And $F0)<>$F0) Then Begin Inc(P); Continue; End;
   If (CB(P+1) And 1)=1 Then H:=7 Else H:=9;
   L:=((LongInt(CB(P+3)) And 3) Shl 11) Or (LongInt(CB(P+4)) Shl 3) Or (CB(P+5) Shr 5);
   If (L<H) Or (P+L>CSize) Then Break;
   If (Pass=1) And (N=0) Then Begin
    Obj:=(CB(P+2) Shr 6)+1; Sfi:=(CB(P+2) Shr 2) And 15; Ch:=((CB(P+2) And 1) Shl 2) Or (CB(P+3) Shr 6);
   End;
   If Pass=2 Then Begin T.Off^[I]:=P+H; T.Sz^[I]:=L-H; T.Dur^[I]:=1024; End;
   Inc(I); Inc(P,L);
  End;
  If Pass=1 Then Begin
   N:=I; If N<1 Then Begin CClose; Exit; End;
   TrkAlloc(T,N);
  End;
 End;
 CClose;
 T.Ok:=True; T.IsVideo:=False; T.Codec:='mp4a'; T.Oti:=$40;
 If Sfi<=12 Then T.Rate:=Rates[Sfi] Else T.Rate:=44100;
 T.Ts:=T.Rate; T.Chans:=Ch; If T.Chans<1 Then T.Chans:=2;
 T.Cfg[0]:=(Obj Shl 3) Or (Sfi Shr 1); T.Cfg[1]:=((Sfi And 1) Shl 7) Or (Ch Shl 3); T.CfgLen:=2;
 ParseAdts:=True;
End;

Function BrandFor(Const Ext: String; Audio: Boolean): String;
Begin
 If Audio Then BrandFor:='M4A ' Else If Ext='MOV' Then BrandFor:='qt  ' Else If Ext='3GP' Then BrandFor:='3gp4' Else If Ext='M4V' Then BrandFor:='M4V ' Else BrandFor:='isom';
End;

{ Ecrit le conteneur choisi par l'extension du profil }
Function MuxOut(Const Ext,Dst: String; Var Tr: Array Of TMuxTrk; NT: Integer; Var Err: String): Boolean;
Begin
 If Ext='FLV' Then MuxOut:=MuxFlv(Dst,Tr,NT,Err)
 Else If Ext='MKV' Then MuxOut:=MuxMkv(Dst,'matroska',Tr,NT,Err)
 Else If Ext='WEBM' Then MuxOut:=MuxMkv(Dst,'webm',Tr,NT,Err)
 Else MuxOut:=MuxMp4(Dst,BrandFor(Ext,False),Tr,NT,Err);
End;

{ Sortie audio AAC (ADTS) ou M4A : a partir du WAV canonique }
Function WriteAacOut(Const Canon,Dst: String; Const Pr: TProf; Var Err: String): Boolean;
Var Adts: String; A: TTrkIn; Tr: Array[0..0] Of TMuxTrk; K: Integer; Kb: LongInt; Ok: Boolean;
Begin
 WriteAacOut:=False;
 Kb:=Pr.AKb; If Kb<64 Then Kb:=128; If Kb>320 Then Kb:=256;
 If Pr.Ext='AAC' Then Begin WriteAacOut:=RunEng(ekEncAAC,Canon,Dst,Kb,Err); Exit; End;
 Adts:=TmpName('AAC');
 If Not RunEng(ekEncAAC,Canon,Adts,Kb,Err) Then Begin DelFile(Adts); Exit; End;
 If Not ParseAdts(Adts,A) Then Begin DelFile(Adts); Err:='Flux AAC invalide.'; Exit; End;
 FillChar(Tr,SizeOf(Tr),0);
 Tr[0].T:=@A; Tr[0].First:=0; Tr[0].Last:=A.N-1; Tr[0].Path:=Adts;
 Ok:=MuxMp4(Dst,'M4A ',Tr,1,Err);
 TrkClear(A); DelFile(Adts);
 WriteAacOut:=Ok;
End;

{ Piste audio du fichier de sortie : copie des paquets AAC ou transcodage }
Function PrepareAudio(Var M: TMedia; Const Pr: TProf; Var Src: TTrkIn; HaveSrc: Boolean; SrcFlv: Boolean; Const SrcPath: String;
 StartMs,EndMs: LongInt; Var Out: TTrkIn; Var OutPath: String; Var First,Last: LongInt; Var Err: String): Boolean;
Var Copy: Boolean; I: LongInt; Acc: Int64; T1,T2,T3: String; SP: TAP; AP: TAP; Rt: LongInt;
Begin
 PrepareAudio:=False; OutPath:='';
 Copy:=HaveSrc And (Src.Codec='mp4a') And (Src.Oti=$40) And (M.Vol=100) And (M.ADelay=0) And (CustRate=0) And (CustCh=0) And (Src.CfgLen>=2) And (Src.Chans<=2);
 If Copy Then Begin
  { fenetre temporelle }
  First:=-1; Last:=-1; Acc:=0;
  For I:=0 To Src.N-1 Do Begin
   If (First<0) And (Acc*1000.0/Src.Ts>=StartMs) Then First:=I;
   If (EndMs>0) And (Acc*1000.0/Src.Ts>=EndMs) Then Break;
   If First>=0 Then Last:=I;
   Inc(Acc,Src.Dur^[I]);
  End;
  If (First<0) Or (Last<First) Then Begin First:=0; Last:=Src.N-1; End;
  OutPath:=SrcPath; Move(Src,Out,SizeOf(Out)); { partage des tableaux }
  PrepareAudio:=True; Exit;
 End;
 { transcodage : decodage -> traitement -> AAC }
 T1:=TmpName('WAV'); T2:=TmpName('WAV'); T3:=TmpName('AAC');
 StageLo:=0; StageHi:=10;
 If Not GetPcm(M,T1,Err) Then Begin DelFile(T1); Exit; End;
 FillChar(SP,SizeOf(SP),0); SP.Vol:=100; SP.Speed:=100;
 BuildAP(M,Pr,AP,SP);
 AP.StartMs:=StartMs; AP.EndMs:=EndMs;
 If AP.OutRate<32000 Then AP.OutRate:=44100;
 If (AP.OutRate<>44100) And (AP.OutRate<>48000) And (AP.OutRate<>32000) Then AP.OutRate:=44100;
 If AP.OutCh=0 Then AP.OutCh:=2;
 If Not ProcessWav(T1,T2,AP,Err) Then Begin DelFile(T1); DelFile(T2); Exit; End;
 DelFile(T1);
 Rt:=Pr.AKb; If Rt<64 Then Rt:=128; If Rt>320 Then Rt:=256;
 If Not RunEng(ekEncAAC,T2,T3,Rt,Err) Then Begin DelFile(T2); DelFile(T3); Exit; End;
 DelFile(T2);
 If Not ParseAdts(T3,Out) Then Begin DelFile(T3); Err:='Encodage AAC invalide.'; Exit; End;
 OutPath:=T3; First:=0; Last:=Out.N-1;
 PrepareAudio:=True;
End;

Procedure FpsOf(Var V: TTrkIn; Var Fn,Fd: LongInt);
Var I: LongInt; Same: Boolean; Acc: Int64; G: LongInt;
Begin
 Fn:=25; Fd:=1; If V.N<1 Then Exit;
 Same:=True; Acc:=0;
 For I:=0 To V.N-1 Do Begin If V.Dur^[I]<>V.Dur^[0] Then Same:=False; Inc(Acc,V.Dur^[I]); End;
 If Same And (V.Dur^[0]>0) Then Begin Fn:=V.Ts; Fd:=V.Dur^[0]; End
 Else If Acc>0 Then Begin Fn:=Round(V.N*1000.0*V.Ts/Acc); Fd:=1000*V.Ts; Fn:=Round(V.N*V.Ts*1000.0/Acc); Fd:=1000; End;
 G:=Gcd(Fn,Fd); If G>1 Then Begin Fn:=Fn Div G; Fd:=Fd Div G; End;
 If (Fn<=0) Or (Fd<=0) Or (Fn Div Fd>240) Then Begin Fn:=25; Fd:=1; End;
End;

Procedure BuildAvcC(Var T: TTrkIn);
Var I,L: Integer;
Begin
 L:=0;
 T.Cfg[L]:=1; T.Cfg[L+1]:=X4SpsB[1]; T.Cfg[L+2]:=X4SpsB[2]; T.Cfg[L+3]:=X4SpsB[3]; T.Cfg[L+4]:=$FF; T.Cfg[L+5]:=$E1; Inc(L,6);
 T.Cfg[L]:=X4SpsLen Shr 8; T.Cfg[L+1]:=X4SpsLen And 255; Inc(L,2);
 For I:=0 To X4SpsLen-1 Do Begin T.Cfg[L]:=X4SpsB[I]; Inc(L); End;
 T.Cfg[L]:=1; Inc(L);
 T.Cfg[L]:=X4PpsLen Shr 8; T.Cfg[L+1]:=X4PpsLen And 255; Inc(L,2);
 For I:=0 To X4PpsLen-1 Do Begin T.Cfg[L]:=X4PpsB[I]; Inc(L); End;
 T.CfgLen:=L;
End;

{ Piste video issue de l'encodeur }
Procedure EncoderTrack(Var T: TTrkIn);
Var I: LongInt;
Begin
 FillChar(T,SizeOf(T),0);
 TrkAlloc(T,VEFrame);
 For I:=0 To VEFrame-1 Do Begin
  T.Off^[I]:=X4SampOff^[I]; T.Sz^[I]:=X4SampSz^[I]; T.Dur^[I]:=VEFd; T.Sync^[I]:=X4SampKey^[I];
 End;
 T.Ok:=True; T.IsVideo:=True; T.Codec:='avc1'; T.Ts:=VEFn; T.W:=VEW; T.H:=VEH;
 BuildAvcC(T);
End;

{ MP4/MOV/FLV H.264 -> MP4 (copie de flux ou transcodage) }
Function VideoJob(Var M: TMedia; Const Pr: TProf; Const Dst: String; Var Err: String): Boolean;
Var
 V,A,Vo: TTrkIn; Ok,HaveA,Reenc,AFlv: Boolean; Fmt: String; Tr: Array[0..1] of TMuxTrk; NT: Integer;
 AFirst,ALast,First,Last,I,Fn,Fd,StartMs,EndMs,K: LongInt; AOut: TTrkIn; APath: String; Acc: Int64; SkipV: Boolean;
 Rw,Rh: LongInt; DecMode: Integer; AltHaveA: Boolean; Y4,DecPath: String;
Begin
 VideoJob:=False; Fmt:=M.Fmt;
 Y4:=''; DecPath:=M.Path; FillChar(A,SizeOf(A),0);
 If InList(Fmt,'WMV,ASF,OGV,OGG,MPG,MPEG,M2V,M1V,DAT,VOB') Then Begin
  K:=Y4mSource(M,Fmt,M.VCodec,Y4,Err);
  If K<=0 Then Begin If (K=0) And (Err='') Then Err:='Codec vid'#233'o '+M.VCodec+' non d'#233'cod'#233'.'; Exit; End;
  If Not Y4mTrack(Y4,V) Then Begin DelFile(Y4); Err:='Fichier vid'#233'o interm'#233'diaire invalide.'; Exit; End;
  DecMode:=5; DecPath:=Y4; Ok:=True;
 End Else Begin
 If InList(Fmt,'MP4,MOV,M4V,3GP') Then Ok:=Mp4Tracks(M.Path,V,A,Err)
 Else If Fmt='FLV' Then Ok:=FlvTracks(M.Path,V,A,Err)
 Else If Fmt='AVI' Then Begin Ok:=AviTracks(M.Path,V,Err); FillChar(A,SizeOf(A),0); End
 Else If InList(Fmt,'MKV,WEBM') Then Ok:=MkvTracks(M.Path,V,A,Err)
 Else Begin Err:='Conteneur vid'#233'o non pris en charge : '+Fmt+' (MP4, MOV, M4V, 3GP, FLV, AVI, MKV, WMV, MPEG, OGV).'; Exit; End;
 If Not Ok Then Exit;
 If Not V.Ok Then Begin TrkClear(V); TrkClear(A); Err:='Aucune piste vid'#233'o dans ce fichier.'; Exit; End;
 DecMode:=VideoMode(Fmt,V);
 If DecMode<0 Then Begin
  { codecs decodes par les moteurs de FFMPEG.PAS via un fichier Y4M }
  K:=Y4mSource(M,Fmt,V.Codec,Y4,Err);
  If K>0 Then Begin
   TrkClear(V);
   If Not Y4mTrack(Y4,V) Then Begin DelFile(Y4); Err:='Fichier vid'#233'o interm'#233'diaire invalide.'; TrkClear(A); Exit; End;
   DecMode:=5; DecPath:=Y4;
  End Else Begin
   If Err='' Then Err:='Codec vid'#233'o '+V.Codec+' non d'#233'cod'#233' (H.264, MPEG-4/XviD/DivX, VP8, Sorenson H.263, WMV, MPEG-1/2, Theora).';
   TrkClear(V); TrkClear(A); Exit;
  End;
 End;
 End;
 If V.W=0 Then V.W:=M.W; If V.H=0 Then V.H:=M.H;
 HaveA:=A.Ok Or (M.ACodec<>''); AFlv:=Fmt='FLV';
 ParseRes(Pr.Res,VJResW,VJResH);
 If (Pr.Res='Auto') Or (Pr.Res='-') Then Begin VJResW:=0; VJResH:=0; End;
 StartMs:=M.TrimS; EndMs:=M.TrimE;
 VJAlt:=InList(Pr.Ext,'AVI,WMV,OGV,MPG,WEBM'); VJDecim:=1;
 Reenc:=VJAlt Or (DecMode<>0) Or EditsPresent(M) Or (StartMs>0) Or ((VJResW>0) And ((VJResW<>V.W) Or (VJResH<>V.H))) Or (V.W=0);
 FillChar(Tr,SizeOf(Tr),0); NT:=0; Ok:=False; APath:=''; FillChar(AOut,SizeOf(AOut),0);
 SkipV:=False;
 { ---- audio ---- }
 AltHaveA:=HaveA And (M.Vol>0);
 If HaveA And (M.Vol>0) And Not VJAlt Then Begin
  If Not PrepareAudio(M,Pr,A,A.Ok,AFlv,M.Path,StartMs,EndMs,AOut,APath,AFirst,ALast,Err) Then Begin
   If Stopped Then Begin TrkClear(V); TrkClear(A); Exit; End;
   If Pos('Aucune piste audio',Err)=0 Then JobWarn:=' (sans audio : '+Err+')';
   HaveA:=False; Err:='';
  End;
 End Else HaveA:=False;
 { ---- video ---- }
 If Not Reenc Then Begin
  First:=0; Last:=V.N-1;
  If StartMs>0 Then Begin
   Acc:=0; K:=0;
   For I:=0 To V.N-1 Do Begin
    If Acc*1000.0/V.Ts<=StartMs Then If V.Sync^[I]<>0 Then K:=I;
    Inc(Acc,V.Dur^[I]);
   End;
   First:=K;
  End;
  If EndMs>0 Then Begin
   Acc:=0; Last:=V.N-1;
   For I:=0 To V.N-1 Do Begin
    If Acc*1000.0/V.Ts>=EndMs Then Begin Last:=I-1; Break; End;
    Inc(Acc,V.Dur^[I]);
   End;
   If Last<First Then Last:=First;
  End;
  Tr[0].T:=@V; Tr[0].First:=First; Tr[0].Last:=Last; Tr[0].Path:=M.Path; NT:=1;
  If HaveA Then Begin
   Tr[1].T:=@AOut; Tr[1].First:=AFirst; Tr[1].Last:=ALast; Tr[1].Path:=APath; NT:=2;
  End;
  StageLo:=90; StageHi:=100;
  Ok:=MuxOut(Pr.Ext,Dst,Tr,NT,Err);
 End Else Begin
  FpsOf(V,Fn,Fd);
  If VJAlt And (Fn>Fd*30) Then Begin VJDecim:=2; Fd:=Fd*2; End;
  VJFn:=Fn; VJFd:=Fd; VJMed:=@M; VJIdx:=0; VJN:=V.N; VJStarted:=False; VJNeedEdit:=EditsPresent(M);
  VJBitrate:=Pr.VKb*1000; If VJBitrate<=0 Then VJBitrate:=2000000;
  VJTrimS:=StartMs; VJTrimE:=EndMs; VJErr:=''; VJOut:=Nil;
  VFrameCb:=TranscodeCb;
  StageLo:=10; StageHi:=50; VJStarted:=False; VJCnt:=0;
  Ok:=DecodeVideoTrack(DecPath,V,0,DecMode,Err);
  VFrameCb:=Nil;
  If Y4<>'' Then DelFile(Y4);
  If Ok And (VJErr<>'') Then Begin Ok:=False; Err:=VJErr; End;
  If Ok And Not VJStarted Then Begin Ok:=False; Err:='Aucune image d'#233'cod'#233'e.'; End;
  If VJStarted Then Begin
   If Ok Then Begin
    StageLo:=50; StageHi:=90;
    If VJAlt Then Ok:=AltVideoOut(M,Pr,Dst,AltHaveA,Err) Else Ok:=EncodeTemp(Err);
   End;
   Close(VJTmp); DelFile(VJTmpName);
  End;
  If VJOut<>Nil Then Begin FreeMem(VJOut,VJOutW*VJOutH*3 Div 2+64); VJOut:=Nil; End;
  If Ok And Not VJAlt Then Begin
   EncoderTrack(Vo);
   Tr[0].T:=@Vo; Tr[0].First:=0; Tr[0].Last:=Vo.N-1; Tr[0].Mem:=PBArr(X4O); Tr[0].Annex:=True; NT:=1;
   If HaveA Then Begin
    Tr[1].T:=@AOut; Tr[1].First:=AFirst; Tr[1].Last:=ALast; Tr[1].Path:=APath; NT:=2;
   End;
   StageLo:=90; StageHi:=100;
   Ok:=MuxOut(Pr.Ext,Dst,Tr,NT,Err);
   TrkClear(Vo);
  End;
  VEncFree;
 End;
 If HaveA Then Begin
  If (APath<>'') And (APath<>M.Path) Then Begin DelFile(APath); TrkClear(AOut); End;
 End;
 TrkClear(V); TrkClear(A);
 VideoJob:=Ok;
End;

{ Image / GIF anime -> video MP4 (H.264) }
Function ImageVideoJob(Var M: TMedia; Const Pr: TProf; Const Dst: String; Var Err: String): Boolean;
Var A: PAnim; K,Rep,R,I,Total: LongInt; Ok: Boolean; Vo: TTrkIn; Tr: Array[0..0] Of TMuxTrk; Im,T: PImg; Out: PEABuffer; OW,OH: LongInt;
Begin
 ImageVideoJob:=False;
 If Not LoadAnim(M.Path,A,MaxAnim) Then Begin Err:='Format d''image non pris en charge (BMP/GIF seulement).'; Exit; End;
 ParseRes(Pr.Res,VJResW,VJResH);
 If (Pr.Res='Auto') Or (Pr.Res='-') Then Begin VJResW:=0; VJResH:=0; End;
 For K:=1 To A^.N Do ApplyEdit(M,A^.F[K]);
 VJMed:=@M;
 CalcOutDims(M,A^.F[1]^.W,A^.F[1]^.H,OW,OH);
 { le redimensionnement est deja fait par ApplyEdit pour la rotation/crop : ne pas les refaire }
 OW:=A^.F[1]^.W And (Not 1); OH:=A^.F[1]^.H And (Not 1);
 If (VJResW>0) And (VJResH>0) Then Begin OW:=VJResW And (Not 1); OH:=VJResH And (Not 1); End;
 If OW<16 Then OW:=16; If OH<16 Then OH:=16;
 Total:=0;
 For K:=1 To A^.N Do Begin
  If A^.N=1 Then Rep:=125 Else Rep:=Max(1,(A^.Dly[K]*25+50) Div 100);
  Inc(Total,Rep);
 End;
 If Not VEncBegin(OW,OH,25,1,Total,Max(Pr.VKb*1000,1000000),Err) Then Begin AnimFree(A); Exit; End;
 GetMem(Out,OW*OH*3 Div 2+64);
 For K:=1 To A^.N Do Begin
  Im:=A^.F[K];
  If (Im^.W<>OW) Or (Im^.H<>OH) Then Begin
   T:=ImgFit(Im,OW,OH,0,0,0,False); If T<>Nil Then Begin ImgFree(A^.F[K]); A^.F[K]:=T; Im:=T; End;
  End;
  ImgToYuv(Im,Out);
  If A^.N=1 Then Rep:=125 Else Rep:=Max(1,(A^.Dly[K]*25+50) Div 100);
  For R:=1 To Rep Do Begin
   VEncFrame(Out);
   If (VEFrame And 7)=0 Then UiTick(VEFrame,Total);
   If Stopped Then Break;
  End;
  If Stopped Then Break;
 End;
 FreeMem(Out,OW*OH*3 Div 2+64); AnimFree(A);
 If Stopped Then Begin VEncFree; Err:='Conversion annul'#233'e.'; Exit; End;
 EncoderTrack(Vo);
 FillChar(Tr,SizeOf(Tr),0);
 Tr[0].T:=@Vo; Tr[0].First:=0; Tr[0].Last:=Vo.N-1; Tr[0].Mem:=PBArr(X4O); Tr[0].Annex:=True;
 StageLo:=90; StageHi:=100;
 Ok:=MuxOut(Pr.Ext,Dst,Tr,1,Err);
 TrkClear(Vo); VEncFree;
 ImageVideoJob:=Ok;
End;
{$ENDIF}
{$IFDEF FPC}
{ ====================================================================== }
{ Sorties video alternatives : AVI (MPEG-4 + MP3), analyse des flux          }
{ ====================================================================== }

{ Flux MP3 -> liste de paquets (un par trame) }
Function ParseMp3(Const Path: String; Var T: TTrkIn): Boolean;
Const Br1: Array[1..14] Of Integer=(32,40,48,56,64,80,96,112,128,160,192,224,256,320);
 Br2: Array[1..14] Of Integer=(8,16,24,32,40,48,56,64,80,96,112,128,144,160);
 Sr: Array[0..2] Of LongInt=(44100,48000,32000);
Var P,L,N,Pass,I,Ver,Idx,Si,Br,Pad,Spf,Rate: LongInt; H: LongInt; Ch: Integer;
Begin
 ParseMp3:=False; FillChar(T,SizeOf(T),0);
 If Not COpen(Path) Then Exit;
 If (CB(0)=Ord('I')) And (CB(1)=Ord('D')) And (CB(2)=Ord('3')) Then P:=10+((CB(6) And 127) Shl 21)+((CB(7) And 127) Shl 14)+((CB(8) And 127) Shl 7)+(CB(9) And 127) Else P:=0;
 N:=0; Rate:=44100; Ch:=2; Spf:=1152;
 For Pass:=1 To 2 Do Begin
  If Pass=2 Then Begin
   If (CB(0)=Ord('I')) And (CB(1)=Ord('D')) And (CB(2)=Ord('3')) Then P:=10+((CB(6) And 127) Shl 21)+((CB(7) And 127) Shl 14)+((CB(8) And 127) Shl 7)+(CB(9) And 127) Else P:=0;
  End;
  I:=0;
  While P+4<CSize Do Begin
   If (CB(P)<>$FF) Or ((CB(P+1) And $E0)<>$E0) Then Begin Inc(P); Continue; End;
   Ver:=(CB(P+1) Shr 3) And 3; Idx:=(CB(P+1) Shr 1) And 3;
   If (Ver=1) Or (Idx<>1) Then Begin Inc(P); Continue; End;
   Br:=CB(P+2) Shr 4; Si:=(CB(P+2) Shr 2) And 3; Pad:=(CB(P+2) Shr 1) And 1;
   If (Br<1) Or (Br>14) Or (Si>2) Then Begin Inc(P); Continue; End;
   If Ver=3 Then Begin L:=144*Br1[Br]*1000 Div Sr[Si]+Pad; Rate:=Sr[Si]; Spf:=1152; End
   Else Begin L:=72*Br2[Br]*1000 Div (Sr[Si] Div 2)+Pad; Rate:=Sr[Si] Div 2; If Ver=0 Then Rate:=Rate Div 1; Spf:=576; End;
   If (CB(P+3) Shr 6)=3 Then Ch:=1 Else Ch:=2;
   If P+L>CSize Then Break;
   If Pass=2 Then Begin T.Off^[I]:=P; T.Sz^[I]:=L; T.Dur^[I]:=Spf; End;
   Inc(I); Inc(P,L);
  End;
  If Pass=1 Then Begin
   N:=I; If N<1 Then Begin CClose; Exit; End;
   TrkAlloc(T,N);
  End;
 End;
 CClose;
 T.Ok:=True; T.IsVideo:=False; T.Codec:='mp3 '; T.Rate:=Rate; T.Ts:=Rate; T.Chans:=Ch;
 ParseMp3:=True;
End;

{ Flux elementaire MPEG-4 Part 2 -> images (les en-tetes precedant la premiere image sont joints a celle-ci) }
Function ParseM4v(Const Path: String; Var T: TTrkIn): Boolean;
Var P,N,Pass,I,Start: LongInt; Key: Boolean;
Begin
 ParseM4v:=False; FillChar(T,SizeOf(T),0);
 If Not COpen(Path) Then Exit;
 For Pass:=1 To 2 Do Begin
  P:=0; I:=0; Start:=-1;
  While P+4<=CSize Do Begin
   If (CB(P)=0) And (CB(P+1)=0) And (CB(P+2)=1) And (CB(P+3)=$B6) Then Begin
    { debut d'une image : la precedente se termine au dernier code de debut avant celle-ci }
    If Start>=0 Then Begin
     If Pass=2 Then T.Sz^[I-1]:=P-Start;
    End;
    If Pass=2 Then Begin
     If I=0 Then T.Off^[I]:=0 Else T.Off^[I]:=P;
     T.Sync^[I]:=Ord((CB(P+4) Shr 6)=0); T.Dur^[I]:=1; T.Cts^[I]:=0;
     If I=0 Then Start:=0 Else Start:=P;
    End Else Start:=P;
    Inc(I); Inc(P,4);
   End Else Inc(P);
  End;
  If Pass=2 Then T.Sz^[I-1]:=CSize-Start;
  If Pass=1 Then Begin
   N:=I; If N<1 Then Begin CClose; Exit; End;
   TrkAlloc(T,N);
  End;
 End;
 CClose;
 T.Ok:=True; T.IsVideo:=True; T.Codec:='MP4V';
 ParseM4v:=True;
End;

{ ---- ecriture d'un AVI (video + audio MP3 facultatif) ---- }
Var AviOut: File; AviIdx: PLArr; AviIdxN: LongInt;

Procedure AW32(V: LongInt); Begin BlockWrite(AviOut,V,4); End;
Procedure AW16(V: Integer); Begin BlockWrite(AviOut,V,2); End;
Procedure ATag(Const S: String); Begin BlockWrite(AviOut,S[1],4); End;

Function MuxAvi(Const Dst: String; Var V,A: TTrkIn; HaveA: Boolean; Const VPath,APath,Fcc: String; Fn,Fd: LongInt; Var Err: String): Boolean;
Var
 FV,FA: File; Ok: Boolean; Hdrl,Strl,Movi,Idx1,MoviStart,Pos0: LongInt; I,J,Total,Ia,Cnt: LongInt; Buf: PBArr; Cap: LongInt;
 Dp: Int64; VT,AT: Double; MaxV,MaxA: LongInt; Z: LongInt; Ad: Double;
 Procedure Fetch(Var F: File; Off,Sz: LongInt);
 Var P: LongInt;
 Begin
  If Sz>Cap Then Begin ReallocMem(Buf,Sz+4096); Cap:=Sz+4096; End;
  {$I-}Seek(F,Off);{$I+}
  P:=0;
  While P<Sz Do Begin
   {$I-}BlockRead(F,Buf^[P],Min(32768,Sz-P),Cnt32);{$I+}
   If (IOResult<>0) Or (Cnt32=0) Then Break;
   Inc(P,Cnt32);
  End;
 End;
 Procedure PutChunk(Const Id: String; Sz,Flags,Kind: LongInt);
 Begin
  AviIdx^[AviIdxN*4]:=Ord(Id[1])+Ord(Id[2])*256+Ord(Id[3])*65536+Ord(Id[4])*16777216;
  AviIdx^[AviIdxN*4+1]:=Flags; AviIdx^[AviIdxN*4+2]:=FilePos(AviOut)-MoviStart; AviIdx^[AviIdxN*4+3]:=Sz; Inc(AviIdxN);
  ATag(Id); AW32(Sz); BlockWrite(AviOut,Buf^,Sz);
  If Odd(Sz) Then Begin Z:=0; BlockWrite(AviOut,Z,1); End;
 End;
Begin
 MuxAvi:=False; Ok:=True; Cap:=65536; GetMem(Buf,Cap);
 If Not OpenSrc(VPath,FV) Then Begin FreeMem(Buf,Cap); Err:='Video source illisible.'; Exit; End;
 If HaveA Then If Not OpenSrc(APath,FA) Then Begin Close(FV); FreeMem(Buf,Cap); Err:='Audio source illisible.'; Exit; End;
 If Not CreateOut(Dst,AviOut,Err) Then Begin Close(FV); If HaveA Then Close(FA); FreeMem(Buf,Cap); Exit; End;
 GetMem(AviIdx,(V.N+A.N+16)*16); AviIdxN:=0;
 MaxV:=0; For I:=0 To V.N-1 Do If V.Sz^[I]>MaxV Then MaxV:=V.Sz^[I];
 MaxA:=0; If HaveA Then For I:=0 To A.N-1 Do If A.Sz^[I]>MaxA Then MaxA:=A.Sz^[I];
 ATag('RIFF'); AW32(0); ATag('AVI ');
 ATag('LIST'); Hdrl:=FilePos(AviOut); AW32(0); ATag('hdrl');
 ATag('avih'); AW32(56); AW32(Round(1000000.0*Fd/Fn)); AW32(2000000); AW32(0); AW32($10); AW32(V.N); AW32(0);
 AW32(1+Ord(HaveA)); AW32(MaxV+MaxA+1024); AW32(V.W); AW32(V.H); AW32(0); AW32(0); AW32(0); AW32(0);
 { flux video }
 ATag('LIST'); Strl:=FilePos(AviOut); AW32(0); ATag('strl');
 ATag('strh'); AW32(56); ATag('vids'); ATag(Fcc); AW32(0); AW32(0); AW32(0); AW32(Fd); AW32(Fn); AW32(0); AW32(V.N); AW32(MaxV);
 AW32(-1); AW32(0); AW16(0); AW16(0); AW16(V.W); AW16(V.H);
 ATag('strf'); AW32(40); AW32(40); AW32(V.W); AW32(V.H); AW16(1); AW16(24); ATag(Fcc); AW32(V.W*V.H*3); AW32(0); AW32(0); AW32(0); AW32(0);
 Z:=FilePos(AviOut)-Strl-4; Seek(AviOut,Strl); AW32(Z); Seek(AviOut,FilePos(AviOut)+Z);
 If HaveA Then Begin
  ATag('LIST'); Strl:=FilePos(AviOut); AW32(0); ATag('strl');
  ATag('strh'); AW32(56); ATag('auds'); AW32(0); AW32(0); AW32(0); AW32(0); AW32(A.Dur^[0]); AW32(A.Rate); AW32(0); AW32(A.N); AW32(MaxA);
  AW32(-1); AW32(0); AW16(0); AW16(0); AW16(0); AW16(0);
  ATag('strf'); AW32(30); AW16($55); AW16(A.Chans); AW32(A.Rate); AW32(16000); AW16(1); AW16(0); AW16(12);
  AW16(1); AW32(2); AW16(A.Sz^[0]); AW16(1); AW16($571);
  Z:=FilePos(AviOut)-Strl-4; Seek(AviOut,Strl); AW32(Z); Seek(AviOut,FilePos(AviOut)+Z);
 End;
 Z:=FilePos(AviOut)-Hdrl-4; Seek(AviOut,Hdrl); AW32(Z); Seek(AviOut,FilePos(AviOut)+Z);
 ATag('LIST'); Movi:=FilePos(AviOut); AW32(0); ATag('movi'); MoviStart:=Movi+4;
 { echantillons entrelaces par date }
 Ia:=0; Dp:=0; Total:=V.N;
 For I:=0 To V.N-1 Do Begin
  Fetch(FV,V.Off^[I],V.Sz^[I]);
  PutChunk('00dc',V.Sz^[I],Ord(V.Sync^[I]<>0)*$10,0);
  VT:=(I+1)*1.0*Fd/Fn;
  If HaveA Then
   While (Ia<A.N) And ((Dp*1.0/A.Rate<VT) Or (I=V.N-1)) Do Begin
    Fetch(FA,A.Off^[Ia],A.Sz^[Ia]);
    PutChunk('01wb',A.Sz^[Ia],$10,1);
    Inc(Dp,A.Dur^[Ia]); Inc(Ia);
   End;
  If (I And 15)=0 Then Begin UiTick(I,Total); If Stopped Then Begin Ok:=False; Break; End; End;
 End;
 If Ok Then Begin
  Z:=FilePos(AviOut)-Movi-4; Seek(AviOut,Movi); AW32(Z); Seek(AviOut,FilePos(AviOut)+Z);
  ATag('idx1'); AW32(AviIdxN*16);
  For I:=0 To AviIdxN-1 Do Begin AW32(AviIdx^[I*4]); AW32(AviIdx^[I*4+1]); AW32(AviIdx^[I*4+2]); AW32(AviIdx^[I*4+3]); End;
  Z:=FilePos(AviOut)-8; Seek(AviOut,4); AW32(Z);
  MuxAvi:=True;
 End Else Err:='Conversion annul'#233'e.';
 Close(AviOut); Close(FV); If HaveA Then Close(FA);
 FreeMem(AviIdx,(V.N+A.N+16)*16); FreeMem(Buf,Cap);
 If Not Ok Then DelFile(Dst);
End;



{ ---- multiplexeur MPEG-PS (video MPEG-1/2 + audio MPEG Layer II) ---- }
Procedure PsPts(Var B: Array Of Byte; At: LongInt; Pfx: Integer; V: Int64);
Begin
 B[At]:=(Pfx Shl 4) Or (((V Shr 30) And 7) Shl 1) Or 1;
 B[At+1]:=(V Shr 22) And 255;
 B[At+2]:=(((V Shr 15) And 127) Shl 1) Or 1;
 B[At+3]:=(V Shr 7) And 255;
 B[At+4]:=((V And 127) Shl 1) Or 1;
End;

Function MuxPs(Const Dst,VPath,APath: String; HaveA: Boolean; Fn,Fd: LongInt; Mpeg2: Boolean; Var Err: String): Boolean;
Type TAu = Record Start,Len,Tr,Typ: LongInt; End; TAuA = Array[0..0] Of TAu; PAu = ^TAuA;
Var
 FV,FA,FO: File; Vs,As_,I,J,P,N,Nau,Cap,Code,LastSlice,AuStart,Npic,Disp,Base,MaxTr,Na,Q,Rate: LongInt;
 VB,AB: PBArr; Au: PAu; Af: PLArr; HasB: Boolean; Dur: Double; Pk: Array[0..2100] Of Byte; Ok: Boolean;
 Scr,NextV,NextA: Int64; Va,Aa,Wr,PosV,PosA: LongInt; FirstPack: Boolean; Pts,Dts: Int64; Sp: LongInt;
 Ver,Idx,Br,Si,Pad,L,Spf,Ar: LongInt; Tmp: LongInt; MuxRate: LongInt; Frames: LongInt; Total: Int64;
 Procedure Pack(Sid: LongInt; Data: PBArr; Len: LongInt; WithPts,WithDts: Boolean; PtsV,DtsV: Int64);
 Var Hl,Pl,K,Pp: LongInt; Sc: Int64; Hd: LongInt;
 Begin
  { en-tete de pack }
  Sc:=Scr; Pp:=0;
  Pk[0]:=0; Pk[1]:=0; Pk[2]:=1; Pk[3]:=$BA;
  If Mpeg2 Then Begin
   Pk[4]:=$44 Or (((Sc Shr 30) And 7) Shl 3) Or ((Sc Shr 28) And 3);
   Pk[5]:=(Sc Shr 20) And 255;
   Pk[6]:=(((Sc Shr 15) And 31) Shl 3) Or 4 Or ((Sc Shr 13) And 3);
   Pk[7]:=(Sc Shr 5) And 255;
   Pk[8]:=((Sc And 31) Shl 3) Or 4;
   Pk[9]:=1;
   Pk[10]:=(MuxRate Shr 14) And 255; Pk[11]:=(MuxRate Shr 6) And 255; Pk[12]:=((MuxRate And 63) Shl 2) Or 3;
   Pk[13]:=$F8; Pp:=14;
  End Else Begin
   Pk[4]:=$21 Or (((Sc Shr 30) And 7) Shl 1);
   Pk[5]:=(Sc Shr 22) And 255;
   Pk[6]:=(((Sc Shr 15) And 127) Shl 1) Or 1;
   Pk[7]:=(Sc Shr 7) And 255;
   Pk[8]:=((Sc And 127) Shl 1) Or 1;
   Pk[9]:=$80 Or ((MuxRate Shr 15) And 127); Pk[10]:=(MuxRate Shr 7) And 255; Pk[11]:=((MuxRate And 127) Shl 1) Or 1;
   Pp:=12;
  End;
  If FirstPack Then Begin
   Pk[Pp]:=0; Pk[Pp+1]:=0; Pk[Pp+2]:=1; Pk[Pp+3]:=$BB; Pk[Pp+4]:=0; Pk[Pp+5]:=12;
   Pk[Pp+6]:=$80 Or ((MuxRate Shr 15) And 127); Pk[Pp+7]:=(MuxRate Shr 7) And 255; Pk[Pp+8]:=((MuxRate And 127) Shl 1) Or 1;
   Pk[Pp+9]:=$04 Or 2 Or 1; Pk[Pp+10]:=$E1; Pk[Pp+11]:=$FF;
   Pk[Pp+12]:=$E0; Pk[Pp+13]:=$E0; Pk[Pp+14]:=$2E;
   Pk[Pp+15]:=$C0; Pk[Pp+16]:=$C0; Pk[Pp+17]:=$20;
   Inc(Pp,18); FirstPack:=False;
  End;
  { en-tete PES }
  Pk[Pp]:=0; Pk[Pp+1]:=0; Pk[Pp+2]:=1; Pk[Pp+3]:=Sid;
  If Mpeg2 Then Begin
   Hd:=3; If WithDts Then Inc(Hd,10) Else If WithPts Then Inc(Hd,5);
   Pl:=Hd+Len;
   Pk[Pp+4]:=Pl Shr 8; Pk[Pp+5]:=Pl And 255;
   Pk[Pp+6]:=$80;
   If WithDts Then Pk[Pp+7]:=$C0 Else If WithPts Then Pk[Pp+7]:=$80 Else Pk[Pp+7]:=0;
   Pk[Pp+8]:=Hd-3;
   K:=Pp+9;
   If WithDts Then Begin PsPts(Pk,K,3,PtsV); PsPts(Pk,K+5,1,DtsV); Inc(K,10); End
   Else If WithPts Then Begin PsPts(Pk,K,2,PtsV); Inc(K,5); End;
  End Else Begin
   Hd:=1; If WithDts Then Inc(Hd,9) Else If WithPts Then Inc(Hd,4);
   Pl:=Hd+Len;
   Pk[Pp+4]:=Pl Shr 8; Pk[Pp+5]:=Pl And 255;
   K:=Pp+6;
   If WithDts Then Begin PsPts(Pk,K,3,PtsV); PsPts(Pk,K+5,1,DtsV); Inc(K,10); End
   Else If WithPts Then Begin PsPts(Pk,K,2,PtsV); Inc(K,5); End
   Else Begin Pk[K]:=$0F; Inc(K); End;
  End;
  Move(Data^,Pk[K],Len);
  BlockWrite(FO,Pk,K+Len); Inc(Wr,K+Len);
  Scr:=Round(Wr*8.0*90000.0/(MuxRate*400.0));
 End;
Begin
 MuxPs:=False; Ok:=True; Wr:=0; FirstPack:=True; Scr:=0; Dur:=90000.0*Fd/Fn;
 If Not OpenSrc(VPath,FV) Then Begin Err:='Flux video MPEG illisible.'; Exit; End;
 Vs:=FileSize(FV); GetMem(VB,Vs+16); BlockRead(FV,VB^,Vs); Close(FV);
 As_:=0; AB:=Nil;
 If HaveA Then If OpenSrc(APath,FA) Then Begin As_:=FileSize(FA); GetMem(AB,As_+16); BlockRead(FA,AB^,As_); Close(FA); End Else HaveA:=False;
 { images }
 Cap:=Vs Div 16+16; GetMem(Au,Cap*SizeOf(TAu)); Nau:=0; AuStart:=-1; LastSlice:=0; HasB:=False; P:=0; Npic:=0;
 While P+4<Vs Do Begin
  If (VB^[P]=0) And (VB^[P+1]=0) And (VB^[P+2]=1) Then Begin
   Code:=VB^[P+3];
   If (Code=$B3) Or (Code=$B8) Or (Code=0) Then Begin
    If (Code<>0) And (LastSlice<>0) And (Nau>0) Then Begin Au^[Nau-1].Len:=P-Au^[Nau-1].Start; LastSlice:=0; AuStart:=P; End
    Else If AuStart<0 Then AuStart:=P;
    If Code=0 Then Begin
     If (LastSlice<>0) And (Nau>0) Then Begin Au^[Nau-1].Len:=P-Au^[Nau-1].Start; AuStart:=P; End;
     LastSlice:=0;
     If Nau<Cap Then Begin
      Au^[Nau].Start:=AuStart; Au^[Nau].Tr:=(VB^[P+4] Shl 2) Or (VB^[P+5] Shr 6); Au^[Nau].Typ:=(VB^[P+5] Shr 3) And 7; Au^[Nau].Len:=0;
      If Au^[Nau].Typ=3 Then HasB:=True;
      Inc(Nau); AuStart:=-1;
     End;
    End;
   End Else If (Code>=1) And (Code<=$AF) Then LastSlice:=1;
   Inc(P,3);
  End Else Inc(P);
 End;
 If Nau>0 Then Au^[Nau-1].Len:=Vs-Au^[Nau-1].Start;
 If Nau=0 Then Begin Err:='Aucune image MPEG.'; FreeMem(VB,Vs+16); FreeMem(Au,Cap*SizeOf(TAu)); Exit; End;
 { trames audio }
 Na:=0;
 If HaveA Then Begin
  GetMem(Af,(As_ Div 100+16)*8); P:=0;
  While P+4<As_ Do Begin
   If (AB^[P]<>$FF) Or ((AB^[P+1] And $E0)<>$E0) Then Begin Inc(P); Continue; End;
   Ver:=(AB^[P+1] Shr 3) And 3; Idx:=(AB^[P+1] Shr 1) And 3; Br:=AB^[P+2] Shr 4; Si:=(AB^[P+2] Shr 2) And 3; Pad:=(AB^[P+2] Shr 1) And 1;
   If (Ver=1) Or (Idx<>2) Or (Br=0) Or (Br=15) Or (Si=3) Then Begin Inc(P); Continue; End;
   { couche II : debit en kb/s }
   If Ver=3 Then Begin
    Case Br Of 1: Ar:=32; 2: Ar:=48; 3: Ar:=56; 4: Ar:=64; 5: Ar:=80; 6: Ar:=96; 7: Ar:=112; 8: Ar:=128; 9: Ar:=160; 10: Ar:=192; 11: Ar:=224; 12: Ar:=256; 13: Ar:=320; Else Ar:=384; End;
    Case Si Of 0: Q:=44100; 1: Q:=48000; Else Q:=32000; End;
    L:=144000*Ar Div Q+Pad;
   End Else Begin
    Case Br Of 1: Ar:=8; 2: Ar:=16; 3: Ar:=24; 4: Ar:=32; 5: Ar:=40; 6: Ar:=48; 7: Ar:=56; 8: Ar:=64; 9: Ar:=80; 10: Ar:=96; 11: Ar:=112; 12: Ar:=128; 13: Ar:=144; Else Ar:=160; End;
    Case Si Of 0: Q:=22050; 1: Q:=24000; Else Q:=16000; End;
    L:=144000*Ar Div Q+Pad;
   End;
   If P+L>As_ Then Break;
   Af^[Na*2]:=P; Af^[Na*2+1]:=L; Inc(Na); Inc(P,L);
  End;
  Spf:=1152;
  If Na=0 Then HaveA:=False;
 End;
 Rate:=44100;
 If HaveA Then Begin
  Q:=(AB^[Af^[0]+2] Shr 2) And 3;
  If Q=1 Then Rate:=48000 Else If Q=2 Then Rate:=32000;
 End;
 Total:=Vs+As_;
 MuxRate:=Round(Total/(Nau*Dur/90000.0)*1.25/50.0)+1; If MuxRate<2000 Then MuxRate:=2000;
 If Not CreateOut(Dst,FO,Err) Then Begin FreeMem(VB,Vs+16); FreeMem(Au,Cap*SizeOf(TAu)); Exit; End;
 { decalage initial 0,5 s }
 Va:=0; Aa:=0; PosV:=0; PosA:=0;
 While (Va<Nau) Or (HaveA And (Aa<Na)) Do Begin
  { instant de decodage de la prochaine donnee }
  NextV:=Round(45000+Va*Dur); NextA:=Round(45000+Aa*(Spf*90000.0/Rate));
  If (Va<Nau) And ((Not HaveA) Or (Aa>=Na) Or (NextV<=NextA)) Then Begin
   Sp:=Au^[Va].Len-PosV; If Sp>1900 Then Sp:=1900;
   Disp:=Au^[Va].Tr;
   { temps d'affichage : numero d'ordre dans le groupe + base }
   If PosV=0 Then Begin
    Dts:=NextV; Pts:=Round(45000+(Va-(Va Mod 1)+0)*Dur);
    If HasB Then Begin
     { PTS = DTS pour I/P, ou DTS + 1 image par decalage ; approximation : reordonnancement d'au plus une image }
     If Au^[Va].Typ=3 Then Pts:=Dts Else Pts:=Dts+Round(Dur*(1+Ord(Va>0)));
     If Va=0 Then Pts:=Dts+Round(2*Dur);
    End Else Pts:=Dts;
    Pack($E0,@VB^[Au^[Va].Start+PosV],Sp,True,HasB,Pts,Dts);
   End Else Pack($E0,@VB^[Au^[Va].Start+PosV],Sp,False,False,0,0);
   Inc(PosV,Sp);
   If PosV>=Au^[Va].Len Then Begin Inc(Va); PosV:=0; End;
  End Else Begin
   { audio : une trame par paquet }
   Pack($C0,@AB^[Af^[Aa*2]],Af^[Aa*2+1],True,False,NextA,0);
   Inc(Aa);
  End;
  If (Va And 15)=0 Then Begin UiTick(Va,Nau); If Stopped Then Begin Ok:=False; Break; End; End;
 End;
 Pk[0]:=0; Pk[1]:=0; Pk[2]:=1; Pk[3]:=$B9; BlockWrite(FO,Pk,4);
 Close(FO); FreeMem(VB,Vs+16); FreeMem(Au,Cap*SizeOf(TAu)); If AB<>Nil Then Begin FreeMem(AB,As_+16); FreeMem(Af,(As_ Div 100+16)*8); End;
 If Not Ok Then Begin Err:='Conversion annul'#233'e.'; DelFile(Dst); End;
 MuxPs:=Ok;
End;


{ ---- multiplexeur ASF (video WMV1/WMV2 + audio WMA) ---- }
Type TLB = Record P: PBArr; Len,Cap: LongInt; End;
Procedure LbInit(Var B: TLB); Begin B.Cap:=65536; GetMem(B.P,B.Cap); B.Len:=0; End;
Procedure LbEnsure(Var B: TLB; N: LongInt);
Var NB: PBArr;
Begin
 If B.Len+N+16>B.Cap Then Begin GetMem(NB,B.Cap*2+N+65536); Move(B.P^,NB^,B.Len); FreeMem(B.P,B.Cap); B.P:=NB; B.Cap:=B.Cap*2+N+65536; End;
End;
Procedure Lb8(Var B: TLB; V: LongInt); Begin LbEnsure(B,1); B.P^[B.Len]:=V And 255; Inc(B.Len); End;
Procedure Lb16(Var B: TLB; V: LongInt); Begin Lb8(B,V); Lb8(B,V Shr 8); End;
Procedure Lb32(Var B: TLB; V: LongInt); Begin Lb8(B,V); Lb8(B,V Shr 8); Lb8(B,V Shr 16); Lb8(B,V Shr 24); End;
Procedure Lb64(Var B: TLB; V: Int64); Begin Lb32(B,V And $FFFFFFFF); Lb32(B,V Shr 32); End;
Procedure LbGuid(Var B: TLB; Const G: String); Var I: Integer; Begin For I:=1 To 16 Do Lb8(B,Ord(G[I])); End;
Procedure LbBytes(Var B: TLB; Src: PBArr; N: LongInt); Begin LbEnsure(B,N); Move(Src^,B.P^[B.Len],N); Inc(B.Len,N); End;
Procedure LbPatch32(Var B: TLB; At,V: LongInt); Var I: Integer; Begin For I:=0 To 3 Do B.P^[At+I]:=(V Shr (8*I)) And 255; End;

Const
 GHdr: String[16]=#$30#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GFileP: String[16]=#$A1#$DC#$AB#$8C#$47#$A9#$CF#$11#$8E#$E4#$00#$C0#$0C#$20#$53#$65;
 GStrmP: String[16]=#$91#$07#$DC#$B7#$B7#$A9#$CF#$11#$8E#$E6#$00#$C0#$0C#$20#$53#$65;
 GAudM: String[16]=#$40#$9E#$69#$F8#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GVidM: String[16]=#$C0#$EF#$19#$BC#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GDataO: String[16]=#$36#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GHdrExt: String[16]=#$B5#$03#$BF#$5F#$2E#$A9#$CF#$11#$8E#$E3#$00#$C0#$0C#$20#$53#$65;
 GNoEc: String[16]=#$00#$57#$FB#$20#$55#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GRes1: String[16]=#$11#$D2#$D3#$AB#$BA#$A9#$CF#$11#$8E#$E6#$00#$C0#$0C#$20#$53#$65;
 AsPkt = 3200; AsPre = 1500;

Var AsPk: TLB; AsPay: Array[0..3300] Of Byte; AsPayN,AsNPay,AsSend,AsPackets: LongInt; AsObj: Array[1..2] Of LongInt;

Procedure AsFlush;
Var Pad,Q: LongInt;
Begin
 If AsNPay=0 Then Exit;
 Pad:=AsPkt-(11+AsPayN);
 Lb8(AsPk,$11); Lb8(AsPk,$5D); Lb16(AsPk,Pad); Lb32(AsPk,AsSend); Lb16(AsPk,0);
 Lb8(AsPk,$80 Or AsNPay);
 LbBytes(AsPk,@AsPay,AsPayN);
 For Q:=1 To Pad Do Lb8(AsPk,0);
 Inc(AsPackets); AsNPay:=0; AsPayN:=0;
End;

Procedure AsPut(Stm,Key,Tms: LongInt; Src: PBArr; Len: LongInt);
Var Off,Take,Room,Tw: LongInt;
 Procedure P8(V: LongInt); Begin AsPay[AsPayN]:=V And 255; Inc(AsPayN); End;
 Procedure P32(V: LongInt); Begin P8(V); P8(V Shr 8); P8(V Shr 16); P8(V Shr 24); End;
Begin
 Off:=0;
 If Len=0 Then Exit;
 While Off<Len Do Begin
  Room:=AsPkt-11-AsPayN-(1+1+4+1+8+2);
  If Room<16 Then Begin AsFlush; Room:=AsPkt-11-(1+1+4+1+8+2); End;
  If AsNPay=0 Then AsSend:=Tms;
  Take:=Len-Off; If Take>Room Then Take:=Room;
  P8(Stm Or (Key Shl 7)); P8(AsObj[Stm]); P32(Off); P8(8); P32(Len); P32(Tms+AsPre);
  P8(Take); P8(Take Shr 8);
  Move(Src^[Off],AsPay[AsPayN],Take); Inc(AsPayN,Take);
  Inc(AsNPay); Inc(Off,Take);
  If (AsNPay>=60) Or (AsPkt-11-AsPayN<40) Then AsFlush;
 End;
 AsObj[Stm]:=(AsObj[Stm]+1) And 255;
End;

Function MuxAsf(Const Dst,AviPath,WmaPath: String; HaveA: Boolean; Fn,Fd: LongInt; Var Err: String): Boolean;
Var V: TTrkIn; FAvi,FO: File; VBuf,SpB,Ex: PBArr; SpSz,ExL,ExP,VW,VH,I,P,Q,Pp,Nv,Na,Vi,Ai,Apos,Tv,Ta,AId,ACodec,ARate,ACh,AAlign,ABr,AExL,AExP,DurMs,VCap,FileSz,Pfs: LongInt;
 Dur: Double; Found: Boolean; Hd,Pre0: TLB; Fcc: String; Sp: String;
 Function Rd(Pos: LongInt): LongInt; Begin Rd:=SpB^[Pos]+SpB^[Pos+1]*256+SpB^[Pos+2]*65536+(SpB^[Pos+3] Shl 24); End;
Begin
 MuxAsf:=False; Ex:=Nil; SpB:=Nil; ExL:=0; AExL:=0; Na:=0; AId:=-1; AsNPay:=0; AsPayN:=0; AsPackets:=0; AsObj[1]:=0; AsObj[2]:=0;
 If Not AviTracks(AviPath,V,Err) Then Exit;
 VW:=V.W; VH:=V.H; Fcc:=V.Codec;
 { donnees supplementaires du format video (strf) }
 If COpen(AviPath) Then Begin
  P:=12; Found:=False;
  While (P+12<=CSize) And Not Found Do Begin
   If (C4(P)='LIST') And (C4(P+8)='hdrl') Then Begin
    Q:=P+12;
    While (Q+8<=P+8+L32(P+4)) And Not Found Do Begin
     If C4(Q)='LIST' Then Inc(Q,12)
     Else Begin
      If (C4(Q)='strf') And (L32(Q+4)>40) Then Begin
       ExL:=L32(Q+4)-40; GetMem(Ex,ExL+8); For I:=0 To ExL-1 Do Ex^[I]:=CB(Q+8+40+I); Found:=True;
      End;
      Q:=Q+8+L32(Q+4)+(L32(Q+4) And 1);
     End;
    End;
    Break;
   End;
   If L32(P+4)<0 Then Break;
   P:=P+8+L32(P+4)+(L32(P+4) And 1);
  End;
  CClose;
 End;
 { audio : objets media du fichier ASF produit par l'encodeur WMA }
 Apos:=0;
 If HaveA Then Begin
  Sp:=TmpName('SPL'); Err:='';
  If RunEng(ekAsfSpool,WmaPath,Sp,0,Err) And OpenSrc(Sp,FAvi) Then Begin
   SpSz:=FileSize(FAvi); GetMem(SpB,SpSz+16); BlockRead(FAvi,SpB^,SpSz); Close(FAvi);
  End Else HaveA:=False;
  DelFile(Sp); Err:='';
 End;
 If HaveA Then Begin
  Found:=False; Pp:=Rd(8); P:=12;
  For I:=1 To Pp Do Begin
   If (Rd(P+4)=2) And Not Found Then Begin Found:=True; AId:=Rd(P); ACodec:=Rd(P+8); ARate:=Rd(P+20); ACh:=Rd(P+24); AAlign:=Rd(P+28); ABr:=Rd(P+32); AExL:=Rd(P+36); AExP:=P+40; End;
   Inc(P,40+Rd(P+36));
  End;
  If Not Found Then HaveA:=False Else Begin
   Apos:=P; Q:=P; Na:=0;
   While (Q+16<=SpSz) And (Rd(Q)<>0) Do Begin If Rd(Q)=AId Then Inc(Na); Inc(Q,16+Rd(Q+12)); End;
  End;
 End;
 Nv:=V.N;
 If Not OpenSrc(AviPath,FAvi) Then Begin Err:='Video interm'#233'diaire illisible.'; Exit; End;
 VCap:=1; For I:=0 To Nv-1 Do If V.Sz^[I]>VCap Then VCap:=V.Sz^[I];
 GetMem(VBuf,VCap+16);
 LbInit(AsPk); Dur:=1000.0*Fd/Fn; Vi:=0; Ai:=0;
 While (Vi<Nv) Or (HaveA And (Ai<Na)) Do Begin
  Tv:=Round(Vi*Dur); Ta:=MaxLongInt;
  If HaveA And (Ai<Na) Then Begin
   While (Apos+16<=SpSz) And (Rd(Apos)<>AId) Do Inc(Apos,16+Rd(Apos+12));
   Ta:=Rd(Apos+8);
  End;
  If (Vi<Nv) And ((Not HaveA) Or (Ai>=Na) Or (Tv<=Ta)) Then Begin
   Seek(FAvi,V.Off^[Vi]); BlockRead(FAvi,VBuf^,V.Sz^[Vi]);
   AsPut(1,Ord((VBuf^[0] Shr 6)=0),Tv,VBuf,V.Sz^[Vi]);
   Inc(Vi);
  End Else Begin
   AsPut(2,1,Ta,@SpB^[Apos+16],Rd(Apos+12));
   Inc(Apos,16+Rd(Apos+12)); Inc(Ai);
  End;
  If (Vi And 15)=0 Then Begin UiTick(Vi,Nv); If Stopped Then Begin Err:='Conversion annul'#233'e.'; Break; End; End;
 End;
 AsFlush; Close(FAvi); FreeMem(VBuf,VCap+16);
 If Err<>'' Then Begin FreeMem(AsPk.P,AsPk.Cap); Exit; End;

 DurMs:=Round(Nv*Dur);
 { objets d'en-tete }
 LbInit(Hd);
 LbGuid(Hd,GFileP); Lb64(Hd,104); LbGuid(Hd,GHdr);
 Pfs:=Hd.Len; Lb64(Hd,0); Lb64(Hd,0); Lb64(Hd,AsPackets);
 Lb64(Hd,Int64(DurMs+AsPre)*10000); Lb64(Hd,Int64(DurMs)*10000); Lb64(Hd,AsPre); Lb32(Hd,2); Lb32(Hd,AsPkt); Lb32(Hd,AsPkt); Lb32(Hd,2000000);
 { flux video }
 LbGuid(Hd,GStrmP); Lb64(Hd,24+54+51+ExL); LbGuid(Hd,GVidM); LbGuid(Hd,GNoEc); Lb64(Hd,0); Lb32(Hd,51+ExL); Lb32(Hd,0); Lb16(Hd,1); Lb32(Hd,0);
 Lb32(Hd,VW); Lb32(Hd,VH); Lb8(Hd,2); Lb16(Hd,40+ExL);
 Lb32(Hd,40+ExL); Lb32(Hd,VW); Lb32(Hd,VH); Lb16(Hd,1); Lb16(Hd,24); For I:=1 To 4 Do Lb8(Hd,Ord(Fcc[I]));
 Lb32(Hd,VW*VH*3); Lb32(Hd,0); Lb32(Hd,0); Lb32(Hd,0); Lb32(Hd,0);
 If ExL>0 Then LbBytes(Hd,Ex,ExL);
 { flux audio }
 If HaveA Then Begin
  LbGuid(Hd,GStrmP); Lb64(Hd,24+54+18+AExL); LbGuid(Hd,GAudM); LbGuid(Hd,GNoEc); Lb64(Hd,0); Lb32(Hd,18+AExL); Lb32(Hd,0); Lb16(Hd,2); Lb32(Hd,0);
  Lb16(Hd,ACodec); Lb16(Hd,ACh); Lb32(Hd,ARate); Lb32(Hd,ABr Div 8); Lb16(Hd,AAlign); Lb16(Hd,16); Lb16(Hd,AExL);
  If AExL>0 Then LbBytes(Hd,@SpB^[AExP],AExL);
 End;
 { extension d'en-tete }
 LbGuid(Hd,GHdrExt); Lb64(Hd,46); LbGuid(Hd,GRes1); Lb16(Hd,6); Lb32(Hd,0);
 FileSz:=30+Hd.Len+50+AsPk.Len;
 LbPatch32(Hd,Pfs,FileSz);
 If Not CreateOut(Dst,FO,Err) Then Begin FreeMem(Hd.P,Hd.Cap); FreeMem(AsPk.P,AsPk.Cap); Exit; End;
 LbInit(Pre0);
 LbGuid(Pre0,GHdr); Lb64(Pre0,30+Hd.Len); Lb32(Pre0,3+Ord(HaveA)); Lb8(Pre0,1); Lb8(Pre0,2);
 BlockWrite(FO,Pre0.P^,Pre0.Len); BlockWrite(FO,Hd.P^,Hd.Len);
 Pre0.Len:=0;
 LbGuid(Pre0,GDataO); Lb64(Pre0,50+AsPk.Len); LbGuid(Pre0,GHdr); Lb64(Pre0,AsPackets); Lb8(Pre0,1); Lb8(Pre0,1);
 BlockWrite(FO,Pre0.P^,Pre0.Len); BlockWrite(FO,AsPk.P^,AsPk.Len);
 Close(FO);
 FreeMem(Pre0.P,Pre0.Cap); FreeMem(Hd.P,Hd.Cap); FreeMem(AsPk.P,AsPk.Cap);
 If SpB<>Nil Then FreeMem(SpB,SpSz+16);
 If Ex<>Nil Then FreeMem(Ex,ExL+8);
 TrkClear(V);
 MuxAsf:=True;
End;


{ ---- sortie WebM : VP8 + Vorbis ---- }
{ Paquets Vorbis d'un fichier Ogg -> piste audio en memoire (les 3 premiers paquets = en-tetes) }
Function OggVorbisTrack(Const Path: String; Var A: TTrkIn; Var Mem: PBArr): Boolean;
Var F: File; Buf: PBArr; Sz,P,I,Nseg,L,N,Cap,Cur,PktStart,H3,K,Np,PageFirst: LongInt; G,Gp: Int64; Seg: Array[0..254] Of Byte;
 PSz,POff: PLArr; Pg: PLArr; Cont: Boolean; Nm,Rate,Ch: LongInt; Total: LongInt;
 Hd: Array[0..2] Of LongInt;
Begin
 OggVorbisTrack:=False; Mem:=Nil; FillChar(A,SizeOf(A),0); MkvPrivLen:=0;
 If Not OpenSrc(Path,F) Then Exit;
 Sz:=FileSize(F); GetMem(Buf,Sz+16); BlockRead(F,Buf^,Sz); Close(F);
 GetMem(Mem,Sz+16); GetMem(PSz,(Sz Div 8+16)*4); GetMem(POff,(Sz Div 8+16)*4); GetMem(Pg,(Sz Div 8+16)*4);
 N:=0; Cur:=0; P:=0; Gp:=0; Cont:=False;
 While P+27<=Sz Do Begin
  If (Buf^[P]<>Ord('O')) Or (Buf^[P+1]<>Ord('g')) Then Break;
  Nseg:=Buf^[P+26]; G:=0; For K:=7 DownTo 0 Do G:=G*256+Buf^[P+6+K];
  L:=P+27+Nseg; PageFirst:=N;
  For I:=0 To Nseg-1 Do Begin
   K:=Buf^[P+27+I];
   Move(Buf^[L],Mem^[Cur],K); Inc(Cur,K); Inc(L,K);
   If K<255 Then Begin
    { paquet termine }
    PSz^[N]:=Cur-0; POff^[N]:=0; Pg^[N]:=0; Inc(N);
   End;
  End;
  { stocker la taille cumulee ; recalcul ensuite }
  Pg^[PageFirst]:=Pg^[PageFirst];
  If N>PageFirst Then For I:=PageFirst To N-1 Do Pg^[I]:=Round(G);
  P:=L;
 End;
 FreeMem(Buf,Sz+16);
 { PSz contient le cumul de fin de paquet : convertir en (offset,taille) }
 If N<4 Then Begin FreeMem(Mem,Sz+16); Mem:=Nil; FreeMem(PSz,(Sz Div 8+16)*4); FreeMem(POff,(Sz Div 8+16)*4); FreeMem(Pg,(Sz Div 8+16)*4); Exit; End;
 Cur:=0;
 For I:=0 To N-1 Do Begin L:=PSz^[I]; POff^[I]:=Cur; PSz^[I]:=L-Cur; Cur:=L; End;
 { identification : canaux et frequence }
 Ch:=Mem^[POff^[0]+11]; Rate:=Mem^[POff^[0]+12]+Mem^[POff^[0]+13]*256+Mem^[POff^[0]+14]*65536+Mem^[POff^[0]+15]*16777216;
 { en-tete CodecPrivate : lacet Xiph des 3 premiers paquets }
 GetMem(MkvPrivBuf,PSz^[0]+PSz^[1]+PSz^[2]+16); MkvPrivLen:=0;
 MkvPrivBuf^[0]:=2; MkvPrivLen:=1;
 For K:=0 To 1 Do Begin
  L:=PSz^[K];
  While L>=255 Do Begin MkvPrivBuf^[MkvPrivLen]:=255; Inc(MkvPrivLen); Dec(L,255); End;
  MkvPrivBuf^[MkvPrivLen]:=L; Inc(MkvPrivLen);
 End;
 For K:=0 To 2 Do Begin Move(Mem^[POff^[K]],MkvPrivBuf^[MkvPrivLen],PSz^[K]); Inc(MkvPrivLen,PSz^[K]); End;
 Np:=N-3;
 TrkAlloc(A,Np);
 { durees : echantillons ecoules par page, partages entre les paquets de la page }
 I:=3; Gp:=0;
 While I<N Do Begin
  K:=I; While (K+1<N) And (Pg^[K+1]=Pg^[I]) Do Inc(K);
  Total:=Pg^[I]-Gp; If Total<0 Then Total:=0;
  For L:=I To K Do Begin
   A.Off^[L-3]:=POff^[L]; A.Sz^[L-3]:=PSz^[L];
   A.Dur^[L-3]:=Total Div (K-I+1);
  End;
  A.Dur^[K-3]:=A.Dur^[K-3]+Total-(Total Div (K-I+1))*(K-I+1);
  Gp:=Pg^[I]; I:=K+1;
 End;
 A.Ok:=True; A.IsVideo:=False; A.Codec:='vorb'; A.Rate:=Rate; A.Ts:=Rate; A.Chans:=Ch;
 FreeMem(PSz,(Sz Div 8+16)*4); FreeMem(POff,(Sz Div 8+16)*4); FreeMem(Pg,(Sz Div 8+16)*4);
 OggVorbisTrack:=True;
End;

{ Phase 2 VP8 : images du fichier temporaire -> paquets en memoire }
Function Vp8Track(Var V: TTrkIn; Var Mem: PBArr; Bitrate: LongInt; Var Err: String): Boolean;
Var I,Fsz,P,Cap,Len: LongInt; Got: Word; Buf: PEABuffer; Key: Boolean; Ok: Boolean;
Begin
 Vp8Track:=False; Fsz:=VJOutW*VJOutH*3 Div 2; Cap:=1 Shl 20; Len:=0; GetMem(Mem,Cap);
 GetMem(Buf,Fsz+16); Seek(VJTmp,0); Ok:=True;
 E8Begin(VJOutW,VJOutH,VJFn,VJFd,Bitrate);
 FillChar(V,SizeOf(V),0); TrkAlloc(V,VJCnt);
 For I:=0 To VJCnt-1 Do Begin
  P:=0;
  While P<Fsz Do Begin
   {$I-}BlockRead(VJTmp,Buf^[P],Min(32768,Fsz-P),Got);{$I+}
   If (IOResult<>0) Or (Got=0) Then Begin Ok:=False; Break; End;
   Inc(P,Got);
  End;
  If Not Ok Then Break;
  Key:=False;
  E8Frame1(Buf,Key);
  If Len+E8PktLen+16>Cap Then Begin ReallocMem(Mem,Cap*2+E8PktLen); Cap:=Cap*2+E8PktLen; End;
  Move(E8Pkt^,Mem^[Len],E8PktLen);
  V.Off^[I]:=Len; V.Sz^[I]:=E8PktLen; V.Dur^[I]:=VJFd; V.Sync^[I]:=Ord(Key); V.Cts^[I]:=0; Inc(Len,E8PktLen);
  If (I And 3)=0 Then Begin UiTick(I,VJCnt); If Stopped Then Begin Ok:=False; Err:='Conversion annul'#233'e.'; Break; End; End;
 End;
 FreeMem(Buf,Fsz+16); E8Free;
 If (Not Ok) And (Err='') Then Err:='Lecture du fichier temporaire impossible.';
 If Ok Then Begin V.Ok:=True; V.IsVideo:=True; V.Codec:='VP80'; V.Ts:=VJFn; V.W:=VJOutW; V.H:=VJOutH; End
 Else Begin FreeMem(Mem,Cap); Mem:=Nil; End;
 Vp8Track:=Ok;
End;

{ ---- fusion de deux flux Ogg (Theora + Vorbis) en un seul fichier ---- }
Type TOgPage = Record Off,Len,Seq: LongInt; Gran: Int64; Bos: Boolean; End;
 TOgPages = Array[0..99999] Of TOgPage; POgPages = ^TOgPages;

Function OgLoad(Const Path: String; Var Buf: PBArr; Var Sz: LongInt; Var Pg: POgPages; Var N: LongInt; Var Time0: Double; Var Rate: Double; Var Shift: LongInt; Var IsTheora: Boolean): Boolean;
Var F: File; P,I,L,Nseg,B0: LongInt; G: Int64; K: Integer;
Begin
 OgLoad:=False; N:=0; Shift:=0; Rate:=1; IsTheora:=False;
 If Not OpenSrc(Path,F) Then Exit;
 Sz:=FileSize(F); GetMem(Buf,Sz+8); BlockRead(F,Buf^,Sz); Close(F);
 GetMem(Pg,SizeOf(TOgPage)*20000);
 P:=0;
 While (P+27<=Sz) And (N<20000) Do Begin
  If (Buf^[P]<>Ord('O')) Or (Buf^[P+1]<>Ord('g')) Or (Buf^[P+2]<>Ord('g')) Or (Buf^[P+3]<>Ord('S')) Then Break;
  Nseg:=Buf^[P+26]; L:=27+Nseg;
  For I:=0 To Nseg-1 Do Inc(L,Buf^[P+27+I]);
  If P+L>Sz Then Break;
  G:=0; For K:=7 DownTo 0 Do G:=G*256+Buf^[P+6+K];
  Pg^[N].Off:=P; Pg^[N].Len:=L; Pg^[N].Gran:=G; Pg^[N].Bos:=(Buf^[P+5] And 2)<>0;
  Pg^[N].Seq:=Buf^[P+18]+Buf^[P+19]*256+Buf^[P+20]*65536+Buf^[P+21]*16777216;
  If N=0 Then Begin
   B0:=P+27+Nseg;
   If (Buf^[B0]=$80) And (Buf^[B0+1]=Ord('t')) Then Begin
    IsTheora:=True;
    Rate:=(Buf^[B0+22]*16777216.0+Buf^[B0+23]*65536+Buf^[B0+24]*256+Buf^[B0+25])/(Buf^[B0+26]*16777216.0+Buf^[B0+27]*65536+Buf^[B0+28]*256+Buf^[B0+29]);
    Shift:=((Buf^[B0+40] And 3) Shl 3) Or (Buf^[B0+41] Shr 5);
   End Else If Buf^[B0]=1 Then Rate:=Buf^[B0+12]+Buf^[B0+13]*256+Buf^[B0+14]*65536.0+Buf^[B0+15]*16777216.0;
  End;
  Inc(N); Inc(P,L);
 End;
 Time0:=0;
 OgLoad:=N>0;
End;

Function OgTime(Var Pg: TOgPage; Rate: Double; Shift: LongInt; IsTheora: Boolean): Double;
Var Kf,Off: Int64;
Begin
 If Pg.Gran<0 Then Begin OgTime:=0; Exit; End;
 If IsTheora Then Begin Kf:=Pg.Gran Shr Shift; Off:=Pg.Gran And ((Int64(1) Shl Shift)-1); OgTime:=(Kf+Off)/Rate; End
 Else OgTime:=Pg.Gran/Rate;
End;

Function OgvMux(Const Dst,VPath,APath: String; HaveA: Boolean; Var Err: String): Boolean;
Var VB,AB: PBArr; VS,AS_,VN,AN,I,J,K,Vi,Ai,Hdr: LongInt; VP,AP: POgPages; VRate,ARate,T0: Double; VSh,ASh: LongInt; VT,AT: Boolean;
 FO: File; Ser: LongWord; C: LongWord; Tmp: PBArr; Ok: Boolean; Tv,Ta: Double;
 Procedure Emit(Bf: PBArr; Var Pg: TOgPage; NewSerial: LongInt);
 Var Q: LongInt; Cr: LongWord;
 Begin
  GetMem(Tmp,Pg.Len+8); Move(Bf^[Pg.Off],Tmp^,Pg.Len);
  For Q:=0 To 3 Do Tmp^[14+Q]:=(NewSerial Shr (8*Q)) And 255;
  Tmp^[22]:=0; Tmp^[23]:=0; Tmp^[24]:=0; Tmp^[25]:=0;
  Cr:=0; For Q:=0 To Pg.Len-1 Do Cr:=(Cr Shl 8) Xor VBCrcTab[((Cr Shr 24) Xor Tmp^[Q]) And 255];
  For Q:=0 To 3 Do Tmp^[22+Q]:=(Cr Shr (8*Q)) And 255;
  BlockWrite(FO,Tmp^,Pg.Len); FreeMem(Tmp,Pg.Len+8);
 End;
Begin
 OgvMux:=False; Ok:=True; VBCrcInit; AN:=0; AP:=Nil; AB:=Nil;
 If Not OgLoad(VPath,VB,VS,VP,VN,T0,VRate,VSh,VT) Then Begin Err:='Flux Theora invalide.'; Exit; End;
 If HaveA Then If Not OgLoad(APath,AB,AS_,AP,AN,T0,ARate,ASh,AT) Then HaveA:=False;
 If Not CreateOut(Dst,FO,Err) Then Exit;
 { en-tetes : pages BOS puis pages d'en-tete restantes }
 Vi:=0; Ai:=0;
 Emit(VB,VP^[0],$1234); Inc(Vi);
 If HaveA Then Begin Emit(AB,AP^[0],$5678); Inc(Ai); End;
 While (Vi<VN) And (VP^[Vi].Seq<=1) Do Begin Emit(VB,VP^[Vi],$1234); Inc(Vi); End;
 If HaveA Then While (Ai<AN) And (AP^[Ai].Seq<=1) Do Begin Emit(AB,AP^[Ai],$5678); Inc(Ai); End;
 While (Vi<VN) Or (HaveA And (Ai<AN)) Do Begin
  If Vi>=VN Then Begin Emit(AB,AP^[Ai],$5678); Inc(Ai); End
  Else If (Not HaveA) Or (Ai>=AN) Then Begin Emit(VB,VP^[Vi],$1234); Inc(Vi); End
  Else Begin
   Tv:=OgTime(VP^[Vi],VRate,VSh,VT); Ta:=OgTime(AP^[Ai],ARate,ASh,AT);
   If Tv<=Ta Then Begin Emit(VB,VP^[Vi],$1234); Inc(Vi); End Else Begin Emit(AB,AP^[Ai],$5678); Inc(Ai); End;
  End;
 End;
 Close(FO);
 FreeMem(VB,VS+8); FreeMem(VP,SizeOf(TOgPage)*20000);
 If AB<>Nil Then Begin FreeMem(AB,AS_+8); FreeMem(AP,SizeOf(TOgPage)*20000); End;
 OgvMux:=True;
End;



{ fourcc video d'un fichier ASF/WMV }
Function AsfFourCC(Const Path: String): String;
Var P,Sz,N,Cnt: LongInt;
Begin
 AsfFourCC:='';
 If Not COpen(Path) Then Exit;
 N:=L32(16+8); P:=30; Cnt:=0;
 While (P+24<CSize) And (Cnt<N) And (Cnt<40) Do Begin
  Sz:=L32(P+16);
  If (CB(P)=$91) And (CB(P+1)=$07) And (CB(P+2)=$DC) And (CB(P+3)=$B7) Then
   If (CB(P+24)=$C0) And (CB(P+25)=$EF) And (CB(P+26)=$19) Then AsfFourCC:=UpStr(C4(P+78+11+16));
  If (Sz<24) Or (Sz>CSize) Then Break;
  P:=P+Sz; Inc(Cnt);
 End;
 CClose;
End;

{ WMV1 / WMV2 dans un fichier ASF : paquets lus depuis la copie temporaire du demultiplexeur ASF }
Procedure DecodeWMVAsf(Const Source,Target: String; Mode: LongInt);
Var Tmp: String; Id,Fcc,W,H,ExPos,ExLen,ObjPos,P,Sz,SId,Cnt,I,K,RN,RD,Ver,E,Vn,Vd: LongInt; Pk: PEABuffer;
 Dts,Dur: PTLArr; Szs: PGFArr; Pos0,Lens: PALLong; Found: Boolean; N,Q,Ex: LongInt;
Begin
 Tmp:=NewTemporary; DemuxASF(Source,Tmp);
 NVLoad(Tmp,V1AsfF,V1AsfSize);
 Found:=False; N:=V1AsfRd(8); P:=12;
 For I:=1 To N Do Begin
  If P+40>V1AsfSize Then Break;
  K:=V1AsfRd(P+4); Ex:=V1AsfRd(P+36);
  If (K=1) And Not Found Then Begin Found:=True; Id:=V1AsfRd(P); Fcc:=V1AsfRd(P+8); W:=V1AsfRd(P+12); H:=V1AsfRd(P+16); ExPos:=P+40; ExLen:=Ex; End;
  Inc(P,40+Ex);
 End;
 ObjPos:=P;
 If Not Found Then Fail('wmv: pas de flux video dans le fichier ASF.');
 If (W<1) Or (H<1) Or (W>16000) Or (H>16000) Then Fail('wmv: dimensions invalides.');
 Cnt:=0; P:=ObjPos;
 While P+16<=V1AsfSize Do Begin
  SId:=V1AsfRd(P); If SId=0 Then Break;
  Sz:=V1AsfRd(P+12);
  If (Sz<0) Or (P+16+Sz>V1AsfSize) Then Break;
  If SId=Id Then Inc(Cnt);
  Inc(P,16+Sz);
 End;
 If Cnt=0 Then Fail('wmv: aucune image dans le fichier ASF.');
 GetMem(Pos0,Cnt*4+8); GetMem(Lens,Cnt*4+8); GetMem(Dts,Cnt*8+8); GetMem(Dur,Cnt*8+8); GetMem(Szs,Cnt*4+8);
 K:=0; P:=ObjPos;
 While (P+16<=V1AsfSize) And (K<Cnt) Do Begin
  SId:=V1AsfRd(P); If SId=0 Then Break;
  Sz:=V1AsfRd(P+12);
  If SId=Id Then Begin Pos0^[K]:=P+16; Lens^[K]:=Sz; Dts^[K]:=V1AsfRd(P+8); Dur^[K]:=0; Szs^[K]:=Sz; Inc(K); End;
  Inc(P,16+Sz);
 End;
 TLRFrameRate(Dts,Dur,Szs,Cnt,1,1000,True,0,0,0,0,RN,RD);
 NVGcd(RN,RD);
 If Fcc=$31564D57 Then Ver:=4 Else Ver:=5;
 Vn:=NVVN; Vd:=NVVD;
 M4MsStart(Ver,W,H,RN,RD,Mode,Target);
 NVVN:=Vn; NVVD:=Vd; M4SarN:=0; M4SarD:=1;
 W2ExtraLen:=0;
 If ExLen>0 Then Begin
  E:=ExLen; If E>4 Then E:=4;
  FillChar(W2Extra,4,0);
  For I:=0 To E-1 Do W2Extra[I]:=V1AsfF^[ExPos+I];
  W2ExtraLen:=ExLen;
 End;
 If Ver=5 Then W2ExtHeader;
 For I:=0 To Cnt-1 Do Begin
  Sz:=Lens^[I];
  If Sz>0 Then Begin
   GetMem(Pk,Sz+64); Move(V1AsfF^[Pos0^[I]],Pk^,Sz);
   M4MsPacket(Pk,Sz);
   FreeMem(Pk);
  End Else NVRepeat;
  If NVDone Then Break;
 End;
 FreeMem(V1AsfF); V1AsfF:=Nil;
 If M4OutBegun=0 Then Fail('wmv: aucune image decodee.');
 NVFinish('wmv');
End;

{ ---- demultiplexeur MPEG-PS minimal : flux elementaires video / audio ---- }
Function PsExtract(Const Src,VDst,ADst: String; Var HaveA: Boolean): Boolean;
Var F,FV,FA: File; Sz,P,L,Q,Hl,Sid,Vs,As_,Pe,Ps: LongInt; B: PBArr; Mpeg2,Ok: Boolean; Err: String;
Begin
 PsExtract:=False; HaveA:=False; Vs:=-1; As_:=-1;
 If Not OpenSrc(Src,F) Then Exit;
 Sz:=FileSize(F); GetMem(B,Sz+16); BlockRead(F,B^,Sz); Close(F);
 Err:='';
 If Not CreateOut(VDst,FV,Err) Then Begin FreeMem(B,Sz+16); Exit; End;
 If Not CreateOut(ADst,FA,Err) Then Begin Close(FV); FreeMem(B,Sz+16); Exit; End;
 P:=0; Ok:=False; Mpeg2:=True; Ps:=0;
 While P+6<Sz Do Begin
  If (B^[P]<>0) Or (B^[P+1]<>0) Or (B^[P+2]<>1) Then Begin Inc(P); Continue; End;
  Sid:=B^[P+3];
  If Sid=$BA Then Begin
   If (B^[P+4] And $C0)=$40 Then Begin Mpeg2:=True; Inc(P,14+(B^[P+13] And 7)); End Else Begin Mpeg2:=False; Inc(P,12); End;
  End Else If (Sid>=$BB) Then Begin
   L:=B^[P+4]*256+B^[P+5]; Pe:=P+6+L;
   If ((Sid>=$E0) And (Sid<=$EF)) Or ((Sid>=$C0) And (Sid<=$DF)) Then Begin
    If Mpeg2 Then Begin Hl:=B^[P+8]; Q:=P+9+Hl; End
    Else Begin
     Q:=P+6; While (Q<Pe) And (B^[Q]=$FF) Do Inc(Q);
     If (B^[Q] And $C0)=$40 Then Inc(Q,2);
     If (B^[Q] And $F0)=$20 Then Inc(Q,5) Else If (B^[Q] And $F0)=$30 Then Inc(Q,10) Else Inc(Q);
    End;
    If Pe>Sz Then Pe:=Sz;
    If (Sid>=$E0) And (Sid<=$EF) Then Begin
     If Vs<0 Then Vs:=Sid;
     If (Sid=Vs) And (Q<Pe) Then Begin BlockWrite(FV,B^[Q],Pe-Q); Ok:=True; End;
    End Else Begin
     If As_<0 Then As_:=Sid;
     If (Sid=As_) And (Q<Pe) Then Begin BlockWrite(FA,B^[Q],Pe-Q); HaveA:=True; End;
    End;
   End;
   If L=0 Then Inc(P,4) Else P:=Pe;
  End Else Inc(P,4);
  Inc(Ps);
  If (Ps And 4095)=0 Then Begin UiTick(P,Sz); If Stopped Then Break; End;
 End;
 Close(FV); Close(FA); FreeMem(B,Sz+16);
 If Not Ok Then DelFile(VDst);
 If Not HaveA Then DelFile(ADst);
 PsExtract:=Ok;
End;

{ Selectionne le moteur de FFMPEG.PAS et decode la video vers un fichier Y4M.
  Retour : 1 = fichier Y4M cree, 0 = codec non pris en charge, -1 = erreur (Err) }
Function Y4mSource(Var M: TMedia; Const Fmt,Codec: String; Var Y4: String; Var Err: String): Integer;
Var U: String; K: Integer; Es,Au: String; HaveA: Boolean; Src: String;
Begin
 Y4mSource:=0; Err:=''; K:=0; U:=UpStr(Codec); Src:=M.Path;
 If (Fmt='WMV') Or (Fmt='ASF') Then Begin
  U:=AsfFourCC(Src);
  If InList(U,'WMV3,WVC1,WMVA,WVP2,WMVP') Then K:=1 Else If InList(U,'WMV1,WMV2') Then K:=7;
 End Else If Fmt='AVI' Then Begin
  If InList(U,'WMV3,WVC1,WMVA') Then K:=2 Else If InList(U,'WMV1,WMV2') Then K:=3;
 End Else If Fmt='FLV' Then Begin
  If U='FSV1' Then K:=6;
 End Else If (Fmt='OGV') Or (Fmt='OGG') Then Begin
  If (U='THEORA') Or (U='') Then K:=5;
 End Else If InList(Fmt,'MPG,MPEG,M2V,M1V,DAT,VOB') Then K:=4;
 If K=0 Then Exit;
 Y4:=TmpName('Y4M'); Es:='';
 If K=4 Then Begin
  Es:=TmpName('M2V'); Au:=TmpName('MPA');
  If COpen(Src) Then Begin
   If (CB(0)=0) And (CB(1)=0) And (CB(2)=1) And (CB(3)=$BA) Then Begin
    CClose;
    If Not PsExtract(Src,Es,Au,HaveA) Then Begin DelFile(Es); DelFile(Au); Err:='Aucun flux vid'#233'o MPEG trouv'#233'.'; Y4mSource:=-1; Exit; End;
    DelFile(Au); Src:=Es;
   End Else CClose;
  End;
 End;
 If Not RunEng(ekDecVid,Src,Y4,K*10,Err) Then Begin
  DelFile(Y4); If Es<>'' Then DelFile(Es); Y4mSource:=-1; Exit;
 End;
 If Es<>'' Then DelFile(Es);
 Y4mSource:=1;
End;

Function Y4mTrack(Const Y4: String; Var V: TTrkIn): Boolean;
Var W,H,Fn,Fd,N,Hl,I: LongInt;
Begin
 Y4mTrack:=False; FillChar(V,SizeOf(V),0);
 If Not Y4mInfo(Y4,W,H,Fn,Fd,N,Hl) Then Exit;
 TrkAlloc(V,N);
 For I:=0 To N-1 Do Begin V.Dur^[I]:=Fd; V.Sync^[I]:=1; V.Cts^[I]:=0; V.Sz^[I]:=1; V.Off^[I]:=0; End;
 V.Ok:=True; V.IsVideo:=True; V.Codec:='y4m'; V.Ts:=Fn; V.W:=W; V.H:=H;
 Y4mTrack:=True;
End;


{ miniature : premiere image par les moteurs de FFMPEG.PAS (BMP) }
Function Y4mFirstFrame(Const Path,Fmt,Codec: String): PImg;
Var M: TMedia; K: Integer; U,Bmp,Es,Au,Src,Part: String; HaveA: Boolean; Err: String; F,G: File; Got: Word; Buf: PBArr; Sz,Rd: LongInt;
Begin
 Y4mFirstFrame:=Nil; K:=0; U:=UpStr(Codec); Src:=Path; Es:='';
 If (Fmt='WMV') Or (Fmt='ASF') Then Begin
  U:=AsfFourCC(Path);
  If InList(U,'WMV3,WVC1,WMVA,WVP2,WMVP') Then K:=1 Else If InList(U,'WMV1,WMV2') Then K:=7;
 End Else If Fmt='AVI' Then Begin
  If InList(U,'WMV3,WVC1,WMVA') Then K:=2 Else If InList(U,'WMV1,WMV2') Then K:=3;
 End Else If Fmt='FLV' Then Begin
  If U='FSV1' Then K:=6;
 End Else If (Fmt='OGV') Or (Fmt='OGG') Then K:=5
 Else If InList(Fmt,'MPG,MPEG,M2V,M1V,DAT,VOB') Then K:=4;
 If K=0 Then Exit;
 If K=4 Then Begin
  { debut du fichier seulement }
  If COpen(Path) Then Begin
   If (CB(0)=0) And (CB(1)=0) And (CB(2)=1) And (CB(3)=$BA) Then Begin
    CClose;
    Part:=TmpName('MPG'); Es:=TmpName('M2V'); Au:=TmpName('MPA');
    If OpenSrc(Path,F) And CreateOut(Part,G,Err) Then Begin
     Sz:=Min(FileSize(F),6000000); GetMem(Buf,32768); Rd:=0;
     While Rd<Sz Do Begin
      {$I-}BlockRead(F,Buf^,32768,Got);{$I+}
      If (IOResult<>0) Or (Got=0) Then Break;
      BlockWrite(G,Buf^,Got); Inc(Rd,Got);
     End;
     FreeMem(Buf,32768); Close(F); Close(G);
     If PsExtract(Part,Es,Au,HaveA) Then Src:=Es;
     DelFile(Au); DelFile(Part);
    End;
   End Else CClose;
  End;
 End;
 Bmp:=TmpName('BMP');
 If RunEng(ekDecVid,Src,Bmp,K*10+2,Err) Then Y4mFirstFrame:=LoadBmp(Bmp);
 DelFile(Bmp); If Es<>'' Then DelFile(Es);
End;

{ ---- Y4M a partir du fichier temporaire d'images brutes ---- }
Function WriteY4m(Const Dst: String; Var Err: String): Boolean;
Var FO: File; Hd: String; I,Fsz,P: LongInt; Got: Word; Buf: PEABuffer; Ok: Boolean; Fr: String;
Begin
 WriteY4m:=False; Fsz:=VJOutW*VJOutH*3 Div 2;
 If Not CreateOut(Dst,FO,Err) Then Exit;
 Hd:='YUV4MPEG2 W'+IStr(VJOutW)+' H'+IStr(VJOutH)+' F'+IStr(VJFn)+':'+IStr(VJFd)+' Ip A1:1 C420jpeg XYSCSS=420JPEG'#10;
 BlockWrite(FO,Hd[1],Length(Hd));
 Fr:='FRAME'#10; GetMem(Buf,Fsz+16); Seek(VJTmp,0); Ok:=True;
 For I:=1 To VJCnt Do Begin
  P:=0;
  While P<Fsz Do Begin
   {$I-}BlockRead(VJTmp,Buf^[P],Min(32768,Fsz-P),Got);{$I+}
   If (IOResult<>0) Or (Got=0) Then Begin Ok:=False; Break; End;
   Inc(P,Got);
  End;
  If Not Ok Then Break;
  BlockWrite(FO,Fr[1],6); BlockWrite(FO,Buf^,Fsz);
  If (I And 7)=0 Then Begin UiTick(I,VJCnt*2); If Stopped Then Begin Ok:=False; Err:='Conversion annul'#233'e.'; Break; End; End;
 End;
 FreeMem(Buf,Fsz+16); Close(FO);
 If (Not Ok) And (Err='') Then Err:='Lecture du fichier temporaire impossible.';
 If Not Ok Then DelFile(Dst);
 WriteY4m:=Ok;
End;

{ Audio recode dans le format de l'audio du conteneur (MP3, WMA, OGG, MP2...) }
Function AltAudio(Var M: TMedia; Const Pr: TProf; Const AExt,Dst: String; Var Err: String): Boolean;
Var T1,T2: String; P,SP: TAP; Pa: TProf;
Begin
 AltAudio:=False; Pa:=Pr; Pa.Ext:=AExt;
 If Pa.AKb<48 Then Pa.AKb:=128;
 If Pa.AKb>320 Then Pa.AKb:=192;
 T1:=TmpName('WAV'); T2:=TmpName('WAV');
 If Not GetPcm(M,T1,Err) Then Begin DelFile(T1); Exit; End;
 FillChar(SP,SizeOf(SP),0); SP.Vol:=100; SP.Speed:=100;
 BuildAP(M,Pa,P,SP);
 If P.OutRate<32000 Then P.OutRate:=44100;
 If (P.OutRate<>44100) And (P.OutRate<>48000) And (P.OutRate<>32000) Then P.OutRate:=44100;
 If P.OutCh=0 Then P.OutCh:=2;
 If Not ProcessWav(T1,T2,P,Err) Then Begin DelFile(T1); DelFile(T2); Exit; End;
 DelFile(T1);
 AltAudio:=WriteFinal(T2,Dst,Pa,Err);
 DelFile(T2);
End;

Function AltVideoOut(Var M: TMedia; Const Pr: TProf; Const Dst: String; HaveAudio: Boolean; Var Err: String): Boolean;
Var Y4,Es,Au: String; V,A: TTrkIn; HaveA,Ok: Boolean; Tr: Array[0..1] Of TMuxTrk; NT: Integer; VMem,AMem: PBArr;
Begin
 AltVideoOut:=False; HaveA:=False; Ok:=False;
 Y4:=TmpName('Y4M'); Es:=TmpName('M4V'); Au:='';
 If Not WriteY4m(Y4,Err) Then Exit;
 If Pr.Ext='AVI' Then Begin
  If Not RunEng(ekEncMpeg4,Y4,Es,Pr.VKb,Err) Then Begin DelFile(Y4); DelFile(Es); Exit; End;
  DelFile(Y4);
  If HaveAudio Then Begin
   Au:=TmpName('MP3');
   If AltAudio(M,Pr,'MP3',Au,Err) Then HaveA:=ParseMp3(Au,A) Else Begin
    If Stopped Then Begin DelFile(Es); DelFile(Au); Exit; End;
    If Pos('Aucune piste audio',Err)=0 Then JobWarn:=' (sans audio : '+Err+')';
    Err:='';
   End;
  End;
  If Not ParseM4v(Es,V) Then Begin Err:='Flux MPEG-4 invalide.'; DelFile(Es); If Au<>'' Then DelFile(Au); Exit; End;
  V.W:=VJOutW; V.H:=VJOutH;
  Ok:=MuxAvi(Dst,V,A,HaveA,Es,Au,'XVID',VJFn,VJFd,Err);
  TrkClear(V); If HaveA Then TrkClear(A);
  DelFile(Es); If Au<>'' Then DelFile(Au);
 End Else If Pr.Ext='WEBM' Then Begin
  DelFile(Y4); DelFile(Es);
  If Not Vp8Track(V,VMem,VJBitrate,Err) Then Exit;
  FillChar(Tr,SizeOf(Tr),0); Tr[0].T:=@V; Tr[0].First:=0; Tr[0].Last:=V.N-1; Tr[0].Mem:=VMem; NT:=1;
  If HaveAudio Then Begin
   Au:=TmpName('OGG');
   If AltAudio(M,Pr,'OGG',Au,Err) Then Begin
    If OggVorbisTrack(Au,A,AMem) Then Begin Tr[1].T:=@A; Tr[1].First:=0; Tr[1].Last:=A.N-1; Tr[1].Mem:=AMem; NT:=2; HaveA:=True; End;
   End Else Begin
    If Stopped Then Begin DelFile(Au); Exit; End;
    If Pos('Aucune piste audio',Err)=0 Then JobWarn:=' (sans audio : '+Err+')';
    Err:='';
   End;
   DelFile(Au); Au:='';
  End;
  Ok:=MuxMkv(Dst,'webm',Tr,NT,Err);
  TrkClear(V); FreeMem(VMem);
  If HaveA Then TrkClear(A);
 End Else If Pr.Ext='WMV' Then Begin
  If Not RunEng(ekEncWmv,Y4,Es,Pr.VKb,Err) Then Begin DelFile(Y4); DelFile(Es); Exit; End;
  DelFile(Y4);
  If HaveAudio Then Begin
   Au:=TmpName('WMA');
   If AltAudio(M,Pr,'WMA',Au,Err) Then HaveA:=True Else Begin
    If Stopped Then Begin DelFile(Es); DelFile(Au); Exit; End;
    If Pos('Aucune piste audio',Err)=0 Then JobWarn:=' (sans audio : '+Err+')';
    Err:=''; DelFile(Au); Au:='';
   End;
  End;
  Ok:=MuxAsf(Dst,Es,Au,HaveA,VJFn,VJFd,Err);
  DelFile(Es); If Au<>'' Then DelFile(Au);
 End Else If Pr.Ext='MPG' Then Begin
  VideoCodec:='mpeg2video';
  If Not RunEng(ekEncMpeg1,Y4,Es,0,Err) Then Begin DelFile(Y4); DelFile(Es); Exit; End;
  DelFile(Y4);
  If HaveAudio Then Begin
   Au:=TmpName('MP2');
   If AltAudio(M,Pr,'MP2',Au,Err) Then HaveA:=True Else Begin
    If Stopped Then Begin DelFile(Es); DelFile(Au); Exit; End;
    If Pos('Aucune piste audio',Err)=0 Then JobWarn:=' (sans audio : '+Err+')';
    Err:=''; DelFile(Au); Au:='';
   End;
  End;
  Ok:=MuxPs(Dst,Es,Au,HaveA,VJFn,VJFd,True,Err);
  DelFile(Es); If Au<>'' Then DelFile(Au);
 End Else If Pr.Ext='OGV' Then Begin
  If Not RunEng(ekEncTheora,Y4,Es,5,Err) Then Begin DelFile(Y4); DelFile(Es); Exit; End;
  DelFile(Y4);
  If HaveAudio Then Begin
   Au:=TmpName('OGG');
   If AltAudio(M,Pr,'OGG',Au,Err) Then HaveA:=True Else Begin
    If Stopped Then Begin DelFile(Es); DelFile(Au); Exit; End;
    If Pos('Aucune piste audio',Err)=0 Then JobWarn:=' (sans audio : '+Err+')';
    Err:=''; DelFile(Au); Au:='';
   End;
  End;
  Ok:=OgvMux(Dst,Es,Au,HaveA,Err);
  DelFile(Es); If Au<>'' Then DelFile(Au);
 End Else Begin
  DelFile(Y4); Err:='Sortie '+Pr.Ext+' non disponible.';
 End;
 AltVideoOut:=Ok;
End;
{$ENDIF}

