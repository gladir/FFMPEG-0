Function NVU4(R,G,B: LongInt): LongInt;Begin
 NVU4:=ADPCMSar(-4865*R-9528*G+14392*B+(257 Shl 14),15);
End;
Function NVV4(R,G,B: LongInt): LongInt;Begin
 NVV4:=ADPCMSar(14392*R-12061*G-2332*B+(257 Shl 14),15);
End;
