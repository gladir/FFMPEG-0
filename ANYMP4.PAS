Const
 ekMP3 = 1; ekAIFF = 2; ekVOC = 3; ekMOD = 4; ekEncMP3 = 5; ekAAC = 6; ekEncAAC = 7; ekAC3 = 8; ekEncAC3 = 9; ekOgg = 10; ekEncVorbis = 11; ekVorbisPk = 12; ekDca = 13; ekWma = 14; ekEncWma = 15; ekEncMpeg4 = 16; ekEncTheora = 17; ekEncWmv = 18; ekEncMpeg1 = 19; ekDecVid = 20; ekMpa = 21; ekEncMp2 = 22; ekWmaAvi = 23; ekAsfSpool = 24;

Type
 TByteArr = Array[0..32767] Of Byte;
 PByteArr = ^TByteArr;
 TIntArr = Array[0..16383] Of Integer;
 PIntArr = ^TIntArr;
 THdr = Array[0..63] Of Byte;
 TWavInfo = Record
  Tag,Ch,Bits,Align: Integer;
  Rate: LongInt;
  DataOfs,DataLen: LongInt;
 End;
 TAP = Record
  StartMs,EndMs,DelayMs: LongInt;
  Vol,Speed: Integer;
  OutRate: LongInt;
  OutCh: Integer;
  Rev: Boolean;
  FadeIn,FadeOut: LongInt;
 End;

Var
 EngFirst: LongInt;
 JobIdx: Integer;
 TmpCount: Integer;
 LastDraw: LongInt;
 EngUsed: Boolean;

Procedure UiTick(Pos,Total: LongInt); Forward;
{$IFDEF FPC}
Procedure DecodeWMVAsf(Const Source,Target: String; Mode: LongInt); Forward;
{$ENDIF}

{$IFDEF FPC}
