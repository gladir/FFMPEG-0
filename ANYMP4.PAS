Function V1Dcdiff(N: LongInt): LongInt;
Begin
 If N<4 Then V1Dcdiff:=V1TreeGet(V1TDcL[V1DcTab]) Else V1Dcdiff:=V1TreeGet(
  V1TDcC[V1DcTab]);
