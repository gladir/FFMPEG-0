Procedure V1PutPixelsClamped(B: PV1S; O: LongInt; Pl: PEABuffer; Off,Stride:
 LongInt; Signed: Boolean);
Var X,Y,V: LongInt;
Begin
 For Y:=0 To 7 Do Begin
  For X:=0 To 7 Do Begin
   V:=B^[O+Y*8+X];
   If Signed Then Inc(V,128);
   Pl^[Off+X]:=V1Clip8(V);
  End;
  Inc(Off,Stride);
 End;
End;
