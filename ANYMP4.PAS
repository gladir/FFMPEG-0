Procedure AVSBuildCRC;
Var
 N,K: Integer;
 C: Int64;
Begin
 For N:=0 To 255 Do Begin
  C:=N;
  For K:=1 To 8 Do If (C And 1)<>0 Then C:=$EDB88320 Xor (C Shr 1) Else C:=C Shr
   1;
  CRC32Table[N]:=ALWrap32(C);
 End;
 CRC32Ready:=True;
End;
Var
 INSrc: PEABuffer;
 INLen,INPos,INBitBuf,INBitCnt,INCap,INOut,INErr: LongInt;
