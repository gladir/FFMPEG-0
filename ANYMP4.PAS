Type
 TDCI32=Array[0..4000000] Of LongInt;
 PDCI32=^TDCI32;
 TDCF=Array[0..1048575] Of Single;
 PDCF=^TDCF;

Const
 DCStride=516;
 { 4 echantillons d'historique ADPCM + 512 }
 DCCbSel: Array[0..9] Of Byte=(1,2,2,2,2,3,3,3,3,3);
 DCCbGrp: Array[0..9] Of Byte=(1,3,3,3,3,7,7,7,7,7);
 DCCbSize: Array[0..9] Of Byte=(3,5,7,9,13,17,25,33,65,129);
 DCCbOff: Array[0..9] Of ShortInt=(-1,-2,-3,-4,-6,-8,-12,-16,-32,-64);
 DCRates: Array[0..15] Of LongInt=(0,8000,16000,32000,0,0,11025,22050,44100,0,0,
  12000,
 24000,48000,96000,192000);
 DCBlockBits: Array[0..6] Of Byte=(7,10,12,13,15,17,19);
 DCPrmSpk: Array[0..9,0..4] Of ShortInt=((0,-1,-1,-1,-1),(1,2,-1,-1,-1),(1,2,-1,
  -1,-1),(1,
 2,-1,-1,-1),(1,2,-1,-1,-1),(0,1,2,-1,-1),(1,2,6,-1,-1),(0,1,2,6,-1),(1,2,3,4,-
  1),(0,1,2,
 3,4));
 { masque haut-parleurs DCA par mode: C=1 L=2 R=4 Ls=8 Rs=16 LFE=32 Cs=64 }
 DCModeMask: Array[0..9] Of Byte=(1,6,6,6,6,7,70,71,30,31);
 DCDca2Wav: Array[0..27] Of Byte=(2,0,1,9,10,3,8,4,5,9,10,6,7,12,13,14,3,6,7,11,
  12,14,16,
 15,17,8,4,5);

Var
 DCBuf: PEABuffer;
 DCSize,DCBit: LongInt;
 DCErr: Boolean;
 DCStart,DCNum,DCOffs: Array[0..61] Of LongInt;
 DCCode: Array[0..2708] Of LongInt;
 DCMaxLen: Array[0..61] Of LongInt;
 DCQI: Array[0..9,0..6] Of LongInt;
 DCFir32P,DCFir32N,DCLfe64F,DCLfe128F: Array[0..511] Of Single;
 DCCos: Array[0..31,0..31] Of Double;
 DCSub: PDCI32;
 DCLfeS: Array[0..300] Of LongInt;
 DCHist1: Array[0..6,0..1023] Of Single;
 DCHist2: Array[0..6,0..63] Of Single;
 DCOff: Array[0..6] Of LongInt;
 DCInited: Boolean;
 { en-tete trame }
 DCCrcPresent,DCNPcm,DCFrameSize,DCMode,DCSr,DCBrCode,DCBitRate,DCDrc,DCTs,
  DCAux,
 DCExtType,DCExtPresent,DCSyncSsf,DCLfe,DCPredHist,DCFilterPerfect,DCSumFront,
 DCSumSurr: LongInt;
 DCNSub,DCNCh: LongInt;
 DCNSubbands,DCVqStart,DCJointIdx,DCTransSel,DCSfSel,DCBaSel: Array[0..6] Of
  LongInt;
 DCQSel: Array[0..6,0..9] Of LongInt;
 DCSfAdj: Array[0..6,0..9] Of LongInt;
 DCNSubSub: Array[0..15] Of LongInt;
 DCPredMode: Array[0..6,0..31] Of LongInt;
 DCPredVq: Array[0..6,0..31] Of LongInt;
 DCBitAlloc: Array[0..6,0..31] Of LongInt;
 DCTrans: Array[0..15,0..6,0..31] Of LongInt;
 DCScale: Array[0..6,0..31,0..1] Of LongInt;
 DCJointSel: Array[0..6] Of LongInt;
 DCJointScale: Array[0..6,0..31] Of LongInt;
 DCOutF: Array[0..6] Of PDCF;
 DCOutN: LongInt;

Procedure DCInit;
Var
 T,I,J,K,E,P,Cnt,L,Code: LongInt;
 Cd: Int64;
 Sizes: Array[0..61] Of LongInt;
 Offs: Array[0..61] Of LongInt;
Begin
 If DCInited Then Exit;
 DCInited:=True;
 T:=0;
 For I:=0 To 9 Do
 For J:=0 To DCCbGrp[I]-1 Do Begin
  Sizes[T]:=DCCbSize[I]; Offs[T]:=DCCbOff[I]; DCQI[I,J]:=T; Inc(T);
 End;
 For I:=0 To 4 Do Begin
  Sizes[T]:=12; Offs[T]:=1; Inc(T);
 End;
 For I:=0 To 4 Do Begin
  Sizes[T]:=129; Offs[T]:=-64; Inc(T);
 End;
 For I:=0 To 3 Do Begin
  Sizes[T]:=4; Offs[T]:=0; Inc(T);
 End;
 P:=0;
 For T:=0 To 61 Do Begin
  DCStart[T]:=P; DCNum[T]:=Sizes[T]; DCOffs[T]:=Offs[T];
  Cd:=0; DCMaxLen[T]:=0;
  For E:=0 To Sizes[T]-1 Do Begin
   L:=DCAVlcLen[P+E];
   If L>0 Then Begin
    DCCode[P+E]:=Cd Shr (32-L);
    If L>DCMaxLen[T] Then DCMaxLen[T]:=L;
    Cd:=Cd+(Int64(1) Shl (32-L));
   End;
  End;
  Inc(P,Sizes[T]);
 End;
 Move(DCAFirPerfect,DCFir32P,2048); Move(DCAFirNon,DCFir32N,2048);
 Move(DCALfe64,DCLfe64F,1024); Move(DCALfe128,DCLfe128F,1024);
 For I:=0 To 31 Do
 For J:=0 To 31 Do DCCos[I,J]:=Cos(Pi/32*(32-I-0.5)*(J+0.5));
 GetMem(DCSub,7*32*DCStride*4+64);
 FillChar(DCSub^,7*32*DCStride*4,0);
 FillChar(DCLfeS,SizeOf(DCLfeS),0);
 FillChar(DCHist1,SizeOf(DCHist1),0); FillChar(DCHist2,SizeOf(DCHist2),0);
 FillChar(DCOff,SizeOf(DCOff),0);
 FillChar(DCSfAdj,SizeOf(DCSfAdj),0);
End;

Function DCLeft: LongInt;Begin
 DCLeft:=DCSize*8-DCBit;
End;

Function DCBits(N: LongInt): Int64;
Var
 V: Int64;
 I,B: LongInt;
Begin
 V:=0;
 For I:=1 To N Do Begin
  B:=DCBit Shr 3;
  If B<DCSize Then V:=V*2+((DCBuf^[B] Shr (7-(DCBit And 7))) And 1) Else V:=V*2;
  Inc(DCBit);
 End;
 DCBits:=V;
End;

Function DCSBits(N: LongInt): LongInt;
Var
 V: Int64;
Begin
 If N=0 Then Begin
  DCSBits:=0; Exit;
 End;
 V:=DCBits(N); If V>=(Int64(1) Shl (N-1)) Then V:=V-(Int64(1) Shl N); DCSBits:=
  V;
End;

Function DCVlc(T: LongInt): LongInt;
Var
 V: Int64;
 L,E,S: LongInt;
Begin
 V:=0; S:=DCStart[T];
 For L:=1 To DCMaxLen[T] Do Begin
  V:=V*2+DCBits(1);
  For E:=0 To DCNum[T]-1 Do   If (DCAVlcLen[S+E]=L) And (DCCode[S+E]=V) Then
   Begin
   DCVlc:=DCAVlcSym[S+E]+DCOffs[T]; Exit;
  End;
 End;
 DCErr:=True; DCVlc:=0;
End;

Function DCClip23(A: Int64): LongInt;Begin
 If A>8388607 Then A:=8388607; If A<-8388608 Then A:=-8388608; DCClip23:=A;
End;

Function DCNorm(A: Int64; Bits: LongInt): LongInt;Begin
 If Bits>0 Then DCNorm:=AVSar(A+(Int64(1) Shl (Bits-1)),Bits) Else DCNorm:=A;
End;

Function DCSmp(Ch,Band,N: LongInt): LongInt;Begin
 DCSmp:=DCSub^[(Ch*32+Band)*DCStride+4+N];
End;

Function DCParseScale(Var Index: LongInt; Sel: LongInt): LongInt;
Var
 V: LongInt;
Begin
 If Sel<5 Then Inc(Index,DCVlc(53+Sel)) Else Index:=DCBits(Sel+1);
 If Sel>5 Then Begin
  If (Index<0) Or (Index>=128) Then Begin
   DCErr:=True; DCParseScale:=0; Exit;
  End;
  V:=DCAScale7[Index];
 End Else
 Begin
  If (Index<0) Or (Index>=64) Then Begin
   DCErr:=True; DCParseScale:=0; Exit;
  End;
  V:=DCAScale6[Index];
 End;
 DCParseScale:=V;
End;

Function DCParseJoint(Sel: LongInt): LongInt;
Var
 Idx: LongInt;
Begin
 If Sel<5 Then Idx:=DCVlc(53+Sel) Else Idx:=DCBits(Sel+1);
 Inc(Idx,64);
 If (Idx<0) Or (Idx>=129) Then Begin
  DCErr:=True; DCParseJoint:=0; Exit;
 End;
 DCParseJoint:=DCAJoint[Idx];
End;
{ Analyse de l'en-tete de trame; retourne False si invalide ou non pris en
 charge }

Function DCParseHeader: Boolean;
Var
 Dummy: Int64;
Begin
 DCParseHeader:=False;
 DCBit:=0;
 If DCBits(32)<>$7FFE8001 Then Exit;
 Dummy:=DCBits(1);
 If DCBits(5)+1<>32 Then Exit;
 DCCrcPresent:=DCBits(1);
 DCNPcm:=DCBits(7)+1;
 If (DCNPcm And 7)<>0 Then Exit;
 DCFrameSize:=DCBits(14)+1;
 If DCFrameSize<96 Then Exit;
 DCMode:=DCBits(6);
 If DCMode>=10 Then Exit;
 DCSr:=DCBits(4);
 If DCRates[DCSr]=0 Then Exit;
 DCBrCode:=DCBits(5);
 If DCBits(1)<>0 Then Exit;
 DCDrc:=DCBits(1); DCTs:=DCBits(1); DCAux:=DCBits(1); Dummy:=DCBits(1);
 DCExtType:=DCBits(3); DCExtPresent:=DCBits(1); DCSyncSsf:=DCBits(1);
 DCLfe:=DCBits(2); If DCLfe=3 Then Exit;
 DCPredHist:=DCBits(1);
 If DCCrcPresent<>0 Then Dummy:=DCBits(16);
 DCFilterPerfect:=DCBits(1);
 Dummy:=DCBits(4); Dummy:=DCBits(2);
 Dummy:=DCBits(3);
 If (Dummy=4) Or (Dummy=7) Then Exit;
 DCSumFront:=DCBits(1); DCSumSurr:=DCBits(1); Dummy:=DCBits(4);
 DCBitRate:=DCABitRates[DCBrCode];
 DCParseHeader:=True;
End;

Function DCParseCoding: Boolean;
Var
 N,Ch,Idx: LongInt;
Begin
 DCParseCoding:=False;
 If DCLeft<0 Then Exit;
 DCNSub:=DCBits(4)+1;
 DCNCh:=DCBits(3)+1;
 If DCNCh<>DCAChannelsTab[DCMode] Then Exit;
 For Ch:=0 To DCNCh-1 Do Begin
  DCNSubbands[Ch]:=DCBits(5)+2;
  If DCNSubbands[Ch]>32 Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do DCVqStart[Ch]:=DCBits(5)+1;
 For Ch:=0 To DCNCh-1 Do Begin
  N:=DCBits(3);
  If N>DCNCh Then Exit;
  DCJointIdx[Ch]:=N;
 End;
 For Ch:=0 To DCNCh-1 Do DCTransSel[Ch]:=DCBits(2);
 For Ch:=0 To DCNCh-1 Do Begin
  DCSfSel[Ch]:=DCBits(3); If DCSfSel[Ch]=7 Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  DCBaSel[Ch]:=DCBits(3); If DCBaSel[Ch]=7 Then Exit;
 End;
 For N:=0 To 9 Do
 For Ch:=0 To DCNCh-1 Do DCQSel[Ch,N]:=DCBits(DCCbSel[N]);
 For N:=0 To 9 Do
 For Ch:=0 To DCNCh-1 Do  If DCQSel[Ch,N]<DCCbGrp[N] Then Begin
  Idx:=DCBits(2); DCSfAdj[Ch,N]:=DCAScaleAdj[Idx];
 End;
 If DCCrcPresent<>0 Then Idx:=DCBits(16);
 DCParseCoding:=True;
End;

Function DCParseSubHeader(Sf: LongInt): Boolean;
Var
 Ch,Band,Sel,Abits,SI,R: LongInt;
Begin
 DCParseSubHeader:=False;
 If DCLeft<0 Then Exit;
 DCNSubSub[Sf]:=DCBits(2)+1;
 R:=DCBits(3);
 For Ch:=0 To DCNCh-1 Do
 For Band:=0 To DCNSubbands[Ch]-1 Do DCPredMode[Ch,Band]:=DCBits(1);
 For Ch:=0 To DCNCh-1 Do
 For Band:=0 To DCNSubbands[Ch]-1 Do If DCPredMode[Ch,Band]<>0 Then DCPredVq[Ch,
  Band]:=
 DCBits(12);
 For Ch:=0 To DCNCh-1 Do Begin
  Sel:=DCBaSel[Ch];
  For Band:=0 To DCVqStart[Ch]-1 Do Begin
   If Sel<5 Then Abits:=DCVlc(48+Sel) Else Abits:=DCBits(Sel-1);
   If DCErr Or (Abits>26) Then Exit;
   DCBitAlloc[Ch,Band]:=Abits;
  End;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  FillChar(DCTrans[Sf,Ch],SizeOf(DCTrans[Sf,Ch]),0);
  If DCNSubSub[Sf]>1 Then Begin
   Sel:=DCTransSel[Ch];
   For Band:=0 To DCVqStart[Ch]-1 Do If DCBitAlloc[Ch,Band]<>0 Then DCTrans[Sf,
    Ch,Band]:=
   DCVlc(58+Sel);
  End;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  Sel:=DCSfSel[Ch]; SI:=0;
  For Band:=0 To DCVqStart[Ch]-1 Do Begin
   If DCBitAlloc[Ch,Band]<>0 Then Begin
    DCScale[Ch,Band,0]:=DCParseScale(SI,Sel); If DCErr Then Exit;
    If DCTrans[Sf,Ch,Band]<>0 Then Begin
     DCScale[Ch,Band,1]:=DCParseScale(SI,Sel); If DCErr Then Exit;
    End;
   End Else DCScale[Ch,Band,0]:=0;
  End;
  For Band:=DCVqStart[Ch] To DCNSubbands[Ch]-1 Do Begin
   DCScale[Ch,Band,0]:=DCParseScale(SI,Sel); If DCErr Then Exit;
  End;
 End;
 For Ch:=0 To DCNCh-1 Do If DCJointIdx[Ch]<>0 Then Begin
  DCJointSel[Ch]:=DCBits(3); If DCJointSel[Ch]=7 Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  SI:=DCJointIdx[Ch]-1;
  If SI>=0 Then Begin
   Sel:=DCJointSel[Ch];
   For Band:=DCNSubbands[Ch] To DCNSubbands[SI]-1 Do Begin
    DCJointScale[Ch,Band]:=DCParseJoint(Sel); If DCErr Then Exit;
   End;
  End;
 End;
 If (DCDrc<>0) Then R:=DCBits(8);
 If DCCrcPresent<>0 Then R:=DCBits(16);
 DCParseSubHeader:=True;
End;

Function DCPredict(Ch,Band,Pred,At: LongInt): LongInt;
Var
 I: LongInt;
 S: Int64;
Begin
 S:=0;
 For I:=0 To 3 Do S:=S+Int64(DCSub^[(Ch*32+Band)*DCStride+4+At-1-I])*DCAAdpcmVb[
  Pred*4+I];
 DCPredict:=DCClip23(DCNorm(S,13));
End;

Function DCParseSubAudio(Sf: LongInt; Var SubPos,LfePos: LongInt): Boolean;
Var
 Audio: Array[0..15] Of LongInt;
 N,Ssf,Ofs,Ch,Band,NSamples,Abits,Sel,Ret,Step,Trans,Scl,Idx,Code1,Code2,Levels,
  Off2,Dv,
 Hi,J,SrcCh,NLfe,Sh,Base,Vq: LongInt;
 Adj,StepScale: Int64;
 VqIdx: Array[0..31] Of LongInt;
 Sc: LongInt;
 Ok: Boolean;

Function Extract(AbitsV,ChV: LongInt; Var Ret2: LongInt): Boolean;
Var
 K,SelV,C1,C2,Lv,Of3,Dd: LongInt;
Begin
 Extract:=True; Ret2:=0;
 If AbitsV=0 Then Begin
  FillChar(Audio,SizeOf(Audio),0); Exit;
 End;
 If AbitsV<=10 Then Begin
  SelV:=DCQSel[ChV,AbitsV-1];
  If SelV<DCCbGrp[AbitsV-1] Then Begin
   For K:=0 To 7 Do Audio[K]:=DCVlc(DCQI[AbitsV-1,SelV]);
   Ret2:=1; Exit;
  End;
  If AbitsV<=7 Then Begin
   C1:=DCBits(DCBlockBits[AbitsV-1]); C2:=DCBits(DCBlockBits[AbitsV-1]);
   Lv:=DCAQuantLevels[AbitsV]; Of3:=(Lv-1) Div 2;
   For K:=0 To 3 Do Begin
    Dd:=C1 Div Lv; Audio[K]:=C1-Dd*Lv-Of3; C1:=Dd;
   End;
   For K:=4 To 7 Do Begin
    Dd:=C2 Div Lv; Audio[K]:=C2-Dd*Lv-Of3; C2:=Dd;
   End;
   If (C1 Or C2)<>0 Then Extract:=False;
   Exit;
  End;
 End;
 For K:=0 To 7 Do Audio[K]:=DCSBits(AbitsV-3);
End;
Begin
 DCParseSubAudio:=False;
 NSamples:=DCNSubSub[Sf]*8;
 If SubPos+NSamples>DCNPcm Then Exit;
 If DCLeft<0 Then Exit;
 { sous-bandes VQ haute frequence }
 For Ch:=0 To DCNCh-1 Do Begin
  For Band:=DCVqStart[Ch] To DCNSubbands[Ch]-1 Do VqIdx[Band]:=DCBits(10);
  For Band:=DCVqStart[Ch] To DCNSubbands[Ch]-1 Do
  For J:=0 To NSamples-1 Do    DCSub^[(Ch*32+Band)*DCStride+4+SubPos+J]:=
   DCClip23(AVSar(
  Int64(DCAHfVq[VqIdx[Band]*32+J])*DCScale[Ch,Band,0]+8,4));
 End;
 { LFE }
 If DCLfe<>0 Then Begin
  NLfe:=2*DCLfe*DCNSubSub[Sf];
  For N:=0 To NLfe-1 Do Audio[N]:=DCSBits(8);
  Idx:=DCBits(8);
  If Idx>=128 Then Exit;
  Sc:=DCAScale7[Idx];
  Sc:=DCNorm(Int64(4697620)*Sc,23);
  Ofs:=LfePos;
  For N:=0 To NLfe-1 Do Begin
   DCLfeS[Ofs]:=DCClip23(AVSar(Int64(Audio[N])*Sc,4)); Inc(Ofs);
  End;
  LfePos:=Ofs;
 End;
 { donnees audio }
 Ofs:=SubPos;
 For Ssf:=0 To DCNSubSub[Sf]-1 Do Begin
  For Ch:=0 To DCNCh-1 Do Begin
   If DCLeft<0 Then Exit;
   For Band:=0 To DCVqStart[Ch]-1 Do Begin
    Abits:=DCBitAlloc[Ch,Band];
    If Not Extract(Abits,Ch,Ret) Then Exit;
    If DCErr Then Exit;
    If DCBitRate=3 Then Step:=DCALossless[Abits] Else Step:=DCALossy[Abits];
    Trans:=DCTrans[Sf,Ch,Band];
    If (Trans=0) Or (Ssf<Trans) Then Scl:=DCScale[Ch,Band,0] Else Scl:=DCScale[
     Ch,Band,1];
    If Ret>0 Then Begin
     Adj:=DCSfAdj[Ch,Abits-1];
     Scl:=DCClip23(AVSar(Adj*Scl,22));
    End;
    StepScale:=Int64(Step)*Scl; Sh:=0;
    If StepScale>(1 Shl 23) Then Begin
     Hi:=StepScale Shr 23; Sh:=0;
     While Hi>1 Do Begin
      Hi:=Hi Shr 1; Inc(Sh);
     End; Inc(Sh);
     StepScale:=StepScale Shr Sh;
    End;
    For N:=0 To 7 Do     DCSub^[(Ch*32+Band)*DCStride+4+Ofs+N]:=DCClip23(DCNorm(
     Int64(
    Audio[N])*StepScale,22-Sh));
   End;
  End;
  If (Ssf=DCNSubSub[Sf]-1) Or (DCSyncSsf<>0) Then   If DCBits(16)<>$FFFF Then
   Exit;
  Inc(Ofs,8);
 End;
 { ADPCM inverse }
 For Ch:=0 To DCNCh-1 Do
 For Band:=0 To DCNSubbands[Ch]-1 Do   If DCPredMode[Ch,Band]<>0 Then
 For J:=0 To NSamples-1 Do Begin
  Idx:=(Ch*32+Band)*DCStride+4+SubPos+J;
  DCSub^[Idx]:=DCClip23(Int64(DCSub^[Idx])+DCPredict(Ch,Band,DCPredVq[Ch,Band],
   SubPos+J));
 End;
 { codage joint }
 For Ch:=0 To DCNCh-1 Do Begin
  SrcCh:=DCJointIdx[Ch]-1;
  If SrcCh>=0 Then
  For Band:=DCNSubbands[Ch] To DCNSubbands[SrcCh]-1 Do
  For J:=0 To NSamples-1 Do     DCSub^[(Ch*32+Band)*DCStride+4+SubPos+J]:=
   DCClip23(DCNorm(
  Int64(DCSub^[(SrcCh*32+Band)*DCStride+4+SubPos+J])*DCJointScale[Ch,Band],17));
 End;
 SubPos:=Ofs;
 DCParseSubAudio:=True;
End;

Function DCDecodeFrame(P: PEABuffer; Size: LongInt): Boolean;
Var
 Sf,SubPos,LfePos,Ch,Band,NSb,I,J: LongInt;
Begin
 DCDecodeFrame:=False; DCErr:=False;
 DCBuf:=P; DCSize:=Size;
 If Not DCParseHeader Then Exit;
 If DCNPcm>512 Then Exit;
 If DCPredHist=0 Then
 For Ch:=0 To 6 Do
 For Band:=0 To 31 Do   FillChar(DCSub^[(Ch*32+Band)*DCStride],16,0);
 If Not DCParseCoding Then Exit;
 SubPos:=0; LfePos:=8;
 For Sf:=0 To DCNSub-1 Do Begin
  If Not DCParseSubHeader(Sf) Then Exit;
  If DCErr Then Exit;
  If Not DCParseSubAudio(Sf,SubPos,LfePos) Then Exit;
  If DCErr Then Exit;
 End;
 For Ch:=0 To DCNCh-1 Do Begin
  NSb:=DCNSubbands[Ch];
  If DCJointIdx[Ch]<>0 Then If DCNSubbands[DCJointIdx[Ch]-1]>NSb Then NSb:=
  DCNSubbands[DCJointIdx[Ch]-1];
  For Band:=0 To 31 Do Begin
   I:=(Ch*32+Band)*DCStride;
   If Band<NSb Then Move(DCSub^[I+DCNPcm],DCSub^[I],16)
               Else FillChar(DCSub^[I],(4+DCNPcm)*4,0);
  End;
 End;
 DCDecodeFrame:=True;
End;
{ Filtrage de synthese de sous-bandes (synth_filter_float) pour un canal; Out
 recoit npcmblocks*32 echantillons }

Procedure DCSynthChannel(Ch: LongInt; Win: Pointer; Out: PDCF);
Var
 Blk,I,J,K,Offset: LongInt;
 Inp: Array[0..31] Of Single;
 W: PDCF;
 H1: PDCF;
 A,B,C,D: Single;
 Acc: Double;
 Scale: Single;
Begin
 W:=PDCF(Win); Scale:=1.0/131072.0; H1:=PDCF(@DCHist1[Ch,0]);
 For Blk:=0 To DCNPcm-1 Do Begin
  For I:=0 To 31 Do Begin
   If ((I+3) And 2)<>0 Then Inp[I]:=-DCSmp(Ch,I,Blk) Else Inp[I]:=DCSmp(Ch,I,
    Blk);
  End;
  Offset:=DCOff[Ch];
  For I:=0 To 31 Do Begin
   Acc:=0;
   For K:=0 To 31 Do Acc:=Acc+Inp[K]*DCCos[I,K];
   H1^[Offset+I]:=Acc;
  End;
  For I:=0 To 15 Do Begin
   A:=DCHist2[Ch,I]; B:=DCHist2[Ch,I+16]; C:=0; D:=0;
   J:=0;
   While J<512-Offset Do Begin
    A:=A+W^[I+J]*(-H1^[Offset+15-I+J]);
    B:=B+W^[I+J+16]*H1^[Offset+I+J];
    C:=C+W^[I+J+32]*H1^[Offset+16+I+J];
    D:=D+W^[I+J+48]*H1^[Offset+31-I+J];
    Inc(J,64);
   End;
   While J<512 Do Begin
    A:=A+W^[I+J]*(-H1^[Offset+15-I+J-512]);
    B:=B+W^[I+J+16]*H1^[Offset+I+J-512];
    C:=C+W^[I+J+32]*H1^[Offset+16+I+J-512];
    D:=D+W^[I+J+48]*H1^[Offset+31-I+J-512];
    Inc(J,64);
   End;
   Out^[Blk*32+I]:=A*Scale; Out^[Blk*32+I+16]:=B*Scale;
   DCHist2[Ch,I]:=C; DCHist2[Ch,I+16]:=D;
  End;
  DCOff[Ch]:=(Offset-32) And 511;
 End;
End;
{ Interpolation du canal LFE (lfe_fir_float) vers Out (npcmblocks*32
 echantillons) }

Procedure DCLfeChannel(Out: PDCF);
Var
 Dec,Factor,NCoef,NLfe,I,J,K,Base,P: LongInt;
 A,B: Single;
 Coef: PDCF;
Begin
 If DCLfe=1 Then Dec:=1 Else Dec:=0;
 Factor:=64 Shl Dec; NCoef:=8 Shr Dec; NLfe:=DCNPcm Shr (Dec+1);
 If Dec=1 Then Coef:=PDCF(@DCLfe128F) Else Coef:=PDCF(@DCLfe64F);
 For I:=0 To NLfe-1 Do Begin
  Base:=8+I;
  For J:=0 To Factor Div 2-1 Do Begin
   A:=0; B:=0;
   For K:=0 To NCoef-1 Do Begin
    A:=A+Coef^[J*NCoef+K]*DCLfeS[Base-K];
    B:=B+Coef^[255-J*NCoef-K]*DCLfeS[Base-K];
   End;
   Out^[I*Factor+J]:=A; Out^[I*Factor+Factor Div 2+J]:=B;
  End;
 End;
 For I:=7 Downto 0 Do DCLfeS[I]:=DCLfeS[NLfe+I];
End;
{ Decode un fichier DTS brut (core, 16 bits BE/LE ou 14 bits) vers un WAV PCM 16
 bits (5.1 max, canaux dans l'ordre WAV). }

Procedure DecodeDCA(Const Source,Target: String);
Var
 F,Cv: PEABuffer;
 Size,CvSize,Pos2,P,I,J,K,N,Mask,WavMask,NSpk,Chn,Frames,Nout,Ch,Spk,Wc,Rate0,Q,
  Code,
 DataBytes,Tmp,LfeSp: LongInt;
 Fmt: Integer;
 Word2: LongInt;
 Win: Pointer;
 Out: Array[0..6] Of PDCF;
 WavMap: Array[0..17] Of LongInt;
 Order: Array[0..6] Of LongInt;
 Pcm: Array[0..8191] Of Byte;
 Used: LongInt;
 X: Single;
 V: LongInt;
 Fs: LongInt;
 T: Single;
 Got: Boolean;
 Wr: Array[0..71] Of Byte;
 Started: Boolean;
 Sync4: Int64;

Procedure P32(At: LongInt; Vv: LongInt);
Var
 Z: Integer;
Begin
 For Z:=0 To 3 Do Begin
  Wr[At+Z]:=Vv And 255; Vv:=Vv Shr 8;
 End;
End;

Procedure P16(At: LongInt; Vv: LongInt);Begin
 Wr[At]:=Vv And 255; Wr[At+1]:=(Vv Shr 8) And 255;
End;

Procedure Header(NCh,Rate,Bytes,MaskW: LongInt);Begin
 FillChar(Wr,SizeOf(Wr),0);
 Wr[0]:=82; Wr[1]:=73; Wr[2]:=70; Wr[3]:=70; Wr[8]:=87; Wr[9]:=65; Wr[10]:=86;
  Wr[11]:=69;
 Wr[12]:=102; Wr[13]:=109; Wr[14]:=116; Wr[15]:=32;
 If NCh<=2 Then Begin
  P32(4,36+Bytes); P32(16,16); P16(20,1); P16(22,NCh); P32(24,Rate); P32(28,
   Rate*NCh*2);
  P16(32,NCh*2); P16(34,16);
  Wr[36]:=100; Wr[37]:=97; Wr[38]:=116; Wr[39]:=97; P32(40,Bytes); WriteBytes(
   Wr,44);
 End Else
 Begin
  P32(4,60+Bytes); P32(16,40); P16(20,$FFFE); P16(22,NCh); P32(24,Rate);
  P32(28,Rate*NCh*2); P16(32,NCh*2); P16(34,16);
  P16(36,22); P16(38,16); P32(40,MaskW);
  Wr[44]:=1; Wr[47]:=0; Wr[48]:=0; Wr[49]:=0; Wr[50]:=16; Wr[52]:=128; Wr[55]:=
   170;
  Wr[57]:=56; Wr[58]:=155; Wr[59]:=113;
  Wr[60]:=100; Wr[61]:=97; Wr[62]:=116; Wr[63]:=97; P32(64,Bytes); WriteBytes(
   Wr,68);
 End;
End;

Procedure FlushPcm;Begin
 If Used>0 Then Begin
  WriteBytes(Pcm,Used); Used:=0;
 End;
End;
Begin
 DCInit;
 OpenRead(Source); Size:=InputSize;
 GetMem(F,Size+64); K:=0;
 While K<Size Do Begin
  If Size-K>4096 Then Q:=4096 Else Q:=Size-K;
  ReadAt(K,F^[K],Q); Inc(K,Q);
 End;
 CloseRead;
 { format du flux: synchro au debut (apres eventuel bourrage) }
 Fmt:=-1; P:=0;
 While P+4<=Size Do Begin
  Sync4:=Int64(F^[P])*16777216+F^[P+1]*65536+F^[P+2]*256+F^[P+3];
  If Sync4=$7FFE8001 Then Fmt:=0 Else If Sync4=$FE7F0180 Then Fmt:=1 Else If
   Sync4=
  $1FFFE800 Then Fmt:=2 Else If Sync4=$FF1F00E8 Then Fmt:=3;
  If Fmt>=0 Then Break;
  Inc(P);
 End;
 If Fmt<0 Then Fail('dts: aucun mot de synchronisation DTS trouve.');
 GetMem(Cv,Size+64); CvSize:=0;
 If Fmt=0 Then Begin
  Move(F^[P],Cv^[0],Size-P); CvSize:=Size-P;
 End
 Else If Fmt=1 Then Begin
  I:=P;
  While I+1<Size Do Begin
   Cv^[CvSize]:=F^[I+1]; Cv^[CvSize+1]:=F^[I]; Inc(CvSize,2); Inc(I,2);
  End;
 End Else
 Begin
  FillChar(Cv^,Size+64,0); N:=0; I:=P;
  While I+1<Size Do Begin
   If Fmt=2 Then Word2:=(F^[I]*256+F^[I+1]) And $3FFF Else Word2:=(F^[I+1]*256+
    F^[I])
   And $3FFF;
   For K:=13 Downto 0 Do Begin
    If ((Word2 Shr K) And 1)<>0 Then Cv^[N Shr 3]:=Cv^[N Shr 3] Or (128 Shr (N
     And 7));
    Inc(N);
   End;
   Inc(I,2);
  End;
  CvSize:=N Div 8;
 End;
 FreeMem(F,Size+64);
 GetMem(Win,2048);
 For I:=0 To 5 Do Out[I]:=Nil;
 For I:=0 To 6 Do GetMem(Out[I],16384*4+64);
 OpenWrite(Target); Used:=0; Started:=False; Frames:=0; DataBytes:=0; Rate0:=0;
  Chn:=0;
 WavMask:=0;
 Pos2:=0;
 While Pos2+10<=CvSize Do Begin
  If Not ((Cv^[Pos2]=$7F) And (Cv^[Pos2+1]=$FE) And (Cv^[Pos2+2]=$80) And (Cv^[
   Pos2+3]=1))
  Then Begin
   Inc(Pos2); Continue;
  End;
  Tmp:=Cv^[Pos2+4]*16777216+Cv^[Pos2+5]*65536+Cv^[Pos2+6]*256+Cv^[Pos2+7];
  Fs:=((Tmp Shr 4) And $3FFF)+1;
  If Fs<96 Then Begin
   Inc(Pos2,4); Continue;
  End;
  If Pos2+Fs>CvSize Then Fs:=CvSize-Pos2;
  Got:=DCDecodeFrame(PEABuffer(@Cv^[Pos2]),Fs);
  If Got Then Begin
   Mask:=DCModeMask[DCMode];
   If DCLfe<>0 Then Mask:=Mask Or 32;
   If DCFilterPerfect<>0 Then Win:=@DCFir32P Else Win:=@DCFir32N;
   For Ch:=0 To DCNCh-1 Do Begin
    Spk:=DCPrmSpk[DCMode,Ch];
    DCSynthChannel(Ch,Win,Out[Spk]);
   End;
   If DCLfe<>0 Then DCLfeChannel(Out[5]);
   If ((DCSumFront<>0) And (DCMode>0)) Or (DCMode=3) Then
   For I:=0 To DCNPcm*32-1 Do Begin
    T:=Out[1]^[I]-Out[2]^[I]; Out[1]^[I]:=Out[1]^[I]+Out[2]^[I]; Out[2]^[I]:=T;
   End;
   If (DCSumSurr<>0) And (DCMode>=8) Then
   For I:=0 To DCNPcm*32-1 Do Begin
    T:=Out[3]^[I]-Out[4]^[I]; Out[3]^[I]:=Out[3]^[I]+Out[4]^[I]; Out[4]^[I]:=T;
   End;
   { ordre WAV }
   For I:=0 To 17 Do WavMap[I]:=-1;
   WavMask:=0;
   For Spk:=0 To 6 Do If (Mask And (1 Shl Spk))<>0 Then Begin
    Wc:=DCDca2Wav[Spk];
    If WavMap[Wc]<0 Then Begin
     WavMap[Wc]:=Spk; WavMask:=WavMask Or (1 Shl Wc);
    End;
   End;
   NSpk:=0;
   For Wc:=0 To 17 Do If WavMap[Wc]>=0 Then Begin
    Order[NSpk]:=WavMap[Wc]; Inc(NSpk);
   End;
   If Not Started Then Begin
    Chn:=NSpk; Rate0:=DCRates[DCSr];
    Header(Chn,Rate0,0,WavMask); Started:=True;
   End;
   If (NSpk=Chn) And (DCRates[DCSr]=Rate0) Then Begin
    For I:=0 To DCNPcm*32-1 Do
    For Ch:=0 To Chn-1 Do Begin
     T:=Out[Order[Ch]]^[I]*32768.0;
     V:=Round(T);
     If V>32767 Then V:=32767; If V<-32768 Then V:=-32768;
     If V<0 Then Inc(V,65536);
     Pcm[Used]:=V And 255; Pcm[Used+1]:=V Shr 8; Inc(Used,2);
     If Used>=8190 Then FlushPcm;
    End;
    Inc(DataBytes,DCNPcm*32*Chn*2);
    If DataBytes>2000000000 Then Fail('dts: sortie superieure a 2 Go.');
   End;
   Inc(Frames);
  End;
  Inc(Pos2,Fs);
 End;
 If Not Started Then Fail('dts: aucune trame DTS decodable.');
 FlushPcm;
 {$I-}Seek(ActiveOutput,0); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('dts: positionnement entete WAV impossible.');
 Header(Chn,Rate0,DataBytes,WavMask);
 CloseWrite;
 FreeMem(Cv,Size+64);
End;
{$ENDIF}
{$IFDEF FPC}
{ ---- ASF / WMA : demultiplexeur ASF et decodeur/encodeur WMA1/WMA2 (FFMPEG.PAS, d apres FFmpeg wma*.c, asfdec_f.c, LGPL-2.1+) ---- }
Type
 TMdK = Array[0..39] Of String[79];
 TMdV = Array[0..39] Of String[255];


Var
 MdN,MdAN,MdCN: LongInt; MdK,MdAK,MdCK: TMdK; MdV,MdAV,MdCV: TMdV; MdCreation:
  Int64;
Procedure ADPCMPatchHeader(Rate: LongInt; Channels: Integer; DataSize: LongInt);
Var
 Code: Integer;
Begin
 {$I-}Seek(ActiveOutput,0); Code:=IOResult;{$I+}
 If Code<>0 Then Fail('Positionnement entete WAV impossible.');
 ADPCMWaveHeader(Rate,Channels,DataSize);
End;

{ ASF packet reader. Reassembles media objects; it does not decode WMV/WMA.
  ASFP0001 is a private spool/test format, never an FLV output.
  Reference: FFmpeg libavformat/asfdec_f.c and the ASF object layout. }

Procedure DemuxASF(Const Source,Target: String);
Const
 GHeader: String[
  16]=#$30#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GFile: String[
  16]=#$A1#$DC#$AB#$8C#$47#$A9#$CF#$11#$8E#$E4#$00#$C0#$0C#$20#$53#$65;
 GStream: String[
  16]=#$91#$07#$DC#$B7#$B7#$A9#$CF#$11#$8E#$E6#$00#$C0#$0C#$20#$53#$65;
 GAudio: String[
  16]=#$40#$9E#$69#$F8#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GVideo: String[
  16]=#$C0#$EF#$19#$BC#$4D#$5B#$CF#$11#$A8#$FD#$00#$80#$5F#$5C#$44#$2B;
 GData: String[
  16]=#$36#$26#$B2#$75#$8E#$66#$CF#$11#$A6#$D9#$00#$AA#$00#$62#$CE#$6C;
 GExtension: String[
  16]=#$B5#$03#$BF#$5F#$2E#$A9#$CF#$11#$8E#$E3#$00#$C0#$0C#$20#$53#$65;
 GEncrypt: String[
  16]=#$FB#$B3#$11#$22#$23#$BD#$D2#$11#$B4#$B7#$00#$A0#$C9#$55#$FC#$6E;
 GEncrypt2: String[
  16]=#$14#$E6#$8A#$29#$22#$26#$17#$4C#$B9#$35#$DA#$E0#$7E#$E9#$28#$9C;
Type
 PFragment=^TFragment;
 TFragment=Record
  Next: PFragment;
  Used: Word;
  Data: Array[0..4095] Of Byte;
 End;
 TStream=Record
  ID,Kind,Channels,Align,ExtraSize: Integer;
  Codec,Width,Height,Rate,BitRate,Expected,Received,Sequence,Stamp: LongInt;
  Key: Boolean;
  Extra: Array[0..2047] Of Byte;
  First,Last: PFragment;
 End;
 TStreams=Array[0..3] Of TStream;
 PStreams=^TStreams;
Var
 Streams: PStreams;
 StreamCount: Integer;
 Cache: Array[0..4095] Of Byte;
 CacheAt,CacheSize,Limit,PacketSize,PacketCount,Preroll,DataStart,DataEnd:
  LongInt;
 HeaderEnd,AtObject,Size,P,PacketEnd,PayloadEnd,PacketStart,PacketLength,
  Padding: LongInt;
 Sequence,Offset,RepSize,ObjectSize,Stamp,PayloadSize,Ignored,Delta: LongInt;
 PacketIndex: LongInt;
 Flags,Properties,SegFlags,Segments,I,J,S,StreamID,Key,SubSize: Integer;
 Signature: String[8];

Procedure ClearObject(Track: Integer);
Var
 F,N: PFragment;
Begin
 F:=Streams^[Track].First;
 While F<>Nil Do Begin
  N:=F^.Next; Dispose(F); F:=N;
 End;
 Streams^[Track].First:=Nil; Streams^[Track].Last:=Nil;
 Streams^[Track].Expected:=0; Streams^[Track].Received:=0;
End;

Procedure Release;
Var
 I: Integer;
Begin
 If Streams<>Nil Then Begin
  For I:=0 To StreamCount-1 Do ClearObject(I); Dispose(Streams); Streams:=Nil;
 End;
End;

Procedure Bad(Const MessageText: String);Begin
 Release; Fail('ASF: '+MessageText);
End;

Procedure Bound(Pos,Count,Last: LongInt);Begin
 If (Pos<0) Or (Count<0) Or (Pos>Last) Then Bad('Position invalide.');
 If Count>Last-Pos Then Bad('Objet ou paquet tronque.');
End;

Function ByteAt(Pos: LongInt): Byte;Begin
 Bound(Pos,1,Limit);
 If (Pos<CacheAt) Or (Pos>=CacheAt+CacheSize) Then Begin
  CacheAt:=Pos; CacheSize:=4096; If Limit-Pos<CacheSize Then CacheSize:=Limit-
   Pos;
  ReadAt(Pos,Cache,CacheSize);
 End;
 ByteAt:=Cache[Pos-CacheAt];
End;

Function LE(Pos: LongInt; Count: Integer): LongInt;
Var
 I: Integer;
 V: LongInt;
Begin
 Bound(Pos,Count,Limit); V:=0;
 For I:=Count-1 Downto 0 Do Begin
  If V>8388607 Then Bad('Valeur superieure a 2 Go non prise en charge.');
  V:=V*256+ByteAt(Pos+I);
 End;
 LE:=V;
End;

Function Small64(Pos: LongInt): LongInt;Begin
 If LE(Pos+4,4)<>0 Then Bad('Valeur 64 bits hors limites.'); Small64:=LE(Pos,4);
End;

Function GUID(Pos: LongInt; Const Value: String): Boolean;
Var
 I: Integer;
Begin
 Bound(Pos,16,Limit); GUID:=False;
 For I:=1 To 16 Do If ByteAt(Pos+I-1)<>Ord(Value[I]) Then Exit;
 GUID:=True;
End;

Procedure Put32(V: LongInt);
Var
 B: Array[0..3] Of Byte;
 I: Integer;
Begin
 For I:=0 To 3 Do B[I]:=(V Shr (I*8)) And 255; WriteBytes(B,4);
End;

Procedure Headers(Start,Last: LongInt; Depth: Integer);
Var
 Pos,N,EndPos,T,TypeSize,ECCSize,ExtraAt,BI: LongInt;
 ID,I: Integer;
Begin
 If Depth>2 Then Bad('Extensions imbriquees excessives.'); Pos:=Start;
 While Pos<Last Do Begin
  Bound(Pos,24,Last); N:=Small64(Pos+16); If N<24 Then Bad(
   'Taille objet invalide.');
  Bound(Pos,N,Last); EndPos:=Pos+N; T:=Pos+24;
  If GUID(Pos,GFile) Then Begin
   If PacketSize<>0 Then Bad('Proprietes fichier dupliquees.'); Bound(T,80,
    EndPos);
   If (LE(T+64,4) And 1)<>0 Then Bad(
    'Diffusion ASF sans taille fixe non implementee.');
   PacketCount:=Small64(T+32); Preroll:=Small64(T+56);
   PacketSize:=LE(T+68,4);
   If (PacketSize<16) Or (PacketSize>16777216) Or (PacketSize<>LE(T+72,4)) Then
    Bad(
   'Tailles de paquets variables ou invalides.');
  End Else If GUID(Pos,GStream) Then Begin
   Bound(T,54,EndPos); TypeSize:=LE(T+40,4); ECCSize:=LE(T+44,4);
   ID:=LE(T+48,2);
   If (ID And $FF80)<>0 Then Bad('Piste chiffree ou identifiant reserve.');
   If ID=0 Then Bad('Identifiant de piste nul.');
   If Small64(T+32)<>0 Then Bad('Decalage temporel de piste non implemente.');
   If StreamCount=4 Then Bad('Plus de quatre pistes.');
   For I:=0 To StreamCount-1 Do If Streams^[I].ID=ID Then Bad(
    'Piste dupliquee.');
   Bound(T+54,TypeSize,EndPos); Bound(T+54+TypeSize,ECCSize,EndPos);
   Streams^[StreamCount].ID:=ID;
   If GUID(T,GAudio) Then Begin
    Streams^[StreamCount].Kind:=2; Inc(T,54); Bound(T,18,T+TypeSize);
    Streams^[StreamCount].Codec:=LE(T,2); Streams^[StreamCount].Channels:=LE(T+
     2,2);
    Streams^[StreamCount].Rate:=LE(T+4,4);
    Ignored:=LE(T+8,4); If Ignored>268435455 Then Bad('Debit audio invalide.');
    Streams^[StreamCount].BitRate:=Ignored*8;
    Streams^[StreamCount].Align:=LE(T+12,2); ExtraAt:=T+18;
    Streams^[StreamCount].ExtraSize:=LE(T+16,2);
    If Streams^[StreamCount].ExtraSize>TypeSize-18 Then Bad(
    'Configuration audio tronquee.');
    If ECCSize>0 Then Begin
     Bound(T+TypeSize,8,EndPos);
     If ByteAt(T+TypeSize)>1 Then Bad(
      'Entrelacement audio ASF non implemente.');
    End;
   End Else If GUID(T,GVideo) Then Begin
    Streams^[StreamCount].Kind:=1; Inc(T,54); Bound(T,51,T+TypeSize);
    BI:=LE(T+11,4); If (BI<40) Or (BI>TypeSize-11) Then Bad(
     'BITMAPINFO invalide.');
    If BI>2088 Then Bad('Configuration codec trop longue.');
    Streams^[StreamCount].Width:=LE(T+15,4); Streams^[StreamCount].Height:=LE(T+
     19,4);
    Streams^[StreamCount].Codec:=LE(T+27,4); ExtraAt:=T+51;
    Streams^[StreamCount].ExtraSize:=BI-40;
   End Else Bad('Type de piste non implemente.');
   If Streams^[StreamCount].ExtraSize>2048 Then Bad(
    'Configuration codec trop longue.');
   For I:=0 To Streams^[StreamCount].ExtraSize-1 Do Streams^[StreamCount].Extra[
    I]:=
   ByteAt(ExtraAt+I);
   Inc(StreamCount);
  End Else If GUID(Pos,GExtension) Then Begin
   Bound(T,22,EndPos); N:=LE(T+18,4); Bound(T+22,N,EndPos); Headers(T+22,T+22+N,
    Depth+1);
  End Else If GUID(Pos,GEncrypt) Or GUID(Pos,GEncrypt2) Then Bad(
  'Chiffrement ASF non implemente.');
  Pos:=EndPos;
 End;
End;

Function ReadField(Kind: Integer; Default: LongInt): LongInt;
Var
 N: Integer;
Begin
 N:=Kind And 3; If N=3 Then N:=4;
 If N=0 Then ReadField:=Default Else
 Begin
  Bound(P,N,PacketEnd); ReadField:=LE(P,N); Inc(P,N);
 End;
End;

Procedure FinishObject(Track: Integer);
Var
 F: PFragment;
Begin
 Put32(Streams^[Track].ID); Put32(Ord(Streams^[Track].Key));
 Put32(Streams^[Track].Stamp-Preroll); Put32(Streams^[Track].Expected);
 F:=Streams^[Track].First;
 While F<>Nil Do Begin
  WriteBytes(F^.Data,F^.Used); F:=F^.Next;
 End;
 ClearObject(Track);
End;

Procedure Fragment(Track: Integer; SourcePos,Count,FragOffset,Total,Seq,Time:
 LongInt;
                   IsKey: Boolean);
Var
 F: PFragment;
 N: Word;
Begin
 If FragOffset=0 Then Begin
  If Streams^[Track].Expected<>0 Then Bad('Objet incomplet avant le suivant.');
  If (Total<=0) Or (Total>16777216) Then Bad('Taille media invalide.');
  Streams^[Track].Expected:=Total; Streams^[Track].Sequence:=Seq;
  Streams^[Track].Stamp:=Time; Streams^[Track].Key:=IsKey Or (Streams^[
   Track].Kind=2);
 End;
 If (Streams^[Track].Expected=0) Or (Streams^[Track].Sequence<>Seq) Or
 (Streams^[Track].Received<>FragOffset) Then Bad(
  'Fragments manquants ou desordonnes.');
 If (Total<>0) And (Total<>Streams^[Track].Expected) Then Bad(
  'Taille media changeante.');
 If Count>Streams^[Track].Expected-Streams^[Track].Received Then Bad(
 'Fragment hors objet.');
 While Count>0 Do Begin
  {$IFNDEF FPC}
   If MaxAvail<SizeOf(TFragment) Then Bad('Memoire DOS insuffisante.');
  {$ENDIF}
  New(F); F^.Next:=Nil; N:=4096; If Count<N Then N:=Count; F^.Used:=N;
  If Streams^[Track].First=Nil Then Streams^[Track].First:=
  F Else Streams^[Track].Last^.Next:=F;
  Streams^[Track].Last:=F; ReadAt(SourcePos,F^.Data,N);
  Inc(SourcePos,N); Dec(Count,N); Inc(Streams^[Track].Received,N);
 End;
 If Streams^[Track].Received=Streams^[Track].Expected Then FinishObject(Track);
