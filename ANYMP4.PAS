 WriteLn(EngOut,
 'MOD2WAV - Cette commande permet de lancer le convertisseur MOD ProTracker ve'+
  'rs WAV PCM16');
 WriteLn(EngOut);
 WriteLn(EngOut,'Syntaxe: MOD2WAV entree.mod [sortie.wav]');
